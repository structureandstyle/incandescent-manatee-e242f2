/*
 * Flow to Form site credit. f2f_credit 1.2.0, sha256 d559f8085d7b.
 *
 * Generated from f2f-patterns, src/f2f_credit. Do not edit this file: change
 * the source there and regenerate with `python -m f2f_credit astro <folder>`.
 * `python -m f2f_credit check <this file>` says whether it is current and
 * unedited.
 *
 * Off unless `enabled` is true. A supplier credit on a client's site is the
 * client's decision: switch it on only after their written yes, and keep that
 * yes in the client folder.
 *
 * One per page, in the footer's bottom bar beside the copyright line. Never
 * hide it at a breakpoint with display:none: the emblem's path id has to stay
 * on the page for the second copy to draw.
 */
type Variant = "takes-form" | "blind-stamp" | "weight-lands";
type Line = "Site by" | "Site and search by";

interface Props {
  /** Off by default. True only after the client's written yes. */
  enabled?: boolean;
  /** takes-form is the default; blind-stamp for icon-led footers; weight-lands for text only. */
  variant?: Variant;
  /** "Site and search by" only where we also run the client's search. */
  line?: Line;
  /** The client's domain, for utm_source. Defaults to `site` in astro.config. */
  host?: string;
  /** False where a Content-Security-Policy forbids inline styles: ship `python -m f2f_credit css` instead. */
  inlineStyle?: boolean;
}

const { enabled = false, variant = "takes-form", line = "Site by", host = Astro.site?.hostname, inlineStyle = true } = Astro.props;

const MARKUP = {
