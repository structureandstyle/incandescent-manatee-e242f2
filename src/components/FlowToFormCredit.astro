  "blind-stamp": "<a class=\"ff-ink\" href=\"__HREF__\"__REL__><span class=\"ff-ink__sr\">__LINE__ flow to form</span><svg viewBox=\"0 0 512 483\" aria-hidden=\"true\"><path id=\"ff-ink-m\" fill-rule=\"evenodd\" d=\"m408 428v-13c0-120-159-82-159-107c0-35 182 16 234-61c-1 84-29 144-75 181zm-152 48c-2 0-5 0-7 0c-18 0-34-2-50-5v-133c0-119 141-72 141-107c0-38-127-3-191-41c-4-62 73-106 165-106c37 0 86 8 119 35c1 0 2 1 3 2c20 17 34 42 34 76c0 140-227 60-227 111c0 35 140-11 140 107v30c-35 21-78 31-127 31zm-81-138v127c-2-1-4-1-5-2c-86-27-142-101-142-221c0-96 36-163 93-199c-21 18-35 43-35 78c0 37 16 59 40 73c2 1 5 3 7 4c73 34 201 4 201 33c0 25-159-13-159 107zm86-331c3 0 6 0 8 0c66 0 124 23 150 58c0 1 1 1 1 1c8 11 13 23 14 36c-37-18-82-25-120-25c-88 0-174 32-187 94c-9-13-15-29-15-51c0-87 88-111 149-113zm188 67c-45-46-111-73-189-74c-1 0-3 0-4 0c-148 0-256 94-256 242c0 112 62 192 157 225c6 2 12 4 18 5c5 2 10 3 16 4c2 1 5 1 8 2c10 2 21 3 32 4c6 0 12 1 18 1h7c47 0 91-10 127-28l24-12l1-1c64-41 104-110 104-200c0-69-23-126-63-168z\"/></svg><svg viewBox=\"0 0 512 483\" aria-hidden=\"true\"><use href=\"#ff-ink-m\"/></svg></a>",
  "weight-lands": "<a class=\"ff-wt\" href=\"__HREF__\"__REL__>__LINE__ <span data-t=\"flow to\">flow to</span> <span class=\"ff-wt__f\" data-t=\"form\">form</span></a>"
};
const CSS = {
  "takes-form": "a.ff-sig.ff-sig,a.ff-sig.ff-sig:visited,a.ff-sig.ff-sig:hover{color:inherit;text-decoration:none}\n.ff-sig{display:inline-flex;align-items:center;gap:.6em;min-height:24px;border-radius:13px;white-space:nowrap;font-synthesis-weight:none}\n.ff-sig__t{text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:.25em}\n.ff-sig b{font-weight:700}\n.ff-sig__m{display:grid;flex:none;width:1.75em;fill:currentColor}\n.ff-sig__m svg{grid-area:1/1;width:100%;height:auto}\n.ff-sig__m svg:first-child{opacity:var(--ff-rest,.4)}\n.ff-sig__m svg+svg{clip-path:inset(100% 0 0)}\n.ff-sig:is(:hover,:focus-visible,:active) .ff-sig__t{text-decoration-thickness:2px}\n.ff-sig:is(:hover,:focus-visible,:active) .ff-sig__m svg+svg{clip-path:inset(0)}\n.ff-sig:focus-visible{outline:2px solid currentColor;outline-offset:5px}\n@media(prefers-reduced-motion:no-preference){.ff-sig__t{transition:text-decoration-thickness .3s ease}.ff-sig__m svg+svg{transition:clip-path .3s ease}}",
  "blind-stamp": "a.ff-ink.ff-ink,a.ff-ink.ff-ink:visited,a.ff-ink.ff-ink:hover{color:inherit;text-decoration:none}\n.ff-ink{position:relative;display:inline-grid;width:2em;line-height:0;border-radius:50%;fill:currentColor}\n.ff-ink__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.ff-ink svg{grid-area:1/1;width:100%;height:auto}\n.ff-ink svg:first-of-type{opacity:var(--ff-rest,.7)}\n.ff-ink svg+svg{clip-path:circle(0 at 38% 94%)}\n.ff-ink:is(:hover,:focus-visible,:active) svg+svg{clip-path:circle(125% at 38% 94%)}\n.ff-ink:focus-visible{outline:2px solid currentColor;outline-offset:4px}\n@media(prefers-reduced-motion:no-preference){.ff-ink svg+svg{transition:clip-path .3s ease}}",
  "weight-lands": "a.ff-wt.ff-wt,a.ff-wt.ff-wt:visited,a.ff-wt.ff-wt:hover{color:inherit;text-decoration-line:underline}\n.ff-wt{display:inline-block;padding-block:4px;border-radius:13px;white-space:nowrap;text-decoration-thickness:1px;text-underline-offset:.25em}\n.ff-wt span{display:inline-flex;flex-direction:column;text-decoration:inherit;font-variation-settings:\"wght\" 400}\n.ff-wt span::after{content:attr(data-t);height:0;overflow:hidden;visibility:hidden;font-variation-settings:\"wght\" 400}\n.ff-wt .ff-wt__f{font-weight:700;font-variation-settings:\"wght\" 700}\n.ff-wt .ff-wt__f::after{font-variation-settings:\"wght\" 800}\n.ff-wt:is(:hover,:focus-visible,:active){text-decoration-thickness:2px}\n.ff-wt:is(:hover,:focus-visible,:active) span{font-variation-settings:\"wght\" 300}\n.ff-wt:is(:hover,:focus-visible,:active) .ff-wt__f{font-variation-settings:\"wght\" 800}\n.ff-wt:focus-visible{outline:2px solid currentColor;outline-offset:5px}\n@media(prefers-reduced-motion:no-preference){.ff-wt{transition:text-decoration-thickness .3s ease}.ff-wt span{transition:font-variation-settings .3s ease}}"
};
const VARIANTS = ["takes-form", "blind-stamp", "weight-lands"];
const LINES = ["Site by", "Site and search by"];

function renderCredit(enabled, variant, line, host, inlineStyle) {
  if (!enabled) return "";
  if (!VARIANTS.includes(variant)) throw new Error(`flow to form credit: unknown variant "${variant}"`);
  if (!LINES.includes(line)) throw new Error(`flow to form credit: line must be one of ${LINES.join(", ")}`);
  if (!host || !/^[a-z0-9.-]+$/i.test(host)) {
    throw new Error("flow to form credit: no client domain, so the link cannot be tagged. Set `site` or pass `host`.");
  }
  const source = host.toLowerCase().replace(/^www\./, "");
  const own = source === "flowtoform.co.uk";
  const href = own ? "/" : `https://flowtoform.co.uk/?utm_source=${source}&amp;utm_medium=site-credit`;
  return (MARKUP[variant] + (inlineStyle ? `<style>${CSS[variant]}</style>` : ""))
    .replace("__HREF__", href)
    .replace("__REL__", own ? "" : ' rel="nofollow"')
    .replace(/__LINE__/g, line);
}

const html = renderCredit(enabled, variant, line, host, inlineStyle);
---
{html && <Fragment set:html={html} />}
