---
/**
 * A service page section's words with a line drawing beside them (17 Nov 2026),
 * as the area pages' AreaSide does. The words keep the reading measure on the
 * left; below 900px the drawing drops under them, so a phone reads the section
 * first.
 *
 *   <ServiceSide drawing="kitchen-run"><p>...</p></ServiceSide>
 */
import ServiceDrawing from "./ServiceDrawing.astro";

interface Props {
  drawing: string;
}

const { drawing } = Astro.props;
---

<div class="service-side">
  <div class="service-side-text">
    <slot />
  </div>
  <div class="service-side-aside">
    <ServiceDrawing drawing={drawing} />
  </div>
</div>

<style>
  .service-side {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: var(--space-10) var(--gap-lg);
    align-items: start;
  }
  @media (max-width: 900px) {
    .service-side {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-side-aside {
      max-width: 480px;
    }
  }
</style>
