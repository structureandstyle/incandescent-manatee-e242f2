---
/**
 * How the work is done in the client's home, as three drawn points.
 *
 * Only the eight Kaspar-confirmed conduct facts may appear here (copy protocol
 * section 11; the eight lines are in the ops repo's company record). The
 * protocol bans them as bare claims ("clean and tidy", "minimal disruption"),
 * so each one says what physically happens.
 */
interface Props {
  items: { icon: "floor" | "screen" | "tidy"; text: string }[];
}

const { items } = Astro.props;
---

<div class="conduct">
  {items.map((item) => (
    <div>
      <svg viewBox="0 0 34 34" aria-hidden="true">
        {item.icon === "floor" && <><rect x="3" y="20" width="28" height="9" /><path d="M3 20 L17 12 L31 20" /></>}
        {item.icon === "screen" && <><rect x="8" y="3" width="18" height="28" /><path d="M17 3 V31" /><circle cx="17" cy="17" r="1.6" /></>}
        {item.icon === "tidy" && <><path d="M5 28 H29" /><path d="M9 28 V16 H25 V28" /><path d="M13 16 V10 H21 V16" /></>}
      </svg>
      <p>{item.text}</p>
    </div>
  ))}
</div>

<style>
  .conduct {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--space-12);
    margin-top: var(--space-12);
    border-top: var(--rule-structure);
  }
  .conduct div { padding: var(--space-9) 0; border-bottom: var(--rule-hair); }
  svg { width: 34px; height: 34px; margin-bottom: var(--space-5); stroke: var(--green); fill: none; stroke-width: 1.3; }
  p { margin: 0; font-size: 15.5px; line-height: 1.5; }
  @media (max-width: 640px) { .conduct { grid-template-columns: 1fr; } }
</style>
