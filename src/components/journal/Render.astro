---
/**
 * An AI render shown as a style example inside an article.
 *
 * Kaspar's rule, 18 Oct 2026: a render carries "AI-generated example" beneath
 * it and nothing more; the article's gallery link takes readers to real work.
 * The caption is fixed here so no article can drop it. Renders live under
 * /images/journal/, never in a service folder, so they cannot reach a gallery.
 *
 * On its own a render sits at reading width. Inside <Renders> two sit side by
 * side (give each `pair`), so a reader can compare the options a section
 * describes.
 *   <Render src="/images/journal/alcove-ai-floating-shelves.webp" width={1536}
 *     height={1024} alt="Floating shelves above handleless cupboards" />
 */
import Plate from "../ds/Plate.astro";

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Set on each render inside <Renders>: half the wide column. */
  pair?: boolean;
}

const { src, alt, width, height, pair = false } = Astro.props;
const sizes = pair ? "(max-width: 760px) 92vw, 530px" : "(max-width: 700px) 92vw, 680px";
---

<div class="render">
  <Plate photo={src} alt={alt} width={width} height={height} ratio={`${width} / ${height}`} subject="AI-generated example" sizes={sizes} />
</div>

<style>
  .render { margin-top: var(--space-12); margin-bottom: var(--space-12); }
</style>
