---
/**
 * One material card inside <Materials>: a photograph, the name, then three
 * short answers. `ask` turns the caption's right half into an open question,
 * for a card whose board or photograph Kaspar has not yet confirmed.
 *
 * Text-only cards, 18 Oct 2026: the alcove article went live without job
 * photographs, so `photo` is optional, and `rows` replaces the three fixed
 * answers when a card needs its own labels. A row labelled "Bear in mind" keeps
 * the walnut label.
 */
import Plate from "../ds/Plate.astro";
import Ask from "../Ask.astro";

interface Props {
  name: string;
  photo?: string;
  alt?: string;
  width?: number;
  height?: number;
  caption?: string;
  ask?: { q: string; text: string };
  what?: string;
  goodFor?: string;
  bearInMind?: string;
  rows?: { label: string; text: string }[];
}

const { name, photo, alt, width, height, caption, ask, what, goodFor, bearInMind } = Astro.props;
const rows = Astro.props.rows ?? [
  { label: "What it is", text: what ?? "" },
  { label: "Good for", text: goodFor ?? "" },
  { label: "Bear in mind", text: bearInMind ?? "" },
];
---

<div class="material">
  {photo && <Plate
    photo={photo}
    alt={alt}
    width={width}
    height={height}
    ratio="4 / 3"
    subject={caption}
    sizes="(max-width: 760px) 92vw, 340px"
  >
    {ask && <Ask q={ask.q} slot="controls">{ask.text}</Ask>}
  </Plate>}
  <h3 class:list={{ "no-photo": !photo }}>{name}</h3>
  <dl>
    {rows.map((r) => <Fragment><dt class:list={{ bim: r.label === "Bear in mind" }}>{r.label}</dt><dd>{r.text}</dd></Fragment>)}
  </dl>
</div>

<style>
  .material { padding: var(--space-11) 0 var(--space-10); }
  .material h3 {
    font-family: var(--font-serif-display);
    font-weight: var(--weight-regular);
    font-size: 24px;
    margin: var(--space-9) 0 var(--space-6);
  }
  .material h3.no-photo { margin-top: 0; }
  dl { margin: 0; }
  dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: var(--space-6);
  }
  dt.bim { color: var(--walnut); }
  dd { margin: var(--space-1) 0 0; font-size: 15px; line-height: 1.5; }
  @media (max-width: 760px) {
    .material { border-bottom: var(--rule-hair); }
    .material:last-child { border-bottom: 0; }
  }
</style>
