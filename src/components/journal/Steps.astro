---
/**
 * The route from enquiry to fitting, as numbered steps. Facts only from the
 * questionnaire answers (src/data/answers.ts): first visit 45 to 60 minutes
 * (Q14), survey about an hour (Q17), lead time 4 to 8 weeks (Q7).
 */
interface Props {
  items: { title: string; text: string }[];
}

const { items } = Astro.props;
---

<ol class="steps">
  {items.map((s, n) => (
    <li>
      <span class="n">{String(n + 1).padStart(2, "0")}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--space-13);
    margin-bottom: var(--space-4);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  li { padding: var(--space-9) var(--space-9) var(--space-9) 0; border-top: 2px solid var(--green); }
  .n { font-family: var(--font-mono); font-size: 12px; letter-spacing: var(--ls-mono); color: var(--green); }
  h3 {
    font-family: var(--font-serif-display);
    font-weight: var(--weight-regular);
    font-size: 21px;
    line-height: 1.2;
    margin: var(--space-3) 0 var(--space-4);
  }
  p { margin: 0; font-size: var(--type-body-sm); line-height: 1.5; color: var(--ink-soft); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 440px) { .steps { grid-template-columns: 1fr; } }
</style>
