---
/**
 * Drawing 1 of the built-in wardrobe guide, the counterpart of AlcoveDrawing
 * (20 Oct 2026, Denis: "a sketch similar to the one on the alcove article").
 * A front view of a three-section wardrobe with the doors off, long hanging,
 * double hanging and shelves, beside a side section showing why the depth
 * matters: a hanger needs the width it is given.
 *
 * The drawing is fixed; the sizes it keys to are props, so the numbers stay in
 * the article where Kaspar approves them:
 *
 *   <WardrobeDrawing
 *     legend={[{ k: "A", label: "Overall depth:", text: "around 600 mm." }, ...]}
 *     note="Starting points for planning, not fixed sizes." />
 *
 * It is a diagram, not to scale: the side section is drawn larger than the
 * front view so the hanger reads. Colours are the brand tokens written out,
 * because SVG presentation attributes do not resolve CSS custom properties.
 * The frame and legend styles are AlcoveDrawing's, so the two read as a set.
 */
interface Props {
  title?: string;
  legend: { k: string; label: string; text: string }[];
  note?: string;
}

const { title = "Drawing 1 · Starting sizes", legend, note } = Astro.props;
const CHAR = "#221D18";
const GREEN = "#2C4A3A";
const OAK = "#B28451";
const PANEL = "#F6F3EA";
const SOFT = "rgba(34,29,24,.66)";
const CLOTH = "rgba(178,132,81,.20)";

// Front view: carcass 40..400 wide, 48 (top) to 292 (base), plinth to 300.
// Left section: one rail, long hanging. Middle: two rails. Right: shelves.
const longRail = 124;
const upperRail = 92;
const lowerRail = 196;
const shelves = [94, 127, 160, 193, 226, 259];
const long = [178, 150, 168, 140, 160];
const short = [52, 46, 54, 44, 50];
---

<figure class="diagram">
  <div class="diagram-cap">
    <span class="mono green">{title}</span>
    <span class="mono">Front view and side section</span>
  </div>
  <svg viewBox="0 0 640 350" role="img" aria-label="Front view of a built-in wardrobe with its doors removed, showing a long hanging section, a double hanging section and a column of shelves, beside a side section with a coat hanger, marking overall depth, clear internal depth, long hanging height, double hanging height and the gap between shelves">
    <g stroke={CHAR} fill="none" stroke-width="1.2">
      <line x1="20" y1="40" x2="430" y2="40" />
      <line x1="20" y1="300" x2="430" y2="300" />
      <rect x="40" y="48" width="360" height="252" />
      <line x1="40" y1="292" x2="400" y2="292" />
      <line x1="160" y1="48" x2="160" y2="292" />
      <line x1="280" y1="48" x2="280" y2="292" />
      <line x1="40" y1={longRail - 10} x2="160" y2={longRail - 10} stroke={OAK} stroke-width="2" />
      <line x1="160" y1={upperRail - 10} x2="280" y2={upperRail - 10} stroke={OAK} stroke-width="2" />
      <line x1="160" y1={lowerRail - 10} x2="280" y2={lowerRail - 10} stroke={OAK} stroke-width="2" />
      <g stroke={OAK} stroke-width="2">{shelves.map((y) => <line x1="280" y1={y} x2="400" y2={y} />)}</g>
      <line x1="48" y1={longRail} x2="152" y2={longRail} stroke-width="1.8" />
      <line x1="168" y1={upperRail} x2="272" y2={upperRail} stroke-width="1.8" />
      <line x1="168" y1={lowerRail} x2="272" y2={lowerRail} stroke-width="1.8" />
    </g>
    <g stroke={SOFT} stroke-width="0.8" fill={CLOTH}>
      {long.map((h, i) => <rect x={64 + i * 18} y={longRail + 4} width="13" height={h - 30} rx="2" />)}
      {short.map((h, i) => <rect x={172 + i * 16} y={upperRail + 4} width="11" height={h} rx="2" />)}
      {short.map((h, i) => <rect x={172 + i * 16} y={lowerRail + 4} width="11" height={h + 10} rx="2" />)}
      {[94, 127, 160, 193, 226].map((y) => <rect x="300" y={y + 18} width="80" height="14" rx="2" />)}
    </g>
    <g stroke={GREEN} stroke-width="1">
      <line x1="52" y1={longRail} x2="52" y2="292" /><line x1="46" y1={longRail} x2="58" y2={longRail} /><line x1="46" y1="292" x2="58" y2="292" />
      <line x1="270" y1={lowerRail} x2="270" y2="292" /><line x1="264" y1={lowerRail} x2="276" y2={lowerRail} /><line x1="264" y1="292" x2="276" y2="292" />
      <line x1="270" y1={upperRail} x2="270" y2={lowerRail - 10} /><line x1="264" y1={upperRail} x2="276" y2={upperRail} /><line x1="264" y1={lowerRail - 10} x2="276" y2={lowerRail - 10} />
      <line x1="416" y1="193" x2="416" y2="226" /><line x1="410" y1="193" x2="422" y2="193" /><line x1="410" y1="226" x2="422" y2="226" />
    </g>
    <g font-size="11" fill={GREEN}>
      <rect x="42" y="240" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="52" y="253" text-anchor="middle">C</text>
      <rect x="260" y="250" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="270" y="263" text-anchor="middle">D</text>
      <rect x="260" y="128" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="270" y="141" text-anchor="middle">D</text>
      <rect x="406" y="200" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="416" y="213" text-anchor="middle">E</text>
      <text x="44" y="64" fill={SOFT} font-size="9" letter-spacing="1.2">LONG</text>
      <text x="164" y="64" fill={SOFT} font-size="9" letter-spacing="1.2">DOUBLE</text>
      <text x="284" y="64" fill={SOFT} font-size="9" letter-spacing="1.2">FOLDED</text>
      <text x="20" y="324" fill={SOFT} font-size="9" letter-spacing="1.2">FRONT VIEW, DOORS OFF</text>
    </g>
    <g stroke={CHAR} fill="none" stroke-width="1.2">
      <line x1="470" y1="40" x2="470" y2="300" stroke-width="2.4" />
      <line x1="470" y1="300" x2="630" y2="300" />
      <line x1="470" y1="48" x2="600" y2="48" />
      <line x1="470" y1="292" x2="600" y2="292" />
      <line x1="476" y1="48" x2="476" y2="292" stroke="rgba(34,29,24,.55)" />
      <line x1="600" y1="48" x2="600" y2="300" stroke-width="2.4" />
      <circle cx="538" cy="124" r="3" />
      <path d="M538 124 q0 -9 7 -9" />
      <path d="M490 150 L538 128 L586 150 Z" />
    </g>
    <g stroke={SOFT} stroke-width="0.8" fill={CLOTH}>
      <path d="M492 152 L584 152 L578 268 L498 268 Z" />
    </g>
    <g stroke={GREEN} stroke-width="1">
      <line x1="470" y1="316" x2="600" y2="316" /><line x1="470" y1="310" x2="470" y2="322" /><line x1="600" y1="310" x2="600" y2="322" />
      <line x1="476" y1="72" x2="597" y2="72" /><line x1="476" y1="66" x2="476" y2="78" /><line x1="597" y1="66" x2="597" y2="78" />
    </g>
    <g font-size="11" fill={GREEN}>
      <rect x="525" y="307" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="535" y="320" text-anchor="middle">A</text>
      <rect x="526" y="63" width="20" height="18" fill={PANEL} stroke={GREEN} /><text x="536" y="76" text-anchor="middle">B</text>
      <text x="476" y="36" fill={SOFT} font-size="9" letter-spacing="1.2">WALL</text>
      <text x="566" y="36" fill={SOFT} font-size="9" letter-spacing="1.2">DOOR</text>
      <text x="470" y="344" fill={SOFT} font-size="9" letter-spacing="1.2">SIDE SECTION</text>
    </g>
  </svg>
  <div class="legend">
    {legend.map((item) => (
      <div><span class="k">{item.k}</span><span><b>{item.label}</b> {item.text}</span></div>
    ))}
  </div>
  {note && <p class="diagram-note">{note}</p>}
</figure>

<style>
  .diagram {
    margin-top: var(--space-14);
    margin-bottom: var(--space-4);
    border: var(--rule-structure);
    padding: var(--space-11) var(--space-11) var(--space-7);
    background: #F6F3EA;
  }
  .diagram-cap {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .mono.green { color: var(--green); }
  svg { display: block; width: 100%; height: auto; }
  svg text { font-family: var(--font-mono); }
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-5) var(--space-12);
    margin: var(--space-8) 0 var(--space-2);
    padding-top: var(--space-7);
    border-top: var(--rule-hair);
  }
  .legend div {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: var(--space-4);
    font-size: var(--type-body-sm);
    line-height: 1.45;
  }
  .legend b { font-weight: var(--weight-medium); }
  .k {
    font-family: var(--font-mono);
    font-size: 12px;
    width: 22px;
    height: 22px;
    border: 1px solid var(--green);
    color: var(--green);
    display: grid;
    place-items: center;
  }
  .diagram-note { margin: var(--space-5) 0 0; font-size: 13.5px; color: var(--ink-soft); }
</style>
