---
import { SERVICES, DEFERRED_SERVICES, serviceLabel } from "../data/site";

interface Props {
  compact?: boolean;
  /** Prefix for element ids, so the page form and the modal form can coexist
      without duplicate ids. Field names are untouched: same Netlify form. */
  idPrefix?: string;
  /** The service to tick on arrival: a service page passes its own title.
      Anywhere else nothing is ticked, rather than silently defaulting to
      fitted wardrobes, which is what every alcove enquiry used to arrive as. */
  service?: string;
  /** Tick the current service without shortening the choice list. The global
      modal uses this on service pages: the visitor keeps the ability to add
      related work while the page they opened it from is already selected. */
  preselectedService?: string;
}
const { compact = false, idPrefix = "", service, preselectedService } = Astro.props;

/**
 * What a lead can ask for. Checkboxes rather than a single choice since
 * 2 September 2026, Denis's call, and it is the right shape: a room being
 * fitted out rarely needs one thing, and a dropdown forced those leads to pick
 * the biggest item and mention the rest in the message, or not at all.
 *
 * Netlify Forms records repeated inputs sharing a name, so every ticked box
 * arrives against `service` without changing how the form is wired.
 *
 * Two entries are not live service pages, and both are deliberate:
 *
 *   Flooring is work he takes. It is a category on his Business Profile with
 *   two services under it, added on the strength of his own description and
 *   repeated mentions in his reviews. There is no page because there is no
 *   usable photography, which is a reason not to publish a page and no reason
 *   at all to refuse the enquiry.
 *
 *   Home office and under-stair storage is one of the six service pages in the
 *   signed scope, deferred on 31 August until its imagery exists. The page is
 *   deferred; the work is not.
 */
const CHOICES = [
  // serviceLabel, not title: this list is read by a visitor, and one service
  // keeps a search term in its own page title that protocol 5 bans everywhere
  // else. The enquiry log records whatever is ticked, so the label is what
  // lands in it, and the two stay in step.
  ...SERVICES.filter((s) => s.slug !== "fitted-wardrobe-cost").map(serviceLabel),
  ...DEFERRED_SERVICES.map(serviceLabel),
  "Flooring",
  "Something else",
];

/**
 * WHAT A SERVICE PAGE SHOWS INSTEAD, 5 September 2026, Denis's call.
 *
 * The full list is right where there is no page context: on /contact/, and in
 * the modal, which opens from anywhere. It was wrong on a service page. Under
 * the heading "What do you need?", a reader who had just spent a page on
 * alcove units was shown a menu of seven other services with theirs ticked,
 * at the exact moment they were about to write. That reads as "while you are
 * here, anything else?", which is the one thing this site's voice is not.
 *
 * So a page that already knows the answer shows the answer, plus the escape
 * hatch. Eight checkboxes become two, the enquiry section stops looking like a
 * lead-capture block, and nothing the shared enquiry log records is lost:
 * whatever is ticked still arrives under `service`, in the log's own
 * vocabulary, and anything else a visitor wants goes in the job box below,
 * which is where they would describe it properly anyway.
 *
 * The multi-select itself is not being reversed. Denis's 2 September reasoning
 * stands, that a room being fitted out rarely needs one thing, and the full
 * list is one click away in the modal on every page including this one.
 */
const choices = service ? [service, "Something else"] : CHOICES;
const selectedService = service ?? preselectedService;

/**
 * What to write in the job box, shown as a placeholder, 2 Sep 2026 on Denis's
 * ask: give someone a shape to copy so they start typing instead of composing.
 *
 * Each one is the same three things in the same order, because those are the
 * three the first reply actually needs: the room, rough sizes, and what the
 * piece has to hold. Nobody writes that unprompted, and an enquiry without it
 * costs a round trip before anything useful can be said back.
 *
 * KEYED BY serviceLabel, NOT BY TITLE, corrected 5 September 2026. A service
 * page passes the label, because that is the vocabulary the checkboxes and the
 * enquiry log are built from, and one service's label and title differ: media
 * walls keeps the search term in its own page title and is called "Built-in TV
 * units" everywhere else. Keyed by title, that page silently fell through to
 * the wardrobe example. One vocabulary, one lookup.
 *
 * The contact page and the modal have no service, so they get the wardrobe
 * example: it is the commonest job and it models the same shape.
 *
 * These are examples, not claims. Keep the numbers ordinary and the language
 * the way a person would actually type it.
 */
const JOB_EXAMPLE_DEFAULT =
  "Bedroom wall about 3m wide and 2.4m to the ceiling. Hanging both sides, drawers in the middle.";

const JOB_EXAMPLES: Record<string, string> = {
  "Fitted wardrobes": JOB_EXAMPLE_DEFAULT,
  "Walk-in wardrobes":
    "Box room about 2m by 2.5m. Hanging on two walls, shoe shelves and a bank of drawers.",
  "Alcove units and shelving":
    "Two alcoves either side of the chimney breast, about 1m wide. Cupboards below, open shelves above.",
  "Built-in TV units":
    "Living room chimney wall, 65 inch TV. Cables and a console to hide, sockets already there.",
  "Bespoke kitchens":
    "Galley kitchen about 4m long. One wall of units and a tall run for the oven and fridge.",
  "Home office and under-stair storage":
    "Under the stairs, about 2m along and sloping. Coats, shoes and a bit of shelving.",
};

const jobExample = (selectedService && JOB_EXAMPLES[selectedService]) || JOB_EXAMPLE_DEFAULT;

/**
 * "How did you hear about us?" was a free-text box until 2 September 2026.
 * It is a dropdown now, Denis's call, and the option list is not cosmetic.
 *
 * This answer is the one the shared enquiry log records in its "Found us via"
 * column, and clause 2 of the agreement counts an enquiry as F2F-generated
 * when it is "recorded as having found you through Google or the website".
 *
 * `value` matches the log's own vocabulary (its Channel column validates
 * against a list carrying Referral and Other) while the label stays in the
 * words a visitor would use. Change one, change the log.
 *
 * THE SEARCH OPTION IS NOT "GOOGLE". Widened 2 September 2026, Denis's point:
 * a lead can arrive from Bing or DuckDuckGo, and a bare "Google" would push
 * them into "Something else" or make them answer wrongly. The label names
 * Google anyway, because that is the word people use for searching, and adds
 * the rest so nobody hesitates. Nothing is lost by not isolating Google here:
 * Search Console and the Business Profile measure Google far more precisely
 * than a self-reported dropdown ever could, and what this field uniquely
 * catches is the traffic no analytics can see.
 *
 * THERE IS NO "WEBSITE" OPTION, and that is deliberate. It shipped with one
 * for a few hours on 2 September and Denis removed it the same day, correctly:
 * anyone filling this form in is already on the website, so the website cannot
 * be how they heard about us. The question would have invited a shrug, and a
 * shrugged answer is worse than an empty one because it still looks like data.
 * The genuine website-found case is a visitor who browses, then phones or
 * messages: that arrives on another channel entirely and the log records it
 * there. Nothing is lost by leaving it off the form.
 *
 * "Something else" is the escape hatch: a lead from a citation site or a van
 * sign would otherwise pick one of two wrong answers, and a mislabelled
 * attribution is a commission figure we cannot defend. The log carries "Other"
 * for the same reason.
 *
 * Left optional, as the text box was. Never add a required field to a lead
 * form to improve our own reporting.
 */
const SOURCES = [
  { value: "Search", label: "Google or another search engine" },
  { value: "Referral", label: "Someone recommended you" },
  { value: "Something else", label: "Something else" },
];

/**
 * Netlify Forms. The site is already on Netlify so this costs nothing and adds
 * no infrastructure, and it produces a timestamped, attributable record.
 *
 * That record is the point. The agreement counts website enquiries as
 * F2F-generated, and without it attribution rests on recall. Photo upload and
 * "how did you hear about us" are both named in the signed scope.
 *
 * Never reuse the old QuoteRequest.tsx. Its submit handler set a success flag
 * and discarded everything, while telling the visitor they would hear back
 * within 24 hours.
 *
 * STYLED ON THE DESIGN TOKENS since 2 Sep 2026. The form arrived with the
 * scaffold's Tailwind utilities, and the token base stylesheet resets
 * `button` outside any cascade layer, which beats a layered utility however
 * late it loads: the submit button rendered as bare text with no background
 * on every page. The scoped rules below are unlayered too, and carry the
 * specificity to win. Field names, ids and Netlify attributes are untouched.
 */
---

<form
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company-website"
  enctype="multipart/form-data"
  action="/thanks/"
  class:list={["enquiry-form", compact && "is-compact"]}
>
  <input type="hidden" name="form-name" value="enquiry" />
  <p hidden>
    <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="row">
    <div>
      <label for={`${idPrefix}name`}>Your name</label>
      <input id={`${idPrefix}name`} name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label for={`${idPrefix}phone`}>Phone</label>
      <input id={`${idPrefix}phone`} name="phone" type="tel" required autocomplete="tel" />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}email`}>Email</label>
    <input id={`${idPrefix}email`} name="email" type="email" required autocomplete="email" />
  </div>

  <fieldset class="choices-field">
    <legend>What do you need?</legend>
    <p class="help">
      {selectedService ? "Already ticked for you. Add anything else you need." : "Tick everything that applies."}
    </p>
    <div class="choices">
      {choices.map((label, i) => (
        <label class="choice" for={`${idPrefix}service-${i}`}>
          <input
            id={`${idPrefix}service-${i}`}
            type="checkbox"
            name="service"
            value={label}
            checked={selectedService === label}
          />
          <span>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label for={`${idPrefix}area`}>Which area of London?</label>
    <input
      id={`${idPrefix}area`} name="area" type="text"
      placeholder="Hampstead, Camden, or your postcode"
    />
  </div>

  <div>
    <label for={`${idPrefix}detail`}>Tell us about the job</label>
    <p class="help">The room, rough sizes, and what it needs to hold is plenty.</p>
    <textarea
      id={`${idPrefix}detail`}
      name="detail"
      rows={compact ? 3 : 5}
      placeholder={jobExample}
    ></textarea>
  </div>

  {/*
    THE ATTACHMENT, widened and corrected 5 September 2026, Denis's ask: people
    have drawings, not only photographs, so the field has to take a document.

    accept now carries PDF and Word alongside images. The extensions are listed
    as well as the MIME types on purpose: iOS and some Android pickers match on
    extension, and a bare image/* on a phone opens the camera roll with no way
    to reach a file at all, which is exactly what a plan arrives as.

    `multiple` IS GONE, and that is a bug fix rather than a reduction. Netlify's
    own documentation is explicit that only one file upload per field is
    supported and that multiple files need multiple fields, so a visitor who
    attached three photographs was silently sending one. The help text invited
    that: it said "a couple of pictures". Worse than losing them, nobody would
    have known: the submission succeeds and looks complete.

    The 8MB ceiling is the whole form request, not the file, and it is Netlify's
    hard limit with a 30 second upload timeout behind it. Two photographs
    straight off a modern phone exceed it on their own, so one file is close to
    the honest maximum anyway. The copy says so, and says what to do instead,
    because an enquiry that fails silently on a 12MP photograph is a lost lead.
  */}
  <div>
    <label for={`${idPrefix}attachment`}>A photo or drawing (optional)</label>
    {/* Wired to the input with aria-describedby, 7 Sep 2026: the one-file and
        8MB limits decide whether an upload succeeds, and a screen reader was
        hearing only the label. */}
    <p class="help" id={`${idPrefix}attachment-help`}>
      One file, up to 8MB. A picture of the room saves a visit and gets you a closer price, and
      plans or drawings are just as useful. PDF, Word and photographs all work. Send anything else
      when we reply.
    </p>
    <input
      id={`${idPrefix}attachment`}
      name="attachment"
      type="file"
      aria-describedby={`${idPrefix}attachment-help`}
      accept="image/*,.jpg,.jpeg,.png,.heic,.heif,.webp,application/pdf,.pdf,.doc,.docx"
    />
  </div>

  <div>
    <label for={`${idPrefix}source`}>How did you hear about us?</label>
    <select id={`${idPrefix}source`} name="source">
      <option value="" selected>Choose one</option>
      {SOURCES.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </div>

  <div class="actions">
    <button type="submit">Send enquiry</button>
  </div>

  {/* "to reply to this enquiry and nothing else" was narrower than the privacy
      notice one click away, which describes quoting and carrying out the work,
      and six years of retention on a completed job. Said at the exact moment a
      visitor decides whether to hand over their name, phone, email and
      photographs of their home, the tighter promise was the one they would
      remember. The two now say the same thing. (4 Sep 2026) */}
  <p class="help">
    We use your details to reply, to quote, and to carry out the work if you go ahead. We do not add
    you to a marketing list. See our{" "}
    <a href="/privacy/">privacy notice</a>.
  </p>
</form>

<style>
  .enquiry-form {
    display: grid;
    gap: var(--space-9);
  }
  .enquiry-form.is-compact {
    gap: var(--space-8);
  }
  .enquiry-form .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: var(--space-8);
  }
  .enquiry-form label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono-table);
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .enquiry-form input,
  .enquiry-form select,
  .enquiry-form textarea {
    display: block;
    width: 100%;
    font: inherit;
    font-size: var(--type-body);
    color: var(--char);
    background: var(--paper);
    border: var(--rule-hair);
    border-radius: 0;
    padding: var(--space-5) var(--space-6);
    transition: border-color var(--t-fast) var(--ease-out);
  }
  .enquiry-form input:focus,
  .enquiry-form select:focus,
  .enquiry-form textarea:focus {
    border-color: var(--hair-strong);
  }
  .enquiry-form textarea {
    resize: vertical;
    min-height: 5.5em;
  }
  /* Lighter than a typed value, so an example never reads as something already
     entered, and dark enough to be worth reading.
     0.45 until 5 Sep 2026, which measured 2.74:1 on paper against WCAG 1.4.3's
     4.5:1 floor, on the area field and the job-description box of every form on
     this site. --ink-soft is the value this palette has already proved at
     5.06:1, and a field's own value renders in full ink, so a placeholder is
     still visibly not an answer. */
  .enquiry-form ::placeholder {
    color: var(--ink-soft);
    opacity: 1;
  }
  .enquiry-form input[type="file"] {
    font-size: var(--type-body-sm);
    color: var(--ink-soft);
    padding: var(--space-4) var(--space-5);
  }
  .enquiry-form input[type="file"]::file-selector-button {
    font: inherit;
    font-family: var(--font-sans);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--char);
    background: none;
    border: var(--rule-structure);
    padding: var(--space-3) var(--space-6);
    margin-right: var(--space-6);
    cursor: pointer;
  }
  .enquiry-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .enquiry-form legend {
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono-table);
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .enquiry-form .choices-field .help {
    margin: var(--space-3) 0 var(--space-6);
  }
  .enquiry-form .choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: var(--space-5) var(--space-9);
  }
  /* The choices are values, not field labels, so they read as body text. The
     design system draws the same line in its spec tables: mono for the label
     column, body for what it says. Without this they inherit the mono
     uppercase of every other label in the form and eight of them in a column
     read as a wall. */
  .enquiry-form .choice {
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
    letter-spacing: normal;
    text-transform: none;
    color: var(--char);
    margin-bottom: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    font-size: var(--type-body-sm);
    cursor: pointer;
    /* A tap target rather than a line of text: these sit close together and
       are the first thing a thumb reaches for. */
    padding: var(--space-3) 0;
    min-height: 30px;
  }
  /* On a phone the whole row has to clear the 44px a thumb needs. It is worth
     the extra height here: a mis-tap on this field sends the wrong enquiry. */
  @media (max-width: 640px) {
    .enquiry-form .choice {
      min-height: 44px;
      padding: var(--space-5) 0;
    }
  }
  /* 20px, was 16 (7 Sep 2026). The tap target is the whole .choice label,
     which clears 30px on desktop and 44px on a phone, so the box itself is
     drawn for the eye rather than the thumb; 20 sits better against the
     label text than 16 did. */
  .enquiry-form .choice input[type="checkbox"] {
    width: 20px;
    height: 20px;
    flex: none;
    padding: 0;
    border: var(--rule-structure);
    background: var(--paper);
    accent-color: var(--green);
    cursor: pointer;
  }
  .enquiry-form .help {
    font-size: var(--type-body-sm);
    color: var(--text-quiet);
    margin: 0;
  }
  .enquiry-form label + .help {
    margin: calc(var(--space-3) * -1) 0 var(--space-4);
  }
  .enquiry-form .help a {
    color: var(--green);
    border-bottom: 1px solid rgba(44, 74, 58, 0.4);
  }
  .enquiry-form .actions {
    padding-top: var(--space-3);
  }
  /* Specific enough to beat the token base sheet's `button { background: none }`. */
  form.enquiry-form button[type="submit"] {
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--paper);
    background: var(--green);
    border: 1px solid var(--green);
    padding: var(--space-7) var(--space-12);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  form.enquiry-form button[type="submit"]:hover,
  form.enquiry-form button[type="submit"]:focus-visible {
    background: var(--char);
    border-color: var(--char);
  }
  @media (max-width: 520px) {
    form.enquiry-form button[type="submit"] {
      width: 100%;
    }
  }
</style>

{/*
  Arms the enquiry_form GA4 event. /thanks/ fires the event, but only if this
  flag is set, and its own comment says "the flag is set in EnquiryForm.astro".
  It was: the listener shipped in 5400d81 and was deleted in 8969a3f, the 2 Sep
  polish pass, leaving thanks.astro reading a key nothing wrote. Every real
  submission has landed on /thanks/ with an empty sessionStorage since, so the
  event has never fired, while enquiry-log.md recorded all four events as
  verified. Netlify Forms kept every lead; what was lost is GA4's count of the
  one channel the agreement lists first. Restored 3 Sep 2026.

  Document level and armed once: the form renders twice on most pages (the page
  form and the site-wide modal), and one listener covers both. Inline rather
  than a module so it is live before a fast submitter can beat the hydration.
*/}
<script is:inline>
  (() => {
    if (window.__ssEnquiryArmed) return;
    window.__ssEnquiryArmed = true;
    document.addEventListener("submit", (e) => {
      const form = e.target;
      if (!form || form.getAttribute("name") !== "enquiry") return;
      try {
        sessionStorage.setItem("ss_enquiry_submitted", String(Date.now()));
      } catch (err) {
        /* Private mode or storage disabled: the lead still reaches Netlify. */
      }
    });
  })();
</script>
