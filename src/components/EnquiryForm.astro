---
/**
 * THE ENQUIRY FORM, in the Get a quote pop-up on every page (Base.astro) and
 * on /contact/. Since 14 Nov 2026 the picture-card form: option A of the two
 * previews (site PR #43), which a founder picked that day to replace the form
 * everywhere it appears. Site PR #41 had already left those two places as the
 * only ones, one form per page, so the inline service-page form and its
 * `service` prop are gone.
 *
 * What the cards changed, and what they did not:
 *   - "What do you need?", the area and "How did you hear about us?" are rows
 *     of picture cards (./enquiry-cards/), real checkboxes and radios that
 *     swipe on a phone, with arrows and a scrollbar too;
 *   - the area is one card per area served plus "Somewhere else", which opens
 *     a box for the area or postcode; what is typed becomes that card's value,
 *     so the log's Area column still gets one plain answer;
 *   - the job box has four prompts that start a line ("Room: ", ...), and a
 *     prompt left unfinished is dropped before sending;
 *   - "How did you hear about us?" has five answers instead of three.
 *   Field names are unchanged, and so is every value Make already reads, apart
 *   from two new sources (Google Maps, ChatGPT). Make scenario 7361484 maps by
 *   field name, so it needs no change. The PR's field mapping has the detail.
 *
 * NETLIFY FORMS. The site is already on Netlify so this costs nothing and adds
 * no infrastructure, and it produces a timestamped, attributable record. That
 * record is the point: the agreement counts website enquiries as F2F-generated,
 * and without it attribution rests on recall. Photo upload and "how did you
 * hear about us" are both named in the signed scope. Netlify registers the
 * form and its fields by reading the built HTML at deploy, which is why every
 * field below, the hidden ones included, is real markup.
 *
 * Never reuse the old QuoteRequest.tsx. Its submit handler set a success flag
 * and discarded everything, while telling the visitor they would hear back
 * within 24 hours.
 */
import CardGroup from "./enquiry-cards/CardGroup.astro";
import {
  AREA_CHOICES,
  JOB_EXAMPLE_DEFAULT,
  JOB_EXAMPLES,
  SERVICE_CHOICES,
  SOURCE_CHOICES,
} from "./enquiry-cards/choices";
import { FIELD_NAMES as SOURCE_FIELDS } from "../scripts/enquiry-source.mjs";
import "./enquiry-cards/enquiry-cards.css";

interface Props {
  compact?: boolean;
  /** Prefix for element ids, so two forms on one page never repeat an id.
      Field names are untouched: same Netlify form. */
  idPrefix?: string;
  /** Tick this service on arrival and keep the full list. The pop-up passes
      the service of the page it opens from (Base.astro, enquiryService); on
      any other page nothing is ticked, rather than silently defaulting to
      fitted wardrobes, which is what every alcove enquiry used to arrive as. */
  preselectedService?: string;
}
const { compact = false, idPrefix = "", preselectedService } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_SS_TURNSTILE_SITE_KEY;
const largeUploadsEnabled = Boolean(turnstileSiteKey);

const selectedService = preselectedService;
const jobExample = (selectedService && JOB_EXAMPLES[selectedService]) || JOB_EXAMPLE_DEFAULT;

/* Four prompts above the job box: the three its help line names, plus timing,
   which the first reply needs for the lead time. Each starts a line the
   visitor finishes. */
const PROMPTS = [
  { label: "The room", starter: "Room: " },
  { label: "Rough sizes", starter: "Rough sizes: " },
  { label: "What it needs to hold", starter: "Needs to hold: " },
  { label: "When you'd like it", starter: "Timing: " },
];
---

<form
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company-website"
  enctype="multipart/form-data"
  action="/thanks/"
  class:list={["enquiry-form", "ecf", compact && "is-compact"]}
  data-ec-form
>
  <input type="hidden" name="form-name" value="enquiry" />
  {/* ONE EMAIL PER ENQUIRY, 8 Oct 2026, Denis's ask. Netlify sent every
      notification as "Form submission from enquiry form:", so Gmail filed
      different leads into one thread (two of the 28 Sep enquiries share one)
      and a new lead could sit unseen inside an old conversation. The submit
      script below overwrites this value with the enquirer's name, what they
      ticked and their area. This value is the fallback if the script never
      runs: Netlify fills in %{submissionId}, which is unique, so no two
      enquiries share a subject either way. */}
  <input type="hidden" name="subject" data-remove-prefix value="Website enquiry (%{submissionId})" />
  {/* WHERE THE ENQUIRY CAME FROM, 13 Oct 2026. Seven empty fields: the five
      utm_ parameters, the landing page and the referring site. They are real
      markup, not added by script, so Netlify registers them when it reads the
      built HTML at deploy; a field it has never seen is dropped on submission.
      The script at the foot of this file fills them in when the form is sent.
      With JavaScript off they arrive empty, which is correct. The list of names
      lives in src/scripts/enquiry-source.mjs, beside the rules for filling
      them. */}
  {SOURCE_FIELDS.map((name) => <input type="hidden" name={name} value="" />)}
  <p hidden>
    <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  {/* Labels inside the boxes (a founder, 14 Nov 2026): each label is still a
      real <label for>, which is also the heading Netlify gives the field in
      the notification email. */}
  <div class="ecf-row">
    <div class="ecf-float">
      <input class="ecf-input" id={`${idPrefix}name`} name="name" type="text" required autocomplete="name" placeholder=" " />
      <label class="ecf-float-label" for={`${idPrefix}name`}>Your name</label>
    </div>
    <div class="ecf-float">
      <input class="ecf-input" id={`${idPrefix}phone`} name="phone" type="tel" required autocomplete="tel" placeholder=" " />
      <label class="ecf-float-label" for={`${idPrefix}phone`}>Phone</label>
    </div>
    <div class="ecf-float">
      <input class="ecf-input" id={`${idPrefix}email`} name="email" type="email" required autocomplete="email" placeholder=" " />
      <label class="ecf-float-label" for={`${idPrefix}email`}>Email</label>
    </div>
  </div>

  {/* Checkboxes rather than a single choice since 2 September 2026, Denis's
      call: a room being fitted out rarely needs one thing. Netlify Forms
      records repeated inputs sharing a name, so every ticked box arrives
      against `service`. */}
  <CardGroup
    legend="What do you need?"
    help={selectedService ? "Already ticked for you. Add anything else you need." : "Tick everything that applies."}
    name="service"
    type="checkbox"
    choices={SERVICE_CHOICES}
    idPrefix={idPrefix}
    checked={selectedService ? [selectedService] : []}
    emailHeading
    showChosen
  />

  <CardGroup
    legend="Which area of north London?"
    help="Pick the nearest."
    name="area"
    type="radio"
    choices={AREA_CHOICES}
    idPrefix={idPrefix}
    role="area"
    emailHeading
    showChosen
  >
    <p class="ecf-help ec-nojs">Somewhere else? Say where in the job box.</p>
    {/* No name of its own, so it is never sent by itself: what is typed here
        becomes the Somewhere else card's value (./enquiry-cards/client.ts). */}
    <div class="ec-other" data-ec-other hidden>
      <div class="ecf-float">
        <input class="ecf-input" id={`${idPrefix}area-other`} type="text" data-ec-other-input placeholder="Finchley, or your postcode" />
        <label class="ecf-float-label" for={`${idPrefix}area-other`}>Your area or postcode</label>
      </div>
    </div>
  </CardGroup>

  <div class="ecf-pair">
    <div>
      <label class="ecf-label" for={`${idPrefix}detail`}>Tell us about the job</label>
      <p class="ecf-help">The room, rough sizes, and what it needs to hold is plenty.</p>
      <div class="eca-prompts" data-ec-prompts role="group" aria-label="Start a line in the box below" hidden>
        {PROMPTS.map((p) => (
          <button type="button" class="eca-prompt" data-starter={p.starter}><span class="eca-mark" aria-hidden="true"></span>{p.label}</button>
        ))}
      </div>
      {/* The placeholder is an example to copy, 2 Sep 2026 on Denis's ask
          (./enquiry-cards/choices.ts, JOB_EXAMPLES). */}
      <textarea
        class="ecf-input"
        id={`${idPrefix}detail`}
        name="detail"
        rows={compact ? 4 : 5}
        placeholder={jobExample}
        aria-describedby={`${idPrefix}link-limit`}
      ></textarea>
      {/* 19 Oct 2026. Netlify drops an enquiry that carries too many links, and
          the visitor still sees the thank-you page. The script refuses to send
          one and says why here, under the box the links usually go in. */}
      <p class="ecf-help link-limit" id={`${idPrefix}link-limit`} role="alert" data-link-limit hidden></p>
    </div>

    <div>
      {largeUploadsEnabled ? (
        <fieldset class="attachments-field" data-upload-fieldset hidden>
          <legend class="ecf-label">Photos or drawings (optional)</legend>
          <p class="ecf-help" id={`${idPrefix}attachments-help`}>
            Add up to six photos, plans or documents, up to 15 MB each and 60 MB together.
          </p>
          {/* 24 Sep 2026. The bare file input replaced its selection on every pick
              and could only take several files with Ctrl held down, which nobody
              knows to do. It is now visually hidden behind an Add files button:
              every pick adds to the list below, and each file can be removed on its
              own. The list, not the input, is what gets uploaded. */}
          <div class="attachments-add">
            <input
              id={`${idPrefix}attachments`}
              class="attachments-input"
              type="file"
              multiple
              disabled
              data-enquiry-files
              aria-describedby={`${idPrefix}attachments-help ${idPrefix}attachments-count ${idPrefix}attachments-notice ${idPrefix}attachments-error`}
              accept=".jpg,.jpeg,.png,.webp,.heic,.heif,.pdf,.doc,.docx"
            />
            <label for={`${idPrefix}attachments`} class="attachments-button" data-add-files>Add files</label>
            <p class="ecf-help attachments-count" id={`${idPrefix}attachments-count`} aria-live="polite" data-file-count>
              No files added yet.
            </p>
          </div>
          <ul class="attachments-list" data-file-list hidden></ul>
          {/* 19 Oct 2026. Files the form turns away are named here, next to the
              list, and stay until the next pick. They used to share the error line
              at the foot of the fieldset, which the upload check cleared a second
              later, so a phone that picked five and kept two showed no reason. */}
          <p class="ecf-help attachment-notice" id={`${idPrefix}attachments-notice`} role="alert" data-file-notice hidden></p>
          <div
            id={`${idPrefix}upload-challenge`}
            class="upload-challenge"
            data-upload-challenge
            data-sitekey={turnstileSiteKey}
            hidden
          ></div>
          <p class="ecf-help upload-status" role="status" data-upload-status hidden></p>
          <p class="ecf-help attachment-error" id={`${idPrefix}attachments-error`} role="alert" data-attachment-error hidden></p>
          {/* 19 Oct 2026. The attachment_links field is gone. It carried every link
              a second time. Netlify drops a submission with more than five links
              (tested that day), so the enquiry now carries one link, to a page
              listing all its files, in the job description that Make copies into
              the CRM. */}
        </fieldset>
        <noscript><p class="ecf-help">Send your enquiry now and share files when we reply.</p></noscript>
      ) : (
        <div>
          <label class="ecf-label" for={`${idPrefix}attachment`}>A photo or drawing (optional)</label>
          <p class="ecf-help" id={`${idPrefix}attachment-help`}>
            One file, up to 8 MB. PDF, Word and photographs work. Send anything else when we reply.
          </p>
          <input
            id={`${idPrefix}attachment`}
            class="ecf-input"
            name="attachment"
            type="file"
            aria-describedby={`${idPrefix}attachment-help`}
            accept="image/*,.jpg,.jpeg,.png,.heic,.heif,.webp,application/pdf,.pdf,.doc,.docx"
          />
        </div>
      )}
    </div>
  </div>

  <CardGroup
    legend="How did you hear about us?"
    name="source"
    type="radio"
    choices={SOURCE_CHOICES}
    idPrefix={idPrefix}
    emailHeading
  />

  <div class="ecf-actions">
    <button type="submit" class="ecf-send">Send enquiry</button>
  </div>

  {/* "to reply to this enquiry and nothing else" was narrower than the privacy
      notice one click away, which describes quoting and carrying out the work,
      and six years of retention on a completed job. Said at the exact moment a
      visitor decides whether to hand over their name, phone, email and
      photographs of their home, the tighter promise was the one they would
      remember. The two now say the same thing. (4 Sep 2026) */}
  <p class="ecf-help">
    We use your details to reply, to quote, and to carry out the work if you go ahead. We do not add
    you to a marketing list. See our{" "}
    <a href="/privacy/">privacy notice</a>.
  </p>
</form>

<script>
  import { initEnquiryCards } from "./enquiry-cards/client";
  initEnquiryCards();
</script>

<style>
  /* The photo upload, as it was before the cards. Field, label and button
     styles are the cards' stylesheet (./enquiry-cards/enquiry-cards.css). */
  .enquiry-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .enquiry-form input[type="file"] {
    font-size: var(--type-body-sm);
    color: var(--ink-soft);
    padding: var(--space-4) var(--space-5);
  }
  .enquiry-form input[type="file"]::file-selector-button {
    font: inherit;
    font-family: var(--font-sans);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--char);
    background: none;
    border: var(--rule-structure);
    padding: var(--space-3) var(--space-6);
    margin-right: var(--space-6);
    cursor: pointer;
  }
  /* The picker, 24 Sep 2026: a button that adds to a list, not a bare input.
     The input stays in the page, visually hidden rather than display:none, so
     it still takes keyboard focus and the label still opens it. */
  .enquiry-form .attachments-add {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }
  .enquiry-form input.attachments-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .enquiry-form label.attachments-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 0;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--char);
    background: var(--paper);
    border: var(--rule-structure);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .enquiry-form label.attachments-button:hover {
    background: var(--char);
    color: var(--paper);
  }
  .enquiry-form input.attachments-input:focus-visible + .attachments-button {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .enquiry-form label.attachments-button[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    background: var(--paper);
    color: var(--char);
  }
  .enquiry-form .attachments-add .attachments-count {
    margin: 0;
  }
  .enquiry-form .attachments-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    border-top: var(--rule-hair);
  }
  .enquiry-form .attachments-list[hidden] {
    display: none;
  }
  .enquiry-form .attachments-list :global(li) {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 44px;
    padding: var(--space-3) 0;
    border-bottom: var(--rule-hair);
  }
  /* 19 Oct 2026. Names wrap rather than end in an ellipsis: on a phone two
     WhatsApp photos both read "IMG-20261019-WA0..." and there is no tooltip
     on touch, so the Remove buttons could not be told apart. */
  .enquiry-form .attachments-list :global(.file-name) {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--type-body-sm);
    color: var(--char);
  }
  .enquiry-form .attachments-list :global(.file-size) {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    color: var(--ink-soft);
  }
  /* The rows are built by the script below, so they carry no Astro scope
     attribute: :global() lets these rules reach them. Specific enough to beat
     the token base sheet's button reset, and a class of its own so the Send
     enquiry styling can never reach it. */
  form.enquiry-form .attachments-list :global(button.file-remove) {
    flex: none;
    min-height: 44px;
    padding: 0 var(--space-3);
    font: inherit;
    font-size: var(--type-body-sm);
    color: var(--green);
    background: none;
    border: 0;
    text-decoration: underline;
    text-decoration-color: rgba(44, 74, 58, 0.4);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  form.enquiry-form .attachments-list :global(button.file-remove:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .enquiry-form .upload-challenge {
    margin-top: var(--space-6);
    min-height: 65px;
  }
  .enquiry-form .upload-challenge[hidden],
  .enquiry-form .upload-status[hidden],
  .enquiry-form .attachment-notice[hidden],
  .enquiry-form .attachment-error[hidden] {
    display: none;
  }
  .enquiry-form .upload-status {
    margin-top: var(--space-5);
  }
  /* overflow-wrap: a refused file name with no spaces is the first word of
     its message, and at phone width it pushed the page sideways. */
  .enquiry-form .attachment-notice,
  .enquiry-form .attachment-error,
  .enquiry-form .link-limit {
    color: var(--char);
    margin-top: var(--space-5);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .enquiry-form .link-limit[hidden] {
    display: none;
  }
</style>

{/*
  Arms the enquiry_form GA4 event. /thanks/ fires the event, but only if this
  flag is set, and its own comment says "the flag is set in EnquiryForm.astro".
  It was: the listener shipped in 5400d81 and was deleted in 8969a3f, the 2 Sep
  polish pass, leaving thanks.astro reading a key nothing wrote. Every real
  submission has landed on /thanks/ with an empty sessionStorage since, so the
  event has never fired, while enquiry-log.md recorded all four events as
  verified. Netlify Forms kept every lead; what was lost is GA4's count of the
  one channel the agreement lists first. Restored 3 Sep 2026.

  Document level and armed once: the form renders twice on /contact/ (the page
  form and the site-wide pop-up), and one listener covers both. Inline rather
  than a module so it is live before a fast submitter can beat the hydration.
*/}
<script is:inline>
  (() => {
    if (window.__ssEnquiryArmed) return;
    window.__ssEnquiryArmed = true;
    const maxFiles = 6;
    const maxFileBytes = 15_000_000;
    const maxTotalBytes = 60_000_000;
    const allowedExtensions = new Set(["jpg", "jpeg", "png", "webp", "heic", "heif", "pdf", "doc", "docx"]);
    const typeExtensions = {
      "image/jpeg": "jpg",
      "image/png": "png",
      "image/webp": "webp",
      "image/heic": "heic",
      "image/heif": "heif",
      "application/pdf": "pdf",
      "application/msword": "doc",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document": "docx",
    };
    const uploadStates = new WeakMap();
    let turnstileLoader;

    const stateFor = (form) => {
      if (!uploadStates.has(form)) uploadStates.set(form, { widgetId: null, token: "", busy: false, uploadedLinks: null, files: [], errorFromCheck: false });
      return uploadStates.get(form);
    };
    // 19 Oct 2026. Android can hand over a photo whose name has no extension,
    // "1000001524" from the photo picker, and the form turned those away as
    // "not a photo". The file's type is the fallback: a JPEG named 1000001524
    // goes as 1000001524.jpg, the name the ticket function checks. Returns ""
    // for anything that is neither an allowed extension nor an allowed type.
    const uploadName = (file) => {
      const name = String(file.name || "").trim() || "file";
      const extension = name.includes(".") ? name.split(".").pop().toLowerCase() : "";
      if (allowedExtensions.has(extension)) return name;
      const fromType = typeExtensions[String(file.type || "").toLowerCase()];
      return fromType ? `${name}.${fromType}` : "";
    };
    const formatSize = (bytes) => bytes >= 100_000
      ? `${(bytes / 1_000_000).toFixed(1)} MB`
      : `${Math.max(1, Math.round(bytes / 1000))} KB`;
    // The list is the source of truth for what uploads. Redrawn whole on every
    // change: six rows at most, so there is nothing to diff.
    const renderFiles = (form) => {
      const state = stateFor(form);
      const list = form.querySelector("[data-file-list]");
      const count = form.querySelector("[data-file-count]");
      const input = form.querySelector("[data-enquiry-files]");
      const addButton = form.querySelector("[data-add-files]");
      if (!list || !input) return;
      list.replaceChildren(...state.files.map((file, index) => {
        const item = document.createElement("li");
        const name = document.createElement("span");
        name.className = "file-name";
        name.textContent = file.name;
        name.title = file.name;
        const size = document.createElement("span");
        size.className = "file-size";
        size.textContent = formatSize(file.size);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "file-remove";
        remove.dataset.removeFile = String(index);
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.disabled = state.busy;
        item.append(name, size, remove);
        return item;
      }));
      list.hidden = !state.files.length;
      const full = state.files.length >= maxFiles;
      if (count) {
        count.textContent = !state.files.length
          ? "No files added yet."
          : full
            ? "Six files added, the most one enquiry can take. Remove one to add another."
            : `${state.files.length} of ${maxFiles} files added.`;
      }
      input.disabled = full || state.busy;
      if (addButton) addButton.setAttribute("aria-disabled", String(full || state.busy));
      const challenge = form.querySelector("[data-upload-challenge]");
      if (challenge && !state.files.length) challenge.hidden = true;
      else if (challenge && state.widgetId !== null) challenge.hidden = false;
    };
    // Adds a pick to the list rather than replacing it. Each file is checked on
    // its own, so one wrong file does not throw away the good ones with it.
    const addFiles = (form, picked) => {
      const state = stateFor(form);
      const messages = [];
      let overflow = 0;
      let total = state.files.reduce((sum, file) => sum + file.size, 0);
      for (const pickedFile of picked) {
        const name = uploadName(pickedFile);
        if (!name) { messages.push(`${pickedFile.name} is not a photo, PDF or Word document.`); continue; }
        const file = name === pickedFile.name
          ? pickedFile
          : new File([pickedFile], name, { type: pickedFile.type, lastModified: pickedFile.lastModified });
        if (state.files.some((f) => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified)) {
          messages.push(`${file.name} is already in the list.`);
          continue;
        }
        if (state.files.length >= maxFiles) { overflow += 1; continue; }
        if (file.size < 1) { messages.push(`${file.name} is empty.`); continue; }
        if (file.size > maxFileBytes) { messages.push(`${file.name} is over 15 MB.`); continue; }
        if (total + file.size > maxTotalBytes) { messages.push(`${file.name} would take the files over 60 MB together.`); continue; }
        state.files.push(file);
        total += file.size;
      }
      if (overflow) {
        // Small numbers in words, as everywhere else on the site.
        const words = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine"];
        const howMany = overflow === 1 ? "one was" : `${words[overflow - 1] ?? overflow} were`;
        messages.push(`You can add up to six files, so ${howMany} not added.`);
      }
      state.uploadedLinks = null;
      showNotice(form, [...new Set(messages)].join(" "));
      // The link limit depends on whether files are attached, so a change to
      // the list clears any link message; the next send checks again.
      showLinkLimit(form, "");
      renderFiles(form);
      if (state.files.length) showChallenge(form);
    };
    // While files upload, the text boxes are read-only: the enquiry is built
    // from them after the uploads, so a link typed mid-upload would otherwise
    // reach Netlify without ever passing the link check.
    // The area is a group of cards since 14 Nov 2026: its only box is the one
    // under Somewhere else, which has no name of its own. The cards themselves
    // stay as they are, since a disabled card would drop out of the enquiry,
    // and a card cannot carry a link.
    const setBusy = (form, busy) => {
      stateFor(form).busy = busy;
      for (const name of ["name", "phone", "email", "detail"]) {
        const field = form.elements.namedItem(name);
        if (field) field.readOnly = busy;
      }
      const otherArea = form.querySelector("[data-ec-other-input]");
      if (otherArea) otherArea.readOnly = busy;
      renderFiles(form);
    };

    // LINKS, 19 Oct 2026. Netlify drops an enquiry that carries too many links
    // and still shows the visitor the thank-you page. Live tests that day: six
    // links in the job description vanished and five arrived; three links in
    // each of two boxes arrived; a burst of posts was dropped whatever its
    // links. So the job description may hold five links, four when files are
    // attached (their page link is the fifth), "www." counted as a link; the
    // other boxes hold none.
    // LINK takes a whole link, to strip it from the subject. LINK_START
    // counts where links begin, so links glued together with commas or
    // brackets still count one each; "https://www." is one start, not two.
    // No lookbehind: older Safari cannot parse it, and a parse error would
    // stop this whole script.
    const LINK = /(?:https?:\/\/|\bwww\.)\S*/gi;
    const LINK_START = /https?:\/\/(?:www\.)?|\bwww\./gi;
    const countLinks = (text) => (String(text || "").match(LINK_START) || []).length;
    const showLinkLimit = (form, message) => {
      const line = form.querySelector("[data-link-limit]");
      if (!line) return;
      line.textContent = message;
      line.hidden = !message;
    };
    // Returns the field at fault and the message, or null when the enquiry
    // can go. Checked when Send is pressed and again on the text that is
    // actually posted; ownLinks is the files page link already in that text.
    const linkProblem = (form, detailText, withFiles, ownLinks = 0) => {
      // The email box is checked for "://" only: an address at a www.
      // domain is a real address, but no address holds a scheme.
      // The area is a group of radios, whose value is the chosen card's. A
      // link there can only have been typed in the Somewhere else box, so
      // that box is the one the message goes under.
      for (const name of ["name", "phone", "area", "email"]) {
        const field = form.elements.namedItem(name);
        const value = String(field?.value || "");
        if (field && (name === "email" ? value.includes("://") : countLinks(value))) {
          const box = field instanceof Element ? field : form.querySelector("[data-ec-other-input]");
          return { field: box, message: "Web links can only go in the job description. Take the link out of this box and add it there." };
        }
      }
      const limit = withFiles ? 4 : 5;
      if (countLinks(detailText) - ownLinks > limit) {
        return {
          field: form.elements.namedItem("detail"),
          message: `The job description can take up to ${limit === 4 ? "four" : "five"} web links${withFiles ? " when files are attached" : ""}. Remove some, or send them when we reply.`,
        };
      }
      return null;
    };
    // The message line moves to sit under the box at fault, so a link in the
    // name box is explained by the name box, not a screen further down.
    const refuseLinks = (form, problem) => {
      const line = form.querySelector("[data-link-limit]");
      if (line && problem.field) problem.field.insertAdjacentElement("afterend", line);
      showLinkLimit(form, problem.message);
      problem.field?.scrollIntoView?.({ block: "center" });
      problem.field?.focus?.({ preventScroll: true });
    };
    // fromCheck marks a message about the upload check itself. Only those are
    // cleared when the check passes: it re-runs after every send attempt, and
    // clearing everything wiped an upload failure a second after it appeared.
    const showError = (form, message, fromCheck = false) => {
      stateFor(form).errorFromCheck = Boolean(message) && fromCheck;
      const error = form.querySelector("[data-attachment-error]");
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
    };
    const showNotice = (form, message) => {
      const notice = form.querySelector("[data-file-notice]");
      if (!notice) return showError(form, message);
      notice.textContent = message;
      notice.hidden = !message;
    };
    const showStatus = (form, message) => {
      const status = form.querySelector("[data-upload-status]");
      if (status) {
        status.textContent = message;
        status.hidden = !message;
      }
    };
    const validateFiles = (files) => {
      if (files.length > maxFiles) return "Choose up to six files.";
      let total = 0;
      for (const file of files) {
        const extension = file.name.split(".").pop()?.toLowerCase();
        if (!allowedExtensions.has(extension)) return `${file.name} is not a supported file format.`;
        if (file.size < 1 || file.size > maxFileBytes) return `${file.name} must be under 15 MB.`;
        total += file.size;
      }
      if (total > maxTotalBytes) return "Files must be under 60 MB together.";
      return "";
    };
    const loadTurnstile = () => {
      if (window.turnstile) return Promise.resolve(window.turnstile);
      if (!turnstileLoader) {
        turnstileLoader = new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          script.async = true;
          script.onload = () => window.turnstile ? resolve(window.turnstile) : reject(new Error("Upload check failed to load."));
          script.onerror = () => reject(new Error("Upload check failed to load."));
          document.head.appendChild(script);
        }).catch((error) => { turnstileLoader = null; throw error; });
      }
      return turnstileLoader;
    };
    const showChallenge = async (form) => {
      const container = form.querySelector("[data-upload-challenge]");
      if (!container) return;
      container.hidden = false;
      const state = stateFor(form);
      if (state.widgetId !== null) return;
      try {
        const turnstile = await loadTurnstile();
        state.widgetId = turnstile.render(`#${container.id}`, {
          sitekey: container.dataset.sitekey,
          action: "ss_enquiry_upload",
          theme: "light",
          callback: (token) => { state.token = token; if (state.errorFromCheck) showError(form, ""); },
          "expired-callback": () => { state.token = ""; },
          // A check error never covers a different error already on screen,
          // such as the reason a send just failed.
          "error-callback": () => {
            state.token = "";
            const shown = form.querySelector("[data-attachment-error]");
            if (!shown || shown.hidden || state.errorFromCheck) showError(form, "Upload check failed. Try again shortly.", true);
          },
        });
      } catch {
        showError(form, "Upload check could not load. Try again shortly.", true);
      }
    };

    document.addEventListener("change", (event) => {
      const input = event.target;
      if (!input?.matches?.("[data-enquiry-files]")) return;
      const form = input.form;
      const picked = Array.from(input.files || []);
      // Cleared so the same file can be picked again after it is removed.
      input.value = "";
      showStatus(form, "");
      showError(form, "");
      addFiles(form, picked);
    });

    // The link message clears as soon as any box it can be about is edited.
    document.addEventListener("input", (event) => {
      const field = event.target;
      const watched = ["name", "phone", "area", "detail"].includes(field?.name) || field?.matches?.("[data-ec-other-input]");
      if (watched && field.form?.getAttribute("name") === "enquiry") {
        showLinkLimit(field.form, "");
      }
    });

    document.addEventListener("click", (event) => {
      const button = event.target.closest?.("[data-remove-file]");
      if (!button?.form) return;
      const form = button.form;
      const state = stateFor(form);
      if (state.busy) return;
      const index = Number(button.dataset.removeFile);
      state.files.splice(index, 1);
      state.uploadedLinks = null;
      showError(form, "");
      showLinkLimit(form, "");
      renderFiles(form);
      // Focus goes to the row that took its place, or back to Add files.
      const remaining = form.querySelectorAll("[data-remove-file]");
      (remaining[Math.min(index, remaining.length - 1)] || form.querySelector("[data-enquiry-files]"))?.focus();
    });

    // Back from the thank-you page can restore this page exactly as it was
    // left, mid-send: Send disabled, "Sending your enquiry..." and read-only
    // boxes. Unlock it. Files already sent are cleared, so a second Send
    // starts a new enquiry rather than reposting the last one's files.
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      document.querySelectorAll('form[name="enquiry"]').forEach((form) => {
        const state = stateFor(form);
        if (state.sent) {
          state.files = [];
          state.uploadedLinks = null;
          state.sent = false;
          showNotice(form, "");
        }
        showStatus(form, "");
        showError(form, "");
        showLinkLimit(form, "");
        const button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = false;
        setBusy(form, false);
      });
    });

    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("[data-upload-fieldset]").forEach((fieldset) => {
        fieldset.hidden = false;
        fieldset.querySelector("[data-enquiry-files]").disabled = false;
        renderFiles(fieldset.closest("form"));
      });
    });

    // The notification email's subject, so each enquiry opens its own thread
    // and reads at a glance in the inbox: "Website enquiry from Nuno: Alcove
    // units and shelving, Hendon". Set here, before either way of sending
    // builds the form data. Line breaks, control and invisible direction
    // characters, and links are taken out, since this text ends up in an
    // email header and every link counts against the enquiry. The cut counts
    // characters, not code units, so it cannot split an emoji.
    const setSubject = (form) => {
      const field = form.querySelector('input[name="subject"]');
      if (!field) return;
      // Invisible characters go first and to nothing, so "Cam<zero width>den"
      // stays Camden and a link split by one is still found and stripped.
      const clean = (text) => String(text || "")
        .replace(/[\u00ad\u061c\u180e\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff]/g, "")
        .replace(LINK, " ")
        .replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
      const name = clean(form.elements.namedItem("name")?.value);
      if (!name) return;
      // The service cards lose their name once the card script runs, which
      // sends them as one line (./enquiry-cards/client.ts), so they are found
      // by data-field as well as by name.
      const services = Array.from(
        form.querySelectorAll('input[type="checkbox"][data-field="service"]:checked, input[type="checkbox"][name="service"]:checked'),
        (box) => clean(box.value),
      ).filter(Boolean);
      const area = clean(form.elements.namedItem("area")?.value);
      // MANY SERVICES, 14 Nov 2026. A founder's test with all nine ticked was
      // cut mid-word at 150 characters ("Home office and un...") and lost the
      // last three and the area. Now the subject names as many whole services
      // as fit, then "and four more", and keeps the area; the email body
      // lists every one.
      const head = `Website enquiry from ${name}`;
      const tail = area ? `, ${area}` : "";
      const fits = (text) => Array.from(text).length <= 150;
      let listed = services.join(", ");
      if (services.length > 1 && !fits(`${head}: ${listed}${tail}`)) {
        const words = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine"];
        for (let shown = services.length - 1; shown >= 1; shown -= 1) {
          const rest = services.length - shown;
          listed = `${services.slice(0, shown).join(", ")} and ${words[rest - 1] ?? rest} more`;
          if (fits(`${head}: ${listed}${tail}`)) break;
        }
      }
      const about = [listed, area].filter(Boolean).join(", ");
      const subject = Array.from(`${head}${about ? `: ${about}` : ""}`);
      field.value = subject.length > 150 ? `${subject.slice(0, 147).join("").trimEnd()}...` : subject.join("");
    };

    document.addEventListener("submit", (e) => {
      const form = e.target;
      if (!form || form.getAttribute("name") !== "enquiry") return;
      setSubject(form);
      const input = form.querySelector("[data-enquiry-files]");
      const state = stateFor(form);
      const files = state.files.slice();
      if (state.busy) { e.preventDefault(); return; }
      const problem = linkProblem(form, form.elements.namedItem("detail")?.value, files.length > 0);
      if (problem) {
        e.preventDefault();
        refuseLinks(form, problem);
        return;
      }
      showLinkLimit(form, "");
      if (!files.length) {
        try { sessionStorage.setItem("ss_enquiry_submitted", String(Date.now())); } catch {}
        return;
      }
      e.preventDefault();
      const error = validateFiles(files);
      if (error) {
        showError(form, error);
        input.focus();
        return;
      }
      if (!state.uploadedLinks && !state.token) {
        showChallenge(form);
        showError(form, "Complete the upload check, then send your enquiry.", true);
        return;
      }

      setBusy(form, true);
      const button = form.querySelector('button[type="submit"]');
      if (button) button.disabled = true;
      showError(form, "");

      // Each send gets its own number. A failed batch of uploads rejects at
      // once while its other uploads finish later; the number stops those
      // late ones writing "Uploaded 2 of 6" under the error.
      const attempt = (state.attempt = (state.attempt || 0) + 1);
      (async () => {
        let links = state.uploadedLinks;
        if (!links) {
          showStatus(form, "Preparing your files...");
          let ticketResponse;
          try {
            ticketResponse = await fetch("/api/enquiry-upload-tickets", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                files: files.map((file) => ({ name: file.name, size: file.size })),
                turnstileToken: state.token,
              }),
            });
          } finally {
            // A token is spent once it reaches the server, and a dropped
            // response does not say whether it did, so start a fresh check
            // after every attempt rather than resend a spent one.
            state.token = "";
            try {
              if (state.widgetId !== null && window.turnstile) window.turnstile.reset(state.widgetId);
            } catch {}
          }
          const ticketData = await ticketResponse.json().catch(() => ({}));
          if (!ticketResponse.ok || ticketData.tickets?.length !== files.length || !ticketData.filesUrl) {
            throw new Error(ticketData.error || "Could not prepare your files. Try again.");
          }

          const tickets = ticketData.tickets;
          let uploaded = 0;
          for (let start = 0; start < files.length; start += 3) {
            await Promise.all(files.slice(start, start + 3).map(async (file, offset) => {
              const ticket = tickets[start + offset];
              // A dropped connection, or a phone that can no longer read the
              // file, rejects the fetch rather than returning a status. Either
              // way the visitor needs the file's name, not "Failed to fetch".
              const response = await fetch(ticket.uploadUrl, {
                method: "PUT",
                headers: { "Content-Type": ticket.contentType },
                body: file,
                credentials: "omit",
              }).catch(() => null);
              if (!response?.ok) throw new Error(`${file.name} could not upload. Try again. If it fails again, remove it and add it again.`);
              uploaded += 1;
              if (state.attempt === attempt) showStatus(form, `Uploaded ${uploaded} of ${files.length} files...`);
            }));
          }
          // 19 Oct 2026. One link for the whole enquiry, then the names in the
          // order its page lists the files. Netlify drops a submission with
          // more than five links, so a link per file lost every six-file
          // enquiry. See folderLink in netlify/functions/lib/enquiry-uploads.mjs.
          // A name is one line, and "www." in it becomes "www_." so a photo
          // saved as "www.pinterest.com.jpg" does not count as a link, while
          // "www.jpg" keeps its extension.
          const listName = (name) => name.replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ").replace(/\bwww\./gi, (www) => `${www.slice(0, 3)}_.`);
          const names = files.map((file, index) => `${index + 1}. ${listName(file.name)}`).join("\n");
          links = `${ticketData.filesUrl}\n${names}`;
          state.uploadedLinks = links;
        }

        showStatus(form, "Sending your enquiry...");
        // Again, in case a service was ticked or unticked during the uploads.
        setSubject(form);
        const data = new FormData(form);
        data.delete("cf-turnstile-response");
        // The link goes here, once. Make copies the job description into the
        // CRM, so this is the copy everyone reads.
        const detail = String(data.get("detail") || "").trimEnd();
        const finalDetail = `${detail}${detail ? "\n\n" : ""}Attached files: ${links}`;
        // Checked again on the text actually posted, files page link included.
        const problem = linkProblem(form, finalDetail, true, 1);
        if (problem) {
          refuseLinks(form, problem);
          throw Object.assign(new Error(""), { shown: true });
        }
        data.set("detail", finalDetail);
        const response = await fetch("/", { method: "POST", body: data, credentials: "same-origin" });
        if (!response.ok) throw new Error("Your files uploaded, but the enquiry could not be sent. Try again.");
        try { sessionStorage.setItem("ss_enquiry_submitted", String(Date.now())); } catch {}
        state.sent = true;
        window.location.assign(form.action);
      })().catch((error) => {
        if (state.attempt === attempt) state.attempt += 1;
        showStatus(form, "");
        // A TypeError here is the browser's own network failure message.
        if (!error?.shown) {
          showError(form, error instanceof TypeError
            ? "The connection dropped before your enquiry was sent. Check your signal and send it again."
            : error.message || "The upload failed. Try again.");
        }
        if (button) button.disabled = false;
        setBusy(form, false);
      });
    });
  })();
</script>

{/*
  WHERE THE ENQUIRY CAME FROM, 13 Oct 2026. Fills the seven hidden source
  fields near the top of the form (utm_source to referrer) when the form is
  submitted, so a lead that began at a Google Business Profile post carries the
  post's tagged link into the notification email.

  The rules, and the reason for each, are in src/scripts/enquiry-source.mjs.
  Short version: a page that carries utm_ parameters supplies them itself. If it
  does not, the first page of the visit is used, but that is only remembered, in
  session storage, once the visitor has accepted analytics cookies. Without a
  yes nothing is stored and the landing page is simply the page they are on.

  Consent is read from window.ssCookieConsent, the interface Base.astro defines
  and the cookie notice and the cookies page both call. "granted" is the only
  value that counts. If that object is missing, or throws, the answer is no.

  A bundled module rather than the inline script above: it imports the rules
  module so the same code is what the tests run. It still loads before any
  realistic submit, and the capture-phase listener below runs ahead of the
  upload script's submit handler, which can build its FormData in the same tick.
  The Base layout mounts the modal copy of this form on every page, so this
  runs site-wide and records the first page of a visit wherever it starts.
*/}
<script>
  import {
    FIELD_NAMES,
    forgetSource,
    rememberSource,
    sourceForSubmit,
  } from "../scripts/enquiry-source.mjs";

  type ConsentApi = { current?: () => string | null };

  const consented = (): boolean => {
    try {
      const api = (window as unknown as { ssCookieConsent?: ConsentApi }).ssCookieConsent;
      return api?.current?.() === "granted";
    } catch {
      return false;
    }
  };
  const getStorage = () => window.sessionStorage;
  const visit = () => ({
    href: window.location.href,
    referrer: document.referrer,
    consented: consented(),
    getStorage,
  });

  if (consented()) rememberSource(visit());
  else forgetSource(getStorage);

  // Accepting on a page that carries utm_ parameters should keep them. Declining
  // or reopening the choice from /cookies/ deletes what was kept.
  document.addEventListener("ss:consent", () => {
    if (consented()) rememberSource(visit());
    else forgetSource(getStorage);
  });

  // Capture phase, so the fields are filled before any other submit handler.
  document.addEventListener(
    "submit",
    (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.getAttribute("name") !== "enquiry") return;
      const source = sourceForSubmit(visit());
      for (const name of FIELD_NAMES) {
        const field = form.elements.namedItem(name);
        if (field instanceof HTMLInputElement) field.value = source[name];
      }
    },
    true,
  );
</script>
