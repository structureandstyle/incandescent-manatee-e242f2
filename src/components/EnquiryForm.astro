---
import { SERVICES, DEFERRED_SERVICES } from "../data/site";

interface Props {
  compact?: boolean;
  /** Prefix for element ids, so the page form and the modal form can coexist
      without duplicate ids. Field names are untouched: same Netlify form. */
  idPrefix?: string;
  /** The service to tick on arrival: a service page passes its own title.
      Anywhere else nothing is ticked, rather than silently defaulting to
      fitted wardrobes, which is what every alcove enquiry used to arrive as. */
  service?: string;
}
const { compact = false, idPrefix = "", service } = Astro.props;

/**
 * What a lead can ask for. Checkboxes rather than a single choice since
 * 2 September 2026, Denis's call, and it is the right shape: a room being
 * fitted out rarely needs one thing, and a dropdown forced those leads to pick
 * the biggest item and mention the rest in the message, or not at all.
 *
 * Netlify Forms records repeated inputs sharing a name, so every ticked box
 * arrives against `service` without changing how the form is wired.
 *
 * Two entries are not live service pages, and both are deliberate:
 *
 *   Flooring is work he takes. It is a category on his Business Profile with
 *   two services under it, added on the strength of his own description and
 *   repeated mentions in his reviews. There is no page because there is no
 *   usable photography, which is a reason not to publish a page and no reason
 *   at all to refuse the enquiry.
 *
 *   Home office and under-stair storage is one of the six service pages in the
 *   signed scope, deferred on 31 August until its imagery exists. The page is
 *   deferred; the work is not.
 */
const CHOICES = [
  ...SERVICES.filter((s) => s.slug !== "fitted-wardrobe-cost").map((s) => s.title),
  ...DEFERRED_SERVICES.map((s) => s.title),
  "Flooring",
  "Something else",
];

/**
 * What to write in the job box, shown as a placeholder, 2 Sep 2026 on Denis's
 * ask: give someone a shape to copy so they start typing instead of composing.
 *
 * Each one is the same three things in the same order, because those are the
 * three the first reply actually needs: the room, rough sizes, and what the
 * piece has to hold. Nobody writes that unprompted, and an enquiry without it
 * costs a round trip before anything useful can be said back.
 *
 * Keyed by service title so a service page shows an example of its own work.
 * The contact page and the modal have no service, so they get the wardrobe
 * example: it is the commonest job and it models the same shape.
 *
 * These are examples, not claims. Keep the numbers ordinary and the language
 * the way a person would actually type it.
 */
const JOB_EXAMPLE_DEFAULT =
  "Bedroom wall about 3m wide and 2.4m to the ceiling. Hanging both sides, drawers in the middle.";

const JOB_EXAMPLES: Record<string, string> = {
  "Fitted wardrobes": JOB_EXAMPLE_DEFAULT,
  "Walk-in wardrobes":
    "Box room about 2m by 2.5m. Hanging on two walls, shoe shelves and a bank of drawers.",
  "Alcove units and shelving":
    "Two alcoves either side of the chimney breast, about 1m wide. Cupboards below, open shelves above.",
  "Media walls and TV units":
    "Living room chimney wall, 65 inch TV. Cables and a console to hide, sockets already there.",
  "Bespoke kitchens":
    "Galley kitchen about 4m long. One wall of units and a tall run for the oven and fridge.",
  "Home office and under-stair storage":
    "Under the stairs, about 2m along and sloping. Coats, shoes and a bit of shelving.",
};

const jobExample = (service && JOB_EXAMPLES[service]) || JOB_EXAMPLE_DEFAULT;

/**
 * "How did you hear about us?" was a free-text box until 2 September 2026.
 * It is a dropdown now, Denis's call, and the option list is not cosmetic.
 *
 * This answer is the one the shared enquiry log records in its "Found us via"
 * column, and clause 2 of the agreement counts an enquiry as F2F-generated
 * when it is "recorded as having found you through Google or the website".
 *
 * `value` matches the log's own vocabulary (its Channel column validates
 * against a list carrying Referral and Other) while the label stays in the
 * words a visitor would use. Change one, change the log.
 *
 * THE SEARCH OPTION IS NOT "GOOGLE". Widened 2 September 2026, Denis's point:
 * a lead can arrive from Bing or DuckDuckGo, and a bare "Google" would push
 * them into "Something else" or make them answer wrongly. The label names
 * Google anyway, because that is the word people use for searching, and adds
 * the rest so nobody hesitates. Nothing is lost by not isolating Google here:
 * Search Console and the Business Profile measure Google far more precisely
 * than a self-reported dropdown ever could, and what this field uniquely
 * catches is the traffic no analytics can see.
 *
 * THERE IS NO "WEBSITE" OPTION, and that is deliberate. It shipped with one
 * for a few hours on 2 September and Denis removed it the same day, correctly:
 * anyone filling this form in is already on the website, so the website cannot
 * be how they heard about us. The question would have invited a shrug, and a
 * shrugged answer is worse than an empty one because it still looks like data.
 * The genuine website-found case is a visitor who browses, then phones or
 * messages: that arrives on another channel entirely and the log records it
 * there. Nothing is lost by leaving it off the form.
 *
 * "Something else" is the escape hatch: a lead from a citation site or a van
 * sign would otherwise pick one of two wrong answers, and a mislabelled
 * attribution is a commission figure we cannot defend. The log carries "Other"
 * for the same reason.
 *
 * Left optional, as the text box was. Never add a required field to a lead
 * form to improve our own reporting.
 */
const SOURCES = [
  { value: "Search", label: "Google or another search engine" },
  { value: "Referral", label: "Someone recommended you" },
  { value: "Something else", label: "Something else" },
];

/**
 * Netlify Forms. The site is already on Netlify so this costs nothing and adds
 * no infrastructure, and it produces a timestamped, attributable record.
 *
 * That record is the point. The agreement counts website enquiries as
 * F2F-generated, and without it attribution rests on recall. Photo upload and
 * "how did you hear about us" are both named in the signed scope.
 *
 * Never reuse the old QuoteRequest.tsx. Its submit handler set a success flag
 * and discarded everything, while telling the visitor they would hear back
 * within 24 hours.
 *
 * STYLED ON THE DESIGN TOKENS since 2 Sep 2026. The form arrived with the
 * scaffold's Tailwind utilities, and the token base stylesheet resets
 * `button` outside any cascade layer, which beats a layered utility however
 * late it loads: the submit button rendered as bare text with no background
 * on every page. The scoped rules below are unlayered too, and carry the
 * specificity to win. Field names, ids and Netlify attributes are untouched.
 */
---

<form
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company-website"
  enctype="multipart/form-data"
  action="/thanks/"
  class:list={["enquiry-form", compact && "is-compact"]}
>
  <input type="hidden" name="form-name" value="enquiry" />
  <p hidden>
    <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="row">
    <div>
      <label for={`${idPrefix}name`}>Your name</label>
      <input id={`${idPrefix}name`} name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label for={`${idPrefix}phone`}>Phone</label>
      <input id={`${idPrefix}phone`} name="phone" type="tel" required autocomplete="tel" />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}email`}>Email</label>
    <input id={`${idPrefix}email`} name="email" type="email" required autocomplete="email" />
  </div>

  <fieldset class="choices-field">
    <legend>What do you need?</legend>
    <p class="help">Tick everything that applies.</p>
    <div class="choices">
      {CHOICES.map((label, i) => (
        <label class="choice" for={`${idPrefix}service-${i}`}>
          <input
            id={`${idPrefix}service-${i}`}
            type="checkbox"
            name="service"
            value={label}
            checked={service === label}
          />
          <span>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label for={`${idPrefix}area`}>Which area of London?</label>
    <input
      id={`${idPrefix}area`} name="area" type="text"
      placeholder="Hampstead, Camden, or your postcode"
    />
  </div>

  <div>
    <label for={`${idPrefix}detail`}>Tell us about the job</label>
    <p class="help">The room, rough sizes, and what it needs to hold is plenty.</p>
    <textarea
      id={`${idPrefix}detail`}
      name="detail"
      rows={compact ? 3 : 5}
      placeholder={jobExample}
    ></textarea>
  </div>

  <div>
    <label for={`${idPrefix}photos`}>Photos of the space (optional)</label>
    <p class="help">A couple of pictures of the room saves a visit and gets you a closer price.</p>
    <input id={`${idPrefix}photos`} name="photos" type="file" accept="image/*" multiple />
  </div>

  <div>
    <label for={`${idPrefix}source`}>How did you hear about us?</label>
    <select id={`${idPrefix}source`} name="source">
      <option value="" selected>Choose one</option>
      {SOURCES.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </div>

  <div class="actions">
    <button type="submit">Send enquiry</button>
  </div>

  <p class="help">
    We use your details to reply to this enquiry and nothing else. See our{" "}
    <a href="/privacy/">privacy notice</a>.
  </p>
</form>

<style>
  .enquiry-form {
    display: grid;
    gap: var(--space-9);
  }
  .enquiry-form.is-compact {
    gap: var(--space-8);
  }
  .enquiry-form .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: var(--space-8);
  }
  .enquiry-form label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono-table);
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .enquiry-form input,
  .enquiry-form select,
  .enquiry-form textarea {
    display: block;
    width: 100%;
    font: inherit;
    font-size: var(--type-body);
    color: var(--char);
    background: var(--paper);
    border: var(--rule-hair);
    border-radius: 0;
    padding: var(--space-5) var(--space-6);
    transition: border-color var(--t-fast) var(--ease-out);
  }
  .enquiry-form input:focus,
  .enquiry-form select:focus,
  .enquiry-form textarea:focus {
    border-color: var(--hair-strong);
  }
  .enquiry-form textarea {
    resize: vertical;
    min-height: 5.5em;
  }
  /* Lighter than the help text, so an example never reads as something already
     typed, and dark enough to be worth reading. */
  .enquiry-form ::placeholder {
    color: rgba(34, 29, 24, 0.45);
    opacity: 1;
  }
  .enquiry-form input[type="file"] {
    font-size: var(--type-body-sm);
    color: var(--ink-soft);
    padding: var(--space-4) var(--space-5);
  }
  .enquiry-form input[type="file"]::file-selector-button {
    font: inherit;
    font-family: var(--font-sans);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--char);
    background: none;
    border: var(--rule-structure);
    padding: var(--space-3) var(--space-6);
    margin-right: var(--space-6);
    cursor: pointer;
  }
  .enquiry-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .enquiry-form legend {
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono-table);
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .enquiry-form .choices-field .help {
    margin: var(--space-3) 0 var(--space-6);
  }
  .enquiry-form .choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: var(--space-5) var(--space-9);
  }
  /* The choices are values, not field labels, so they read as body text. The
     design system draws the same line in its spec tables: mono for the label
     column, body for what it says. Without this they inherit the mono
     uppercase of every other label in the form and eight of them in a column
     read as a wall. */
  .enquiry-form .choice {
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
    letter-spacing: normal;
    text-transform: none;
    color: var(--char);
    margin-bottom: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    font-size: var(--type-body-sm);
    cursor: pointer;
    /* A tap target rather than a line of text: these sit close together and
       are the first thing a thumb reaches for. */
    padding: var(--space-3) 0;
    min-height: 30px;
  }
  /* On a phone the whole row has to clear the 44px a thumb needs. It is worth
     the extra height here: a mis-tap on this field sends the wrong enquiry. */
  @media (max-width: 640px) {
    .enquiry-form .choice {
      min-height: 44px;
      padding: var(--space-5) 0;
    }
  }
  .enquiry-form .choice input[type="checkbox"] {
    width: 16px;
    height: 16px;
    flex: none;
    padding: 0;
    border: var(--rule-structure);
    background: var(--paper);
    accent-color: var(--green);
    cursor: pointer;
  }
  .enquiry-form .help {
    font-size: var(--type-body-sm);
    color: var(--text-quiet);
    margin: 0;
  }
  .enquiry-form label + .help {
    margin: calc(var(--space-3) * -1) 0 var(--space-4);
  }
  .enquiry-form .help a {
    color: var(--green);
    border-bottom: 1px solid rgba(44, 74, 58, 0.4);
  }
  .enquiry-form .actions {
    padding-top: var(--space-3);
  }
  /* Specific enough to beat the token base sheet's `button { background: none }`. */
  form.enquiry-form button[type="submit"] {
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--paper);
    background: var(--green);
    border: 1px solid var(--green);
    padding: var(--space-7) var(--space-12);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  form.enquiry-form button[type="submit"]:hover,
  form.enquiry-form button[type="submit"]:focus-visible {
    background: var(--char);
    border-color: var(--char);
  }
  @media (max-width: 520px) {
    form.enquiry-form button[type="submit"] {
      width: 100%;
    }
  }
</style>
