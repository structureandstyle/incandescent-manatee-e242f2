---
import { SERVICES } from "../data/site";

interface Props {
  compact?: boolean;
  /** Prefix for element ids, so the page form and the modal form can coexist
      without duplicate ids. Field names are untouched: same Netlify form. */
  idPrefix?: string;
}
const { compact = false, idPrefix = "" } = Astro.props;

/**
 * Netlify Forms. The site is already on Netlify so this costs nothing and adds
 * no infrastructure, and it produces a timestamped, attributable record.
 *
 * That record is the point. The agreement counts website enquiries as
 * F2F-generated, and without it attribution rests on recall. Photo upload and
 * "how did you hear about us" are both named in the signed scope.
 *
 * Never reuse the old QuoteRequest.tsx. Its submit handler set a success flag
 * and discarded everything, while telling the visitor they would hear back
 * within 24 hours.
 */
---

<form
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="company-website"
  enctype="multipart/form-data"
  action="/thanks/"
  class={compact ? "space-y-4" : "space-y-5"}
>
  <input type="hidden" name="form-name" value="enquiry" />
  <p class="hidden">
    <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${idPrefix}name`} class="block text-sm font-medium">Your name</label>
      <input
        id={`${idPrefix}name`} name="name" type="text" required autocomplete="name"
        class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
      />
    </div>
    <div>
      <label for={`${idPrefix}phone`} class="block text-sm font-medium">Phone</label>
      <input
        id={`${idPrefix}phone`} name="phone" type="tel" required autocomplete="tel"
        class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
      />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}email`} class="block text-sm font-medium">Email</label>
    <input
      id={`${idPrefix}email`} name="email" type="email" required autocomplete="email"
      class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
    />
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${idPrefix}service`} class="block text-sm font-medium">What do you need?</label>
      <select
        id={`${idPrefix}service`} name="service"
        class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
      >
        {SERVICES.filter((s) => s.slug !== "fitted-wardrobe-cost").map((s) => (
          <option value={s.title}>{s.title}</option>
        ))}
        <option value="Something else">Something else</option>
      </select>
    </div>
    <div>
      <label for={`${idPrefix}area`} class="block text-sm font-medium">Which area of London?</label>
      <input
        id={`${idPrefix}area`} name="area" type="text"
        class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
      />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}detail`} class="block text-sm font-medium">Tell us about the job</label>
    <textarea
      id={`${idPrefix}detail`} name="detail" rows={compact ? 3 : 5}
      class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
    ></textarea>
  </div>

  <div>
    <label for={`${idPrefix}photos`} class="block text-sm font-medium">Photos of the space (optional)</label>
    <p class="mt-1 text-xs text-ink-soft">A couple of pictures of the room saves a visit and gets you a closer price.</p>
    <input
      id={`${idPrefix}photos`} name="photos" type="file" accept="image/*" multiple
      class="mt-2 w-full text-sm file:mr-3 file:rounded-full file:border-0 file:bg-sand file:px-4 file:py-2 file:text-sm"
    />
  </div>

  <div>
    <label for={`${idPrefix}source`} class="block text-sm font-medium">How did you hear about us?</label>
    <input
      id={`${idPrefix}source`} name="source" type="text"
      class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
    />
  </div>

  <button
    type="submit"
    class="w-full rounded-full bg-ink px-6 py-3 text-sm font-medium text-bone transition-colors hover:bg-timber-deep sm:w-auto"
  >
    Send enquiry
  </button>

  <p class="text-xs text-ink-soft">
    We use your details to reply to this enquiry and nothing else. See our
    <a href="/privacy/" class="underline">privacy notice</a>.
  </p>
</form>

{/*
  Netlify posts the form, then redirects to /thanks/. The GA4 event fires there
  rather than here, so it only counts submissions that actually succeeded.
  This flag is what tells /thanks/ it was reached by a submission rather than a
  refresh, a bookmark or a direct hit. Website enquiries are counted as
  F2F-generated under the agreement, so an inflated number is a commercial
  problem, not just a reporting one.
*/}
<script is:inline>
  document.addEventListener("submit", (e) => {
    const form = e.target;
    if (!form || form.getAttribute("name") !== "enquiry") return;
    try {
      sessionStorage.setItem("ss_enquiry_submitted", String(Date.now()));
    } catch (err) {
      /* private mode: the enquiry still sends, it just goes uncounted */
    }
  });
</script>
