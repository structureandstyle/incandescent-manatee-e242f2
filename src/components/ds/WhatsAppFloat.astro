---
/**
 * A WhatsApp button that floats at the bottom right of every page, 7 Nov 2026
 * (Arthur, on the preview link). It goes away as the green enquiry band or the
 * footer comes into view, because both already offer WhatsApp, and it comes
 * back on the way up.
 *
 * Square, not round: nothing else in this brand is rounded, and the button
 * matches the square Get a quote beside the reviews. Door green with the
 * paper-coloured glyph, the site's own accent pair.
 *
 * It also steps aside while something else owns the bottom of the screen or the
 * whole of it: the cookie notice (until answered), the phone menu, and the
 * enquiry pop-up. Those are CSS (:has), so they hold with JavaScript off too;
 * only the footer check needs the script, and without it the button simply
 * stays put.
 *
 * GA4 counts the click like every other wa.me link (Base.astro's delegated
 * listener fires enquiry_whatsapp).
 */
import { CONTACT } from "../../data/site-content";
---

<a
  class="wa-float"
  data-wa-float
  href={CONTACT.whatsapp}
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp Structure & Style"
>
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: calc(16px + env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 25;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: var(--surface-accent);
    color: var(--text-on-accent);
    box-shadow: 0 6px 18px rgba(34, 29, 24, 0.22);
    transition:
      opacity var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-out),
      visibility 0s linear 0s;
  }
  .wa-float:hover,
  .wa-float:focus-visible { background: var(--char); }
  .wa-float:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }

  /* Away: faded, out of the tab order and not tappable. */
  .wa-float.is-away,
  :global(html:has(#cookie-notice:not([hidden]))) .wa-float,
  :global(html:has([data-nav-drawer][open])) .wa-float,
  :global(html:has(dialog[open])) .wa-float {
    opacity: 0;
    transform: translateY(12px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-out),
      visibility 0s linear var(--t-fast);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float,
    .wa-float.is-away { transform: none; }
  }

  @media print { .wa-float { display: none; } }
</style>

<script>
  // Away while the green enquiry band or the footer is on screen: both carry
  // WhatsApp already, and the button would otherwise sit on top of them.
  const btn = document.querySelector<HTMLElement>("[data-wa-float]");
  const ends = document.querySelectorAll("[data-enquire-band], [data-site-footer]");
  if (btn && ends.length && "IntersectionObserver" in window) {
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) onScreen.add(e.target);
        else onScreen.delete(e.target);
      }
      btn.classList.toggle("is-away", onScreen.size > 0);
    });
    ends.forEach((el) => io.observe(el));
  }
</script>
