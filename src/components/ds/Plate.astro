---
/**
 * A framed photograph with a specification caption.
 *
 * This is a REWRITE, not a port. The design system used <image-slot>, 64.8KB of
 * Claude Design canvas runtime that persists a dragged-in image to a JSON
 * sidecar via window.omelette and is read-only outside that runtime. None of
 * that belongs in a built site.
 *
 * What it does instead, and the rule that matters:
 *
 *   photo given  -> a real <img>, lazy, with width and height so it reserves
 *                   its space and does not shift the page as it loads
 *   slot given   -> the slotted content (the wardrobe drawing is the one user)
 *   no photo     -> an honest empty frame that says what is missing
 *
 * It never renders a decorative stand-in that could be mistaken for the client's
 * work. The design system's own README made the same commitment in words ("Do
 * not replace the captions until real plates exist"); here it is structural.
 *
 * The slot branch was missing until 30 Aug 2026, and the miss was silent: the
 * homepage passed the wardrobe drawing as a child, Astro discarded it, and the
 * frame rendered "awaiting" instead. The drawing and its assembling animation
 * were both reported lost when in fact they were never mounted.
 *
 * The caption is a specification line, not a description: subject on the left,
 * detail on the right, both in the mono voice.
 *
 * The photograph is focusable and labelled as a control since 1 Sep 2026: the
 * zoom-in cursor promised an action a keyboard could not reach. The lightbox
 * script in Base.astro opens it on Enter and Space. The alt attribute stays
 * untouched for the signed scope's keyword requirement.
 */
import MonoLabel from "./MonoLabel.astro";

interface Props {
  /** Root-relative path to a real photograph. Omit while none exists. */
  photo?: string;
  /** Required whenever `photo` is set. */
  alt?: string;
  width?: number;
  height?: number;
  /** What the plate is of, e.g. "Plate 02 · Fitted wardrobes". */
  subject?: string;
  /** The right-hand half of the caption. */
  detail?: string;
  /** What is still needed, shown in the empty frame. */
  awaiting?: string;
  /**
   * Load immediately rather than lazily. Set it on the first plate of a page:
   * that image is usually the largest contentful paint, and lazy-loading the
   * LCP element delays the single metric this rebuild exists to fix.
   */
  eager?: boolean;
  ratio?: string;
  framed?: boolean;
  as?: string;
  /** Animate the reveal as a single plane pass. */
  plane?: boolean | "left" | "top";
  class?: string;
  style?: string;
}

const {
  photo,
  alt,
  width,
  height,
  subject,
  detail,
  awaiting = "Photograph to place",
  eager = false,
  ratio = "3 / 2",
  framed = true,
  as: Tag = "figure",
  plane = false,
  class: className,
  style = "",
  ...rest
} = Astro.props;

const Cap = Tag === "figure" ? "figcaption" : "div";
const planed = plane !== false && plane != null;
const direction = plane === true ? "left" : plane;

if (photo && !alt) {
  throw new Error(
    `Plate: a photograph needs alt text (photo="${photo}"). ` +
      "Every diagram and image on this site carries one: it is in the signed scope " +
      "and it is how the primary keyword reaches the image."
  );
}

const frameCss = [
  framed ? "border:var(--rule-structure)" : "border:none",
  "background:var(--paper)",
  `aspect-ratio:${ratio}`,
  "overflow:hidden",
  "display:grid",
].join(";");

const hasCaption = Boolean(subject || detail);
---

<Tag class={className} style={`margin:0;${style}`} {...rest}>
  <div style={frameCss} data-motion={planed ? "plane" : undefined} data-from={direction || undefined}>
    {photo ? (
      <img
        src={photo}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding={eager ? "sync" : "async"}
        data-plate-photo
        tabindex="0"
        role="button"
        aria-label={`Enlarge: ${alt}`}
        style="width:100%;height:100%;object-fit:cover;cursor:zoom-in"
      />
    ) : Astro.slots.has("default") ? (
      <slot />
    ) : (
      <div style="display:grid;place-items:center;background:var(--wash-char);padding:var(--space-10)">
        <MonoLabel tone="soft" style="text-align:center">{awaiting}</MonoLabel>
      </div>
    )}
  </div>

  {hasCaption && (
    <Cap
      style="display:flex;justify-content:space-between;gap:var(--space-8);flex-wrap:wrap;border-top:var(--rule-structure);padding-top:var(--space-5)"
      data-motion={planed ? "stamp-group" : undefined}
    >
      {subject && <MonoLabel tone="default" style="letter-spacing:var(--ls-mono-table)">{subject}</MonoLabel>}
      {detail && <MonoLabel style="letter-spacing:var(--ls-mono-table)">{detail}</MonoLabel>}
      <slot name="controls" />
    </Cap>
  )}
</Tag>
