---
/**
 * The door green band that closes every page.
 * Ported from the design system's components/sections/EnquireBand.jsx.
 *
 * One change to the API. The source took `facts` as an array of strings and
 * rendered them itself. Here the facts are a named slot, because on this site
 * all three of them are answers to the content questionnaire and have to render
 * through <Value>: finished copy once the client replies, a marked open
 * question until then. A string array could not carry that.
 *
 * The design stated the three outright, as "Commissions £3,000-£15,000",
 * "Bench books 6-8 weeks ahead" and "North West London". The first was
 * unconfirmed, the second described a bench that does not exist, and the third
 * was never checked. See src/data/site-content.ts.
 *
 * THE GOOGLE RATING, from 29 October 2026, on Denis's go-ahead for reviews on
 * every page: one line above the call to action, so the proof sits where the
 * page asks for the enquiry, and on wardrobe pages Lorenzo I's review as well,
 * found by the page's path in BAND_QUOTES (site-content.ts). The review takes
 * the band's empty right-hand side on a laptop and follows the buttons below
 * 900px, so the call to action never moves down for it. FormProof.astro
 * carries the evidence for both.
 */
import Display from "./Display.astro";
import MonoLabel from "./MonoLabel.astro";
import Link from "./Link.astro";
import FormProof from "../FormProof.astro";
import { BAND_QUOTES, CONTACT } from "../../data/site-content";

interface Props {
  kicker?: string;
  heading: string;
  /**
   * Primary action. Defaults to the enquiry form, because a form submission is
   * the one enquiry channel that attributes itself end to end (GA4 event on
   * /thanks/, a record in Netlify Forms). Pass null on a page where the form
   * sits directly below the band.
   *
   * The band no longer shows the email address: Denis's ruling, 1 Sep 2026.
   * The big serif address outweighed the quote CTA and pulled enquiries into
   * the channel that attributes worst (a copied address loses even the
   * self-labelling mailto subject), and commission from month 4 rides on
   * attribution. The address stays on the contact page, in the footer's
   * remit, and in the schema; the band funnels to the form.
   */
  cta?: { label: string; href: string } | null;
  /**
   * Offer the phone and WhatsApp beside the form, under a line asking which
   * the reader would rather use. Defaults on wherever there is a call to
   * action at all.
   */
  direct?: boolean;
  stamp?: boolean;
  chamfer?: boolean;
  class?: string;
  style?: string;
}

const {
  kicker = "Enquiries",
  heading,
  cta = { label: "Get a quote", href: "/contact/" },
  direct = true,
  stamp = false,
  chamfer = false,
  class: className,
  style = "",
} = Astro.props;

const hasFacts = Astro.slots.has("facts");
const quote = BAND_QUOTES[Astro.url.pathname];
---

{/* data-on-dark, 5 Sep 2026. It is what switches the focus ring to paper: the
    ring's own colour is door green and so is this band, so a focused control
    here had an outline the same colour as the ground behind it. The attribute
    already carried the reversed link colour; now it carries the ring too. */}
<section
  class={className}
  data-on-dark
  style={`background:var(--surface-accent);color:var(--text-on-accent);${style}`}
>
  <div style="max-width:var(--page-max);margin:0 auto;padding:var(--band-y) var(--gutter)">
    <div class:list={["band-grid", { "has-quote": quote }]}>
      <div>
        {kicker && <MonoLabel as="p" tone="paper-soft">{kicker}</MonoLabel>}

        {/* A hyphenated word never splits across lines here (29 Oct 2026): beside
            a review the column narrows, and "Planning a built-in wardrobe?" broke
            at its hyphen, "built- / in wardrobe?". */}
        <Display level={2} as="h2" tone="paper" style="margin-top:var(--space-8)">
          {heading.split(/(\s+)/).map((part) => (part.includes("-") ? <span style="white-space:nowrap">{part}</span> : part))}
        </Display>

        {Astro.slots.has("default") && (
          <p style="max-width:56ch;margin-top:var(--space-10);color:var(--ink-rev-soft)">
            <slot />
          </p>
        )}

        <FormProof tone="dark" style="margin-top:var(--space-10)" />

        {/*
          The form leads and the two direct channels sit beside it, 2 Sep 2026,
          Denis's ask. This is not a reversal of his 1 September ruling that took
          the email address off this band: that ruling was about attribution, and
          the address is the one channel that loses it, since a copied address
          arrives with nothing attached. A tel: or wa.me tap fires its own GA4
          event from Base.astro, so both of these are as attributable as the form
          and none of them costs the commission evidence.

          The call to action is bigger than a nav label here because it is the one
          action this whole band exists to ask for.
        */}
        {cta && (
          <div class="band-actions">
            <a class="band-cta" href={cta.href}>{cta.label}</a>

            {direct && (
              <p class="band-direct">
                <MonoLabel as="span" tone="paper-soft">Prefer to call or message?</MonoLabel>
                <Link variant="nav" tone="paper" chamfer href={CONTACT.phoneHref}>
                  Call {CONTACT.phoneDisplay}
                </Link>
                {/* rel="noopener" with no target does nothing at all: it only bites
                    when a link opens a new browsing context. Every external link on
                    this site now opens in a new tab and carries the rel, which is
                    what the Maps and reviews links already did (5 Sep 2026). */}
                <Link variant="nav" tone="paper" chamfer href={CONTACT.whatsapp} target="_blank" rel="noopener">
                  WhatsApp
                </Link>
              </p>
            )}
          </div>
        )}
      </div>

      {quote && <FormProof tone="dark" rating={false} quotes={[quote]} />}
    </div>

    <style>
      /* The band's copy, and on a wardrobe page the review beside it from
         900px, where the copy stops at 56ch and leaves the right-hand side
         empty. Below that the review follows the buttons. */
      .band-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-15) var(--gap-xl);
        align-items: start;
      }
      @media (min-width: 900px) {
        .band-grid.has-quote {
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }
      }
      .band-actions {
        margin-top: var(--space-14);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-10) var(--space-15);
      }
      /* Not a nav link: the one action the band is asking for, at a size that
         says so, and a filled block so it reads as a control rather than a
         line of text on a dark ground. */
      .band-cta {
        display: inline-block;
        font-family: var(--font-sans);
        font-weight: var(--weight-medium);
        font-size: var(--type-label-lg);
        letter-spacing: var(--ls-label);
        text-transform: uppercase;
        color: var(--green);
        background: var(--paper);
        border: 1px solid var(--paper);
        padding: var(--space-8) var(--space-14);
        transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
      }
      .band-cta:hover,
      .band-cta:focus-visible {
        background: none;
        color: var(--paper);
      }
      .band-direct {
        margin: 0;
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--space-6) var(--space-10);
      }
      /* On a phone the two sit one above the other, the button runs the full
         width so it is unmissable and easy to hit, and the question keeps its
         own line so the phone number and WhatsApp stay side by side under it
         rather than splitting across two. */
      @media (max-width: 560px) {
        .band-actions {
          flex-direction: column;
          align-items: stretch;
          gap: var(--space-12);
        }
        .band-cta {
          text-align: center;
          padding: var(--space-9) var(--space-14);
        }
        .band-direct {
          flex-direction: column;
          gap: var(--space-7);
        }
        .band-direct :global(a) {
          align-self: flex-start;
        }
      }
    </style>

    {hasFacts && (
      <div
        style="display:flex;gap:var(--space-14);flex-wrap:wrap;margin-top:var(--space-16);padding-top:var(--space-9);border-top:var(--rule-structure-rev)"
        data-motion={stamp ? "stamp-group" : undefined}
      >
        <slot name="facts" />
      </div>
    )}
  </div>
</section>
