---
/**
 * The serif voice. Every heading on the site.
 * Ported from the design system's components/typography/Display.jsx.
 *
 * Levels 1 to 5 render as h1 to h5 by default; level 6 is a serif size rather
 * than a heading rank and renders as h4 unless `as` says otherwise. Pass `as`
 * whenever the visual size and the document outline disagree, which is the
 * usual case on a page whose largest text is not its most important heading.
 */
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  as?: string;
  tone?: "default" | "paper";
  measure?: string;
  class?: string;
  style?: string;
}

const {
  level = 1,
  as,
  tone = "default",
  measure,
  class: className,
  style = "",
  ...rest
} = Astro.props;

const LEVELS: Record<number, string> = {
  1: "font-size:var(--type-display-1);line-height:var(--lh-display-1);letter-spacing:var(--ls-display-1);max-width:var(--measure-display)",
  2: "font-size:var(--type-display-2);line-height:var(--lh-display-2);max-width:18ch",
  3: "font-size:var(--type-display-3);line-height:var(--lh-display-3);max-width:var(--measure-display-tight)",
  4: "font-size:var(--type-display-4);line-height:var(--lh-display-2);letter-spacing:var(--ls-display-4)",
  5: "font-size:var(--type-display-5);line-height:var(--lh-display-5)",
  6: "font-size:var(--type-serif-lg);line-height:1.25",
};

const Tag = as || (level <= 5 ? `h${Math.max(1, Math.min(level, 5))}` : "h4");

const css = [
  "font-family:var(--font-serif-display)",
  "font-weight:var(--weight-regular)",
  "text-wrap:balance",
  `color:${tone === "paper" ? "var(--ink-rev)" : "var(--text-heading)"}`,
  LEVELS[level],
  measure ? `max-width:${measure}` : "",
  style,
].filter(Boolean).join(";");
---

<Tag class={className} style={css} {...rest}><slot /></Tag>
