---
/**
 * Wardrobe wall, front elevation. The drawing that assembles itself.
 * Ported from the design system's components/media/WardrobeDrawing.jsx.
 *
 * This should have come across in step 4 and did not. It was dropped without
 * being flagged, which is worse than dropping it deliberately: the token
 * --t-loop was ported with the comment "the one permitted loop: the wardrobe
 * drawing redrawing itself", and a token with nothing using it should have
 * raised the question.
 *
 * What it is, in the design system's own terms. Five open bays and nothing in
 * them: a shelf stack, a long hang over a bench, a short hang, a hang over a
 * wide drawer with a second rail beneath, and a second shelf stack. No doors,
 * because an elevation cannot show a swing, and no closed fronts, because they
 * would hide everything the drawing is for. It is the infrastructure, which is
 * the part actually being sold.
 *
 * Eight stages share ONE clock so they stay in lockstep for ever: there is no
 * animation-delay anywhere, each stage's window is written into its own
 * keyframes. The stages map to the four process steps. Visit squares up the
 * carcass and its bays; Drawing planes in the back, seats the shelves on their
 * pins and drops the rails; Making shelves the wide bay, runs in the bench box
 * and lands the seat slab on it; Fitting seats the plinth, takes up the wall
 * with the scribe fillet, then the dimensions.
 *
 * THE PART THAT MATTERS FOR CORRECTNESS: the drawing is authored AT REST. The
 * animations only add the build. So print, reduced motion and a browser with no
 * JavaScript all get a finished drawing rather than an empty frame, and a still
 * capture is never blank. The setting-out lines are never animated at all, so
 * the board always carries its marking out.
 *
 * Two changes from the source, both mechanical:
 *
 * 1. The source started its clock from a React useEnter hook and a .go class.
 *    This uses the site's one IntersectionObserver and the .in class it already
 *    adds, so no component ships to the browser.
 * 2. The hiding rules are scoped to html.js. Without that, a visitor with no
 *    JavaScript would never get .in and the drawing would stay half built. The
 *    source could not have this bug because its hiding and its revealing were
 *    the same component.
 */

interface Props {
  /** Seconds for the whole build. The system's only loop, and it runs once. */
  cycle?: number;
  labels?: boolean;
  title?: string;
  class?: string;
  style?: string;
}

const {
  cycle = 7,
  labels = true,
  title = "Wardrobe wall, front elevation",
  class: className,
  style = "",
} = Astro.props;

const DIVIDERS = [200, 620, 1660, 2060, 3180, 3600];
const SHELF_ROWS = [
  { cls: "sh1", ys: [680, 1000] },
  { cls: "sh2", ys: [1320, 1640] },
  { cls: "sh3", ys: [1960, 2280] },
];
const RAILS = [
  { x1: 700, x2: 1580, y: 860 },
  { x1: 1720, x2: 2000, y: 1360 },
  { x1: 2140, x2: 3100, y: 860 },
];

/* Footwear in true side profile. Each shoe draws about 40px wide on the page,
   so the interior is held to the few seams that still read at that size. All
   stand on the floor line at y = 0 and run toe-right; `flip` turns one of a
   pair to face the other way.

   Redrawn 30 Aug 2026: the first set read as clunky at page size. Each
   silhouette is now one continuous closed path with a proper sole return, the
   court's heel pin slimmed to six units, and every transition eased through a
   curve rather than a corner. */
const COURT = {
  w: 200,
  st: [
    "M40,-60 C34,-42 31,-26 30,-14 C29,-9 28,-4 28,0 L34,0 C35,-8 36,-16 38,-22 C46,-27 58,-24 72,-17 C94,-7 122,-3 150,-3 C166,-3 182,-3 194,-4 C186,-13 170,-21 150,-26 C128,-31 108,-32 96,-34 C84,-47 68,-58 54,-63 C48,-65 43,-64 40,-60 Z",
  ],
  hr: ["M100,-13 C130,-8 162,-7 190,-7", "M52,-58 C60,-50 70,-42 84,-36"],
};
const OXFORD = {
  w: 200,
  st: [
    "M20,-42 C20,-50 28,-54 38,-50 C56,-43 74,-34 96,-29 C122,-23 150,-20 174,-17 C186,-15 192,-10 192,-5 C192,-1 187,0 178,0 L24,0 C17,0 14,-4 14,-12 C14,-24 16,-34 20,-42 Z",
    "M50,-42 L60,-35", "M63,-39 L73,-32", "M76,-36 L86,-29",
  ],
  hr: ["M14,-9 C60,-12 120,-10 190,-6", "M44,-46 C50,-32 52,-16 50,0", "M150,-21 C156,-13 158,-6 158,0"],
};
const LOAFER = {
  w: 200,
  st: [
    "M20,-40 C20,-48 28,-51 38,-48 C58,-41 76,-33 98,-28 C124,-23 150,-20 174,-17 C186,-15 192,-10 192,-5 C192,-1 187,0 178,0 L24,0 C17,0 14,-4 14,-12 C14,-23 16,-32 20,-40 Z",
    "M88,-33 L114,-27 L111,-18 L85,-24 Z",
  ],
  hr: ["M14,-9 C60,-12 120,-10 190,-6", "M124,-25 C144,-21 162,-16 178,-11", "M95,-30 L104,-28"],
};

const SHOES = [
  { of: OXFORD, x: 1672, y: 2595, tone: "st", flip: false },
  { of: LOAFER, x: 1860, y: 2595, tone: "hr", flip: true },
  { of: COURT, x: 1670, y: 2130, tone: "st", flip: false },
  { of: COURT, x: 1855, y: 2130, tone: "hr", flip: true },
  { of: COURT, x: 1670, y: 2320, tone: "st", flip: false },
  { of: COURT, x: 1855, y: 2320, tone: "hr", flip: true },
];
const shoeTransform = (s: (typeof SHOES)[number], k = 0.9) =>
  `translate(${s.flip ? s.x + s.of.w * k : s.x},${s.y}) scale(${s.flip ? -k : k},${k})`;

const ariaLabel =
  `${title}. A hairline drawing that assembles itself in work order, then is dressed: ` +
  `a suitcase on the top shelf, a coat and a dress on the long rail, shirts and a skirt ` +
  `on theirs, folded piles, a handbag, and shoes on the shoe shelves.`;
