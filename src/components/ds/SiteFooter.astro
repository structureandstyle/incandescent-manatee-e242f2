---
/**
 * The footer: wordmark, the ampersand at size, and a row of mono lines.
 * Ported from the design system's components/sections/SiteFooter.jsx.
 *
 * On the ink surface, so both lockups take the paper colour from `color`
 * inheritance rather than from a separate reversed artwork file.
 *
 * The source wrapped the mark in a <Brand> motion component, the one blur in
 * the system, which burns the mark in once on reveal. Here that is
 * data-motion="brand", already implemented by the ported motion CSS.
 */
import Logo from "./Logo.astro";

interface Props {
  lines?: readonly string[];
  /** Contact links, rendered as a row above the legal lines. */
  links?: readonly { label: string; href: string }[];
  /** Policy links, rendered beside the legal lines in the same faint mono. */
  legal?: readonly { label: string; href: string }[];
  showMark?: boolean;
  brand?: boolean;
  class?: string;
  style?: string;
}

const {
  lines = [],
  links = [],
  legal = [],
  showMark = true,
  brand = false,
  class: className,
  style = "",
} = Astro.props;
---

<footer
  class={className}
  style={`background:var(--surface-ink);color:var(--ink-rev);${style}`}
>
  <div style="max-width:var(--page-max);margin:0 auto;padding:var(--footer-y) var(--gutter) var(--space-15);display:flex;flex-direction:column;gap:var(--space-16)">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-14);flex-wrap:wrap">
      <Logo lockup="wordmark" height={26} title="Structure & Style" />
      {showMark && (
        <span data-motion={brand ? "brand" : undefined} style="opacity:.92">
          <Logo lockup="mark" height={56} title="" />
        </span>
      )}
    </div>

    {links.length > 0 && (
      <div style="display:flex;gap:var(--space-9) var(--space-14);flex-wrap:wrap;border-top:var(--rule-hair-rev);padding-top:var(--space-9)">
        {links.map((l) => (
          <a
            href={l.href}
            style="font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono-table);text-transform:uppercase;color:var(--ink-rev-soft);border-bottom:1px solid var(--hair-rev-strong);padding:var(--space-4) 0;display:inline-block"
          >{l.label}</a>
        ))}
      </div>
    )}
    {legal.length > 0 && (
      /* The policy row. Both documents were reachable only from the enquiry
         form's small print before 4 Sep 2026, which is not where anyone looks
         for them, and the cookie notice needs its policy findable after it has
         been answered and dismissed. Its own row, above the legal lines, in the
         same faint mono so it reads as small print rather than as navigation. */
      <div style="display:flex;gap:var(--space-9) var(--space-12);flex-wrap:wrap;border-top:var(--rule-hair-rev);padding-top:var(--space-9)">
        {legal.map((l) => (
          <a
            href={l.href}
            style="font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono-table);text-transform:uppercase;color:var(--ink-rev-quiet);border-bottom:1px solid transparent;min-height:44px;display:inline-flex;align-items:center"
          >{l.label}</a>
        ))}
      </div>
    )}
    <div style="display:flex;justify-content:space-between;gap:var(--space-9);flex-wrap:wrap;border-top:var(--rule-hair-rev);padding-top:var(--space-9)">
      {lines.map((l) => (
        <span style="font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono-table);text-transform:uppercase;color:var(--ink-rev-faint)">{l}</span>
      ))}
    </div>
  </div>
</footer>
