---
/**
 * One material: a swatch or photograph, the name in serif, a line on what it is
 * like to work with, and a reference in the mono voice.
 * Ported from the design system's components/specification/MaterialChip.jsx.
 *
 * THE POP, 1 September 2026, Denis's direction after seeing the first
 * expandable version: pressing a card no longer unfolds an accordion under it
 * (which made rows jump), it pops the material itself. A native <dialog>
 * opens, the material's own swatch is the canvas, and the copy sits on it
 * over a dark wash, like an image with text on it. The wash is one consistent
 * rule because the swatches run light to near-black and striped, and paper
 * text on a washed swatch is legible on all of them where per-material text
 * colours would be six special cases. A band of the pure, unwashed swatch
 * stays at the top so the wash never misstates the finish tone.
 *
 * Native <dialog> is the same choice the enquiry modal made: Escape, focus
 * trap and focus return come free, a backdrop press closes, and the copy is
 * server-rendered in the DOM either way. Without JavaScript the button does
 * nothing and the grid is simply the grid, which matches the lightbox's
 * stance. A chip given any of `uses`, `pros` or `cons` gets the pop; a chip
 * given none renders exactly as it always did.
 *
 * A NOTE ON SWATCHES, because this component is where the materials correction
 * could quietly undo itself.
 *
 * The design mapped three chips onto --oak, --walnut and --green, standing for
 * European oak, American black walnut and painted tulipwood. What is on file is
 * MDF, veneered MDF and plywood (Q22, pending confirmation). Those tokens
 * survive as photography references, and reusing them here to stand for a
 * material that is not that timber would put the removed claim back through the
 * side door: a chip filled with oak brown, captioned MDF, still says oak.
 *
 * So `swatch` has no default. A chip with no swatch and no photograph renders
 * an empty frame, which is honest.
 *
 * Q24 answered 30 Aug 2026 and the swatches were chosen the same day: abstract
 * CSS finish tones, defined per material in `site-content.ts` MATERIALS. Each
 * depicts its finish category truthfully (paint as paint, veneer as timber
 * tone, plywood as its striped edge), and none is a photograph.
 */
import MonoLabel from "./MonoLabel.astro";
import variants from "../../../public/images/_variants.json";

interface Props {
  name: string;
  description?: string;
  reference?: string;
  /** One or two sentences on where the material goes. */
  uses?: string;
  /** What weighs in its favour, spec-table voice. */
  pros?: readonly string[];
  /** What weighs against it, stated as plainly as the pros. */
  cons?: readonly string[];
  /** A CSS colour. Deliberately no default: see the note above. */
  swatch?: string;
  /**
   * Show the band of pure, unwashed swatch across the top of the pop.
   *
   * True for a material, because the band is what stops the dark wash
   * misstating the finish tone: you see the real colour of the oak or the
   * green board before reading copy laid over a dimmed version of it.
   *
   * False when the swatch is a photograph of objects rather than a surface.
   * The hardware swatch is hinges laid out on a grey sweep, so the band
   * cropped a strip of that sweep and read as an unrelated silver bar above
   * the panel (Denis, 2 Sep 2026). There is no finish tone to protect, so the
   * wash runs to the top edge instead.
   */
  band?: boolean;
  plane?: boolean | "left" | "top";
  /**
   * The swatch's rendered width, as a CSS sizes list. The default is the
   * measured one for a card in a three-column grid; a card that spans wider
   * passes its own, or the browser fetches a file for a box it is not in.
   */
  sizes?: string;
  class?: string;
  style?: string;
}

const {
  name,
  description,
  reference,
  uses,
  pros,
  cons,
  swatch,
  band = true,
  plane = false,
  sizes = "(max-width: 700px) 92vw, (max-width: 1080px) 44vw, 320px",
  class: className,
  style = "",
} = Astro.props;

const hasMedia = Astro.slots.has("default");
const planed = plane !== false && plane != null;
const direction = plane === true ? "left" : plane;
const expandable = Boolean(uses || (pros && pros.length) || (cons && cons.length));

const popId = `mat-pop-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

/**
 * THE SWATCH IS AN <img> ON THE CARD FRONT, 5 September 2026.
 *
 * It was a CSS background-image, and a background is fetched the moment the
 * element enters the render tree whatever the scroll position: loading="lazy"
 * only governs <img> and <iframe>. So all six swatches, 246KB over six
 * requests, were downloaded on every load of the home page, where the
 * materials section sits four screens down, and of /materials/, where they
 * competed with that page's own critical path.
 *
 * The pop keeps the background, because a swatch is genuinely the canvas
 * there and a <dialog> that is not open is display:none, which means its
 * background is never fetched until someone opens it.
 *
 * The value in site-content.ts is a CSS shorthand, "url(...) center / cover",
 * so the URL is pulled out of it rather than the data being restructured two
 * days before launch: one regex here against six call sites and a generator
 * script in the ops repo.
 */
const swatchUrl = swatch?.match(/url\(\s*['"]?([^'")]+)['"]?\s*\)/)?.[1] ?? null;

/**
 * Being an img rather than a background is also what makes a srcset possible.
 *
 * The sizes list is measured rather than guessed, which is the whole trick: a
 * first pass declared 46vw and 30vw, the browser dutifully fetched the file for
 * a 172px box, and the render pass caught six visibly soft swatches at 375, 443
 * and 768. A chip actually renders at 333px on a 375 phone (89vw), 326 at 768
 * (42vw) and about 301 from 1280 up. Declared honestly, nothing is soft and
 * nothing over-fetches.
 */
const swatchWidths: number[] = swatchUrl ? (variants as Record<string, number[]>)[swatchUrl] ?? [] : [];
const swatchSrcset = swatchWidths.length
  ? swatchWidths.map((w) => `${swatchUrl!.replace(/\.webp$/, `-${w}w.webp`)} ${w}w`).join(", ")
  : undefined;

const frame = [
  "border:var(--rule-structure)",
  /* A colour or gradient still paints as a background; a photograph does not,
     because the <img> below carries it. The wash stays underneath either way,
     so the frame is never bare while the image loads. */
  `background:${swatchUrl ? "var(--wash-char)" : swatch || "var(--wash-char)"}`,
  /* The shape is a variable so a grid can vary it by breakpoint, 6 Sep 2026.
     Five cards in three columns leave a hole; the last two now span the row
     and keep the height of the three above them by being wider rather than
     taller, which is a different aspect at desktop and the normal one on a
     phone. A page sets --mat-ratio on the cards it stretches; everything else
     gets 3 / 2 as before. */
  `aspect-ratio:${hasMedia ? "auto" : "var(--mat-ratio, 3 / 2)"}`,
  "overflow:hidden",
].join(";");
---

{
  expandable ? (
    <div class={className} style={style}>
      <button
        type="button"
        class="ss-mat-open"
        data-mat-open={popId}
        aria-haspopup="dialog"
        aria-controls={popId}
      >
        <span class="ss-mat-frame" style={frame} data-motion={planed ? "plane" : undefined} data-from={direction || undefined}>
          {swatchUrl && !hasMedia && (
            <img
              src={swatchUrl}
              srcset={swatchSrcset}
              sizes={swatchSrcset ? sizes : undefined}
              alt=""
              loading="lazy"
              decoding="async"
              style="width:100%;height:100%;object-fit:cover;display:block"
            />
          )}
          <slot />
        </span>
        <span class="ss-mat-head">
          <span style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-md)">
            {name}
          </span>
          <span class="ss-mat-mark" aria-hidden="true">+</span>
        </span>
      </button>

      <dialog id={popId} class="ss-mat-pop" aria-label={name} style={`--mat-swatch:${swatch || "var(--wash-char)"}`}>
        {band && <div class="ss-mat-pop-band" aria-hidden="true"></div>}
        <div class="ss-mat-pop-body">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-8)">
            <MonoLabel as="p" tone="paper-soft">Materials</MonoLabel>
            <button type="button" class="ss-mat-close" data-mat-close aria-label="Close">&times;</button>
          </div>

          <h3 style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-lg);margin:var(--space-5) 0 var(--space-4)">
            {name}
          </h3>

          {description && (
            <p style="font-size:var(--type-body-sm);color:rgba(242,238,227,.8)">{description}</p>
          )}

          {uses && (
            <>
              <MonoLabel as="p" tone="paper-soft" style="margin-top:var(--space-10)">Used for</MonoLabel>
              <p style="font-size:var(--type-body-sm);margin-top:var(--space-3)">{uses}</p>
            </>
          )}

          {pros && pros.length > 0 && (
            <>
              <MonoLabel as="p" tone="paper-soft" style="margin-top:var(--space-10)">In its favour</MonoLabel>
              <ul class="ss-mat-pop-list">
                {pros.map((p) => <li>{p}</li>)}
              </ul>
            </>
          )}

          {cons && cons.length > 0 && (
            <>
              <MonoLabel as="p" tone="paper-soft" style="margin-top:var(--space-10)">The trade-offs</MonoLabel>
              <ul class="ss-mat-pop-list">
                {cons.map((c) => <li>{c}</li>)}
              </ul>
            </>
          )}
        </div>
      </dialog>
    </div>
  ) : (
    <div class={className} style={style}>
      <div style={frame} data-motion={planed ? "plane" : undefined} data-from={direction || undefined}>
        {swatchUrl && !hasMedia && (
          <img
            src={swatchUrl}
            srcset={swatchSrcset}
            sizes={swatchSrcset ? "(max-width: 700px) 92vw, (max-width: 1080px) 44vw, 320px" : undefined}
            alt=""
            loading="lazy"
            decoding="async"
            style="width:100%;height:100%;object-fit:cover;display:block"
          />
        )}
        <slot />
      </div>

      <h3 style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-md);margin:var(--space-7) 0 var(--space-3)">
        {name}
      </h3>

      {description && (
        <p style="font-size:var(--type-body-sm);color:var(--ink-soft);max-width:36ch">{description}</p>
      )}

      {reference && (
        <MonoLabel style="display:block;margin-top:var(--space-5)">{reference}</MonoLabel>
      )}

      <slot name="description" />
    </div>
  )
}

<script>
  // The pop wiring, run once per page however many chips render. A press on
  // the card opens its own dialog; the backdrop, Escape and the button close
  // it. Focus trap and focus return are the native element's.
  document.querySelectorAll<HTMLButtonElement>("[data-mat-open]").forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.matOpen || "") as HTMLDialogElement | null;
    if (!dlg || typeof dlg.showModal !== "function") return;
    btn.addEventListener("click", () => dlg.showModal());
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.querySelector("[data-mat-close]")?.addEventListener("click", () => dlg.close());
  });

  // Escape closes. The native element does this on its own in a real browser;
  // the explicit handler costs one line and removes the dependence on it.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLDialogElement>("dialog.ss-mat-pop[open]").forEach((d) => d.close());
  });
</script>

<style is:global>
  .ss-mat-open {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .ss-mat-open:focus-visible { outline: 1px solid var(--green); outline-offset: 4px; }
  .ss-mat-open .ss-mat-frame { display: block; }
  .ss-mat-open .ss-mat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  .ss-mat-open .ss-mat-mark {
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    color: var(--ink-soft);
    transition: transform var(--t-fast) var(--ease-out);
  }
  .ss-mat-open:hover .ss-mat-mark { transform: rotate(90deg); }

  /* The pop itself: the swatch is the canvas. The body carries a dark wash so
     paper text reads on every swatch in the range; the band above it stays
     pure so the wash never misstates the finish tone. */
  .ss-mat-pop {
    width: min(620px, 94vw);
    max-height: 92vh;
    overflow-y: auto;
    border: var(--rule-structure);
    padding: 0;
    margin: auto;
    background: var(--mat-swatch);
    color: var(--paper);
  }
  .ss-mat-pop::backdrop { background: rgba(24, 21, 17, 0.6); }
  .ss-mat-pop[open] { animation: ss-mat-pop-in var(--t-fast) var(--ease-out); }
  @keyframes ss-mat-pop-in {
    from { opacity: 0; transform: scale(0.985); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-mat-pop[open] { animation: none; }
  }
  .ss-mat-pop-band { height: clamp(64px, 12vw, 104px); }
  .ss-mat-pop-body {
    background: rgba(24, 21, 17, 0.78);
    padding: clamp(20px, 4vw, 40px);
  }
  /* 16 x 26 until 5 Sep 2026, against WCAG 2.5.8's 24 x 24 floor. The padding
     takes the hit area past 44px and the negative margin cancels it in layout,
     so the row keeps the height it had. */
  .ss-mat-close {
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: rgba(242, 238, 227, 0.9);
    padding: 9px 12px;
    margin: -9px -12px -9px 0;
    min-width: 44px;
    min-height: 44px;
  }

  /* The pop is a dark surface and the focus ring is door green, so a focused
     control in here would be outlined in a colour close to its own ground.
     Same fix as the enquiry band's. */
  .ss-mat-pop { --focus-ring: var(--paper); }

  /* WITHOUT JAVASCRIPT THE POP NEVER OPENS, and a <dialog> carrying no open
     attribute is display:none in the user agent stylesheet, so every
     material's uses, pros and trade-offs were unreachable on the one page
     whose whole job is to explain them. Author CSS beats the UA rule: with no
     .js on <html>, which Base.astro stamps before first paint, the panel
     renders inline under its own card instead. Nothing is duplicated in the
     DOM and the copy is the same copy. The plus mark goes, because it promises
     an action that needs script, and so does the close button, which would
     close nothing. */
  html:not(.js) .ss-mat-pop {
    display: block;
    position: static;
    width: auto;
    max-width: none;
    max-height: none;
    margin: var(--space-7) 0 0;
  }
  html:not(.js) .ss-mat-close,
  html:not(.js) .ss-mat-open .ss-mat-mark {
    display: none;
  }
  .ss-mat-pop-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .ss-mat-pop-list li {
    font-size: var(--type-body-sm);
    padding: var(--space-3) 0;
    border-top: 1px solid rgba(242, 238, 227, 0.22);
  }
  .ss-mat-pop-list li:first-child { border-top: none; padding-top: 0; }
</style>
