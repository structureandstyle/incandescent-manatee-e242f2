---
/**
 * One material: a swatch or photograph, the name in serif, a line on what it is
 * like to work with, and a reference in the mono voice.
 * Ported from the design system's components/specification/MaterialChip.jsx.
 *
 * EXPANDABLE since 1 September 2026, on Denis's ask: pressing a material opens
 * it up with what it is, where it is used, and what weighs for and against it.
 * Same mechanism as Faq.astro, native <details>/<summary>: no JavaScript,
 * keyboard and screen-reader behaviour for free, and the detail text is in the
 * DOM for Google either way. A chip given any of `uses`, `pros` or `cons`
 * renders as a disclosure; a chip given none renders exactly as before.
 *
 * A NOTE ON SWATCHES, because this component is where the materials correction
 * could quietly undo itself.
 *
 * The design mapped three chips onto --oak, --walnut and --green, standing for
 * European oak, American black walnut and painted tulipwood. What is on file is
 * MDF, veneered MDF and plywood (Q22, pending confirmation). Those tokens
 * survive as photography references, and reusing them here to stand for a
 * material that is not that timber would put the removed claim back through the
 * side door: a chip filled with oak brown, captioned MDF, still says oak.
 *
 * So `swatch` has no default. A chip with no swatch and no photograph renders
 * an empty frame, which is honest.
 *
 * Q24 answered 30 Aug 2026 and the swatches were chosen the same day: abstract
 * CSS finish tones, defined per material in `site-content.ts` MATERIALS. Each
 * depicts its finish category truthfully (paint as paint, veneer as timber
 * tone, plywood as its striped edge), and none is a photograph.
 */
import MonoLabel from "./MonoLabel.astro";

interface Props {
  name: string;
  description?: string;
  reference?: string;
  /** One or two sentences on where the material goes. */
  uses?: string;
  /** What weighs in its favour, spec-table voice. */
  pros?: readonly string[];
  /** What weighs against it, stated as plainly as the pros. */
  cons?: readonly string[];
  /** A CSS colour. Deliberately no default: see the note above. */
  swatch?: string;
  plane?: boolean | "left" | "top";
  class?: string;
  style?: string;
}

const {
  name,
  description,
  reference,
  uses,
  pros,
  cons,
  swatch,
  plane = false,
  class: className,
  style = "",
} = Astro.props;

const hasMedia = Astro.slots.has("default");
const planed = plane !== false && plane != null;
const direction = plane === true ? "left" : plane;
const expandable = Boolean(uses || pros?.length || cons?.length);

const frame = [
  "border:var(--rule-structure)",
  `background:${swatch || "var(--wash-char)"}`,
  `aspect-ratio:${hasMedia ? "auto" : "3 / 2"}`,
  "overflow:hidden",
].join(";");
---

{
  expandable ? (
    <details class:list={["ss-mat", className]} style={style}>
      <summary>
        <div style={frame} data-motion={planed ? "plane" : undefined} data-from={direction || undefined}>
          <slot />
        </div>
        <span class="ss-mat-head">
          <span style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-md)">
            {name}
          </span>
          <span class="ss-mat-mark" aria-hidden="true">+</span>
        </span>
      </summary>

      <div class="ss-mat-body">
        {description && (
          <p style="font-size:var(--type-body-sm);color:var(--ink-soft)">{description}</p>
        )}

        {uses && (
          <>
            <MonoLabel as="p" tone="soft" style="margin-top:var(--space-8)">Used for</MonoLabel>
            <p style="font-size:var(--type-body-sm);margin-top:var(--space-3)">{uses}</p>
          </>
        )}

        {pros && pros.length > 0 && (
          <>
            <MonoLabel as="p" tone="soft" style="margin-top:var(--space-8)">In its favour</MonoLabel>
            <ul class="ss-mat-list">
              {pros.map((p) => <li>{p}</li>)}
            </ul>
          </>
        )}

        {cons && cons.length > 0 && (
          <>
            <MonoLabel as="p" tone="soft" style="margin-top:var(--space-8)">The trade-offs</MonoLabel>
            <ul class="ss-mat-list">
              {cons.map((c) => <li>{c}</li>)}
            </ul>
          </>
        )}
      </div>
    </details>
  ) : (
    <div class={className} style={style}>
      <div style={frame} data-motion={planed ? "plane" : undefined} data-from={direction || undefined}>
        <slot />
      </div>

      <h3 style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-md);margin:var(--space-7) 0 var(--space-3)">
        {name}
      </h3>

      {description && (
        <p style="font-size:var(--type-body-sm);color:var(--ink-soft);max-width:36ch">{description}</p>
      )}

      {reference && (
        <MonoLabel style="display:block;margin-top:var(--space-5)">{reference}</MonoLabel>
      )}

      <slot name="description" />
    </div>
  )
}

<style is:global>
  .ss-mat summary {
    cursor: pointer;
    list-style: none;
  }
  .ss-mat summary::-webkit-details-marker { display: none; }
  .ss-mat .ss-mat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  .ss-mat .ss-mat-mark {
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    color: var(--ink-soft);
    transition: transform var(--t-fast) var(--ease-out);
  }
  .ss-mat[open] .ss-mat-mark { transform: rotate(45deg); }
  .ss-mat summary:focus-visible { outline: 1px solid var(--green); outline-offset: 4px; }
  .ss-mat .ss-mat-body {
    padding: var(--space-4) 0 var(--space-4);
    max-width: 44ch;
  }
  .ss-mat .ss-mat-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .ss-mat .ss-mat-list li {
    font-size: var(--type-body-sm);
    padding: var(--space-3) 0;
    border-top: var(--rule-hair);
  }
  .ss-mat .ss-mat-list li:first-child { border-top: none; padding-top: 0; }
</style>
