---
/**
 * A plate that cycles through a set of photographs: arrows in the caption,
 * a counter keeping place, and the lightbox opening at whichever photograph
 * is showing (Base.astro reads this component's data attributes to know the
 * set it should swipe through).
 *
 * Extracted 1 September 2026 from the homepage's Selected work cards, when
 * Denis asked the work page to collapse its full galleries back into one
 * card per category: the same behaviour was about to exist in two inline
 * copies, so it became a component. Without JavaScript the first photograph
 * stands and the arrows do nothing, which is honest.
 */
import Plate from "./Plate.astro";
import MonoLabel from "./MonoLabel.astro";
import variants from "../../../public/images/_variants.json";

interface Shot {
  file: string;
  w: number;
  h: number;
}

interface Props {
  shots: readonly Shot[];
  /** "Fitted wardrobes, completed installation by ..." — ", photograph N" is appended. */
  altBase: string;
  subject: string;
  detail?: string;
  ratio?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
  style?: string;
}

const {
  shots,
  altBase,
  subject,
  detail = "Completed",
  ratio = "4 / 3",
  eager = false,
  sizes = "(max-width: 900px) 92vw, 46vw",
  class: className,
  style = "",
} = Astro.props;

const many = shots.length > 1;
const pad = (n: number) => String(n).padStart(2, "0");
const round3 = (n: number) => Math.round(n * 1000) / 1000;

/**
 * The frame's own ratio as a number, so the script can tell when the shot it
 * is about to show is a different shape from the frame holding it.
 *
 * A carousel cannot resize between shots without the card jumping, so the
 * frame is fixed and a portrait photograph in it would be centre-cropped to a
 * landscape band. On the kitchens set that band is ceiling and downlights.
 * Rather than crop, the script switches that shot to object-fit:contain and
 * the frame's wash becomes its mount.
 */
const [rw, rh] = ratio.split("/").map((n) => Number(n.trim()));
const frameRatio = Number.isFinite(rw) && Number.isFinite(rh) && rh ? round3(rw / rh) : 1.333;

/**
 * A srcset per shot, so the responsive variants survive a swap.
 *
 * Plate builds one for the first photograph on its own. The rest are swapped
 * in by the script below, which sets img.src, and an img whose src changes
 * while its srcset still lists the old candidates loads the wrong file. The
 * whole set is handed to the script instead, and it sets both together.
 */
const srcsets = shots.map((s) => {
  const widths = (variants as Record<string, number[]>)[s.file] ?? [];
  if (!widths.length) return "";
  return [...widths.map((w) => `${s.file.replace(/\.webp$/, `-${w}w.webp`)} ${w}w`), `${s.file} ${s.w}w`].join(", ");
});
---

{/* THE ARROWS, 5 September 2026. They measured 6.6 x 18.1 CSS pixels, against
    the 24 x 24 minimum, and the glyph itself was a hairline in --ink-soft on
    cream: on a phone the control was hard to see at all, let alone hit. The
    padding takes the hit area past 44px and the negative margin cancels it in
    layout, so the caption row keeps the height it had. The glyph is full ink
    at a size that reads. The lightbox's own arrows already did this. */}
<div
  class={className}
  style={style}
  data-carousel
  data-files={JSON.stringify(shots.map((s) => s.file))}
  data-ratios={JSON.stringify(shots.map((s) => round3(s.w / s.h)))}
  data-srcsets={JSON.stringify(srcsets)}
  data-frame-ratio={String(frameRatio)}
  data-alt-base={altBase}
>
  <Plate
    photo={shots[0].file}
    alt={`${altBase}, photograph 1`}
    width={shots[0].w}
    height={shots[0].h}
    subject={subject}
    detail={detail}
    ratio={ratio}
    eager={eager}
    sizes={sizes}
  >
    {many && (
      <Fragment slot="controls">
        <span style="display:flex;align-items:center;gap:var(--space-6)">
          <button
            type="button"
            data-car-prev
            aria-label={`Previous ${subject.toLowerCase()} photograph`}
            style="background:none;border:none;padding:13px 14px;margin:-13px -8px;cursor:pointer;font-family:var(--font-mono);font-size:17px;line-height:1;color:var(--char)"
          >&larr;</button>
          <MonoLabel tone="soft" style="letter-spacing:var(--ls-mono-table)">
            <span data-car-count>{`01 / ${pad(shots.length)}`}</span>
          </MonoLabel>
          <button
            type="button"
            data-car-next
            aria-label={`Next ${subject.toLowerCase()} photograph`}
            style="background:none;border:none;padding:13px 14px;margin:-13px -8px;cursor:pointer;font-family:var(--font-mono);font-size:17px;line-height:1;color:var(--char)"
          >&rarr;</button>
        </span>
      </Fragment>
    )}
  </Plate>
</div>

<script>
  // The wiring, once per page however many carousels render. Arrows cycle the
  // card through its own photographs; the counter keeps place; clicking the
  // image opens the lightbox at whichever photograph is showing.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((card) => {
    const files: string[] = JSON.parse(card.dataset.files || "[]");
    if (files.length < 2) return;
    const img = card.querySelector("img");
    const count = card.querySelector("[data-car-count]");
    if (!img) return;
    // A carousel's frame cannot change shape between shots without the card
    // jumping, so a photograph that is a different shape from the frame is
    // shown whole against the frame's wash rather than cropped to fit it.
    // Two of the kitchen shots are 1126 x 2000 and a 4:3 centre crop of those
    // keeps the ceiling and loses the kitchen (5 Sep 2026).
    const ratios: number[] = JSON.parse(card.dataset.ratios || "[]");
    const srcsets: string[] = JSON.parse(card.dataset.srcsets || "[]");
    const frameRatio = Number(card.dataset.frameRatio) || 1.333;
    const fitFor = (n: number) => {
      const r = ratios[n];
      if (!r) return "cover";
      return Math.abs(Math.log(r / frameRatio)) > 0.25 ? "contain" : "cover";
    };
    let i = 0;
    const pad = (n: number) => String(n).padStart(2, "0");
    const show = (next: number) => {
      i = (next + files.length) % files.length;
      // srcset before src, and always both: an <img> whose src changes while
      // its srcset still lists the previous photograph's candidates loads the
      // previous photograph.
      if (srcsets[i]) img.srcset = srcsets[i];
      else img.removeAttribute("srcset");
      img.src = files[i];
      img.alt = `${card.dataset.altBase}, photograph ${i + 1}`;
      img.style.objectFit = fitFor(i);
      if (count) count.textContent = `${pad(i + 1)} / ${pad(files.length)}`;
    };
    img.style.objectFit = fitFor(0);
    card.querySelector("[data-car-prev]")?.addEventListener("click", () => show(i - 1));
    card.querySelector("[data-car-next]")?.addEventListener("click", () => show(i + 1));
  });
</script>
