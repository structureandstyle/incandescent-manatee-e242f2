---
/**
 * The reviews block: an aggregate on the left, indexed quotes on the right.
 * Ported from the design system's components/sections/Reviews.jsx.
 *
 * No stars, no badge, no third-party card. The rating mark is five squares,
 * because nothing in this brand is rounded, and the quotes are set in the mono
 * annotation voice, lower case at reading size, indexed and ruled like a plate
 * caption. All of that is the design system's and is kept.
 *
 * ONE BEHAVIOURAL CHANGE, and it is why this file is longer than the source.
 *
 * `quotes` is currently empty and will stay empty until real ones are pulled
 * from the Business Profile. The design shipped four placeholder strings that
 * described what a quote should do rather than quoting anyone ("Pull the
 * strongest line about fit and finish"). Rendered against an empty array the
 * source produced a two-column grid with nothing in the right-hand column,
 * which looks like a loading failure.
 *
 * So the layout collapses to a single column when there are no quotes, and says
 * plainly that the aggregate is verified while the quotes are still to come.
 * The count and average are real, confirmed against the profile on 23 August
 * 2026: 15 at 5.0, all 15 answered.
 *
 * Compliance line, restated because it governs what may ever go here: genuine
 * past customers only, unedited, no gating, no incentives.
 */
import Display from "./Display.astro";
import MonoLabel from "./MonoLabel.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  title?: string;
  meta?: string;
  average?: string;
  count?: number;
  source?: string;
  quotes?: readonly { text: string; meta?: string }[];
  scribe?: boolean;
  stamp?: boolean;
  class?: string;
  style?: string;
}

const {
  title = "Reviews",
  meta,
  average = "5.0",
  count,
  source,
  quotes = [],
  scribe = true,
  stamp = false,
  class: className,
  style = "",
} = Astro.props;

const filled = Math.round(Number(average) || 0);
const hasQuotes = quotes.length > 0;
---

<section data-reviews class={className} style={style}>
  <SectionHead meta={meta} scribe={scribe}>{title}</SectionHead>

  <div
    style={`display:grid;grid-template-columns:${hasQuotes ? "minmax(0,5fr) minmax(0,7fr)" : "minmax(0,1fr)"};gap:var(--gap-xl);align-items:start`}
  >
    <div data-motion={stamp ? "stamp-group" : undefined}>
      <div style="display:flex;align-items:baseline;gap:var(--space-10)">
        <Display level={2} as="p" measure="none">{average}</Display>
        <span aria-hidden="true" style="display:flex;gap:var(--space-3);padding-bottom:var(--space-4)">
          {[0, 1, 2, 3, 4].map((i) => (
            <span
              style={`width:7px;height:7px;border:1px solid var(--green);background:${i < filled ? "var(--green)" : "transparent"}`}
            ></span>
          ))}
        </span>
      </div>

      <MonoLabel as="p" tone="default" style="margin-top:var(--space-10)">
        {count} reviews · average {average} out of 5
      </MonoLabel>

      {source && (
        <MonoLabel as="p" tone="soft" style="margin-top:var(--space-5)">{source}</MonoLabel>
      )}

      {!hasQuotes && (
        <MonoLabel as="p" tone="soft" caps={false} style="margin-top:var(--space-10);max-width:44ch;letter-spacing:var(--ls-mono-tight);line-height:1.62">
          Individual reviews are shown once they are taken from the profile unedited.
        </MonoLabel>
      )}
    </div>

    {hasQuotes && (
      <ol style="list-style:none;margin:0;padding:0">
        {quotes.map((q, i) => (
          <li
            data-reviews-item
            style={`display:grid;grid-template-columns:66px minmax(0,1fr);gap:var(--space-6);padding:var(--space-12) 0;border-top:${i ? "var(--rule-hair)" : "var(--rule-structure)"}`}
          >
            <MonoLabel as="span" tone="soft" style="padding-top:4px">
              Rev. {String(i + 1).padStart(2, "0")}
            </MonoLabel>
            <div>
              <MonoLabel
                as="p"
                tone="default"
                caps={false}
                style="font-size:var(--type-body-sm);letter-spacing:var(--ls-mono-tight);line-height:1.62;text-wrap:pretty"
              >{q.text}</MonoLabel>
              {q.meta && (
                <MonoLabel as="p" tone="soft" style="margin-top:var(--space-6)">{q.meta}</MonoLabel>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>
