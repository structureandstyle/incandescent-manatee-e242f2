---
/**
 * One stage of the process, with a hand-drawn tool glyph.
 * Ported from the design system's components/specification/ProcessStep.jsx.
 *
 * The glyphs are the design's most distinctive detail and are ported intact:
 * a 60x44 grid, strokes that scribe in along their own length via a normalised
 * pathLength, fills and paper details fading in behind them, staggered 70ms.
 * The source drove that from an IntersectionObserver in React; here it is
 * data-motion="scribe-glyph" and CSS, so nothing ships to the browser.
 *
 * A NOTE ON THE PLANE GLYPH, which matters more than it looks.
 *
 * The four icons map to the four stages: tape to the visit, pencil to the
 * drawings, PLANE to the making, square to the fitting. The glyph was held off
 * stage 03 while the unnumbered stage-04 question was unanswered, because
 * choosing it would have asserted what happens between cutting and fitting.
 *
 * The answer arrived 30 Aug 2026: components are machined, edged and finished
 * to the approved drawings, and pieces are built up and finished in the room.
 * Finishing work is real, so the glyph went on (Denis's call, same day). Its
 * accessible name is "hand plane", not the source's "bench plane": there is no
 * bench, and the one word was the difference between artwork and a claim.
 */

type Tone = "bd" | "md" | "chf" | "pfl" | "ppl" | "hl";
type Glyph = [string, Record<string, string | number>, Tone];

const L = (x1: number, y1: number, x2: number, y2: number, t: Tone): Glyph =>
  ["line", { x1, y1, x2, y2 }, t];

const GLYPHS: Record<string, Glyph[]> = {
  tape: [
    ["circle", { cx: 20, cy: 19, r: 14 }, "bd"],
    ["circle", { cx: 20, cy: 19, r: 8.5 }, "bd"],
    ["circle", { cx: 20, cy: 19, r: 3.5 }, "bd"],
    ["path", { d: "M28.5,6.5 Q37.5,10 37.5,19 L37.5,25.5" }, "bd"],
    L(37.5, 25.5, 51, 25.5, "bd"),
    L(33, 33, 51, 33, "bd"),
    ["rect", { x: 51, y: 23.5, width: 3.6, height: 10.5, rx: 1 }, "bd"],
    L(40, 33, 40, 28.8, "md"),
    L(44, 33, 44, 28.8, "md"),
    L(48, 33, 48, 28.8, "md"),
    ["path", { d: "M26.8,29.3 L29.8,29.3 L29.8,26.3" }, "bd"],
    ["circle", { cx: 23, cy: 28.6, r: 0.9 }, "chf"],
  ],
  pencil: [
    L(47.6, 5.6, 52.4, 12.4, "bd"),
    L(47.6, 5.6, 19.6, 25.6, "bd"),
    L(52.4, 12.4, 24.4, 32.4, "bd"),
    L(43.5, 8.5, 48.3, 15.3, "md"),
    L(45.9, 11.9, 22, 29, "md"),
    L(19.6, 25.6, 24.4, 32.4, "bd"),
    L(19.6, 25.6, 12, 36.5, "bd"),
    L(24.4, 32.4, 12, 36.5, "bd"),
    ["path", { d: "M12,36.5 L14.9,33 L16.4,35.2 Z" }, "chf"],
  ],
  plane: [
    ["path", { d: "M4,36 L56,36" }, "md"],
    ["path", { d: "M4,36 L4,32.5 Q4,31 6,31 L15,31" }, "md"],
    ["circle", { cx: 10.5, cy: 25.8, r: 3.8 }, "md"],
    L(8.7, 31, 9.2, 29.3, "md"),
    L(12.3, 31, 11.8, 29.3, "md"),
    ["path", { d: "M15,31 Q21,30 23.5,26.2" }, "md"],
    L(35, 6.5, 23.5, 26.2, "md"),
    L(38, 8.5, 27.5, 25.5, "md"),
    L(35, 6.5, 38, 8.5, "md"),
    ["circle", { cx: 30.2, cy: 16, r: 2 }, "md"],
    ["circle", { cx: 27.4, cy: 20.3, r: 1.5 }, "md"],
    ["path", { d: "M27.5,25.5 Q30,27.6 32,25.2 C34,15.5 40,12.5 45,13.5 C51.5,15 51,21.5 46.5,26 Q44,28.6 43.6,33.2" }, "md"],
    ["path", { d: "M36.5,28 C36.8,21.5 40,17.5 44,18 C48,18.6 47.4,23 44.2,26.4 Q42.4,28.4 42,31" }, "md"],
    ["path", { d: "M43.6,33.2 L56,33.2 L56,36" }, "md"],
  ],
  square: [
    ["path", { d: "M14,4 L24,4 L24,30 L52,30 L52,40 L14,40 Z" }, "chf"],
    ["circle", { cx: 19, cy: 8.5, r: 1.6 }, "pfl"],
    L(24.6, 30.7, 30.6, 38.7, "ppl"),
    ...[6.2, 8.6, 11, 13.4, 15.8, 18.2, 20.6, 23, 25.4, 27.8].map(
      (y, i): Glyph => L(14, y, i % 2 ? 17 : 18.6, y, "ppl")
    ),
    ...[26, 28.4, 30.8, 33.2, 35.6, 38, 40.4, 42.8, 45.2, 47.6, 50].map(
      (x, i): Glyph => L(x, 40, x, i % 2 ? 37 : 35.4, "ppl")
    ),
    /* the wall it is squared against */
    L(11.5, 2, 11.5, 42.5, "hl"),
    L(11.5, 42.5, 54, 42.5, "hl"),
  ],
};

const ICON_NAMES: Record<string, string> = {
  tape: "measuring tape",
  pencil: "pencil",
  plane: "hand plane",
  square: "try square",
};

const TONE: Record<Tone, string> = {
  bd: "stroke:var(--char);stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round",
  md: "stroke:var(--char);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round",
  chf: "fill:var(--char);stroke:none",
  pfl: "fill:var(--paper);stroke:none",
  ppl: "stroke:var(--paper);stroke-width:1.2",
  hl: "stroke:var(--hair);stroke-width:1.2",
};

/* These tones are filled shapes rather than strokes, so they fade rather than draw. */
const FADES: Record<string, boolean> = { chf: true, pfl: true, ppl: true };

interface Props {
  number?: string;
  title: string;
  icon?: "tape" | "pencil" | "plane" | "square";
  /**
   * Short mono facts stamped in under the copy, row by row: durations, counts,
   * what is included. The design system's process page carried these on every
   * stage (its StageDetails), and they are ported here as a stamp-group.
   */
  details?: string[];
  class?: string;
  style?: string;
}

const { number, title, icon, details, class: className, style = "" } = Astro.props;
const glyph = icon && GLYPHS[icon] ? GLYPHS[icon] : null;
---

<div
  data-row="stage"
  class={className}
  style={`display:grid;grid-template-columns:88px minmax(0,240px) minmax(0,1fr);gap:var(--gap-md);padding:var(--space-12) 0;border-bottom:var(--rule-hair);${style}`}
>
  {glyph ? (
    <svg
      role="img"
      aria-label={`Stage ${number || ""} · ${ICON_NAMES[icon!] || icon}`.trim()}
      viewBox="0 0 60 44"
      width="46"
      data-glyph
      style="display:block;margin-top:1px;overflow:visible"
    >
      {glyph.map(([tag, attrs, tone], i) => {
        const Shape = tag as any;
        const fades = FADES[tone];
        const delay = 140 + Math.min(i, 10) * 70;
        return (
          <Shape
            {...attrs}
            fill="none"
            pathLength={fades ? undefined : 1}
            data-fades={fades ? "" : undefined}
            style={`${TONE[tone]};--d:${delay}ms`}
          />
        );
      })}
    </svg>
  ) : (
    <span style="font-family:var(--font-mono);font-size:var(--type-mono-md);letter-spacing:var(--ls-mono);color:var(--ink-soft);padding-top:var(--space-2)">{number}</span>
  )}

  <h3 style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-lg)">{title}</h3>
  <div>
    <p style="max-width:var(--measure-tight)"><slot /></p>
    {details && details.length > 0 && (
      <p
        data-motion="stamp-group"
        style="display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-4) var(--space-9);margin-top:var(--space-9)"
      >
        {details.map((d, i) => (
          <>
            {i > 0 && <span style="font-family:var(--font-mono);font-size:var(--type-mono);color:var(--ink-soft)" aria-hidden="true">·</span>}
            <span style="font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono);text-transform:uppercase;color:var(--ink-soft)">{d}</span>
          </>
        ))}
      </p>
    )}
  </div>
</div>

<style>
  /* Strokes scribe in along their own length; fills and paper details fade in
     behind them. Both keyed off the same per-shape delay, set inline as --d. */
  [data-glyph] > :not([data-fades]) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 520ms var(--ease-out) var(--d);
  }
  [data-glyph] > [data-fades] {
    opacity: 0;
    transition: opacity 420ms var(--ease-out) var(--d);
  }
  [data-glyph].in > :not([data-fades]) { stroke-dashoffset: 0; }
  [data-glyph].in > [data-fades] { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    [data-glyph] > :not([data-fades]) { stroke-dashoffset: 0; transition: none; }
    [data-glyph] > [data-fades] { opacity: 1; transition: none; }
  }
</style>
