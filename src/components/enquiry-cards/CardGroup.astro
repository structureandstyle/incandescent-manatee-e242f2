---
/**
 * One question answered with picture cards: a fieldset whose every card is a
 * real checkbox or radio inside its label, so a tap, a click, the keyboard and
 * a screen reader all work the way they do on a plain list. The drawing is
 * decoration (aria-hidden); the label is the name.
 *
 * LAYOUT. Without JavaScript the cards wrap into a grid: a plain, complete
 * list. With it (Base.astro stamps .js on <html> before first paint) they are
 * one line of cards that swipes sideways, with arrow buttons and a visible
 * scrollbar for anyone who does not swipe. On the full-width /contact/ form
 * the row shares the width and only scrolls when it cannot fit
 * (enquiry-cards.css, the rules under @container ecf). The arrows only appear
 * when there is something to scroll to. They are for a pointer and stay out
 * of the tab order: the keyboard moves card to card, and each focused card
 * scrolls fully into view (./client.ts).
 *
 * The enquiry form's picture cards, 14 Nov 2026 (EnquiryForm.astro). See
 * ./choices.ts for what each card sends.
 */
import type { Choice } from "./choices";
import "./enquiry-cards.css";

interface Props {
  legend: string;
  help?: string;
  /** The field name the form sends. */
  name: string;
  type: "checkbox" | "radio";
  choices: Choice[];
  /** Unique per form on the page, as EnquiryForm's idPrefix. */
  idPrefix: string;
  checked?: string[];
  /**
   * An unlabelled, never-chosen first input, which makes Netlify's email name
   * the field rather than its first card. Netlify labels a group of inputs
   * that share a name with the label of the first one, and ignores the legend
   * (a known, unfixed Netlify bug): without this the email read "Fitted
   * wardrobes: Alcove units and shelving" (8 Oct 2026, Denis's ask), and with
   * the area and source as cards it would read "Hampstead: Camden" and
   * "Google: Referral". With it the lines read "Service: ...", "Area: ..."
   * and "Source: ...". It is never chosen, so it never sends a value. Hidden
   * in a paragraph like the honeypot, so a radio group's arrow keys skip it.
   */
  emailHeading?: boolean;
  /** Show what is chosen under the cards: useful when chosen cards have scrolled out of view. */
  showChosen?: boolean;
  /** Extra data attribute for the client script to find this group by role. */
  role?: string;
}

const {
  legend,
  help,
  name,
  type,
  choices,
  idPrefix,
  checked = [],
  emailHeading = false,
  showChosen = false,
  role,
} = Astro.props;

const base = `${idPrefix}${name.replace(/[^a-z0-9]+/gi, "-")}`;
const trackId = `${base}-cards`;
const helpId = help ? `${base}-help` : undefined;
---

<fieldset
  class="ec-group"
  data-ec-group={role ?? ""}
  data-layout="row"
  aria-describedby={helpId}
>
  <legend class="ec-legend">{legend}</legend>
  <div class="ec-bar">
    {help ? <p class="ecf-help" id={helpId}>{help}</p> : <span />}
    <div class="ec-arrows" data-ec-arrows hidden>
      <button type="button" class="ec-arrow" data-ec-scroll="-1" aria-controls={trackId} aria-label="Show earlier cards" tabindex="-1">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3L5 8l5 5" /></svg>
      </button>
      <button type="button" class="ec-arrow" data-ec-scroll="1" aria-controls={trackId} aria-label="Show more cards" tabindex="-1">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" /></svg>
      </button>
    </div>
  </div>
  {emailHeading && <p hidden><input type={type} name={name} value="" tabindex="-1" /></p>}
  <div class="ec-cards" id={trackId} data-ec-track>
    {choices.map((c, i) => (
      <label class="ec-card" for={`${base}-${i}`}>
        <span class="ec-art" aria-hidden="true">
          <svg viewBox="0 0 120 80" focusable="false"><use href={`#ec-art-${c.art}`} /></svg>
        </span>
        <span class="ec-label">
          <input
            class="ec-input"
            id={`${base}-${i}`}
            type={type}
            name={name}
            value={c.value}
            checked={checked.includes(c.value)}
            data-label={c.label}
          />
          <span class="ec-text">
            {c.label}
            {c.sub && <span class="ec-sub">{c.sub}</span>}
          </span>
        </span>
      </label>
    ))}
  </div>
  {showChosen && <p class="ec-chosen" data-ec-chosen></p>}
  <slot />
</fieldset>
