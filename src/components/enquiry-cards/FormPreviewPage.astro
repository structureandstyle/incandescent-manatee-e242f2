---
/**
 * The body of the two hidden form preview pages, /form-preview-a/ and
 * /form-preview-b/ (14 Nov 2026). Laid out like /contact/: the heading, his
 * paragraph, and the form in its bordered box at the same width. A short
 * internal note says what the option is and links to the other one, and two
 * buttons open the same form as the Get a quote pop-up: once as most pages
 * open it, and once as a service page does, with its service already ticked.
 * Once site PR #41 merges, the pop-up and /contact/ are the only places the
 * form appears (a founder, 14 Nov 2026: one form per page).
 *
 * Both pages are noindexed and kept out of the sitemap by their entry in
 * src/data/page-gates.ts, and nothing on the site links to them. When a
 * founder has picked, both pages and this folder's preview-only parts go.
 */
import Wrap from "../ds/Wrap.astro";
import Display from "../ds/Display.astro";
import Kicker from "../ds/Kicker.astro";
import MonoLabel from "../ds/MonoLabel.astro";
import ArtSprite from "./ArtSprite.astro";
import EnquiryFormA from "./EnquiryFormA.astro";
import EnquiryFormB from "./EnquiryFormB.astro";

interface Props {
  variant: "a" | "b";
}
const { variant } = Astro.props;
const Form = variant === "a" ? EnquiryFormA : EnquiryFormB;
const other = variant === "a" ? "b" : "a";
const SERVICE_DEMO = "Alcove units and shelving";

const NOTES = {
  a: {
    title: "Option A: the whole form on one page",
    points: [
      "Same order as today: your details first, then the questions.",
      "Each picture question is one row of cards. It swipes on a phone; the arrows and the scrollbar move it on a laptop.",
      "Tell us about the job has four prompts. Tapping one starts a line in the box, such as \"Room: \".",
      "Somewhere else opens a box for the area or postcode, and that is what arrives in the log.",
    ],
  },
  b: {
    title: "Option B: one question at a time",
    points: [
      "Five short steps with a progress line. Name, phone and email come last, after the easy questions.",
      "Cards sit in a grid on a laptop and swipe in two rows on a phone.",
      "Tell us about the job has a rough-width picker. Picking a width writes it as the first line of the box, where it can be changed.",
      "Somewhere else opens a box for the area or postcode, and that is what arrives in the log.",
    ],
  },
}[variant];
---

<ArtSprite />

<Wrap style="padding-top:var(--hero-y);padding-bottom:var(--space-15)">
  <div class="pv-note">
    <MonoLabel as="p" tone="green">Internal preview, hidden from Google</MonoLabel>
    <p>
      {NOTES.title}. Nothing sent from this page goes anywhere: Send shows what the enquiry would carry
      instead. <a href={`/form-preview-${other}/`}>See option {other.toUpperCase()}</a>.
    </p>
    <div class="pv-buttons">
      <button type="button" class="pv-open" data-pv-open={`pv-popup-${variant}`}>Open as the Get a quote pop-up</button>
      <button type="button" class="pv-open" data-pv-open={`pv-service-${variant}`}>Open as the pop-up on a service page</button>
    </div>
  </div>
</Wrap>

<Wrap style="padding-bottom:var(--section-y)">
  <Kicker scribe>Enquiries</Kicker>
  <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">Get a quote</Display>
  <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet);margin-bottom:var(--space-15)">
    Tell us what you have in mind and send a few photos, rough dimensions and any inspiration
    images you have. We'll come back to you with anything else we need, then arrange a survey
    before providing a detailed quotation.
  </p>
  <div class="pv-grid">
    <aside class="pv-points">
      <MonoLabel as="p" style="margin-bottom:var(--space-6)">What is different</MonoLabel>
      <ul>
        {NOTES.points.map((p) => <li>{p}</li>)}
      </ul>
    </aside>
    <div class="pv-form" style="border:var(--rule-structure);padding:clamp(20px,4vw,40px);background:var(--paper)">
      <MonoLabel as="p" style="margin-bottom:var(--space-10)">Send an enquiry</MonoLabel>
      <Form idPrefix={`p${variant}-`} />
    </div>
  </div>
</Wrap>

<dialog id={`pv-popup-${variant}`} class="pv-dialog" aria-labelledby={`pv-popup-${variant}-h`}>
  <div class="pv-dialog-head">
    <MonoLabel as="p" tone="soft">Enquiries</MonoLabel>
    <button type="button" class="pv-close" aria-label="Close">&times;</button>
  </div>
  <h2 id={`pv-popup-${variant}-h`} class="pv-dialog-title">If you have a room in mind, start here.</h2>
  <p class="pv-dialog-lede">
    Rough dimensions, a photo or drawing, and a sense of what the piece needs to do gets you a
    considered reply, not a brochure.
  </p>
  <Form compact idPrefix={`m${variant}-`} />
</dialog>

<dialog id={`pv-service-${variant}`} class="pv-dialog" aria-labelledby={`pv-service-${variant}-h`}>
  <div class="pv-dialog-head">
    <MonoLabel as="p" tone="soft">Enquiries, from the alcove units page</MonoLabel>
    <button type="button" class="pv-close" aria-label="Close">&times;</button>
  </div>
  <h2 id={`pv-service-${variant}-h`} class="pv-dialog-title">If you have a room in mind, start here.</h2>
  <p class="pv-dialog-lede">
    Opened from a service page, the pop-up has that page's service already ticked, here alcove units,
    and keeps the full list to add to. The example in the job box matches the service too.
  </p>
  <Form compact idPrefix={`s${variant}-`} preselectedService={SERVICE_DEMO} />
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-pv-open]").forEach((button) => {
    const dialog = document.getElementById(button.dataset.pvOpen ?? "") as HTMLDialogElement | null;
    if (!dialog || !("showModal" in dialog)) return;
    button.addEventListener("click", () => dialog.showModal());
    dialog.querySelector(".pv-close")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .pv-note {
    border: var(--rule-structure);
    padding: var(--space-9) var(--space-10);
    display: grid;
    gap: var(--space-5);
    max-width: 920px;
  }
  .pv-note p { margin: 0; font-size: var(--type-body-sm); }
  .pv-note a { color: var(--green); border-bottom: 1px solid rgba(44, 74, 58, 0.4); }
  .pv-buttons { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  button.pv-open {
    min-height: 44px;
    padding: var(--space-3) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--char);
    background: var(--paper);
    border: var(--rule-structure);
    cursor: pointer;
  }
  button.pv-open:hover { background: var(--char); color: var(--paper); }

  .pv-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: "points form";
    gap: var(--space-15) var(--gap-xl);
    align-items: start;
  }
  .pv-points { grid-area: points; max-width: var(--measure-short); }
  .pv-points ul { margin: 0; padding: 0 0 0 1.1em; display: grid; gap: var(--space-5); font-size: var(--type-body-sm); color: var(--text-quiet); }
  .pv-form { grid-area: form; min-width: 0; }
  @media (max-width: 820px) {
    .pv-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "form" "points";
    }
  }

  .pv-dialog {
    width: min(660px, 94vw);
    max-height: 92vh;
    overflow-y: auto;
    border: var(--rule-structure);
    background: var(--paper);
    color: var(--ink);
    padding: clamp(20px, 4vw, 40px);
    margin: auto;
  }
  .pv-dialog::backdrop { background: rgba(24, 21, 17, 0.6); }
  .pv-dialog-head {
    position: sticky;
    top: calc(clamp(20px, 4vw, 40px) * -1);
    z-index: 2;
    background: var(--paper);
    padding-top: clamp(20px, 4vw, 40px);
    margin-top: calc(clamp(20px, 4vw, 40px) * -1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
  }
  button.pv-close {
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 9px 12px;
    min-width: 44px;
    min-height: 44px;
    margin-right: -12px;
  }
  .pv-dialog-title {
    font-family: var(--font-serif-display);
    font-weight: var(--weight-regular);
    font-size: var(--type-serif-lg);
    margin: var(--space-6) 0 var(--space-4);
  }
  .pv-dialog-lede { font-size: var(--type-body-sm); color: var(--text-quiet); margin-bottom: var(--space-10); }
</style>
