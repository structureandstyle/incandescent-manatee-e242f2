---
/**
 * Site footer. A thin wrapper over the design system's SiteFooter.
 *
 * The mono lines carry the legal identity and nothing else. The design system's
 * own footer ended with "Identity by Flow to Form", a supplier credit on the
 * client's site. That is the client's decision to make rather than ours, so it
 * was left out until he was asked; he agreed on 16 Oct 2026. Everything here is a matter of public record:
 * Companies House 16822866, incorporated 31 October 2025.
 *
 * Reorganised 29 Oct 2026 (Denis: "needs to be organised a bit"). What it
 * holds is what it held, plus the journal and the opening hours, both already
 * published elsewhere on the site. What changed is the grouping: the contact
 * routes and the hours are one block, the links are three groups that mirror
 * the header, and the small print is one bar. SiteFooter.astro says why each
 * piece sits where it does and which sites in the trade it was taken from.
 */
import SiteFooter from "./ds/SiteFooter.astro";
import { AGENCY_CREDIT, BUSINESS, SERVICES, hoursLines, servicePath, serviceLabel } from "../data/site";
import { indexable } from "../data/page-gates";
import { NAV, ENQUIRE_HREF } from "../data/site-content";
import { getCollection } from "astro:content";
import { isLive } from "../data/journal";

/* Derived, not typed (5 Sep 2026). A literal 2026 on a static site with no
   scheduled rebuild goes silently wrong on 1 January, on every page at once,
   with nobody needing to touch the content for it to happen. */
const year = new Date().getFullYear();

/* The lists are derived rather than written out, so a page cannot be linked
   from here unless its questions are answered, and it appears on its own the
   day its gate clears.

   SERVICES ARE THE SERVICES, all five, and that includes the two wave-two
   pages that currently send noindex. Corrected 4 Sep 2026: the first version
   filtered them out on the reasoning that the footer should not link a
   noindexed page, which produced a services list missing built-in TV units and
   bespoke kitchens and ending on a cost guide. Denis, whose services they are,
   called it wrong, and he was right. Both pages are real pages of about 1,150
   words, both are noindexed for copy reasons rather than because they are
   unfinished, and the home page service strip already links to both
   deliberately. A footer that misdescribes what the business sells is a worse
   fault than an internal link to a page Google is not indexing yet.

   The cost guide moves to its own group. It is not a service, and the journal
   joins it there the day the first article publishes. */
const serviceLinks = SERVICES.filter((s) => !s.guide && indexable(servicePath(s))).map((s) => ({
  label: serviceLabel(s),
  href: servicePath(s),
}));

/* The journal never did join, 29 Oct 2026: the header grew a Journal link the
   day the alcove guide went live (Header.astro, 13 Oct 2026) and the footer
   kept one guide, with two articles published. Now both follow the header's
   rule: an article counts once it is cleared, and a draft on a preview build
   does not. The articles go under Guides by their breadcrumb label, which is
   short enough for a list, newest first and no more than three, so the group
   stays a list as the journal grows. The journal itself sits under The
   company, where the header puts it. */
const articles = (await getCollection("journal"))
  .filter(isLive)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const guideLinks = [
  ...SERVICES.filter((s) => s.guide && indexable(servicePath(s))).map((s) => ({
    label: serviceLabel(s),
    href: servicePath(s),
  })),
  ...articles.slice(0, 3).map((a) => ({ label: a.data.crumb ?? a.data.title, href: `/journal/${a.id}/` })),
];

const pageLinks = [
  ...NAV.filter((item) => indexable(item.href)),
  ...(articles.length > 0 ? [{ label: "Journal", href: "/journal/" }] : []),
];

/* The contact routes, on every page. The address lives here by Denis's 1 Sep
   2026 ruling (off the enquiry band, kept on the contact page, in the footer
   and in the schema). The mailto subject labels the source, as on contact.

   Enquire moved here from The company on 29 Oct 2026, to stand with the other
   ways in, and it leads them for the reason the enquiry band leads with the
   form: the form is the route that attributes itself end to end, and the
   email the one that does not, so the address stays last and at the size of
   the links around it. It still navigates rather than opening the enquiry
   modal (7 Sep 2026): Base.astro leaves every /contact/ link inside
   [data-site-footer] alone. */
const contact = [
  { label: "Enquire", href: ENQUIRE_HREF, lead: true },
  { label: `Call ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
  { label: "WhatsApp", href: BUSINESS.whatsapp },
  { label: BUSINESS.email, href: `mailto:${BUSINESS.email}?subject=${encodeURIComponent("Enquiry via structureandstyle.co.uk")}` },
];
---

<SiteFooter
  brand
  tagline="Bespoke joinery and fitted furniture · London"
  contact={contact}
  hours={hoursLines()}
  nav={[
    /* "What we make" was the first heading and the verify gate refused the
       build: "we make" is a Section 5 provenance ban, because the site never
       claims the making. It caught it on all twelve pages at once, which is
       the argument for the gate in one line. */
    { heading: "Services", links: serviceLinks },
    { heading: "The company", links: pageLinks },
    { heading: "Guides", links: guideLinks },
  ]}
  legal={[
    { label: "Privacy notice", href: "/privacy/" },
    { label: "Cookies", href: "/cookies/" },
  ]}
  lines={[`© ${year} ${BUSINESS.legalName}`, `Company no. ${BUSINESS.companyNumber}`]}
  {/* On since Kaspar agreed, 16 Oct 2026: see AGENCY_CREDIT in src/data/site.ts.
      One boolean there turns it off again. */}
  credit={AGENCY_CREDIT.enabled ? AGENCY_CREDIT.line : null}
/>
