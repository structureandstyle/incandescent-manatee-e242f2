---
import { BUSINESS, SERVICES, servicePath } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-sand/50">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-semibold">Structure <span class="text-timber">&amp;</span> Style</p>
      <p class="mt-2 max-w-sm text-sm text-ink-soft">{BUSINESS.tagline}.</p>

      <div class="mt-5 flex flex-col gap-1 text-sm">
        <a href={BUSINESS.phoneHref} class="font-medium hover:text-timber">{BUSINESS.phoneDisplay}</a>
        <a href={`mailto:${BUSINESS.email}`} class="hover:text-timber">{BUSINESS.email}</a>
        <a href={BUSINESS.whatsapp} rel="noopener" class="hover:text-timber">Message on WhatsApp</a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold">What we do</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-soft">
        {
          SERVICES.map((s) => (
            <li>
              <a href={servicePath(s)} class="hover:text-timber">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Where we work</h2>
      <p class="mt-3 text-sm text-ink-soft">{BUSINESS.areaServed.join(", ")} and across north London.</p>
      <ul class="mt-5 space-y-2 text-sm text-ink-soft">
        <li><a href="/contact/" class="hover:text-timber">Get a quote</a></li>
        <li><a href="/privacy/" class="hover:text-timber">Privacy notice</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-5 text-xs text-ink-soft">
      &copy; {year} {BUSINESS.legalName}. Registered in England and Wales, company no. {BUSINESS.companyNumber}.
    </div>
  </div>
</footer>
