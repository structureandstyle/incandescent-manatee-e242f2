---
/**
 * One area-page section's words with something to look at beside them.
 *
 * A founder's comment on the Primrose Hill draft (15 Nov 2026): "add examples
 * of what the text describes on the right side ... photos, 2d illustrations
 * or something else". The words keep the page's reading measure on the left;
 * the right takes either a line drawing from src/data/area-drawings.ts
 * (drawing="id") or whatever the page passes in slot "side" (the price cards,
 * PriceCards.astro). Line drawings rather than photographs: a photograph of a
 * local house reads as a job there, which the page never claims, and
 * photographs of other people's houses would need licences.
 *
 *   <AreaSide drawing="stucco-villa">
 *     <p>...</p>
 *   </AreaSide>
 *
 * Below 900px the side drops under the words, so a phone reads the section
 * first and then sees the drawing. Each drawing is an <svg role="img"> with
 * its own description (its label in area-drawings.ts) and a caption.
 *
 * Several drawings (26 Nov 2026, a founder on the Belsize Park mews section:
 * "have a few sketches to describe the copy"): pass a list,
 * drawing={["bp-mews-section", "bp-mews-tv-unit"]}, one per piece the words
 * describe, in the order the words name them. They stack in the side column.
 *
 * Under the words (26 Nov 2026, the same founder: the sketches "need to be
 * underneath the text, and then ... the sketches side by side"): pass `below`
 * and the drawings sit under the words in a row of two, each half the section's
 * width; one drawing takes one half. Below 700px they stack, full width.
 */
import MonoLabel from "./ds/MonoLabel.astro";
import { AREA_DRAWINGS } from "../data/area-drawings";

interface Props {
  drawing?: string | string[];
  /** Drawings under the words, side by side, instead of in a column beside them. */
  below?: boolean;
}

const { drawing, below = false } = Astro.props;
const ids = drawing === undefined ? [] : Array.isArray(drawing) ? drawing : [drawing];
const drawings = ids.map((id) => {
  const d = AREA_DRAWINGS[id];
  if (!d) throw new Error(`There is no area drawing called "${id}" in src/data/area-drawings.ts.`);
  return d;
});
const prefixed = (markup: string) => markup.replace(/class="([a-z]+)"/g, 'class="ad-$1"');
---

<div class:list={["area-side", { "area-side--below": below && drawings.length > 0 }]}>
  <div class="area-side-text">
    <slot />
  </div>
  <div class="area-side-aside">
    {drawings.length ? (
      <div class="area-drawings">
        {drawings.map((d) => (
          <figure class="area-drawing">
            <svg viewBox="0 0 320 240" role="img" aria-label={d.label} set:html={prefixed(d.markup)} />
            <figcaption>
              <MonoLabel tone="soft">{d.caption}</MonoLabel>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <slot name="side" />
    )}
  </div>
</div>

<style>
  .area-side {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: var(--space-10) var(--gap-lg);
    align-items: start;
  }
  .area-drawings {
    display: grid;
    gap: var(--space-8);
  }
  .area-drawing {
    margin: 0;
    border: var(--rule-hair);
    background: #f6f3ea;
    padding: var(--space-9) var(--space-9) var(--space-7);
  }
  .area-drawing svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .area-drawing figcaption {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--rule-hair);
  }
  @media (max-width: 900px) {
    .area-side {
      grid-template-columns: minmax(0, 1fr);
    }
    .area-side-aside {
      max-width: 480px;
    }
  }
  /* Drawings under the words, two to a row. */
  .area-side--below {
    grid-template-columns: minmax(0, 1fr);
  }
  .area-side--below .area-side-text {
    max-width: var(--measure);
  }
  .area-side--below .area-side-aside {
    max-width: none;
  }
  .area-side--below .area-drawings {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-lg);
    align-items: start;
  }
  @media (max-width: 700px) {
    .area-side--below .area-drawings {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
