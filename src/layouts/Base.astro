---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieNotice from "../components/ds/CookieNotice.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import { SITE_URL, BUSINESS, GA4_ID } from "../data/site";
import { REVIEWS } from "../data/site-content";

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page, on top of the site-wide LocalBusiness. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute or root-relative share image. */
  image?: string;
  /**
   * Keep this page out of the index. Set by a page while the content
   * questionnaire has not answered everything that page depends on, so draft
   * copy can be built and reviewed on a branch deploy without any of it
   * reaching search. See `src/data/page-gates.ts`.
   *
   * Not defaulted from the gate here on purpose: the layout does not know the
   * page's path reliably enough to look it up, so each page passes it. A page
   * that forgets is indexable, which is right for a finished page and is caught
   * for an unfinished one by `npm run verify`.
   */
  noindex?: boolean;
  /** The 404 template has no real address to point a canonical at. */
  noCanonical?: boolean;
}

const { title, description, schema, image = "/og-default.jpg", noindex = false, noCanonical = false } = Astro.props;

// Self-referencing canonical on every template. The old site had one canonical
// on one page and Google overrode it anyway, because the Business Profile was
// pointing somewhere else.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const fullTitle = title.includes(BUSINESS.name) ? title : `${title} | ${BUSINESS.name}`;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE_URL}/#business`,
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  /* WITH THE TRAILING SLASH, 5 Sep 2026. SITE_URL carries none, so this one
     field disagreed with the canonical link and the og:url on the same page,
     on all eighteen of them. The NAP record is explicit that citations are
     checked character by character and that an inconsistency is a negative
     signal rather than a missing one, and this was the only NAP-adjacent field
     on the site contradicting itself. */
  url: `${SITE_URL}/`,
  /* The Business Profile this entity actually is. The rating below is read
     off that profile, and until now nothing in the markup said where it came
     from: sameAs is what ties the two together, and it is the same URL the
     reviews block already links to on the home page. */
  sameAs: [REVIEWS.profileUrl],
  telephone: BUSINESS.phoneDisplay,
  /* An address, 7 September 2026, on the audit finding the block had none.
     Google's LocalBusiness guidance wants one, and a service-area business
     can give the locality without a street. The registered office is a
     Companies House service address in Covent Garden that the ops repo rules
     is never published, and Camden Town is the operating base (Denis, 2 Sep
     2026), so this is the borough and the country and nothing finer: true,
     and the same shape as the Business Profile, which hides its address. */
  address: { "@type": "PostalAddress", addressLocality: "London", addressCountry: "GB" },
  email: BUSINESS.email,
  image: ogImage,
  priceRange: "££",
  areaServed: BUSINESS.areaServed.map((a) => ({ "@type": "Place", name: a })),
  openingHoursSpecification: BUSINESS.openingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  aggregateRating: {
    "@type": "AggregateRating",
    /* A number, not the string it was serialised as (audit, 7 Sep 2026):
       the site stores it as "5.0" so the page prints one decimal. */
    ratingValue: Number(BUSINESS.ratingValue),
    reviewCount: BUSINESS.reviewCount,
  },
};

const graph = [localBusiness, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Stamp .js before first paint, so the motion CSS can hide what it is about
      to reveal. Without it, html:not(.js) in motion-actions.css keeps every
      animated element at its resting state, which is what a visitor with no
      JavaScript gets: the whole page, no motion. This must stay inline and
      stay here, above the stylesheet, or elements flash visible then hide.
    */}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}

    {/*
      THE ICON SET, 5 September 2026. Until now this was one line: an SVG
      favicon. favicon.ico sat in the build unreferenced, there was no
      apple-touch-icon, no manifest and no theme-color, so a visitor who saved
      the site to a phone home screen got a screenshot of the page or a blank
      tile rather than the mark. That is the one place a small joinery firm's
      site is looked at next to established ones.

      Four lines, in the order a browser wants them: the SVG for anything that
      supports it, the ICO for anything that does not, the 180px PNG iOS
      requires, and the manifest Android reads. theme-color is the door green,
      which is the browser chrome on a phone and the tile colour on Android.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2C4A3A" />
    {
      /* Draft copy is never indexable. `noindex` is driven by the page's gate in
         src/data/page-gates.ts, and lifts on its own once the questions that page
         depends on are answered. nofollow as well, so the crawler does not walk
         from a draft page into the rest of the site and treat it as a live route. */
      noindex && <meta name="robots" content="noindex,nofollow" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Three preloads, not two. The display serif paints the H1 and the body sans
      paints everything under it, so both sit on the largest contentful paint.
      The mono joined on 5 Sep 2026: it sets the kicker above every H1 on the
      site, "Bespoke joinery · London" on the home page, which is the first line
      of text on the page and was waiting for the stylesheet to be parsed before
      the browser knew the file existed. font-display: swap meant a flash of
      fallback rather than a block, which is why this was a small finding rather
      than a large one, but the flash is on the first thing anyone reads.

      The italic and the heavier sans weights still load on demand through
      @font-face (tokens/fonts.css): they paint below the fold or not at all.
      All three files are in /public/fonts; a preload of a missing file 404s on
      every page load, which is why the earlier Inter preload stayed commented
      out until it was gone.
    */}
    <link rel="preload" href="/fonts/libre-caslon-display-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* Two more, 7 September 2026: the italic is in the homepage H1 and the
        500 weight is every nav link and mono label, so both are above the
        fold on every page. Lighthouse traced them behind the stylesheet on
        all twelve routes; preloaded, they fetch alongside it. */}
    <link rel="preload" href="/fonts/libre-caslon-text-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-500.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {/*
      ANALYTICS IS GATED ON CONSENT, from 4 Sep 2026.

      Until then gtag.js loaded on first paint on every page and Google
      Analytics set its cookies before the visitor had done anything. Analytics
      cookies are not strictly necessary, so PECR wants consent before they are
      set, and the site said nothing about cookies anywhere. That is now the
      cookie notice, /cookies/, and this gate.

      The gate is the script tag, not just Consent Mode: nothing from Google is
      fetched at all until the visitor accepts. Consent Mode's denied defaults
      are set anyway, before anything else, so a later grant is an update rather
      than a first word.

      The three link listeners are registered whatever the answer, because they
      push to dataLayer rather than to Google. Declined, those pushes sit in an
      array nobody reads and go nowhere. Accepted later in the visit, gtag.js
      processes the queue on load, so an enquiry made before the banner was
      answered is not lost.

      With JavaScript off nothing here runs, so nothing is set and nothing needs
      consenting to.
    */}
    {
      GA4_ID && (
        <>
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }

            gtag("consent", "default", {
              analytics_storage: "denied",
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
            });

            var SS_CONSENT_KEY = "ss_cookie_consent";
            var ssAnalyticsLoaded = false;

            function ssLoadAnalytics() {
              if (ssAnalyticsLoaded) return;
              ssAnalyticsLoaded = true;
              gtag("consent", "update", { analytics_storage: "granted" });
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA4_ID;
              document.head.appendChild(s);
              gtag("js", new Date());
              gtag("config", GA4_ID);
            }

            function ssReadConsent() {
              try { return localStorage.getItem(SS_CONSENT_KEY); } catch (err) { return null; }
            }
            function ssWriteConsent(value) {
              try { localStorage.setItem(SS_CONSENT_KEY, value); } catch (err) {}
            }

            // The one interface the notice and the cookie policy both call.
            window.ssCookieConsent = {
              current: ssReadConsent,
              grant: function () {
                ssWriteConsent("granted");
                ssLoadAnalytics();
                document.dispatchEvent(new CustomEvent("ss:consent", { detail: "granted" }));
              },
              deny: function () {
                ssWriteConsent("denied");
                gtag("consent", "update", { analytics_storage: "denied" });
                document.dispatchEvent(new CustomEvent("ss:consent", { detail: "denied" }));
              },
              /* Reopens the choice: used by the "change your mind" control on
                 /cookies/. Analytics already loaded this page stays loaded
                 until the next navigation, which is why deny also updates
                 Consent Mode above rather than relying on the reload. */
              reset: function () {
                try { localStorage.removeItem(SS_CONSENT_KEY); } catch (err) {}
                document.dispatchEvent(new CustomEvent("ss:consent", { detail: "reset" }));
              },
            };

            if (ssReadConsent() === "granted") ssLoadAnalytics();

            // Enhanced measurement catches the WhatsApp link, because wa.me is a
            // different host and counts as an outbound click. It does not catch
            // tel: or mailto:, which have no hostname. Those are two of the three
            // enquiry channels the agreement counts, so they fire from here.
            document.addEventListener("click", (e) => {
              const a = e.target.closest && e.target.closest("a[href]");
              if (!a) return;
              const href = a.getAttribute("href") || "";
              if (href.startsWith("tel:")) {
                gtag("event", "enquiry_call", { method: "phone", link_url: href });
              } else if (href.startsWith("mailto:")) {
                gtag("event", "enquiry_email", { method: "email", link_url: href });
              } else if (href.includes("wa.me")) {
                gtag("event", "enquiry_whatsapp", { method: "whatsapp", link_url: href });
              }
            });
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-bone"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* After the footer, so it is last in the tab order rather than in front of
        the page. It ships hidden and shows itself only when there is no stored
        answer. */}
    <CookieNotice />

    {/*
      The enquiry modal. A link to /contact/ inside the page opens this instead
      of navigating (except on the contact page itself), so the visitor enquires
      from where they are rather than losing their place: the pattern Denis
      asked for on 31 Aug 2026 after seeing it in the wild.

      The header is the exception, from 3 Sep 2026, on Denis's instruction: the
      Enquire button top right goes to /contact/ like the four nav links beside
      it. A navigation control navigates. The in-page calls to action, which are
      read at the end of an argument for the work, still open in place, which is
      what the 31 Aug pattern was for. Native <dialog>:
      Escape and the backdrop close it for free, and without JavaScript the
      links simply navigate to /contact/, which stays fully functional.
    */}
    <dialog
      id="enquiry-modal"
      style="width:min(660px,94vw);max-height:92vh;overflow-y:auto;border:var(--rule-structure);background:var(--paper);color:var(--ink);padding:clamp(20px,4vw,40px);margin:auto"
    >
      {/* The header row sticks to the top of the dialog's own scroller, 5 Sep
          2026. The form is longer than the dialog at 1440 x 900, so scrolling
          to the submit button used to carry the only close control off the top
          with it. The button also carries 44px of hit area rather than the
          glyph's own 16 x 26. */}
      <div style="position:sticky;top:calc(clamp(20px,4vw,40px) * -1);z-index:1;background:var(--paper);padding-top:clamp(20px,4vw,40px);margin-top:calc(clamp(20px,4vw,40px) * -1);display:flex;justify-content:space-between;align-items:center;gap:var(--space-8)">
        <MonoLabel as="p" tone="soft">Enquiries</MonoLabel>
        <button
          type="button"
          id="enquiry-modal-close"
          aria-label="Close"
          style="background:none;border:none;font-size:26px;line-height:1;cursor:pointer;color:var(--ink-soft);padding:9px 12px;min-width:44px;min-height:44px;margin-right:-12px"
        >&times;</button>
      </div>
      <h2 style="font-family:var(--font-serif-display);font-weight:var(--weight-regular);font-size:var(--type-serif-lg);margin:var(--space-6) 0 var(--space-4)">
        If you have a room in mind, start here.
      </h2>
      <p style="font-size:var(--type-body-sm);color:var(--text-quiet);margin-bottom:var(--space-10)">
        Rough dimensions, a photo or two, and a sense of what the piece needs to do gets you a
        considered reply, not a brochure.
      </p>
      <EnquiryForm compact idPrefix="modal-" />
    </dialog>

    <style is:global>
      #enquiry-modal::backdrop { background: rgba(24, 21, 17, 0.6); }
    </style>

    <script>
      // Any /contact/ link opens the modal in place. On the contact page the
      // links behave normally, and with no JavaScript nothing is intercepted.
      const modal = document.getElementById("enquiry-modal") as HTMLDialogElement | null;
      if (modal && "showModal" in modal && !location.pathname.startsWith("/contact")) {
        document.addEventListener("click", (e) => {
          const a = (e.target as Element | null)?.closest?.('a[href^="/contact"]');
          if (!a) return;
          // The header's Enquire button is navigation, not an in-page call to
          // action, so it is left to do what its href says.
          if (a.closest("[data-site-header]")) return;
          e.preventDefault();
          modal.showModal();
        });
        document.getElementById("enquiry-modal-close")?.addEventListener("click", () => modal.close());
        modal.addEventListener("click", (e) => {
          if (e.target === modal) modal.close();
        });
      }
    </script>

    <script>
      // The reveal. One observer for the whole page, replacing the per-component
      // useEnter hook the design system ran in React. Adds .in once, then stops
      // watching: nothing here re-hides on the way out, because a section that
      // fades as you scroll back up reads as a bug rather than as motion.
      //
      // Elements already in view at load are revealed by the observer's first
      // synchronous callback, so above-the-fold content does not wait.
      //
      // The trigger sits BELOW the fold, not inside it (3 Sep 2026). It used to
      // be threshold .12 with the root shortened 5% at the bottom, so a section
      // had to be properly on screen before a 780ms fade started. Scroll a phone
      // quickly and you landed on a viewport of empty paper and waited for it,
      // which reads as a broken page rather than as motion. Starting 20% of a
      // screen early means the fade is already running by the time the section
      // arrives, and a normal scroll still sees it move.
      const revealable = document.querySelectorAll("[data-motion], [data-glyph]");
      if (revealable.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0, rootMargin: "0px 0px 20% 0px" }
        );
        revealable.forEach((el) => io.observe(el));

        // Failsafe. If the observer never fires, every animated element stays
        // at opacity 0 or scaleX(0) and the copy is invisible. That is a worse
        // outcome than losing the motion, so after three seconds everything is
        // revealed regardless. Costs one timer and removes a whole class of
        // silent failure: an IntersectionObserver that does not fire is not
        // hypothetical, it is what happens in a browser pane that is not
        // compositing, which is where this was tested.
        setTimeout(() => {
          revealable.forEach((el) => el.classList.add("in"));
        }, 3000);
      }
    </script>

    <script>
      /**
       * LAZY IMAGES THAT NEVER PAINT, 5 September 2026.
       *
       * Chromium abandons a native loading="lazy" fetch when the viewport
       * passes an image and then reverses, and it does not retry: the frame
       * stays empty for the rest of the visit. A flick down the page and back
       * up is enough to trigger it, and the render pass caught it on the home
       * page's Selected work cards, on /work/ and on /bespoke-kitchens/, in two
       * independent capture runs and again live. It reads as a broken site,
       * because a bordered empty frame is exactly what this design uses for a
       * photograph that does not exist.
       *
       * One observer per page re-arms any lazy image that has reached the
       * viewport without painting: first by promoting it to eager, which the
       * spec says resumes a deferred load, then by re-assigning its source if
       * it is still blank a second and a half later. Images that load normally
       * are unobserved on sight and cost nothing.
       */
      const lazyPhotos = document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]');
      if (lazyPhotos.length && "IntersectionObserver" in window) {
        const painted = (img: HTMLImageElement) => img.complete && img.naturalWidth > 0;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const img = entry.target as HTMLImageElement;
              io.unobserve(img);
              if (painted(img)) continue;
              img.loading = "eager";
              setTimeout(() => {
                if (painted(img)) return;
                const src = img.getAttribute("src");
                const srcset = img.getAttribute("srcset");
                if (!src) return;
                img.removeAttribute("src");
                if (srcset) img.removeAttribute("srcset");
                if (srcset) img.setAttribute("srcset", srcset);
                img.setAttribute("src", src);
              }, 1500);
            }
          },
          { rootMargin: "400px 0px" }
        );
        lazyPhotos.forEach((img) => io.observe(img));
      }
    </script>

    <script>
      // The lightbox. Any Plate photograph opens full-screen on click, so the
      // work can be looked at properly rather than judged at grid size.
      // Progressive enhancement over the same <img>: no library, one overlay
      // built lazily on first use, closed by click, Escape or the button.
      // Without JavaScript the images are simply images, which is fine.
      //
      // NAVIGABLE since 1 Sep 2026, Denis's ask: an enlarged photograph could
      // not be swiped. The lightbox now knows the set it opened from: a work
      // carousel's own photographs when opened from one, otherwise every plate
      // photograph on the page in reading order. Swipe, the arrow keys and the
      // on-screen arrows all move through that set; a tap outside the controls
      // still closes.
      let box: HTMLDivElement | null = null;
      let lastFocus: Element | null = null;
      let set: { src: string; alt: string }[] = [];
      let idx = 0;

      /**
       * aria-modal="true" promises assistive technology that everything behind
       * the overlay is inert, and until 5 Sep 2026 only the Tab key honoured
       * it: a screen reader browsing by virtual cursor still walked the header
       * and the page underneath. The enquiry modal and the material pop get
       * this free from native <dialog>.showModal(); this overlay is the one
       * that builds itself, so it says so explicitly. Everything in <body>
       * except the overlay goes inert while it is open.
       */
      function setBackgroundInert(on: boolean) {
        for (const el of Array.from(document.body.children)) {
          if (el === box) continue;
          if (on) (el as HTMLElement).inert = true;
          else (el as HTMLElement).inert = false;
        }
      }

      function closeBox() {
        if (!box) return;
        box.style.display = "none";
        setBackgroundInert(false);
        document.documentElement.style.overflow = "";
        if (lastFocus instanceof HTMLElement) lastFocus.focus();
      }

      const pad = (n: number) => String(n).padStart(2, "0");

      function showAt(next: number) {
        if (!box || !set.length) return;
        idx = (next + set.length) % set.length;
        const big = box.querySelector("img")!;
        const cap = box.querySelector("p")!;
        big.src = set[idx].src;
        big.alt = set[idx].alt;
        cap.textContent =
          set.length > 1 ? `${pad(idx + 1)} / ${pad(set.length)} · ${set[idx].alt}` : set[idx].alt;
        // The neighbours load while this one is looked at, so a swipe lands
        // on a picture rather than on a blank frame.
        if (set.length > 1) {
          new Image().src = set[(idx + 1) % set.length].src;
          new Image().src = set[(idx - 1 + set.length) % set.length].src;
        }
      }

      // The set a photograph belongs to: its carousel's files if it sits in
      // one; otherwise every plate photograph inside the nearest
      // [data-plate-set], or on the whole page if there is none.
      //
      // THE FULL FILE, NOT THE ONE THE GRID LOADED (7 Sep 2026). This read
      // el.currentSrc, which is whichever srcset candidate the browser chose
      // for the plate's own slot. Once the grids declared their real 320px
      // width that candidate became the 400px file, and the lightbox showed a
      // 400px picture in the middle of a 1500px screen. The src attribute is
      // the original at full size and is what an enlargement is for; the
      // variants exist so the grid does not pay for it until someone asks.
      function setFor(img: HTMLImageElement): { src: string; alt: string; el?: HTMLImageElement }[] {
        const car = img.closest<HTMLElement>("[data-carousel]");
        if (car && car.dataset.files) {
          const files: string[] = JSON.parse(car.dataset.files);
          const altBase = car.dataset.altBase || img.alt;
          return files.map((f, n) => ({ src: f, alt: `${altBase}, photograph ${n + 1}` }));
        }
        // Scoped, so the homepage's six do not count the hero as a seventh
        // and the counter reads 06 rather than 07.
        const scope = img.closest<HTMLElement>("[data-plate-set]") ?? document;
        return [...scope.querySelectorAll<HTMLImageElement>("img[data-plate-photo]")].map((el) => ({
          src: el.getAttribute("src") || el.src,
          alt: el.alt,
          el,
        }));
      }

      function openBox(img: HTMLImageElement) {
        if (!box) {
          box = document.createElement("div");
          box.setAttribute("role", "dialog");
          box.setAttribute("aria-modal", "true");
          box.setAttribute("aria-label", "Photograph, enlarged");
          // The scrim was .94 until 5 Sep 2026, which let the gallery grid and
          // its plate captions read straight through it: two blocks of similar
          // mono text, the page's and the lightbox's own, landing on top of
          // each other at 375 and again at 1440. Opaque now, with a blur for
          // the browsers that support one.
          box.style.cssText =
            "position:fixed;inset:0;z-index:200;display:none;place-items:center;" +
            "background:rgba(24,21,17,.985);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);" +
            "padding:clamp(16px,4vw,48px);cursor:zoom-out";
          const navBtn =
            "position:absolute;top:50%;transform:translateY(-50%);background:none;border:none;" +
            "color:rgba(242,238,227,.9);font-family:var(--font-mono);font-size:30px;line-height:1;" +
            "cursor:pointer;padding:16px";
          box.innerHTML =
            '<img style="max-width:100%;max-height:82vh;object-fit:contain;display:block;border:1px solid rgba(242,238,227,.25)" alt="">' +
            '<p style="margin-top:12px;font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(242,238,227,.75);text-align:center"></p>' +
            // 44px of hit area rather than the glyph's own 18 x 28: the close
            // control on a full-screen overlay is the one a phone reaches for.
            '<button type="button" aria-label="Close" style="position:absolute;top:8px;right:10px;background:none;border:none;color:rgba(242,238,227,.9);font-size:28px;line-height:1;cursor:pointer;padding:10px 14px;min-width:44px;min-height:44px">&times;</button>' +
            `<button type="button" data-box-prev aria-label="Previous photograph" style="${navBtn};left:6px">&larr;</button>` +
            `<button type="button" data-box-next aria-label="Next photograph" style="${navBtn};right:6px">&rarr;</button>`;
          box.addEventListener("click", closeBox);
          box.querySelector("[data-box-prev]")!.addEventListener("click", (e) => {
            e.stopPropagation();
            showAt(idx - 1);
          });
          box.querySelector("[data-box-next]")!.addEventListener("click", (e) => {
            e.stopPropagation();
            showAt(idx + 1);
          });
          document.addEventListener("keydown", (e) => {
            if (!box || box.style.display === "none") return;
            if (e.key === "Escape") closeBox();
            if (e.key === "ArrowLeft") showAt(idx - 1);
            if (e.key === "ArrowRight") showAt(idx + 1);
            // aria-modal promises the page behind is inert, so Tab must stay
            // inside: cycle through the dialog's own visible buttons.
            if (e.key === "Tab") {
              const btns = [...box.querySelectorAll<HTMLElement>("button")].filter(
                (b) => b.style.display !== "none"
              );
              if (!btns.length) return;
              e.preventDefault();
              const at = btns.indexOf(document.activeElement as HTMLElement);
              const next = e.shiftKey
                ? (at - 1 + btns.length) % btns.length
                : (at + 1) % btns.length;
              btns[next].focus();
            }
          });
          // The swipe. Horizontal beats vertical and 40px beats a tap; a tap
          // stays a tap and closes as before.
          let x0 = 0;
          let y0 = 0;
          box.addEventListener(
            "touchstart",
            (e) => {
              x0 = e.touches[0].clientX;
              y0 = e.touches[0].clientY;
            },
            { passive: true }
          );
          box.addEventListener(
            "touchend",
            (e) => {
              const dx = e.changedTouches[0].clientX - x0;
              const dy = e.changedTouches[0].clientY - y0;
              if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
              showAt(dx < 0 ? idx + 1 : idx - 1);
            },
            { passive: true }
          );
          document.body.appendChild(box);
        }
        set = setFor(img);
        // Found by identity where the set was built from elements, and by
        // filename for a carousel's file list.
        const seen = img.currentSrc || img.src;
        const found = set.findIndex((s) => s.el === img || seen.endsWith(s.src) || s.src.endsWith(seen));
        showAt(found >= 0 ? found : 0);
        const many = set.length > 1;
        box.querySelectorAll<HTMLElement>("[data-box-prev],[data-box-next]").forEach((b) => {
          b.style.display = many ? "" : "none";
        });
        box.style.display = "grid";
        document.documentElement.style.overflow = "hidden";
        lastFocus = document.activeElement;
        setBackgroundInert(true);
        (box.querySelector("button") as HTMLElement).focus();
      }

      document.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        const img = target?.closest?.("img[data-plate-photo]");
        if (!(img instanceof HTMLImageElement)) return;
        // A plate inside a link (the homepage work grid) keeps its navigation.
        if (img.closest("a")) return;
        e.preventDefault();
        openBox(img);
      });

      // The keyboard entry point: the plates are focusable buttons
      // (Plate.astro), so Enter and Space must do what a click does.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const img = document.activeElement;
        if (!(img instanceof HTMLImageElement) || !img.matches("[data-plate-photo]")) return;
        if (img.closest("a")) return;
        e.preventDefault();
        openBox(img);
      });
    </script>
  </body>
</html>
