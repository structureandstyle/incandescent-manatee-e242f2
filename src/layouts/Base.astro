---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL, BUSINESS, GA4_ID } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page, on top of the site-wide LocalBusiness. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute or root-relative share image. */
  image?: string;
  /**
   * Keep this page out of the index. Set by a page while the content
   * questionnaire has not answered everything that page depends on, so draft
   * copy can be built and reviewed on a branch deploy without any of it
   * reaching search. See `src/data/page-gates.ts`.
   *
   * Not defaulted from the gate here on purpose: the layout does not know the
   * page's path reliably enough to look it up, so each page passes it. A page
   * that forgets is indexable, which is right for a finished page and is caught
   * for an unfinished one by `npm run verify`.
   */
  noindex?: boolean;
}

const { title, description, schema, image = "/og-default.jpg", noindex = false } = Astro.props;

// Self-referencing canonical on every template. The old site had one canonical
// on one page and Google overrode it anyway, because the Business Profile was
// pointing somewhere else.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const fullTitle = title.includes(BUSINESS.name) ? title : `${title} | ${BUSINESS.name}`;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE_URL}/#business`,
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  url: SITE_URL,
  telephone: BUSINESS.phoneDisplay,
  email: BUSINESS.email,
  image: ogImage,
  priceRange: "££",
  areaServed: BUSINESS.areaServed.map((a) => ({ "@type": "Place", name: a })),
  openingHoursSpecification: BUSINESS.openingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: BUSINESS.ratingValue,
    reviewCount: BUSINESS.reviewCount,
  },
};

const graph = [localBusiness, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Stamp .js before first paint, so the motion CSS can hide what it is about
      to reveal. Without it, html:not(.js) in motion-actions.css keeps every
      animated element at its resting state, which is what a visitor with no
      JavaScript gets: the whole page, no motion. This must stay inline and
      stay here, above the stylesheet, or elements flash visible then hide.
    */}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /* Draft copy is never indexable. `noindex` is driven by the page's gate in
         src/data/page-gates.ts, and lifts on its own once the questions that page
         depends on are answered. nofollow as well, so the crawler does not walk
         from a draft page into the rest of the site and treat it as a live route. */
      noindex && <meta name="robots" content="noindex,nofollow" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Font preload stays commented until inter-variable.woff2 is actually in
      /public/fonts. Preloading a missing file 404s on every page load and buys
      nothing. Until then the system stack renders, which blocks nothing at all
      and is a large improvement on the old site's eight blocking font files.
      <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    */}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {
      GA4_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", GA4_ID);

            // Enhanced measurement catches the WhatsApp link, because wa.me is a
            // different host and counts as an outbound click. It does not catch
            // tel: or mailto:, which have no hostname. Those are two of the three
            // enquiry channels the agreement counts, so they fire from here.
            document.addEventListener("click", (e) => {
              const a = e.target.closest && e.target.closest("a[href]");
              if (!a) return;
              const href = a.getAttribute("href") || "";
              if (href.startsWith("tel:")) {
                gtag("event", "enquiry_call", { method: "phone", link_url: href });
              } else if (href.startsWith("mailto:")) {
                gtag("event", "enquiry_email", { method: "email", link_url: href });
              } else if (href.includes("wa.me")) {
                gtag("event", "enquiry_whatsapp", { method: "whatsapp", link_url: href });
              }
            });
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-bone"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // The reveal. One observer for the whole page, replacing the per-component
      // useEnter hook the design system ran in React. Adds .in once, then stops
      // watching: nothing here re-hides on the way out, because a section that
      // fades as you scroll back up reads as a bug rather than as motion.
      //
      // Elements already in view at load are revealed by the observer's first
      // synchronous callback, so above-the-fold content does not wait.
      const revealable = document.querySelectorAll("[data-motion], [data-glyph]");
      if (revealable.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -5% 0px" }
        );
        revealable.forEach((el) => io.observe(el));

        // Failsafe. If the observer never fires, every animated element stays
        // at opacity 0 or scaleX(0) and the copy is invisible. That is a worse
        // outcome than losing the motion, so after three seconds everything is
        // revealed regardless. Costs one timer and removes a whole class of
        // silent failure: an IntersectionObserver that does not fire is not
        // hypothetical, it is what happens in a browser pane that is not
        // compositing, which is where this was tested.
        setTimeout(() => {
          revealable.forEach((el) => el.classList.add("in"));
        }, 3000);
      }
    </script>

    <script>
      // The lightbox. Any Plate photograph opens full-screen on click, so the
      // work can be looked at properly rather than judged at grid size.
      // Progressive enhancement over the same <img>: no library, one overlay
      // built lazily on first use, closed by click, Escape or the button.
      // Without JavaScript the images are simply images, which is fine.
      let box: HTMLDivElement | null = null;
      let lastFocus: Element | null = null;

      function closeBox() {
        if (!box) return;
        box.style.display = "none";
        document.documentElement.style.overflow = "";
        if (lastFocus instanceof HTMLElement) lastFocus.focus();
      }

      function openBox(img: HTMLImageElement) {
        if (!box) {
          box = document.createElement("div");
          box.setAttribute("role", "dialog");
          box.setAttribute("aria-modal", "true");
          box.setAttribute("aria-label", "Photograph, enlarged");
          box.style.cssText =
            "position:fixed;inset:0;z-index:200;display:none;place-items:center;" +
            "background:rgba(24,21,17,.94);padding:clamp(16px,4vw,48px);cursor:zoom-out";
          box.innerHTML =
            '<img style="max-width:100%;max-height:82vh;object-fit:contain;display:block;border:1px solid rgba(242,238,227,.25)" alt="">' +
            '<p style="margin-top:12px;font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(242,238,227,.75);text-align:center"></p>' +
            '<button type="button" aria-label="Close" style="position:absolute;top:16px;right:20px;background:none;border:none;color:rgba(242,238,227,.9);font-size:28px;line-height:1;cursor:pointer">&times;</button>';
          box.addEventListener("click", closeBox);
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeBox();
          });
          document.body.appendChild(box);
        }
        const big = box.querySelector("img")!;
        const cap = box.querySelector("p")!;
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        cap.textContent = img.alt;
        box.style.display = "grid";
        document.documentElement.style.overflow = "hidden";
        lastFocus = document.activeElement;
        (box.querySelector("button") as HTMLElement).focus();
      }

      document.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        const img = target?.closest?.("img[data-plate-photo]");
        if (!(img instanceof HTMLImageElement)) return;
        // A plate inside a link (the homepage work grid) keeps its navigation.
        if (img.closest("a")) return;
        e.preventDefault();
        openBox(img);
      });
    </script>
  </body>
</html>
