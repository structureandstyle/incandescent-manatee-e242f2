---
/**
 * The contact page. Ported to the design system 2 Sep 2026: it was the last
 * page still wearing the scaffold's Tailwind markup, a bold sans heading and a
 * rounded card beside every other page's serif and hairlines.
 *
 * THE FORM FIRST, ACROSS THE PAGE, 14 Nov 2026 (a founder relaying Arthur,
 * with the picture-card form that replaced the old one that day):
 *   1. The heading and the Google rating line only. The two review quotes
 *      that sat beside the form since 29 Oct 2026 are gone; the stars stay.
 *   2. The form, across the whole width in a frame up to 1360px wide, so the
 *      service and area cards sit side by side and show at once. A row
 *      scrolls only when it cannot fit (enquiry-cards.css, the wide rules
 *      under @container ecf).
 *   3. Under it, for anyone who would rather talk: phone, WhatsApp, email,
 *      opening hours and the areas, with Kaspar's paragraph on what happens
 *      next, moved down from the top of the page.
 *
 * Copy corrected on the way in, 2 Sep 2026. The old lede promised "a
 * realistic range before anyone visits", which no questionnaire answer
 * supports: the process is a reply, a visit, and a fixed itemised quotation
 * (Q13, Q17, Q20). The form comes first because it is the one enquiry channel
 * that attributes itself end to end, and because dimensions and photographs
 * genuinely make the first answer better. Never framed as call deflection,
 * and since 6 Sep 2026 not framed at all: the line under the phone number
 * that made the case for the form came off on Kaspar's instruction. It was
 * the one sentence on this page that argued with the reader about which
 * channel to use. The number stands on its own, like the other four entries.
 *
 * Hours render from BUSINESS.openingHours, which mirrors the Business Profile
 * (Mon to Fri 08:00 to 18:00, Sat 09:00 to 14:00), so the two cannot drift.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import FormProof from "../components/FormProof.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import AreaList from "../components/AreaList.astro";
import { BUSINESS, hoursLines } from "../data/site";
import { indexable } from "../data/page-gates";

const hours = hoursLines();

const mailto = `mailto:${BUSINESS.email}?subject=${encodeURIComponent("Enquiry via structureandstyle.co.uk")}`;
---

<Base
  title="Get a quote"
  description="Tell us what you have in mind, with a few photos and rough dimensions, and Structure & Style will come back to you with a survey and a quotation."
  noindex={!indexable("/contact/")}
>
  <Wrap style="max-width:1360px;padding-top:var(--space-15);padding-bottom:var(--section-y)">
    <div class="contact-head">
      <Display level={1} as="h1" style="margin:0">Get a quote</Display>
      <FormProof />
    </div>

    <div class="contact-form">
      <EnquiryForm />
    </div>

    <section class="contact-direct" aria-labelledby="contact-direct-title">
      <MonoLabel as="p" style="margin-bottom:var(--space-4)">Contact details</MonoLabel>
      <h2 id="contact-direct-title" class="contact-direct-title">Or talk to us directly</h2>
      {/* His paragraph, 6 September 2026, the last message of his review. It
          asks for more than ours did (several photos, dimensions, inspiration
          images) and calls the visit a survey, which is what it is. */}
      <p class="contact-direct-lede">
        Tell us what you have in mind and send a few photos, rough dimensions and any inspiration
        images you have. We'll come back to you with anything else we need, then arrange a survey
        before providing a detailed quotation.
      </p>
      <dl class="contact-details">
        <div>
          <dt><MonoLabel as="span">Phone</MonoLabel></dt>
          <dd><Link href={BUSINESS.phoneHref} variant="nav" chamfer>Call {BUSINESS.phoneDisplay}</Link></dd>
        </div>
        <div>
          <dt><MonoLabel as="span">WhatsApp</MonoLabel></dt>
          <dd><Link href={BUSINESS.whatsapp} variant="nav" chamfer target="_blank" rel="noopener">Message us</Link></dd>
        </div>
        <div>
          <dt><MonoLabel as="span">Email</MonoLabel></dt>
          <dd><Link href={mailto} variant="inline" chamfer>{BUSINESS.email}</Link></dd>
        </div>
        <div>
          <dt><MonoLabel as="span">Hours</MonoLabel></dt>
          {hours.map((h) => <dd class="contact-quiet">{h}</dd>)}
        </div>
        <div>
          <dt><MonoLabel as="span">Where we work</MonoLabel></dt>
          <dd class="contact-quiet">Across north London, including <AreaList />.</dd>
        </div>
      </dl>
    </section>
  </Wrap>
</Base>

<style>
  .contact-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6) var(--space-12);
    margin-bottom: var(--space-10);
  }
  .contact-form {
    border: var(--rule-structure);
    padding: clamp(20px, 2.6vw, 32px);
    background: var(--paper);
  }

  .contact-direct {
    margin-top: var(--section-y);
    border-top: var(--rule-structure);
    padding-top: var(--space-12);
  }
  .contact-direct-title {
    font-family: var(--font-serif-display);
    font-weight: var(--weight-regular);
    font-size: var(--type-display-5);
    margin: 0 0 var(--space-6);
  }
  .contact-direct-lede {
    max-width: var(--measure);
    font-size: var(--type-body);
    color: var(--text-quiet);
    margin: 0 0 var(--space-12);
  }
  /* Five across on a laptop, two then one as the screen narrows, each under
     a hairline. */
  .contact-details {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--space-10) var(--space-12);
  }
  .contact-details > div {
    border-top: var(--rule-hair);
    padding-top: var(--space-6);
  }
  .contact-details dd {
    margin: var(--space-4) 0 0;
  }
  .contact-quiet {
    color: var(--text-quiet);
  }
</style>
