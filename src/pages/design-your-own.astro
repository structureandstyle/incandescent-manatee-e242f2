---
/**
 * DESIGN YOUR OWN, 19 Nov 2026 (a founder, in chat: a page where people build
 * their own wardrobe or alcove units in 3D, see the price and send it). It
 * takes the place of the Christmas bundle page, which was never live: the
 * builder stays, the offer is gone.
 *
 * What a visitor does: types rough sizes, says how the run meets the walls,
 * picks a finish, doors, handles and an inside, and watches the picture and
 * the guide price follow. Then adds it to a project, or sends it.
 *
 * THE PRICE IS THE COST GUIDE'S. It is read from the cost guide's own tables
 * (src/data/builder.ts), shown as "from", and called a guide. A design he has
 * not published a figure for (a run past 2.4m, one alcove, an alcove past
 * about 1m) shows no figure and says why. Extras never move the figure: they
 * are listed as priced in the quotation. tests/builder-model.test.mjs holds
 * all of that.
 *
 * NO FORM OF ITS OWN. One form per page (site PR #41): sending opens the
 * site's Get a quote pop-up with the services ticked and the job box filled
 * with the design in words and a link back to it (src/scripts/builder/ui.mjs).
 * Field names, the Worker and Make are untouched.
 *
 * WITHOUT 3D. The flat drawing below is in the page's own HTML, so the design
 * shows before any script has run. The 3D view and its library load only once
 * the builder is on screen, and where 3D cannot run the drawing stays.
 *
 * THE WORDS are the copy agent's (src/data/design-your-own-copy.ts), written
 * against protocol v1.4. Do not rewrite them here.
 *
 * NOT IN THE INDEX until a founder approves the launch
 * (src/data/design-your-own-gate.ts). No schema of its own: the build check
 * allows Service markup on the service pages only.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import Faq from "../components/ds/Faq.astro";
import FormProof from "../components/FormProof.astro";
import { COPY } from "../data/design-your-own-copy";
import { PRICES, UNIT_SERVICE, OTHER_SERVICES } from "../data/builder";
import { DESIGN_YOUR_OWN_LIVE } from "../data/design-your-own-gate";
import { BUSINESS } from "../data/site";
import {
  COLOURS,
  DEFAULTS,
  DOORS,
  EXTRAS,
  FITS,
  HANDLES,
  INSIDES,
  LIMITS,
  describe,
  guidePrice,
  money,
  quotedItems,
  specLines,
  title,
} from "../scripts/builder/model.mjs";
import { elevationSvg } from "../scripts/builder/elevation.mjs";

/* The design the page opens on, drawn and priced at build time so it is there
   before any script runs. The script then takes over from the same rules. */
const first = describe(DEFAULTS.wardrobe);
const firstAlcove = describe(DEFAULTS.alcove);
const firstPrice = guidePrice(first, PRICES);
const firstWords = specLines(first, PRICES.finishes);
const firstQuoted = quotedItems(first);
const figure = (from: number | null) => (from ? `${COPY.price.from} ${money(from)}` : COPY.price.quoted);

const config = {
  prices: { wardrobe: PRICES.wardrobe, alcovePair: PRICES.alcovePair },
  finishes: PRICES.finishes,
  labels: UNIT_SERVICE,
  others: OTHER_SERVICES,
  copy: {
    section: COPY.steps.inside.section,
    from: COPY.price.from,
    quoted: COPY.price.quoted,
    quotedWide: COPY.price.quotedWide,
    quotedOneAlcove: COPY.price.quotedOneAlcove,
    quotedWideAlcove: COPY.price.quotedWideAlcove,
    includesWardrobe: COPY.price.includesWardrobe,
    includesAlcove: COPY.price.includesAlcove,
    extras: COPY.price.extras,
    leftWidth: COPY.fields.leftWidth,
    oneWidth: COPY.fields.oneWidth,
    outOfRange: COPY.fields.outOfRange,
    drag: COPY.view.drag,
    loading: COPY.view.loading,
    unavailable: COPY.view.unavailable,
    add: COPY.actions.add,
    added: COPY.actions.added,
    update: COPY.actions.update,
    copied: COPY.actions.copied,
    edit: COPY.project.edit,
    remove: COPY.project.remove,
  },
};
/* "<" escaped so nothing in the data can close the script element. */
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");

const W = LIMITS.wardrobe;
const A = LIMITS.alcove;
const wardrobeNumbers = [
  { name: "w", label: COPY.fields.width, value: first.w, range: W.w, step: 10 },
  { name: "h", label: COPY.fields.height, value: first.h, range: W.h, step: 10 },
  { name: "d", label: COPY.fields.depth, value: first.d, range: W.d, step: 10 },
];
---

<Base title={COPY.meta.title} description={COPY.meta.description} noindex={!DESIGN_YOUR_OWN_LIVE}>
  <Wrap style="padding-top:var(--space-15)">
    <header class="dyo-hero">
      <MonoLabel as="p" tone="green">{COPY.hero.kicker}</MonoLabel>
      <Display level={2} as="h1" style="margin:var(--space-6) 0 0;max-width:20ch">{COPY.hero.h1}</Display>
      <p class="dyo-lede">{COPY.hero.lede}</p>
      <div class="dyo-hero-actions">
        <Link href="#design" variant="button">{COPY.hero.start}</Link>
        <Link href={BUSINESS.whatsapp} variant="cta" chamfer target="_blank" rel="noopener">{COPY.hero.whatsapp}</Link>
      </div>
      <FormProof />
    </header>
  </Wrap>

  <section id="design" class="dyo" data-dyo aria-label={COPY.hero.kicker}>
    <script type="application/json" data-dyo-config set:html={configJson} />
    <Wrap style="max-width:1360px">
      <noscript><p class="dyo-noscript">{COPY.fallback.noscript}</p></noscript>
      <div class="dyo-grid">
        <div class="dyo-stage">
          <div class="dyo-frame">
            <div class="dyo-picture" data-dyo-picture role="img" aria-label={`${title(first, PRICES.finishes)}. ${firstWords.join(" ")}`}>
              <div class="dyo-drawing" data-dyo-drawing set:html={elevationSvg(first)} />
              <canvas class="dyo-canvas" data-dyo-canvas hidden aria-hidden="true"></canvas>
            </div>
            <p class="dyo-chip">
              <span class="dyo-chip-label">{COPY.price.label}</span>
              <span class="dyo-chip-figure" data-dyo-figure>{figure(firstPrice.from)}</span>
            </p>
            <p class="dyo-status" data-dyo-status role="status" hidden></p>
          </div>
          <div class="dyo-tools">
            <div class="dyo-seg" role="group" aria-label={`${COPY.view.threeD} / ${COPY.view.drawing}`}>
              <button type="button" data-dyo-mode="3d" aria-pressed="false">{COPY.view.threeD}</button>
              <button type="button" data-dyo-mode="drawing" aria-pressed="true">{COPY.view.drawing}</button>
            </div>
            <div class="dyo-seg" role="group" aria-label={`${COPY.view.doorsClosed} / ${COPY.view.doorsOpen}`}>
              <button type="button" data-dyo-doors="closed" aria-pressed="true">{COPY.view.doorsClosed}</button>
              <button type="button" data-dyo-doors="open" aria-pressed="false">{COPY.view.doorsOpen}</button>
            </div>
            <div class="dyo-seg" data-dyo-3d-only hidden>
              <button type="button" data-dyo-look="front">{COPY.view.front}</button>
              <button type="button" data-dyo-look="angle">{COPY.view.angle}</button>
            </div>
            <div class="dyo-seg" data-dyo-3d-only hidden>
              <button type="button" data-dyo-zoom="-1" aria-label={COPY.view.zoomOut}><span aria-hidden="true">&minus;</span></button>
              <button type="button" data-dyo-zoom="1" aria-label={COPY.view.zoomIn}><span aria-hidden="true">+</span></button>
            </div>
            <label class="dyo-tick dyo-tick-inline" data-dyo-3d-only hidden>
              <input type="checkbox" data-dyo-person checked />
              <span>{COPY.view.person}</span>
            </label>
          </div>
          <p class="dyo-note">{COPY.view.note}</p>
        </div>

        <form class="dyo-controls" data-dyo-form novalidate>
          <fieldset class="dyo-step">
            <legend>{COPY.units.heading}</legend>
            <div class="dyo-units">
              <label class="dyo-card">
                <input type="radio" name="dyo-unit" value="wardrobe" checked />
                <span class="dyo-card-box">
                  <span class="dyo-card-title">{COPY.units.wardrobe}</span>
                  <span class="dyo-card-hint">{COPY.units.wardrobeHint}</span>
                </span>
              </label>
              <label class="dyo-card">
                <input type="radio" name="dyo-unit" value="alcove" />
                <span class="dyo-card-box">
                  <span class="dyo-card-title">{COPY.units.alcove}</span>
                  <span class="dyo-card-hint">{COPY.units.alcoveHint}</span>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset class="dyo-step" data-dyo-for="wardrobe">
            <legend>{COPY.steps.size.title}</legend>
            <p class="dyo-help">{COPY.steps.size.help}</p>
            <div class="dyo-numbers">
              {wardrobeNumbers.map((f) => (
                <label class="dyo-number">
                  <span>{f.label}</span>
                  <span class="dyo-number-box">
                    <input type="number" name={f.name} value={f.value} min={f.range[0]} max={f.range[1]} step={f.step} inputmode="numeric" />
                    <span aria-hidden="true">{COPY.fields.unitMm}</span>
                  </span>
                </label>
              ))}
            </div>
            {wardrobeNumbers.map((f) => <p class="dyo-range" data-dyo-range={f.name} role="alert" hidden></p>)}
          </fieldset>

          <fieldset class="dyo-step" data-dyo-for="wardrobe">
            <legend>{COPY.steps.walls.title}</legend>
            <p class="dyo-help">{COPY.steps.walls.help}</p>
            <div class="dyo-chips">
              {FITS.map((x) => (
                <label class="dyo-chipbox">
                  <input type="radio" name="dyo-fit" value={x.id} checked={x.id === first.fit} />
                  <span>{x.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dyo-step" data-dyo-for="alcove" hidden>
            <legend>{COPY.steps.alcoveSize.title}</legend>
            <p class="dyo-help">{COPY.steps.alcoveSize.help}</p>
            <div class="dyo-chips">
              <label class="dyo-chipbox">
                <input type="radio" name="dyo-count" value="2" checked />
                <span>{COPY.fields.alcovePair}</span>
              </label>
              <label class="dyo-chipbox">
                <input type="radio" name="dyo-count" value="1" />
                <span>{COPY.fields.alcoveOne}</span>
              </label>
            </div>
            <div class="dyo-numbers">
              <label class="dyo-number">
                <span data-dyo-left-label>{COPY.fields.leftWidth}</span>
                <span class="dyo-number-box">
                  <input type="number" name="wl" value={firstAlcove.wl} min={A.w[0]} max={A.w[1]} step="10" inputmode="numeric" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
              <label class="dyo-number" data-dyo-right-alcove>
                <span>{COPY.fields.rightWidth}</span>
                <span class="dyo-number-box">
                  <input type="number" name="wr" value={firstAlcove.wr} min={A.w[0]} max={A.w[1]} step="10" inputmode="numeric" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
              <label class="dyo-number">
                <span>{COPY.fields.alcoveDepth}</span>
                <span class="dyo-number-box">
                  <input type="number" name="ad" value={firstAlcove.d} min={A.d[0]} max={A.d[1]} step="10" inputmode="numeric" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
              <label class="dyo-number">
                <span>{COPY.fields.ceiling}</span>
                <span class="dyo-number-box">
                  <input type="number" name="ah" value={firstAlcove.h} min={A.h[0]} max={A.h[1]} step="10" inputmode="numeric" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
              <label class="dyo-number">
                <span>{COPY.fields.breast}</span>
                <span class="dyo-number-box">
                  <input type="number" name="breast" value={firstAlcove.breast} min={A.breast[0]} max={A.breast[1]} step="10" inputmode="numeric" aria-describedby="dyo-breast-help" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
            </div>
            <p class="dyo-help dyo-help-after" id="dyo-breast-help">{COPY.fields.breast}: {COPY.fields.breastHelp}</p>
            {["wl", "wr", "ad", "ah", "breast"].map((name) => <p class="dyo-range" data-dyo-range={name} role="alert" hidden></p>)}
          </fieldset>

          <fieldset class="dyo-step" data-dyo-for="alcove" hidden>
            <legend>{COPY.steps.alcoveUnit.title}</legend>
            <p class="dyo-help">{COPY.steps.alcoveUnit.help}</p>
            <div class="dyo-numbers">
              <label class="dyo-number">
                <span>{COPY.fields.baseHeight}</span>
                <span class="dyo-number-box">
                  <input type="number" name="base" value={firstAlcove.base} min={A.base[0]} max={A.base[1]} step="10" inputmode="numeric" />
                  <span aria-hidden="true">{COPY.fields.unitMm}</span>
                </span>
              </label>
              <label class="dyo-number">
                <span>{COPY.fields.shelves}</span>
                <span class="dyo-number-box">
                  <input type="number" name="shelves" value={firstAlcove.shelves} min={A.shelves[0]} max={A.shelves[1]} step="1" inputmode="numeric" />
                </span>
              </label>
            </div>
            {["base", "shelves"].map((name) => <p class="dyo-range" data-dyo-range={name} role="alert" hidden></p>)}
          </fieldset>

          <fieldset class="dyo-step">
            <legend>{COPY.steps.finish.title}</legend>
            <p class="dyo-help">{COPY.steps.finish.help}</p>
            <div class="dyo-rows">
              {PRICES.finishes.map((name, f) => (
                <label class="dyo-row">
                  <input type="radio" name="dyo-finish" value={f} checked={f === first.finish} />
                  <span class="dyo-row-box">
                    <span class="dyo-row-name">{name}</span>
                    <span class="dyo-row-price" data-dyo-finish-price={f}>{figure(guidePrice({ ...first, finish: f }, PRICES).from)}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dyo-step">
            <legend>{COPY.steps.colour.title}: <span class="dyo-legend-value" data-dyo-colour-name>{COLOURS[first.finish][first.colour].name}</span></legend>
            <p class="dyo-help">{COPY.steps.colour.help}</p>
            {COLOURS.map((set, f) => (
              <div class="dyo-swatches" data-dyo-colours={f} hidden={f !== first.finish}>
                {set.map((c, i) => (
                  <label class="dyo-swatch">
                    <input type="radio" name={`dyo-colour-${f}`} value={i} checked={i === 0} />
                    <span class:list={["dyo-swatch-box", c.grain && "is-grain"]} style={`background-color:${c.hex}`}></span>
                    <span class="dyo-sr">{c.name}</span>
                  </label>
                ))}
              </div>
            ))}
          </fieldset>

          <fieldset class="dyo-step">
            <legend>{COPY.steps.doors.title}</legend>
            {COPY.steps.doors.help && <p class="dyo-help">{COPY.steps.doors.help}</p>}
            <div class="dyo-chips">
              {DOORS.map((x) => (
                <label class="dyo-chipbox">
                  <input type="radio" name="dyo-door" value={x.id} checked={x.id === first.door} />
                  <span>{x.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dyo-step">
            <legend>{COPY.steps.handles.title}</legend>
            {COPY.steps.handles.help && <p class="dyo-help">{COPY.steps.handles.help}</p>}
            <div class="dyo-chips">
              {HANDLES.map((x) => (
                <label class="dyo-chipbox">
                  <input type="radio" name="dyo-handle" value={x.id} checked={x.id === first.handle} />
                  <span>{x.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dyo-step" data-dyo-for="wardrobe">
            <legend>{COPY.steps.inside.title}</legend>
            <p class="dyo-help">{COPY.steps.inside.help}</p>
            <div class="dyo-selects" data-dyo-inside>
              {first.sections.map((doors, i) => (
                <label class="dyo-select">
                  <span>{COPY.steps.inside.section} {i + 1}</span>
                  <select aria-label={`${COPY.steps.inside.section} ${i + 1}, ${doors === 2 ? "two doors" : "one door"}`}>
                    {INSIDES.map((x) => <option value={x.id} selected={x.id === first.inside[i]}>{x.label}</option>)}
                  </select>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dyo-step">
            <legend>{COPY.steps.extras.title}</legend>
            <p class="dyo-help">{COPY.steps.extras.help}</p>
            <div class="dyo-ticks" data-dyo-for="wardrobe">
              {EXTRAS.wardrobe.map((x) => (
                <label class="dyo-tick">
                  <input type="checkbox" name="dyo-extra-wardrobe" value={x.id} checked={first.extras.includes(x.id)} />
                  <span>{x.label}</span>
                </label>
              ))}
            </div>
            <div class="dyo-ticks" data-dyo-for="alcove" hidden>
              {EXTRAS.alcove.map((x) => (
                <label class="dyo-tick">
                  <input type="checkbox" name="dyo-extra-alcove" value={x.id} checked={firstAlcove.extras.includes(x.id)} />
                  <span>{x.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="dyo-price">
            <p class="dyo-price-label">{COPY.price.label}</p>
            <p class="dyo-price-figure" data-dyo-figure aria-live="polite">{figure(firstPrice.from)}</p>
            <p class="dyo-price-note" data-dyo-price-note>{COPY.price.includesWardrobe}</p>
            <p class="dyo-price-note" data-dyo-extras-note hidden={!firstQuoted.length}>{firstQuoted.length ? COPY.price.extras.replace("{items}", firstQuoted.join(", ")) : ""}</p>
            <p class="dyo-price-guide">{COPY.price.guide}</p>
            <ul class="dyo-words" data-dyo-words>
              {firstWords.map((line) => <li>{line}</li>)}
            </ul>
            <div class="dyo-actions">
              <button type="button" class="dyo-button" data-dyo-add>{COPY.actions.add}</button>
              <button type="button" class="dyo-button is-quiet" data-dyo-send>{COPY.actions.send}</button>
              <button type="button" class="dyo-text-button" data-dyo-copy>{COPY.actions.copyLink}</button>
            </div>
            <p class="dyo-toast" data-dyo-toast role="status" hidden></p>
          </div>
        </form>
      </div>
    </Wrap>

    <Wrap style="max-width:1360px">
      <section class="dyo-project" aria-labelledby="dyo-project-title">
        <div class="dyo-project-main">
          <h2 id="dyo-project-title" class="dyo-h2">{COPY.project.heading} <span class="dyo-count" data-dyo-count hidden></span></h2>
          <p class="dyo-help" data-dyo-project-empty>{COPY.project.empty}</p>
          <ul class="dyo-items" data-dyo-project></ul>
          <p class="dyo-total" data-dyo-total hidden>
            <span>{COPY.project.total}</span>
            <span class="dyo-total-figure" data-dyo-total-figure></span>
          </p>
          <p class="dyo-help" data-dyo-total-note hidden>{COPY.project.totalNote}</p>
        </div>
        <div class="dyo-project-side">
          <fieldset class="dyo-step dyo-step-plain">
            <legend>{COPY.project.othersHeading}</legend>
            <p class="dyo-help">{COPY.project.othersHelp}</p>
            <div class="dyo-ticks">
              {OTHER_SERVICES.map((o) => (
                <label class="dyo-tick">
                  <input type="checkbox" name="dyo-other" value={o.value} />
                  <span>{o.label}{o.from && <span class="dyo-tick-from">, {o.from}</span>}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <button type="button" class="dyo-button" data-dyo-send-project disabled>{COPY.project.send}</button>
          <p class="dyo-help">{COPY.project.sendHelp}</p>
        </div>
      </section>
    </Wrap>
  </section>

  <Wrap style="padding-bottom:var(--section-y)">
    <section class="dyo-block dyo-limits" aria-labelledby="dyo-limits-title">
      <h2 id="dyo-limits-title" class="dyo-h2">{COPY.limits.heading}</h2>
      <p class="dyo-body">{COPY.limits.body}</p>
      <Link href={BUSINESS.whatsapp} variant="cta" chamfer target="_blank" rel="noopener">{COPY.limits.cta}</Link>
    </section>

    <section class="dyo-block" aria-labelledby="dyo-how-title">
      <h2 id="dyo-how-title" class="dyo-h2">{COPY.how.heading}</h2>
      <ol class="dyo-how">
        {COPY.how.steps.map((step, i) => (
          <li>
            <MonoLabel as="span" tone="green">{String(i + 1).padStart(2, "0")}</MonoLabel>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="dyo-block" aria-labelledby="dyo-faq-title">
      <h2 id="dyo-faq-title" class="dyo-h2">{COPY.faq.heading}</h2>
      <div class="dyo-faqs">
        {COPY.faq.items.map((item) => <Faq q={item.q}>{item.a}</Faq>)}
      </div>
    </section>
  </Wrap>
</Base>

<script>
  import { initBuilder } from "../scripts/builder/ui.mjs";
  initBuilder(document.querySelector("[data-dyo]"));
</script>

{/* Global, because the script builds some of this markup (the section
    choosers, the project list, the drawing) and scoped styles would miss it.
    Every rule is under .dyo or a dyo- class, so nothing else on the site is
    touched. */}
<style is:global>
  .dyo-hero { padding-bottom: var(--space-15); }
  .dyo-lede {
    max-width: var(--measure-tight);
    margin: var(--space-9) 0 0;
    font-size: var(--type-lede);
    line-height: var(--lh-body);
    color: var(--text-quiet);
  }
  .dyo-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-13);
    margin: var(--space-12) 0 var(--space-10);
  }

  .dyo { scroll-margin-top: var(--dyo-top, 84px); border-top: var(--rule-structure); padding: var(--space-13) 0 var(--section-y); }
  .dyo [hidden] { display: none !important; }
  .dyo-noscript { margin: 0 0 var(--space-10); padding: var(--space-8) var(--space-10); border: var(--rule-structure); }
  .dyo-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .dyo-grid { display: grid; gap: var(--space-12); }
  @media (min-width: 940px) {
    .dyo-grid { grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr); gap: var(--space-17); align-items: start; }
  }

  /* The picture stays in view while the choices scroll past it. On a phone
     only the picture sticks: its buttons scroll away, so the choices keep
