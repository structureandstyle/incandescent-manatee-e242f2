---
/**
 * The maker page.
 *
 * This page is entirely Q50 to Q56 and holds almost nothing today, which is
 * correct. The design's version was written around a workshop and a bench that
 * Q3 establishes do not exist, so there was nothing here worth keeping except
 * the layout.
 *
 * Two constraints govern what may ever go on it:
 *
 * Q56 asks whether he is happy to be photographed. No portrait appears until
 * that comes back yes. The design carried a portrait plate captioned "Portrait
 * to follow", which is a reasonable placeholder but presumes the answer.
 *
 * Section 10 of the tone protocol is an absolute factual limit: one person, no
 * crew nouns. Q6 records that he works alone and brings in a plumber,
 * electrician and plasterer as a job needs them. That is worth saying plainly
 * because clients read it as accountability, but it stays off the page until Q6
 * comes back confirmed rather than provisional.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Value from "../components/Value.astro";

import { BAND, CONTACT } from "../data/site-content";
import { indexable } from "../data/page-gates";
import { answered } from "../data/answers";

const isIndexable = indexable("/maker/");
const portraitCleared = answered("q56");
---

<Base
  title="The maker"
  description="Who makes the work, where he trained, and how long he has been doing it."
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Maker</Kicker>
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      One pair of hands
    </Display>
    <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
      Every commission is measured, drawn and fitted by the same person. Trades come in when a job
      needs them, and they are coordinated rather than subcontracted out of sight.
    </p>
    <p style="max-width:var(--measure);margin-top:var(--space-10);color:var(--text-quiet)">
      How he works, confirmed: <Value q="q06" />
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <div style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--gap-xl);align-items:start">
      <Plate
        subject="Portrait"
        detail={portraitCleared ? "To place" : "Not yet cleared"}
        awaiting={
          portraitCleared
            ? "Portrait to place"
            : "No portrait until Q56 confirms he is happy to be photographed"
        }
        ratio="4 / 5"
      />

      <div>
        <SectionHead meta="In his own words" level={4}>How this started</SectionHead>
        <p style="max-width:var(--measure)"><Value q="q50" /></p>

        <div style="margin-top:var(--space-16)">
          <SectionHead meta="Training" level={4}>Where he learned it</SectionHead>
          <p style="max-width:var(--measure)"><Value q="q51" /></p>
        </div>

        <div style="margin-top:var(--space-16)">
          <SectionHead meta="Before this" level={4}>What came first</SectionHead>
          <p style="max-width:var(--measure)"><Value q="q52" /></p>
        </div>

        <div style="margin-top:var(--space-16)">
          <SectionHead meta="The choice" level={4}>Why fitted furniture</SectionHead>
          <p style="max-width:var(--measure)"><Value q="q53" /></p>
        </div>

        <div style="margin-top:var(--space-16)">
          <SectionHead meta="Where the work happens" level={4}>Based in</SectionHead>
          <p style="max-width:var(--measure)"><Value q="q03" /></p>
        </div>
      </div>
    </div>
  </Wrap>

  <EnquireBand heading="If you have a room in mind, start here." email={CONTACT.email} chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>
