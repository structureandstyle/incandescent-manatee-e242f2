import AreaPage from "../../components/AreaPage.astro";
import Wrap from "../../components/ds/Wrap.astro";
import SectionHead from "../../components/ds/SectionHead.astro";
import Faq from "../../components/ds/Faq.astro";
import Link from "../../components/ds/Link.astro";
import AreaSide from "../../components/AreaSide.astro";
import PriceCards from "../../components/PriceCards.astro";
import Ask from "../../components/Ask.astro";

import { AREAS } from "../../data/areas";

const area = AREAS.find((a) => a.slug === "areas/maida-vale")!;

const PRICES = [
  {
    art: "fitted-wardrobes",
    name: "Fitted wardrobes",
    href: "/fitted-wardrobes/",
    price: "From £2,300 for a 2-door run up to 1.2m in melamine, and from £4,000 at 4 doors.",
    moves: "Width, finish, internal drawers, integrated lighting and more complex designs move the figure.",
  },
  {
    art: "alcove-units",
    name: "Alcove units",
    href: "/alcove-units/",
    price: "From £3,300 for a pair in melamine, and from £6,000 in oak veneer.",
    moves: "Finish, shelving detail, drawers and lighting move the figure. It assumes base cupboards with shelving over, up to about 1m per alcove.",
  },
];
const P2 = "margin-top:var(--space-10)";
const TEXT = "max-width:var(--measure)";
const SECTION = "padding-bottom:var(--section-y)";
const EXT = { target: "_blank", rel: "noopener" };
---

<AreaPage area={area}>
  <Fragment slot="lede">
    <p>
      We design and install <Link href="/fitted-wardrobes/">fitted wardrobes</Link>, <Link href="/alcove-units/">alcove units</Link> and built-in shelving for homes in Maida Vale, including Little Venice and around Elgin Avenue. In stucco houses and mansion flats, we can fit storage into the alcoves beside a chimney breast or around your bed.
    </p>
  </Fragment>

  <Wrap style={SECTION}>
    <SectionHead meta="Stucco houses" level={4}>Fitted wardrobes for stucco houses in Little Venice</SectionHead>
    <AreaSide drawing="canal-villas">
      <p>
        Little Venice and the streets around Warwick Avenue have white stucco villas and terraces. If your bedroom has a cornice, we can run the wardrobe to the ceiling under a matching cornice, or stop it just below the original. Doors painted in the wall colour help the wardrobe blend in, while a contrasting colour or timber finish makes it stand out.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Shelving" level={4}>Built-in shelving and alcove units for living rooms in Maida Vale</SectionHead>
    <AreaSide drawing="stucco-crescent">
      <p>
        Warrington Crescent and Formosa Street are lined with tall stucco houses. If your living room has alcoves beside the chimney breast, we can fit <Link href="/journal/alcove-units-guide/">floating shelves or framed shelving</Link> above low cupboards. Shelf openings of around 250 to 350 mm suit books, and larger display pieces need 350 to 450 mm or more.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Mansion flats" level={4}>Fitted wardrobes around the bed in Maida Vale's mansion flats</SectionHead>
    <AreaSide drawing="bed-recess-wardrobes">
      <p>
        Around Elgin Avenue, many homes are flats in mansion blocks. We can fit a <Link href="/fitted-wardrobes/">wardrobe</Link> either side of the bed, with bedside shelves or drawers set into each. You can choose Shaker doors or flat handleless doors to suit how the flat is furnished.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Listed homes" level={4}>Fitted wardrobes and shelving in listed Maida Vale homes</SectionHead>
    <div style={TEXT}>
      <p>
        If you live around Warwick Avenue or Clifton Gardens, check whether your home is listed on <Link href="https://www.westminster.gov.uk/planning-building-control-and-environmental-regulations-menu/design-and-heritage/listed-buildings" {...EXT}>Westminster City Council's listed buildings page</Link>. If it is, ask the council before work starts whether your wardrobes or shelving need listed building consent. That matters most if original skirting or panelling would be removed or altered.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Access" level={4}>Parking, lifts and building access for fitting in Maida Vale</SectionHead>
    <div style={TEXT}>
      <p>
        Before fitting day, we'll agree with you where to unload and where our van can park. If the van needs a <Link href="https://www.westminster.gov.uk/parking/trade-parking-businesses/apply-trade-parking-permit" {...EXT}>Westminster trade parking permit</Link>, we'll confirm with you which of us applies.
      </p>
      <p style={P2}>
        In a mansion block, we'll ask you about the lift and any rules on deliveries or working hours. Where there's a managing agent, we can coordinate with them and send our insurance and safety documents before we start. For narrow hallways and stairs, we can bring larger pieces in sections and assemble them in your flat.
      </p>
      <p style={P2}>
        We normally work 8am to 5pm on weekdays, adjusted to suit you or your building. Before any materials come in, we protect the floors and stairs along the route into your home.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Guide prices" level={4}>What a fitted wardrobe or alcove unit costs in Maida Vale</SectionHead>
    <AreaSide>
      <p>Every figure here is a starting price, and a larger or more detailed piece costs more.</p>
      <p style={P2}>
        The guarantee covers installation and workmanship for 2 years and the structure of the joinery for 10 years. Hardware is on the manufacturer's warranty, and doors and drawers are adjusted in the first 2 years. Our <Link href="/fitted-wardrobe-cost/">cost guide</Link> shows what moves the price of a fitted wardrobe.
      </p>
      <PriceCards slot="side" items={PRICES} />
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
    <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
      <Faq q="Is built-in shelving a good idea?">
        Built-in shelving is a good idea if you want a fixed place for books, with closed cupboards below for everything else. A taller base gives more enclosed storage but less room for shelves, and a lower base leaves more for display. We'll set that balance around what you want to store and what you want on show.
      </Faq>
      <Faq q="Are built-in shelves still in style?">
        Built-in shelves are still in style, because they can be designed for a period room or a contemporary one. Mouldings and framed shelving echo period woodwork, while flat doors and plain shelf edges look more modern. In a stucco house, you can also mix the two, with simple panelled doors under plain shelving.
      </Faq>
      <Faq q="How can you add storage above a bed?">
        We can fit a row of cupboards above the headboard, between the wardrobes either side of the bed. We set them about <Ask q="maida-vale-over-bed-clearance">the clearance you leave, in mm</Ask> above the mattress, so you can sit up and use a reading light. They suit things you reach for less often, such as spare bedding or out-of-season clothes.
      </Faq>
    </div>
  </Wrap>
</AreaPage>
