 * block and "measured in its room" lines wording no other page uses.
 */
import AreaPage from "../../components/AreaPage.astro";
import Wrap from "../../components/ds/Wrap.astro";
import SectionHead from "../../components/ds/SectionHead.astro";
import Faq from "../../components/ds/Faq.astro";
import Link from "../../components/ds/Link.astro";
import AreaSide from "../../components/AreaSide.astro";
import PriceCards from "../../components/PriceCards.astro";

import { AREAS } from "../../data/areas";

const area = AREAS.find((a) => a.slug === "areas/maida-vale")!;

const PRICES = [
  {
    art: "fitted-wardrobes",
    name: "Fitted wardrobes",
    href: "/fitted-wardrobes/",
    price: "From £2,300 for a 2-door run up to 1.2m in melamine, and from £4,000 at 4 doors.",
    moves: "Width, finish, internal drawers, integrated lighting and more complex designs move the figure.",
  },
  {
    art: "alcove-units",
    name: "Alcove units",
    href: "/alcove-units/",
    price: "From £3,300 for a pair in melamine, and from £6,000 in oak veneer.",
    moves: "Finish, shelving detail, drawers and lighting move the figure. It assumes base cupboards with shelving over, up to about 1m per alcove.",
  },
];
const P2 = "margin-top:var(--space-10)";
const TEXT = "max-width:var(--measure)";
const SECTION = "padding-bottom:var(--section-y)";
const EXT = { target: "_blank", rel: "noopener" };
---

<AreaPage area={area}>
  <Fragment slot="lede">
    <p>
      Our bespoke carpentry in Maida Vale covers <Link href="/fitted-wardrobes/">fitted wardrobes</Link>, <Link href="/alcove-units/">alcove units</Link> and built-in shelving for stucco villas by the canal and early mansion flats.
    </p>
    <p style={P2}>
      Maida Vale sits in the City of Westminster, not Camden, so the listing and parking rules below are Westminster's. Every piece of bespoke joinery is measured in its room, whether a canal-side villa or a mansion flat.
    </p>
  </Fragment>

  <Wrap style={SECTION}>
    <SectionHead meta="Canal and villas" level={4}>Fitted wardrobes for the stucco villas by the canal</SectionHead>
    <AreaSide drawing="canal-villas">
      <p>
        Maida Vale is a conservation area: Westminster protects the whole district for its character. Westminster's leaflet on it says the Regent's Canal and the Grand Union Canal set the earliest layout. Building got under way in the 1830s, and the south was virtually complete by the mid-1860s.
      </p>
      <p style={P2}>
        At the canal end is Little Venice, which the leaflet sums up as "white stucco, greenery and water". Stucco is the painted render that gives these fronts their smooth white finish. A published history of Paddington describes stuccoed detached and semi-detached villas along the southern avenues.
      </p>
      <p style={P2}>
        In a mid-19th century villa, traditional panelled doors give <Link href="/fitted-wardrobes/">fitted wardrobes</Link> a more detailed front. A cornice (the moulded band along the top), suitable handles and carefully chosen panel proportions can connect the wardrobe with existing woodwork. The details should suit the scale of the room rather than compete with it.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Stucco crescents" level={4}>Built-in shelving for Warrington Crescent and Formosa Street</SectionHead>
    <AreaSide drawing="stucco-crescent">
      <p>
        Westminster's character overview of its conservation areas calls the imposing stucco crescents of Warrington Crescent and Formosa Street the area's most notable features.
      </p>
      <p style={P2}>
        Nos 2 to 18 Formosa Street is a mid-19th century terrace of three storeys in brick and stucco. Historic England lists it at Grade II, so the law protects it for its special interest. Its sash windows above the ground floor sit in moulded surrounds, each under a cornice on brackets.
      </p>
      <p style={P2}>
        Built-in shelving and <Link href="/alcove-units/">alcove units</Link> can take their cue from that moulded detail. Panelled doors, framed shelving, decorative mouldings and shaped plinths (the base a unit stands on) can echo the woodwork in a period home. A large moulding may work alongside substantial cornicing, while a smaller room with simpler woodwork may suit less ornament.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Early flats" level={4}>Wardrobes around the bed in Maida Vale's early mansion flats</SectionHead>
    <AreaSide drawing="bed-recess-wardrobes">
      <p>
        Flats came early to Maida Vale. A published history of Paddington records the first flats planned in 1890, at Nos 1 and 3 Maida Vale. Carlton, Elgin and Ashworth Mansions stood by 1902.
      </p>
      <p style={P2}>
        Westminster's leaflet places early mansion blocks around Elgin Avenue. These are large blocks of flats.
      </p>
      <p style={P2}>
        Where a mansion-flat bedroom has a recess for the bed, <Link href="/fitted-wardrobes/">wardrobes</Link> on either side can combine clothes storage with bedside shelves or drawers. Cupboards above the headboard add space for less frequently used items.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Listed buildings" level={4}>Listed buildings and Westminster's rules</SectionHead>
    <div style={TEXT}>
      <p>
        Westminster's May 2004 leaflet counted over 350 listed buildings in the area, mostly Grade II. They include stuccoed houses, villas and flats around Warwick Avenue, Warrington Crescent, Formosa Street and Clifton Gardens.
      </p>
      <p style={P2}>
        Fitted furniture in an unlisted home does not generally need planning permission, as the <Link href="https://www.planningportal.co.uk/info/200130/common_projects/33/internal_walls" {...EXT}>Planning Portal</Link> notes for internal alterations. In a listed building, work affecting its special architectural or historic interest needs listed building consent, inside as well as out. Working without it is a criminal offence, even if you did not know the building was listed.
      </p>
      <p style={P2}>
        <Link href="https://www.westminster.gov.uk/planning-building-control-and-environmental-regulations-menu/design-and-heritage/listed-buildings" {...EXT}>Westminster's listed buildings page</Link> links a map for checking a street, and suggests asking for its advice before applying. You can also apply for a Certificate of Lawfulness of Proposed Works, which establishes whether planned work to a listed building would be lawful.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Access" level={4}>Parking for the fitting days in Westminster</SectionHead>
    <div style={TEXT}>
      <p>
        Westminster does not run an on-street visitor permit scheme. Its daily <Link href="https://www.westminster.gov.uk/parking/trade-parking-businesses/apply-trade-parking-permit" {...EXT}>trade parking permit</Link> is for people having work done or doing it. It covers pay-to-park and resident bays in the zone it was bought for.
      </p>
      <p style={P2}>
        The permit is not meant for deliveries, so Westminster asks you to check its loading and unloading allowances first. Parking, deliveries and access are agreed with you before installation.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Guide prices" level={4}>What a fitted wardrobe or alcove unit costs in Maida Vale</SectionHead>
    <AreaSide>
      <p>Every figure here is a starting price, and a larger or more detailed piece costs more.</p>
      <p style={P2}>
        The guarantee covers installation and workmanship for 2 years and the structure of the joinery for 10 years. Hardware is on the manufacturer's warranty, and doors and drawers are adjusted in the first 2 years. Our <Link href="/fitted-wardrobe-cost/">cost guide</Link> shows what moves the price of a fitted wardrobe.
      </p>
      <PriceCards slot="side" items={PRICES} />
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
    <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
      <Faq q="Is built-in shelving a good idea?">
        Built-in shelving gives books and display a fixed place, with cupboards below for what you keep out of sight. A taller base unit gives more enclosed storage but reduces the height available for shelving. A lower base leaves more room for display.
      </Faq>
      <Faq q="Are built-in shelves still in style?">
        Built-in shelving is not tied to one style. Simple panelled doors beneath plain shelving can bridge traditional architecture and contemporary furnishings. Painted cupboards with timber shelves can add texture without elaborate mouldings, and a period property does not require period-style cabinetry.
      </Faq>
      <Faq q="How can you add storage above a bed?">
        Cupboards can bridge the wall above the headboard, between wardrobes on either side of the bed. Leave comfortable room to sit up against the headboard, reach bedside storage and use reading lights. Overhead cupboards should sit at a deliberate height, with their support and fixings resolved in the design.
      </Faq>
    </div>
  </Wrap>
</AreaPage>
