import AreaPage from "../../components/AreaPage.astro";
import Wrap from "../../components/ds/Wrap.astro";
import SectionHead from "../../components/ds/SectionHead.astro";
import Faq from "../../components/ds/Faq.astro";
import Link from "../../components/ds/Link.astro";
import AreaSide from "../../components/AreaSide.astro";
import PriceCards from "../../components/PriceCards.astro";

import { AREAS } from "../../data/areas";

const area = AREAS.find((a) => a.slug === "areas/primrose-hill")!;

const PRICES = [
  {
    art: "alcove-units",
    name: "Alcove units",
    href: "/alcove-units/",
    price: "From £3,300 for a pair in melamine, and from £6,000 in oak veneer.",
    moves: "Shelving detail, drawers and lighting move the figure.",
  },
  {
    art: "fitted-wardrobes",
    name: "Fitted wardrobes",
    href: "/fitted-wardrobes/",
    price: "From £2,300 for a 2-door run up to 1.2m in melamine, and from £4,000 at 4 doors.",
    moves: "Width, finish, internal drawers and lighting move the figure.",
  },
  {
    art: "walk-in-wardrobes",
    name: "Walk-in wardrobes",
    href: "/walk-in-wardrobes/",
    price: "Typically from around £5,000.",
    moves: "The size of the room, the number of runs, the layout and the finishes move the figure.",
  },
];
const P2 = "margin-top:var(--space-10)";
const TEXT = "max-width:var(--measure)";
const SECTION = "padding-bottom:var(--section-y)";
const EXT = { target: "_blank", rel: "noopener" };
---

<AreaPage area={area}>
  <Fragment slot="lede">
    <p>
      We design and install <Link href="/fitted-wardrobes/">fitted wardrobes</Link>, <Link href="/alcove-units/">alcove cupboards</Link> and shelving for Primrose Hill homes, including those on Regent's Park Road and Chalcot Crescent. If your villa, terrace house or flat has a pair of alcoves or a sloping loft ceiling, we'll design the storage around them.
    </p>
  </Fragment>

  <Wrap style={SECTION}>
    <SectionHead meta="Period bedrooms" level={4}>Fitted wardrobes for period bedrooms in Primrose Hill</SectionHead>
    <AreaSide drawing="stucco-villa">
      <p>
        Around St Mark's Square and Prince Albert Road, many homes are Victorian villas and tall terraces. Where there's an original cornice, the wardrobe can stop just below it or run to the ceiling with the cornice across its top. With a high ceiling, you can choose full-height doors or a row of top cupboards for suitcases and winter clothes.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Alcoves" level={4}>Alcove cupboards and shelves for Primrose Hill living rooms</SectionHead>
    <AreaSide drawing="alcove-pair">
      <p>
        Flats in Primrose Hill's converted houses can still have their original chimney breasts, with alcoves either side. We can set the cupboards flush with the chimney breast to save floor space, or bring them forward for deeper storage. Above them, you can have floating shelves that show the wall colour, or <Link href="/journal/alcove-units-guide/">framed shelving</Link> with its own sides and back.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Loft rooms" level={4}>Fitted wardrobes for loft rooms around Chalcot Square</SectionHead>
    <AreaSide drawing="mansard-wardrobe">
      <p>
        Some houses on Chalcot Square have loft rooms with sloping ceilings and dormer windows. The hanging space goes where the room is tallest, with drawers or shelves under the lower part of the slope. We'll keep each compartment easy to reach and check that every door can open fully under the slope.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Back rooms" level={4}>Fitted cupboards for small back rooms in Primrose Hill</SectionHead>
    <div style={TEXT}>
      <p>
        Mid-Victorian terraces here often have a narrow back wing, with smaller rooms in it. In these rooms, we can keep the cupboards shallow, leaving space to move around and open the doors. Shelves around 350 to 400 mm deep still take folded clothes, and shirts can hang on a <Link href="/journal/built-in-wardrobe-ideas/">front-to-back rail</Link>.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Listed homes" level={4}>Fitted joinery for listed houses in Primrose Hill</SectionHead>
    <div style={TEXT}>
      <p>
        Many homes around Chalcot Crescent and St George's Terrace are listed. Before you plan any joinery, you can look yours up on <Link href="https://www.camden.gov.uk/listed-buildings" {...EXT}>Camden Council's listed buildings page</Link>.
      </p>
      <p style={P2}>
        If it is, ask the council before work starts whether the joinery needs listed building consent, especially if original skirting or panelling would change. If the council asks to see the design, we can provide scaled drawings of the joinery.
      </p>
    </div>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Access" level={4}>Parking, steps and stairs on fitting days in Primrose Hill</SectionHead>
    <AreaSide drawing="steps-route">
      <p>
        Before fitting day, we'll work out with you where the van can unload and park. Camden's <Link href="https://www.camden.gov.uk/controlled-parking-zones" {...EXT}>controlled parking zones page</Link> shows your zone if you search by postcode. We'll check whether a <Link href="https://www.camden.gov.uk/trade-permits" {...EXT}>Camden trade permit</Link> suits your street, and agree with you who arranges it.
      </p>
      <p style={P2}>
        Primrose Hill's villas and terraces often have front steps up to a raised ground floor. The joinery can come in sections that fit up the steps and through the hall, then be assembled in your room. On fitting day, we protect the floors and stairs between the front door and your room before anything comes in.
      </p>
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Guide prices" level={4}>What alcove units and fitted wardrobes cost</SectionHead>
    <AreaSide>
      <p>Every figure here is a starting price, and a larger or more detailed piece costs more.</p>
      <p style={P2}>
        A fixed, itemised quotation follows the measured survey. The guarantee covers installation and workmanship for 2 years and the structure of the joinery for 10 years.
      </p>
      <PriceCards slot="side" items={PRICES} />
    </AreaSide>
  </Wrap>

  <Wrap style={SECTION}>
    <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
    <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
      <Faq q="Do I need my freeholder's permission for fitted furniture in a flat?">
        It depends on your lease, so check it before work starts. Many leases ask for the freeholder's consent before alterations, and some count furniture fixed to the walls as an alteration. If your building has a managing agent, we can coordinate with them and provide our insurance and safety documents.
      </Faq>
      <Faq q="Are alcove cupboards worth it?">
        They're worth it if you want hidden storage and open shelves in one place. The cupboards can keep toys or paperwork out of sight, with books and pictures on the shelves above. Beside a fireplace, they also shape the look of the whole wall.
      </Faq>
      <Faq q="How high should alcove units be?">
        There's no standard height: it depends on how much you want to store and how much you want on show. A taller cupboard gives more closed storage and leaves less height for the shelves above. If the two alcoves differ in width, keeping both cupboard tops at the same height ties them together.
      </Faq>
    </div>
  </Wrap>
</AreaPage>
