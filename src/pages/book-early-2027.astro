---
/**
 * PREVIEW ONLY, 12 Nov 2026 (branch flowtoform/booking-2027-preview): the
 * early-2027 booking page, where the Google post, the site band and the
 * quotations send people. Arthur's brief: one page for every service, the
 * visitor ticks what they want made and which add-ons they would choose, no
 * project value asked.
 *
 * Rev 2 (Arthur's preview comments, 12 Nov): every service he offers; a
 * catchier headline (three versions offered, the first here); "What is
 * included" becomes "Christmas bundles" with five service cards drawn in 2D.
 * Quick prices on three cards first (wardrobes, alcoves, walk-ins), as agreed;
 * TV units and kitchens show their published "from" figure and go straight
 * to the add-ons.
 *
 * THE QUICK PRICE IS ALWAYS A FLOOR. It is the guide starting price from the
 * cost guide, and the quotation can only be the same or higher, so "add-ons
 * worth at least £Y" never promises more than the band the quotation lands in.
 *
 * Every figure in [brackets] is a draft waiting on Kaspar: the band values and
 * add-on prices come from the cost guide preview (ss-cost-extras-preview) and
 * go live only once his real prices are live there first, so "normally £300"
 * has a real price behind it (CAP 3.7; DMCCA 2024 Sch 20 para 23). His own
 * published wardrobe, alcove pair, walk-in, TV unit and kitchen "from" figures
 * are shown as they are. Deposit: Arthur set a draft [15%] on 12 Nov, covering the 2D drawings and elevations (Kaspar confirms). Prices are marked indicative, and a quotation follows a measured survey or the customer's photos and measurements (Arthur, 12 Nov; Kaspar confirms the photo route).
 *
 * Copy to protocol v1.4: no "offer", "deal", "discount", "limited time" or
 * "free"; facts, not the promise formula; the closing date stated once and
 * never extended (Sch 20 para 7). noindex: a temporary page, removed on
 * 1 February 2027 with a redirect to /fitted-wardrobe-cost/.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import FormProof from "../components/FormProof.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";

/** Preview: wrap draft figures in brackets. False once Kaspar's prices are in. */
const DRAFT = true;
const draft = (s: string) => (DRAFT ? `[${s}]` : s);

const money = (n: number) => `£${n.toLocaleString("en-GB")}`;

/* Extras on the house, rev 14 (Arthur, 12 Nov: "the value has to be 10 to 15%,
   and we want to upsell, not discount"). Each step is about half again the one
   below and its allowance is 13 to 15% of the step, so the share never goes
   above 15% and falls to no less than 10% just before the next step, where it
   jumps back up: the next step is always close enough to pull one more drawer
   into the bundle. Below £2,500 (Arthur's first step) nothing is included.
   Every value is a draft for Kaspar. */
const BANDS: [number, number][] = [
  [2500, 350], [3500, 500], [5000, 750], [7500, 1000], [10000, 1500],
  [15000, 2000], [20000, 3000], [30000, 4500], [45000, 6000],
];

/* Parts and extras at normal prices: the cost guide preview's drafts, plus a
   hanging rail, priced here for the first time. All drafts for Kaspar. */
const ADDONS = {
  rail: { name: "Hanging rail", price: 50 },
  shelf: { name: "Shelf", price: 50 },
  drawer: { name: "Soft-close drawer", price: 150 },
  led: { name: "LED lighting with a door sensor, per section", price: 150 },
  trouser: { name: "Pull-out trouser rail", price: 150 },
  shoe: { name: "Pull-out shoe rack", price: 180 },
  pulldown: { name: "Pull-down hanging rail", price: 180 },
  tray: { name: "Lined jewellery or accessory tray", price: 150 },
  mirror: { name: "Full-length mirror inside a door", price: 200 },
};

/* Finish pictures from the materials page (public/images/materials/README.md):
   melamine is his own work, MDF and oak veneer are the supplier samples Denis
   kept on 2 Sep 2026. Hand-painted and sprayed are both MDF, so they share the
   MDF photograph under a colour wash that tells them apart. Decorative beside
   their labels, so alt="" (rule 7). Arthur, 12 Nov: the hero photo goes, the
   material pictures stay. */
const FINISHES = [
  { name: "Melamine board", img: "/images/materials/melamine-board-400w.webp", wash: "" },
  { name: "Hand-painted MDF", img: "/images/materials/mdf-board-400w.webp", wash: "painted" },
  { name: "Sprayed MDF", img: "/images/materials/mdf-board-400w.webp", wash: "sprayed" },
  { name: "Oak veneer", img: "/images/materials/veneered-board-400w.webp", wash: "" },
];

/* Arthur's upsell ladder, kept inside the 10 to 15%: from £15,000 what is on
   the house is enough for a whole unit, picked like any extra and valued at its
   normal starting price; another finish, or anything past the allowance, at
   normal prices. The library unit's price is a draft; the others are his
   published starting prices in melamine. */
const WHOLE = {
  library: { name: "Library unit, 2.4m high and 1.2m wide", price: 2000 },
  wardrobe2: { name: "2-door wardrobe, a rail and 2 shelves inside", price: 2300 },
  alcoves: { name: "A pair of alcove units", price: 3300 },
  tvunit: { name: "Built-in TV unit, up to " + draft("2.4m") + " wide", price: 3500 },
  wardrobe4: { name: "4-door wardrobe, 2 rails and 4 shelves inside", price: 4000 },
};
const WHOLE_FROM = 15000;

/* The wardrobe as an empty box (Arthur, 12 Nov): doors and carcass, Blum
   soft-close hinges, delivery and fitting; then the customer picks the inside
   part by part. His published prices include a basic inside, so the box is
   his price less that inside at the draft part prices (2 doors: a rail and 2
   shelves; 3 doors: 2 rails and 3 shelves; 4 doors: 2 rails and 4 shelves).
   Drafts until he gives box prices. Rows are finishes, columns door counts. */
const PUBLISHED = [[2300, 3200, 4000], [2500, 3500, 4500], [3200, 4300, 5400], [3700, 5000, 6300]];
const STD_INSIDE = [{ rail: 1, shelf: 2 }, { rail: 2, shelf: 3 }, { rail: 2, shelf: 4 }];
const partsValue = (o: Record<string, number>) =>
  Object.entries(o).reduce((s, [k, n]) => s + (ADDONS as Record<string, { price: number }>)[k].price * n, 0);
const BOX = PUBLISHED.map((row) => row.map((v, i) => v - partsValue(STD_INSIDE[i])));
/* Kitchens use his four-door wardrobe's finish steps until he prices them. */
const FINISH_STEP = PUBLISHED.map((r) => r[2] / PUBLISHED[0][2]);
const WARDROBE_PARTS = ["rail", "shelf", "drawer", "led", "trouser", "shoe", "pulldown", "tray", "mirror"];

/* included: what each starting price already covers, from his published copy
   and Arthur's comments (Blum hinges from Kaspar's Q28; "Design included"). */
const BUNDLES = [
  {
    id: "wardrobe", label: "Fitted wardrobes", from: BOX[0][0], fromText: "box from " + draft(money(BOX[0][0])),
    sizeLabel: "Doors", sizes: ["2 doors", "3 doors", "4 doors"],
    finishes: FINISHES, prices: BOX, boxDraft: true, priceLabel: "the box",
    typical: [
      { parts: { rail: 1, shelf: 2, drawer: 2 }, text: "a rail, 2 shelves and 2 drawers" },
      { parts: { rail: 2, shelf: 3, drawer: 3 }, text: "2 rails, 3 shelves and 3 drawers" },
      { parts: { rail: 2, shelf: 4, drawer: 4 }, text: "2 rails, 4 shelves and 4 drawers" },
    ],
    partsLabel: "What goes inside", parts: WARDROBE_PARTS,
    includes: "The box is the doors and carcass. Then choose what goes inside.",
    included: ["Choose the doors and the finish", "Then build the inside, part by part"],
    addons: WARDROBE_PARTS,
  },
  {
    /* cardFloor: one alcove has no price yet and may sit below the first step,
       so the card promises only that, not the pair's step. */
    id: "alcove", label: "Alcove units and shelving", from: 3300, cardFloor: 2000, fromText: "from £3,300 a pair",
    sizeLabel: "Size", sizes: ["A pair of alcoves", "One alcove"],
    finishes: FINISHES, prices: [[3300, null], [3600, null], [4000, null], [6000, null]],
    partsLabel: "Extras", parts: ["shelf", "drawer", "led"],
    includes: "At this price: in each alcove, a base cupboard with two doors and three open shelves above, up to about 1m wide.",
    included: ["A base cupboard and three open shelves, each side", "Up to about 1m wide per alcove"],
    addons: ["shelf", "drawer", "led"],
  },
  {
    id: "walkin", label: "Walk-in wardrobes", from: 5000, fromText: "from around £5,000",
    sizeLabel: "Layout", sizes: ["One wall", "Two walls, L-shaped", "Three walls, U-shaped"],
    finishes: null, prices: [[5000, 5000, 5000]], around: true,
    partsLabel: "Extras", parts: WARDROBE_PARTS,
    includes: "A walk-in wardrobe is priced per room, by what goes into it, and typically starts from around £5,000. Add the extras you would like below.",
    included: ["Layout planned around what you store", "One, two or three walls"],
    addons: WARDROBE_PARTS,
  },
  {
    id: "tv", label: "Built-in TV units", from: 3500, fromText: "from £3,500",
    sizes: null, finishes: FINISHES, prices: null, perProject: true,
    partsLabel: "Extras", parts: ["led", "drawer", "shelf"],
    includes: "Built-in TV units are priced per project after one visit, from £3,500.",
    included: ["Layout set around your TV", "Closed cupboards and open sections"],
    addons: ["led", "drawer", "shelf"],
  },
  {
    /* Arthur, 12 Nov: pick how many units, then the finish; design and units
       included, appliances and worktops not. From £10,000 for up to [12]
       units in melamine; each unit beyond that a draft [£850]. */
    id: "kitchen", label: "Bespoke kitchens", from: 10000, fromText: "from £10,000",
    kind: "kitchen", unitsIncluded: 12, perUnit: 850,
    sizes: null, finishes: FINISHES, prices: null,
    partsLabel: "Extras", parts: ["led", "drawer"],
    includes: "",
    includesList: ["From £10,000 for up to " + draft("12") + " units in melamine board", "Each unit beyond that about " + draft("£850") + "; other finishes cost more", "Not included: appliances and worktops"],
    included: ["Up to " + draft("12") + " units, in your choice of finish", "Appliances and worktops not included"],
    addons: ["led", "drawer"],
  },
];

const allowance = (p: number) => BANDS.reduce((a, [min, v]) => (p >= min ? v : a), 0);

const WHOLE_NOTE: Record<number, string> = {
  15000: ", enough for a library unit",
  20000: ", enough for a 2-door wardrobe",
  30000: ", enough for a pair of alcove units, a TV unit or a 4-door wardrobe",
  45000: ", enough for any of the whole units",
};
const BAND_ROWS = BANDS.map(([at, v], i) => {
  const next = BANDS[i + 1];
  const t = (n: number) => (n >= WHOLE_FROM ? draft(money(n)) : money(n));
  return [t(at) + (next ? " to " + t(next[0] - 1) : " and over"), "up to " + draft(money(v)) + (WHOLE_NOTE[at] || "")];
});

const TERMS = [
  "Booked means the quotation accepted in writing and the [15%] deposit paid by 11.59pm on Sunday 31 January 2027.",
  "The deposit covers your 2D drawings and elevations, which start once it is paid, and books your fitting slot.",
  "Applies to fitted wardrobe, walk-in wardrobe, alcove unit, TV unit and kitchen jobs with a quotation of £2,500 or more. Several units in one quotation count together.",
  "The quotation total at normal prices sets how much is included, as in the table above.",
  "From " + draft("£15,000") + ", what is included can be a whole unit: a library unit, 2.4m high and 1.2m wide, a 2-door or 4-door wardrobe, a pair of alcove units or a TV unit, valued at its normal starting price. Another finish, or anything beyond what is included, is charged at normal prices.",
  "Prices on this page are indicative guide prices. The firm figure is the itemised quotation, sent after a measured survey or from your photos and measurements.",
  "Each extra on the house appears on the quotation as its own line at £0. Its normal price is the price on our cost guide, and what we charge for it on any other job.",
  "Prices are unchanged. The quotation is the normal itemised price for the job.",
  "Lighting needs a power supply that can reach the unit, which we check at the visit. Where it cannot, other extras of the same value are included.",
  "Extras and whole units on the house cannot be exchanged for money, swapped for a lower price or moved to another job.",
  "The fitting date is agreed when the deposit is paid.",
  "Your cancellation rights are not affected.",
  "The closing date will not be extended.",
  "No VAT is added: we are not currently VAT registered.",
];

const clientData = {
  draft: DRAFT,
  bands: BANDS,
  addons: ADDONS,
  whole: WHOLE,
  wholeFrom: WHOLE_FROM,
  finishStep: FINISH_STEP,
  bundles: BUNDLES.map((b) => ({ ...b })),
};
---

<Base
  title="The Christmas bundle"
  description="Wardrobes, walk-ins, alcove units, TV units and kitchens booked by 31 January 2027 come with add-ons you choose, at no cost. Prices unchanged, no VAT added."
  noindex={true}
>
  {/* LANDING PAGE, rev 4 (Arthur, 12 Nov: "make it a landing page, hero
      explains the offer then the options, Hormozi technique, Christmassy").
      Hormozi's value equation, kept inside protocol v1.4 and the pricing law:
      - a named bundle (The Christmas bundle) with the add-ons as named things;
      - dream outcome and time: plan it over Christmas, fitted in the new year;
      - low effort: three steps, one visit, a fixed itemised quotation;
      - likelihood: the live Google rating, two whole reviews, his real
        guarantee (Q35), nothing invented;
      - the value stack shown at normal prices from the cost guide, never a
        "you save" or a struck-out price;
      - urgency and scarcity only where true: the closing date, never
        extended, and a slot count only once Kaspar gives a real one.
      Christmas in the brand palette: the site's green, a berry ribbon in the
      brand's deep red, a drawn holly sprig. No snow, no countdown. */}
  <section class="xmas-hero">
    <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
      <div class="xmas-hero-grid">
        <div class="xmas-hero-copy">
          <p class="xmas-kicker">
            <svg class="holly" viewBox="0 0 40 24" aria-hidden="true"><path d="M20 12 C14 2 6 4 2 8 C7 9 6 14 10 15 C12 11 16 12 20 12 Z" /><path d="M20 12 C26 2 34 4 38 8 C33 9 34 14 30 15 C28 11 24 12 20 12 Z" /><circle cx="17" cy="15" r="3" /><circle cx="23" cy="15" r="3" /><circle cx="20" cy="19" r="3" /></svg>
            Christmas bundles, booking until 31 January 2027
          </p>
          <h1 class="xmas-h1">The Christmas bundle: extras worth from [£350], on the house</h1>
          <p class="xmas-lede">
            Fitted wardrobes, walk-ins, alcove units, TV units and kitchens booked by Sunday 31 January 2027
            come with add-ons you choose, at no cost. Plan it over Christmas, and it is fitted in the new year.
          </p>
          <p class="xmas-ctas">
            <a class="xmas-btn" href="#bundles">Build your bundle</a>
          </p>
          <p class="xmas-small">Booking closes on Sunday 31 January 2027, and the date will not move.</p>
        </div>
        {/* BALANCE (Arthur, 12 Nov: "the hero looks off, balance it"). With the
            photo gone the right half stood empty. It now holds the bundle at a
            glance, as a gift tag: what is always included, then the ladder of
            add-ons by quotation, ending with the library unit. Text, not a
            picture; brackets mark the drafts. */}
        <aside class="xmas-card" aria-label="What is in the Christmas bundle">
          {/* A red ribbon across the tag, crossing the one down its side, with a bow
              where they meet (Arthur, 12 Nov: "like a red ribbon, something festive"). */}
          <span class="xmas-lid" aria-hidden="true"></span>
          <svg class="xmas-bow" viewBox="0 0 80 56" aria-hidden="true"><path d="M37 31 L25 54 L31.5 51.5 L35 55 L40 32 Z" /><path d="M43 31 L55 54 L48.5 51.5 L45 55 L40 32 Z" /><path d="M40 28 C27 4 3 3 6 19 C9 33 28 33 40 28 Z" /><path d="M40 28 C53 4 77 3 74 19 C71 33 52 33 40 28 Z" /><path class="crease" d="M40 28 C31 16 18 12 13 18" /><path class="crease" d="M40 28 C49 16 62 12 67 18" /><rect x="33" y="21" width="14" height="14" rx="4" /></svg>
          <p class="xmas-card-title xmas-card-ribbon">In every bundle</p>
          <ul class="xmas-card-list">
            <li>Add-ons you choose: lighting, drawers, rails, racks</li>
            <li>Prices unchanged, no VAT added</li>
            <li>A [15%] deposit covers your 2D drawings and elevations, and books your slot</li>
          </ul>
          <p class="xmas-card-title">On the house, by quotation</p>
          <dl class="xmas-ladder">
            <div><dt>£2,500</dt><dd>up to [£350]</dd></div>
            <div><dt>£5,000</dt><dd>up to [£750]</dd></div>
            <div><dt>£10,000</dt><dd>up to [£1,500]</dd></div>
            <div><dt>[£15,000]</dt><dd>up to [£2,000]</dd></div>
            <div class="xmas-ladder-top"><dt>[£30,000]</dt><dd>[£4,500]: a whole wardrobe, alcoves or TV unit</dd></div>
          </dl>
        </aside>
      </div>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <SectionHead level={4}>How it works</SectionHead>
    <ol class="xmas-steps">
      <li><strong>Build your bundle.</strong> Pick the furniture, its size and finish, then what goes inside, and add as many units to your basket as you like. Send it with one enquiry.</li>
      <li><strong>We see the space.</strong> A measured survey at your home, or photos and measurements from you. Then we send an itemised quotation, with your add-ons on it at £0.</li>
      <li><strong>Book by 31 January.</strong> Accept the quotation and pay a [15%] deposit, which covers your 2D drawings and elevations and books your fitting slot. We agree the date then.</li>
    </ol>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <div id="bundles"></div>
    <SectionHead level={4}>Christmas bundles</SectionHead>
    <p class="booking-note">
      Build each unit you would like made, size and finish first, then what goes inside, and add it to your
      basket. Add as many units as you like: they count together, and the basket total sets the extras on the
      house, each its own line at £0 on the quotation. One button sends the whole basket with your enquiry.
    </p>

    {/* What every unit shares, said once (Arthur, 12 Nov: "whatever is the same
        across all the products, put it somewhere standard for all of them"). */}
    <div class="std-strip">
      <p class="std-strip-title">Every unit comes with</p>
      <ul class="std-strip-list">
        <li>Design included</li>
        <li>Made to measure</li>
        <li>Delivered and fitted</li>
        <li>Blum soft-close hardware</li>
      </ul>
    </div>

    <div class="bundle-cards" role="list">
      {BUNDLES.map((b) => (
        <button type="button" class="bundle-card" data-bundle={b.id} aria-pressed="false" role="listitem">
          {/* Larger and in colour (Arthur, 12 Nov): brand tokens only, oak and
              walnut timber, green paint, charcoal for the TV and hangers. Tight
              viewBoxes so each drawing fills its card. */}
          <span class="bundle-drawing" aria-hidden="true">
            {b.id === "wardrobe" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="10" y="6" width="140" height="132" /><rect class="f-oak2" x="14" y="16" width="42" height="118" /><rect class="f-oak2" x="59" y="16" width="42" height="118" /><rect class="f-oak2" x="104" y="16" width="42" height="118" /><line class="s-wal" x1="10" y1="12" x2="150" y2="12" /><line class="h" x1="50" y1="64" x2="50" y2="86" /><line class="h" x1="65" y1="64" x2="65" y2="86" /><line class="h" x1="110" y1="64" x2="110" y2="86" /><rect class="f-wal" x="6" y="138" width="148" height="8" /></svg>
            )}
            {b.id === "alcove" && (
              <svg viewBox="0 0 160 150"><rect class="f-greenwash" x="58" y="4" width="44" height="142" /><rect class="f-wal" x="50" y="70" width="60" height="7" /><rect class="f-oak2" x="6" y="98" width="50" height="48" /><line class="s-wal" x1="31" y1="98" x2="31" y2="146" /><rect class="f-oak2" x="104" y="98" width="50" height="48" /><line class="s-wal" x1="129" y1="98" x2="129" y2="146" /><line class="s-wal" x1="6" y1="40" x2="56" y2="40" /><line class="s-wal" x1="6" y1="66" x2="56" y2="66" /><line class="s-wal" x1="104" y1="40" x2="154" y2="40" /><line class="s-wal" x1="104" y1="66" x2="154" y2="66" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="18" y="29" width="6" height="11" /><rect class="f-oak" x="25" y="24" width="8" height="16" /><rect class="f-green" x="110" y="52" width="8" height="14" /><rect class="f-char" x="120" y="55" width="6" height="11" /><rect class="f-oak" x="134" y="28" width="12" height="12" /></svg>
            )}
            {b.id === "walkin" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="6" y="6" width="148" height="138" /><rect class="f-paper" x="12" y="22" width="80" height="116" /><line class="s-wal" x1="12" y1="32" x2="92" y2="32" /><path class="s-wal" d="M22 37 V31 a3 3 0 1 1 6 0" /><path class="f-green" d="M15 42 L19 37 H25 L29 42 V100 H15 Z" /><path class="s-wal" d="M40 37 V31 a3 3 0 1 1 6 0" /><path class="f-oak2" d="M33 42 L37 37 H43 L47 42 V70 H33 Z" /><path class="s-wal" d="M58 37 V31 a3 3 0 1 1 6 0" /><path class="f-wal" d="M51 42 L55 37 H61 L65 42 V92 H51 Z" /><path class="s-wal" d="M76 37 V31 a3 3 0 1 1 6 0" /><path class="f-greenwash" d="M69 42 L73 37 H79 L83 42 V72 H69 Z" /><line class="s-wal" x1="12" y1="118" x2="92" y2="118" /><rect class="f-char" x="18" y="111" width="12" height="7" rx="2" /><rect class="f-char" x="33" y="111" width="12" height="7" rx="2" /><rect class="f-wal" x="52" y="111" width="12" height="7" rx="2" /><rect class="f-wal" x="67" y="111" width="12" height="7" rx="2" /><rect class="f-oak2" x="98" y="22" width="50" height="116" /><line class="s-wal" x1="98" y1="66" x2="148" y2="66" /><line class="s-wal" x1="98" y1="84" x2="148" y2="84" /><line class="s-wal" x1="98" y1="102" x2="148" y2="102" /><line class="s-wal" x1="98" y1="120" x2="148" y2="120" /><line class="h" x1="116" y1="75" x2="130" y2="75" /><line class="h" x1="116" y1="93" x2="130" y2="93" /><line class="h" x1="116" y1="111" x2="130" y2="111" /><line class="h" x1="116" y1="129" x2="130" y2="129" /></svg>
            )}
            {b.id === "tv" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="4" y="6" width="152" height="138" /><rect class="f-char" x="42" y="30" width="76" height="46" /><rect class="f-oak2" x="4" y="100" width="152" height="44" /><line class="s-wal" x1="42" y1="100" x2="42" y2="144" /><line class="s-wal" x1="80" y1="100" x2="80" y2="144" /><line class="s-wal" x1="118" y1="100" x2="118" y2="144" /><line class="s-wal" x1="4" y1="40" x2="36" y2="40" /><line class="s-wal" x1="4" y1="70" x2="36" y2="70" /><line class="s-wal" x1="124" y1="40" x2="156" y2="40" /><line class="s-wal" x1="124" y1="70" x2="156" y2="70" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="19" y="30" width="6" height="10" /><rect class="f-green" x="132" y="58" width="12" height="12" /><line class="s-wal" x1="40" y1="100" x2="120" y2="100" /></svg>
            )}
            {b.id === "kitchen" && (
              <svg viewBox="0 0 160 150"><rect class="f-green" x="6" y="6" width="148" height="42" /><line class="s-paper" x1="43" y1="6" x2="43" y2="48" /><line class="s-paper" x1="80" y1="6" x2="80" y2="48" /><line class="s-paper" x1="117" y1="6" x2="117" y2="48" /><rect class="f-wal" x="2" y="84" width="156" height="9" /><rect class="f-green" x="6" y="93" width="148" height="51" /><line class="s-paper" x1="43" y1="93" x2="43" y2="144" /><line class="s-paper" x1="80" y1="93" x2="80" y2="144" /><line class="s-paper" x1="117" y1="93" x2="117" y2="144" /><line class="s-paper" x1="80" y1="110" x2="117" y2="110" /><line class="s-paper" x1="80" y1="127" x2="117" y2="127" /><line class="h-oak" x1="34" y1="104" x2="34" y2="120" /><line class="h-oak" x1="52" y1="104" x2="52" y2="120" /><line class="h-oak" x1="92" y1="102" x2="105" y2="102" /><line class="h-oak" x1="92" y1="119" x2="105" y2="119" /><line class="h-oak" x1="92" y1="136" x2="105" y2="136" /><rect class="f-oak" x="128" y="70" width="18" height="14" /></svg>
            )}
          </span>
          <span class="bundle-name">{b.label}</span>
          <span class="bundle-from">{b.fromText}</span>
          <ul class="bundle-incl">{b.included.map((i) => <li>{i}</li>)}</ul>
          <span class="bundle-allow">{allowance((b as { cardFloor?: number }).cardFloor ?? b.from) ? "On the house: extras worth at least " + draft(money(allowance((b as { cardFloor?: number }).cardFloor ?? b.from))) : "Extras on the house from a £2,500 basket"}</span>
          <span class="bundle-cta">Build it <span aria-hidden="true">→</span></span>
        </button>
      ))}
    </div>

    <div class="bundle-panel" data-bundle-panel hidden aria-live="polite">
      <p class="bundle-panel-title" data-panel-title></p>
      <div data-step-size class="bundle-step" hidden>
        <MonoLabel as="p"><span data-size-label>Size</span></MonoLabel>
        <div class="chips" data-chips-size></div>
      </div>
      <div data-step-units class="bundle-step" hidden>
        <MonoLabel as="p">How many units</MonoLabel>
        <div data-units-ctrl></div>
      </div>
      <div data-step-finish class="bundle-step" hidden>
        <MonoLabel as="p">Finish</MonoLabel>
        <div class="finish-tiles" data-chips-finish></div>
      </div>
      <p class="bundle-result" data-result></p>
      <p class="booking-note" data-includes></p>
      <ul class="bundle-incl panel-incl" data-includes-list hidden></ul>
      <div data-step-parts class="bundle-step" hidden>
        <MonoLabel as="p"><span data-parts-label>What goes inside</span></MonoLabel>
        <p data-typical-wrap hidden><button type="button" class="chip" data-typical>Fill with a typical inside</button></p>
        <ul class="addon-list" data-parts></ul>
      </div>
      <p class="bundle-result" data-unit-total hidden></p>
      <p class="basket-nudge" data-panel-nudge hidden></p>
      <p style="margin-top:var(--space-6)"><button type="button" class="bundle-add" data-add disabled>Add to basket</button></p>
    </div>

    {/* The basket (Arthur, 12 Nov: "maybe we should create a basket that sends the
        email, in case someone wants more than one unit"). It already held several
        units; now it is named a basket, has "Add another unit", and a bar keeps
        the count and total on screen while people build. "Send" fills the
        enquiry form's hidden fields, so the units reach Kaspar in the enquiry
        email (and the sheet, once Make maps the fields). */}
    <div class="basket" id="basket" data-basket hidden aria-live="polite">
      <p class="bundle-panel-title basket-title"><svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10 L10 4 M17 10 L14 4" /><path d="M3 10 H21 L19 20 H5 Z" /><path d="M9 13 V17 M12 13 V17 M15 13 V17" /></svg>Your basket</p>
      <ul class="basket-list" data-basket-list></ul>
      <p class="bundle-result" data-total></p>
      <p class="booking-note">Every unit: design included, made to measure, delivered and fitted, Blum soft-close hardware.</p>
      <p class="basket-library" data-library hidden></p>
      <p class="basket-nudge" data-nudge hidden></p>
      <p style="margin-top:var(--space-6)"><a class="bundle-add basket-more" href="#bundles">Add another unit</a></p>
      <div class="bundle-step">
        <MonoLabel as="p">On the house</MonoLabel>
        <p class="bundle-meter" data-meter></p>
        <ul class="addon-list" data-addons></ul>
        <p class="bundle-estimate" data-estimate></p>
        <p style="margin-top:var(--space-8)">
          <button type="button" class="bundle-send" data-send>Send my basket with an enquiry</button>
        </p>
      </div>
    </div>

    <div class="basket-bar" data-basket-bar hidden>
      <span class="basket-bar-text"><svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10 L10 4 M17 10 L14 4" /><path d="M3 10 H21 L19 20 H5 Z" /><path d="M9 13 V17 M12 13 V17 M15 13 V17" /></svg><span data-basket-bar-text></span></span>
      <a class="basket-bar-btn" href="#basket">View basket</a>
    </div>

    <SectionHead level={5} style="margin-top:var(--space-14)">How much is included</SectionHead>
    <table class="booking-table">
      <thead><tr><th>Your quotation</th><th>What is included</th></tr></thead>
      <tbody>{BAND_ROWS.map(([a, b]) => <tr><td>{a}</td><td class="num">{b}</td></tr>)}</tbody>
    </table>
    <p class="booking-note">{draft("For example, a wardrobe that comes to £2,600 brings two more soft-close drawers at £0, or lighting in two sections.")}</p>
    <p class="booking-note">
      Normal prices are on our <Link href="/fitted-wardrobe-cost/" variant="inline">cost guide</Link>. Lighting
      needs a power supply that can reach the unit, which we check at the visit. Where it cannot, other extras
      of the same value are included.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>What stands behind it</SectionHead>
    <div class="xmas-proof">
      <div>
        <FormProof quotes={["lorenzo", "ozge"]} keep={1} />
      </div>
      <ul class="xmas-guarantee">
        <li><strong>2 years</strong> on installation and workmanship.</li>
        <li><strong>10 years</strong> on the structure of the joinery.</li>
        <li><strong>Hardware</strong> under its maker's warranty.</li>
        <li><strong>Your cancellation rights</strong> are not affected.</li>
      </ul>
    </div>
  </Wrap>

  <section class="xmas-ribbon">
    <Wrap style="padding-top:var(--space-12);padding-bottom:var(--space-12)">
      <p class="xmas-ribbon-main">Booking closes on Sunday 31 January 2027.</p>
      <p class="xmas-ribbon-sub">[Number] fitting slots between February and April. The date will not be extended.</p>
      <p style="margin-top:var(--space-8)"><a class="xmas-btn xmas-btn-light" href="#bundles">Build your bundle</a></p>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <div id="booking-form" class="booking-form" style="border:var(--rule-structure);padding:clamp(20px,4vw,40px);background:var(--paper)">
      <MonoLabel as="p" style="margin-bottom:var(--space-10)">Send an enquiry</MonoLabel>
      <p class="booking-note" data-bundle-summary hidden></p>
      <EnquiryForm bonusPicker idPrefix="booking-" />
    </div>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>Terms</SectionHead>
    <ul class="booking-terms">{TERMS.map((t) => <li>{t}</li>)}</ul>
  </Wrap>
</Base>

<script is:inline define:vars={{ data: clientData }}>
  /* The bundle builder, rev 14 (Arthur, 12 Nov). Each unit is built up: its
     size (doors, layout or number of units) and finish give the starting price
     (for a wardrobe, the empty box); then the parts and extras the customer
     wants, at normal prices, give the unit total. Units add up in the bundle,
     and the bundle total sets the extras on the house, 10 to 15% of it, picked
     as items at £0 (from £15,000 a whole unit can be one of them). The panel
     states, as a fact, what the bundle brings on the house with this unit and
     how far the next step is: the upsell, one more drawer and it is included. */
  (() => {
    const $ = (s, r = document) => r.querySelector(s);
    const money = (n) => "£" + n.toLocaleString("en-GB");
    const d = (s) => (data.draft ? "[" + s + "]" : s);
    const allowance = (p) => data.bands.reduce((a, [min, v]) => (p >= min ? v : a), 0);
    const nextBand = (p) => data.bands.find(([min]) => min > p) || null;
    const all = Object.assign({}, data.addons, data.whole);
    const addonOrder = Object.keys(data.addons);
    const wholeOrder = Object.keys(data.whole);
    const panel = $("[data-bundle-panel]");
    const basket = $("[data-basket]");
    const state = { b: null, size: null, finish: null, units: 12, parts: {}, list: [], picks: {}, split: null };
    /* The basket bar shows while units are in the basket and neither the basket
       nor the enquiry form is on screen. */
    const bar = $("[data-basket-bar]");
    const seen = new Set();
    const showBar = () => { bar.hidden = !state.list.length || seen.size > 0; };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
        showBar();
      });
      io.observe(basket);
      io.observe(document.getElementById("booking-form"));
    }

    const chip = (label, on, click, disabled) => {
      const el = document.createElement("button");
      el.type = "button";
      el.className = "chip";
      el.textContent = label;
      el.setAttribute("aria-pressed", on ? "true" : "false");
      if (disabled) el.disabled = true;
      el.addEventListener("click", click);
      return el;
    };
    const stepper = (n, set, label, min, max) => {
      const ctrl = document.createElement("span");
      ctrl.className = "addon-ctrl";
      const minus = chip("−", false, () => set(n - 1), n <= min);
      minus.setAttribute("aria-label", "One fewer: " + label);
      const count = document.createElement("span");
      count.className = "addon-count";
      count.textContent = String(n);
      const plus = chip("+", false, () => set(n + 1), n >= max);
      plus.setAttribute("aria-label", "One more: " + label);
      ctrl.append(minus, count, plus);
      return ctrl;
    };
    const addonRow = (k, n, set, suffix) => {
      const a = all[k];
      const li = document.createElement("li");
      li.className = "addon";
      const name = document.createElement("span");
      name.className = "addon-name";
      name.textContent = a.name + ", " + suffix + d(money(a.price));
      li.append(name, stepper(n, set, a.name, 0, 20));
      return li;
    };

    const partsValue = (parts) => Object.keys(parts).reduce((s, k) => s + all[k].price * (parts[k] || 0), 0);
    const partsText = (parts) => Object.keys(parts).filter((k) => parts[k] > 0).map((k) => all[k].name + " × " + parts[k]).join("; ");

    /* The starting price as configured, before parts and extras. */
    const basePrice = () => {
      const b = state.b;
      if (!b) return null;
      if (b.sizes && state.size === null) return null;
      if (b.finishes && state.finish === null) return null;
      if (b.kind === "kitchen") {
        const v = Math.round((data.finishStep[state.finish] * (b.from + Math.max(0, state.units - b.unitsIncluded) * b.perUnit)) / 50) * 50;
        const published = state.finish === 0 && state.units <= b.unitsIncluded;
        return { value: v, draft: !published, text: "indicative from " + (published ? money(v) : d(money(v))) };
      }
      if (b.perProject) return { value: b.from, draft: false, text: "indicative, priced per project " + b.fromText };
      const v = b.prices[b.finishes ? state.finish : 0][state.size];
      if (v === null) return { value: null, draft: true, text: d("price to come") };
      return {
        value: v, draft: !!b.boxDraft,
        text: (b.priceLabel ? b.priceLabel + ", " : "") + "indicative " + (b.around ? "from around " : "from ") + (b.boxDraft ? d(money(v)) : money(v)),
      };
    };
    const unitNow = () => {
      const p = basePrice();
      if (!p) return null;
      const extras = partsValue(state.parts);
      return { p, extras, total: p.value === null ? null : p.value + extras, draft: p.draft || extras > 0 };
    };

    /* How a list of units and the picks on the house split: the allowance
       follows the quotation, units plus anything picked past the allowance. */
    const split = (list, picks) => {
      const base = list.reduce((s, u) => s + (u.value || 0), 0);
      const keys = addonOrder.filter((k) => list.some((u) => u.addons.includes(k))).concat(base >= data.wholeFrom ? wholeOrder : []);
      const used = keys.reduce((s, k) => s + all[k].price * (picks[k] || 0), 0);
      let allow = allowance(base);
      let extra = Math.max(0, used - allow);
      for (let i = 0; base && i < 4; i++) { allow = allowance(base + extra); extra = Math.max(0, used - allow); }
      return { base, keys, allow, included: used - extra, extra, quote: base + extra, draft: list.some((u) => u.draft) };
    };
    const nextLine = (quote) => {
      const nb = nextBand(quote);
      if (!nb) return "";
      return "At " + money(nb[0]) + ", extras worth " + d(money(nb[1])) + " come on the house" +
        (nb[0] === data.wholeFrom ? ", enough for a whole library unit" : "") + ". Your basket is " + money(nb[0] - quote) + " away.";
    };

    const renderPanel = () => {
      const b = state.b;
      if (!b) { panel.hidden = true; return; }
      panel.hidden = false;
      $("[data-panel-title]").textContent = b.label;

      $("[data-step-size]").hidden = !b.sizes;
      $("[data-size-label]").textContent = b.sizeLabel || "Size";
      const siz = $("[data-chips-size]"); siz.replaceChildren();
      (b.sizes || []).forEach((s, i) => siz.append(chip(s, state.size === i, () => { state.size = i; renderPanel(); })));

      $("[data-step-units]").hidden = b.kind !== "kitchen";
      if (b.kind === "kitchen") $("[data-units-ctrl]").replaceChildren(stepper(state.units, (n) => { state.units = n; renderPanel(); }, "kitchen unit", 4, 40));

      $("[data-step-finish]").hidden = !b.finishes;
      const fin = $("[data-chips-finish]"); fin.replaceChildren();
      (b.finishes || []).forEach((f, i) => {
        const t = document.createElement("button");
        t.type = "button";
        t.className = "finish-tile";
        t.setAttribute("aria-pressed", state.finish === i ? "true" : "false");
        const pic = document.createElement("span");
        pic.className = "finish-pic" + (f.wash ? " " + f.wash : "");
        const img = document.createElement("img");
        img.src = f.img; img.alt = ""; img.loading = "lazy"; img.width = 400; img.height = 300;
        pic.append(img);
        const name = document.createElement("span");
        name.textContent = f.name;
        t.append(pic, name);
        t.addEventListener("click", () => { state.finish = i; renderPanel(); });
        fin.append(t);
      });

      const now = unitNow();
      const need = b.sizes && state.size === null
        ? (b.sizeLabel === "Doors" ? "how many doors" : "a " + (b.sizeLabel || "size").toLowerCase())
        : "a finish";
      $("[data-result]").textContent = now ? b.label + ": " + now.p.text + "." : "Choose " + need + " to see an indicative price.";
      $("[data-includes]").textContent = b.includes || "";
      const il = $("[data-includes-list]"); il.replaceChildren();
      (b.includesList || []).forEach((t) => { const li = document.createElement("li"); li.textContent = t; il.append(li); });
      il.hidden = !b.includesList;

      const ps = $("[data-step-parts]");
      ps.hidden = !(now && b.parts);
      if (now && b.parts) {
        $("[data-parts-label]").textContent = b.partsLabel;
        const typ = b.typical && state.size !== null ? b.typical[state.size] : null;
        $("[data-typical-wrap]").hidden = !typ;
        if (typ) $("[data-typical]").textContent = "Fill with a typical inside: " + typ.text;
        const list = $("[data-parts]"); list.replaceChildren();
        b.parts.forEach((k) => list.append(addonRow(k, state.parts[k] || 0, (m) => { state.parts[k] = Math.max(0, m); renderPanel(); }, "")));
      }

      const ut = $("[data-unit-total]");
      const pn = $("[data-panel-nudge]");
      ut.hidden = !(now && now.total !== null);
      pn.hidden = true;
      if (now && now.total !== null) {
        ut.textContent = "This unit: indicative from " + (now.draft ? d(money(now.total)) : money(now.total)) +
          (now.extras ? ", with " + d(money(now.extras)) + " of parts and extras" : "") + ".";
        const s = split(state.list.concat([{ value: now.total, addons: b.addons, draft: now.draft }]), state.picks);
        const k = Math.floor(s.allow / data.addons.drawer.price);
        const pl = (n, w) => n + " " + w + (n > 1 ? "s" : "");
        const t = (s.allow
          ? "With this unit your basket comes to " + (s.draft ? d(money(s.quote)) : money(s.quote)) + ", and extras worth " + d(money(s.allow)) + " come on the house" +
            (s.base >= data.wholeFrom ? ", enough for a whole unit. "
              : k <= 6 ? ": that is " + pl(k, "more soft-close drawer") + " at £0, or lighting in " + pl(k, "section") + ". "
              : ": you pick them in your basket. ")
          : "") + nextLine(s.quote);
        pn.textContent = t.trim();
        pn.hidden = !t.trim();
      }
      $("[data-add]").disabled = !now;
    };

    const renderBasket = () => {
      if (!state.list.length) { basket.hidden = true; showBar(); return; }
      basket.hidden = false;
      const ul = $("[data-basket-list]"); ul.replaceChildren();
      state.list.forEach((u, i) => {
        const li = document.createElement("li");
        const t = document.createElement("span");
        t.textContent = u.label + (u.detail ? ", " + u.detail : "") + ": " + u.text;
        const lines = [];
        if (u.partsText) lines.push(u.partsLabel + ": " + u.partsText + ".");
        if (u.included && u.included.length) lines.push("Includes: " + u.included.join("; ") + ".");
        lines.forEach((x) => { const sm = document.createElement("small"); sm.className = "basket-incl"; sm.textContent = x; t.append(sm); });
        const rm = document.createElement("button");
        rm.type = "button"; rm.className = "basket-remove"; rm.textContent = "Remove";
        rm.setAttribute("aria-label", "Remove " + u.label);
        rm.addEventListener("click", () => { state.list.splice(i, 1); renderBasket(); });
        li.append(t, rm);
        ul.append(li);
      });
      const keys = split(state.list, {}).keys;
      Object.keys(state.picks).forEach((k) => { if (!keys.includes(k)) delete state.picks[k]; });
      const s = split(state.list, state.picks);
      state.split = s;
      const pending = state.list.some((u) => u.value === null);
      $("[data-total]").textContent = "Indicative total: from " + (s.draft ? d(money(s.base)) : money(s.base)) +
        (pending ? ", plus a unit with its price to come" : "") + "." + (s.allow ? " Extras worth " + d(money(s.allow)) + " come on the house." : "");
      const wh = $("[data-library]");
      wh.hidden = s.base < data.wholeFrom;
      wh.textContent = "Your basket is past " + d(money(data.wholeFrom)) + ", so what is on the house can be a whole unit: pick one below, at its normal starting price.";
      const nudge = $("[data-nudge]");
      const nl = nextLine(s.quote);
      nudge.hidden = !nl;
      nudge.textContent = nl;
      $("[data-meter]").textContent = s.allow
        ? "On the house: " + d(money(s.included)) + " of " + d(money(s.allow)) + " chosen" + (s.extra ? ". Beyond that, at normal prices: " + d(money(s.extra)) : "") + "."
        : "Extras come on the house from a basket of " + money(data.bands[0][0]) + ".";
      const addons = $("[data-addons]"); addons.replaceChildren();
      s.keys.forEach((k) => {
        if (k === wholeOrder[0]) {
          const h = document.createElement("li");
          h.className = "addon-group";
          h.textContent = "Or a whole unit";
          addons.append(h);
        }
        addons.append(addonRow(k, state.picks[k] || 0, (m) => { state.picks[k] = Math.max(0, m); renderBasket(); }, "normally "));
      });
      const n = state.list.length;
      $("[data-basket-bar-text]").textContent = n + " unit" + (n > 1 ? "s" : "") + ", from " + (s.draft ? d(money(s.base)) : money(s.base)) +
        (s.allow ? ", " + d(money(s.allow)) + " on the house" : "");
      showBar();
      $("[data-estimate]").textContent = "Indicative estimate with everything on it: from " + d(money(s.quote)) +
        ". The firm figure is the itemised quotation, after a measured survey or from your photos and measurements.";
    };

    document.querySelectorAll("[data-bundle]").forEach((card) => {
      card.addEventListener("click", () => {
        const b = data.bundles.find((x) => x.id === card.dataset.bundle);
        document.querySelectorAll("[data-bundle]").forEach((c) => c.setAttribute("aria-pressed", c === card ? "true" : "false"));
        state.b = b; state.size = null; state.finish = null; state.units = b.unitsIncluded || 12; state.parts = {};
        renderPanel();
        panel.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    $("[data-typical]").addEventListener("click", () => {
      const b = state.b;
      if (!b || !b.typical || state.size === null) return;
      state.parts = Object.assign({}, b.typical[state.size].parts);
      renderPanel();
    });

    $("[data-add]").addEventListener("click", () => {
      const b = state.b; const now = unitNow();
      if (!b || !now) return;
      const detail = [
        b.kind === "kitchen" ? state.units + " units" : "",
        b.sizes && state.size !== null ? b.sizes[state.size] : "",
        b.finishes && state.finish !== null ? b.finishes[state.finish].name : "",
      ].filter(Boolean).join(", ");
      state.list.push({
        id: b.id, label: b.label, detail, value: now.total, draft: now.draft,
        text: now.total === null ? now.p.text : "indicative from " + (now.draft ? d(money(now.total)) : money(now.total)),
        partsText: partsText(state.parts), partsLabel: b.partsLabel, addons: b.addons, included: b.id === "wardrobe" ? [] : b.included,
      });
      state.b = null; state.parts = {};
      document.querySelectorAll("[data-bundle]").forEach((c) => c.setAttribute("aria-pressed", "false"));
      renderPanel();
      renderBasket();
      basket.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    $("[data-send]").addEventListener("click", () => {
      const sp = state.split;
      if (!state.list.length || !sp) return;
      const units = state.list.map((u) => u.label + (u.detail ? " (" + u.detail + ")" : "") + ": " + u.text + (u.partsText ? "; " + u.partsText : "")).join(" | ");
      const quick = units + ". Indicative total from " + money(sp.base) + (sp.extra ? ", with extras beyond what is included from " + money(sp.quote) : "");
      const picks = Object.entries(state.picks).filter(([, n]) => n > 0).map(([k, n]) => n + " x " + all[k].name).join("; ");
      const form = document.querySelector("#booking-form form");
      form.querySelector("[data-quick-price]").value = quick;
      form.querySelector("[data-bonus-picks]").value = picks
        ? picks + " (" + money(sp.included) + " on the house" + (sp.extra ? ", " + money(sp.extra) + " beyond at normal prices" : "") + ")"
        : "";
      form.querySelectorAll("input[name=service]").forEach((box) => { if (state.list.some((u) => u.label === box.value)) box.checked = true; });
      const summary = $("[data-bundle-summary]");
      summary.textContent = "Your basket: " + quick + "." + (picks ? " On the house: " + picks + "." : "");
      summary.hidden = false;
      document.getElementById("booking-form").scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>

