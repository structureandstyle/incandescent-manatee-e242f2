---
/**
 * PREVIEW ONLY, 12 Nov 2026 (branch flowtoform/booking-2027-preview): the
 * early-2027 booking page, where the Google post, the site band and the
 * quotations send people. Arthur's brief: one page for every service, the
 * visitor ticks what they want made and which extras they would choose, no
 * project value asked.
 *
 * Every figure in [brackets] is a draft waiting on Kaspar: the band values and
 * normal prices come from the cost guide preview (ss-cost-extras-preview) and
 * go live only once his real prices are live there first, so "normally £300"
 * has a real price behind it (CAP 3.7; DMCCA 2024 Sch 20 para 23). The deposit
 * is open: his schedule says 20%, Arthur floated 5 to 20% (12 Nov voice note).
 *
 * Copy to protocol v1.4: no "offer", "deal", "discount", "limited time" or
 * "free"; facts, not the promise formula; the closing date stated once and
 * never extended (Sch 20 para 7). noindex: a temporary page, removed on
 * 1 February 2027 with a redirect to /fitted-wardrobe-cost/.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import Plate from "../components/ds/Plate.astro";

const BANDS = [
  ["£2,000 to £2,999", "up to [£300]"],
  ["£3,000 to £4,999", "up to [£450]"],
  ["£5,000 to £7,999", "up to [£750]"],
  ["£8,000 and over", "up to [£1,000]"],
];

const EXTRAS = [
  ["LED lighting with a door sensor, per hanging section", "[£150]"],
  ["Soft-close drawer inside the wardrobe, each", "[£150]"],
  ["Pull-out trouser rail", "[£150]"],
  ["Pull-out shoe rack", "[£180]"],
  ["Lined jewellery or accessory tray", "[£150]"],
  ["Full-length mirror inside a door", "[£200]"],
];

const STEPS = [
  "Tell us what you would like made and which extras you would choose, using the form below.",
  "We visit, measure, and send a fixed, itemised quotation with your extras on it.",
  "The booking is made when the quotation is accepted and the [20%] deposit is paid, by Sunday 31 January 2027. The fitting date is agreed then.",
];

const TERMS = [
  "Booked means the quotation accepted in writing and the [20%] deposit paid by 11.59pm on Sunday 31 January 2027.",
  "Applies to fitted wardrobe, walk-in wardrobe and alcove jobs with a quotation of £2,000 or more.",
  "The quotation total before extras sets how much is included.",
  "Each extra appears on the quotation as its own line at £0. Its normal price is the price on our cost guide, and what we charge for it on any other job.",
  "Prices are unchanged. The quotation is the normal itemised price for the job.",
  "Lighting needs a power supply that can reach the wardrobe, which we check at the visit. Where it cannot, other extras of the same value are included.",
  "Extras cannot be exchanged for money, swapped for a lower price or moved to another job.",
  "The fitting date is agreed when the deposit is paid.",
  "Your cancellation rights are not affected.",
  "The closing date will not be extended.",
  "No VAT is added: we are not currently VAT registered.",
];
---

<Base
  title="Booking for early 2027"
  description="Fitted wardrobe, walk-in and alcove jobs booked by 31 January 2027 include extras at no cost, chosen from our price list. Prices unchanged, no VAT added."
  noindex={true}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Early 2027</Kicker>
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      Booking now for early 2027
    </Display>
    <div class="booking-hero">
      <div class="booking-photo">
        <Plate
          photo="/images/fitted-wardrobes/fitted-wardrobes-05.webp"
          alt="A fitted wardrobe with its white doors open, showing a light wood-grain interior: a hanging rail under a shelf on the left, and a stack of seven drawers with long bar handles below an open shelf on the right."
          width={1400}
          height={1867}
          label="Fitted wardrobes"
          eager
        />
      </div>
      <div class="booking-lede">
        <p style="font-size:var(--type-lede);color:var(--text-quiet);margin:0">
          Fitted wardrobe, walk-in wardrobe and alcove jobs booked by Sunday 31 January 2027 include
          extras at no cost. The larger the job, the more is included. Prices are unchanged, and no VAT
          is added: we are not currently VAT registered.
        </p>
        <p style="margin-top:var(--space-10)">
          <Link href="#booking-form" variant="nav" chamfer>Tell us about your room</Link>
        </p>
      </div>
    </div>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>What is included</SectionHead>
    <p class="booking-note">
      Each extra appears on the quotation as its own line at £0, beside its normal price. How much is
      included depends on the quotation.
    </p>
    <table class="booking-table">
      <thead><tr><th>Your quotation</th><th>Extras included, at normal prices</th></tr></thead>
      <tbody>{BANDS.map(([a, b]) => <tr><td>{a}</td><td class="num">{b}</td></tr>)}</tbody>
    </table>
    <p class="booking-note">[For example, a £2,500 wardrobe could include lighting in two sections, or two drawers.]</p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>What you can choose</SectionHead>
    <p class="booking-note">
      Normal prices in melamine board, from our <Link href="/fitted-wardrobe-cost/" variant="inline">cost guide</Link>.
      Painted and veneered drawers follow the same steps as the wardrobe prices.
    </p>
    <table class="booking-table">
      <thead><tr><th>Extra</th><th>Normal price</th></tr></thead>
      <tbody>{EXTRAS.map(([a, b]) => <tr><td>{a}</td><td class="num">{b}</td></tr>)}</tbody>
    </table>
    <p class="booking-note">
      Lighting needs a power supply that can reach the wardrobe, which we check at the visit. Where it
      cannot, other extras of the same value are included.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>How booking works</SectionHead>
    <ol class="booking-steps">{STEPS.map((s) => <li>{s}</li>)}</ol>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <div id="booking-form" class="booking-form" style="border:var(--rule-structure);padding:clamp(20px,4vw,40px);background:var(--paper)">
      <MonoLabel as="p" style="margin-bottom:var(--space-10)">Send an enquiry</MonoLabel>
      <EnquiryForm bonusPicker idPrefix="booking-" />
    </div>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>Terms</SectionHead>
    <ul class="booking-terms">{TERMS.map((t) => <li>{t}</li>)}</ul>
  </Wrap>
</Base>

<style>
  .booking-hero {
    display: grid;
    gap: var(--gap-xl);
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
  }
  @media (max-width: 820px) {
    .booking-hero { grid-template-columns: 1fr; }
  }
  .booking-note {
    max-width: var(--measure);
    margin-top: var(--space-6);
    font-size: var(--type-body-sm);
    color: var(--text-quiet);
  }
  .booking-table {
    width: 100%;
    max-width: var(--measure);
    margin-top: var(--space-9);
    border-collapse: collapse;
  }
  .booking-table th {
    text-align: left;
    padding: var(--space-4) var(--space-6) var(--space-4) 0;
    border-bottom: var(--rule-structure);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono-table);
    font-size: var(--type-mono);
    font-weight: var(--weight-regular);
    color: var(--ink-soft);
  }
  .booking-table td {
    padding: var(--space-5) var(--space-6) var(--space-5) 0;
    border-bottom: var(--rule-hair);
    vertical-align: top;
  }
  .booking-table td.num {
    font-family: var(--font-mono);
    font-size: var(--type-mono);
    letter-spacing: var(--ls-mono-table);
    white-space: nowrap;
  }
  .booking-steps,
  .booking-terms {
    max-width: var(--measure);
    margin-top: var(--space-9);
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-5);
  }
  .booking-terms { font-size: var(--type-body-sm); color: var(--text-quiet); }
</style>
