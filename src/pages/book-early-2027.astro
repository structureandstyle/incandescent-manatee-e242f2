---
/**
 * PREVIEW ONLY, 12 Nov 2026 (branch flowtoform/booking-2027-preview): the
 * early-2027 booking page, where the Google post, the site band and the
 * quotations send people. Arthur's brief: one page for every service, the
 * visitor ticks what they want made and which add-ons they would choose, no
 * project value asked.
 *
 * Rev 2 (Arthur's preview comments, 12 Nov): every service he offers; a
 * catchier headline (three versions offered, the first here); "What is
 * included" becomes "Christmas bundles" with five service cards drawn in 2D.
 * Quick prices on three cards first (wardrobes, alcoves, walk-ins), as agreed;
 * TV units and kitchens show their published "from" figure and go straight
 * to the add-ons.
 *
 * THE QUICK PRICE IS ALWAYS A FLOOR. It is the guide starting price from the
 * cost guide, and the quotation can only be the same or higher, so "add-ons
 * worth at least £Y" never promises more than the band the quotation lands in.
 *
 * Every figure in [brackets] is a draft waiting on Kaspar: the band values and
 * add-on prices come from the cost guide preview (ss-cost-extras-preview) and
 * go live only once his real prices are live there first, so "normally £300"
 * has a real price behind it (CAP 3.7; DMCCA 2024 Sch 20 para 23). His own
 * published wardrobe, alcove pair, walk-in, TV unit and kitchen "from" figures
 * are shown as they are. Deposit: Arthur set a draft [15%] on 12 Nov, covering the 2D drawings and elevations (Kaspar confirms). Prices are marked indicative, and a quotation follows a measured survey or the customer's photos and measurements (Arthur, 12 Nov; Kaspar confirms the photo route).
 *
 * Copy to protocol v1.4: no "offer", "deal", "discount", "limited time" or
 * "free"; facts, not the promise formula; the closing date stated once and
 * never extended (Sch 20 para 7). noindex: a temporary page, removed on
 * 1 February 2027 with a redirect to /fitted-wardrobe-cost/.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import FormProof from "../components/FormProof.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import { DRAFT, draft, money, BANDS, WHOLE_FROM } from "../data/booking-2027";

/* Parts and extras at normal prices: the cost guide preview's drafts, plus a
   hanging rail, priced here for the first time. All drafts for Kaspar.
   byFinish: drawers and shelves follow the finish, exactly as the cost guide
   preview's "Extras that follow the finish" table (melamine, hand-painted,
   sprayed, veneered wood); price is the melamine figure. */
const ADDONS = {
  rail: { name: "Hanging rail", price: 50 },
  shelf: { name: "Shelf", price: 50, byFinish: [50, 55, 70, 80] },
  drawer: { name: "Soft-close drawer", price: 150, byFinish: [150, 170, 200, 240] },
  led: { name: "LED lighting with a door sensor, per section", price: 150 },
  trouser: { name: "Pull-out trouser rail", price: 150 },
  shoe: { name: "Pull-out shoe rack", price: 180 },
  pulldown: { name: "Pull-down hanging rail", price: 180 },
  tray: { name: "Lined jewellery or accessory tray", price: 150 },
  mirror: { name: "Full-length mirror inside a door", price: 200 },
};

/* Finish pictures from the materials page (public/images/materials/README.md):
   melamine is his own work, MDF and oak veneer are the supplier samples Denis
   kept on 2 Sep 2026. Hand-painted and sprayed are both MDF, so they share the
   MDF photograph under a colour wash that tells them apart. Decorative beside
   their labels, so alt="" (rule 7). Arthur, 12 Nov: the hero photo goes, the
   material pictures stay. */
const FINISHES = [
  { name: "Melamine board", img: "/images/materials/melamine-board-400w.webp", wash: "" },
  { name: "Hand-painted MDF", img: "/images/materials/mdf-board-400w.webp", wash: "painted" },
  { name: "Sprayed MDF", img: "/images/materials/mdf-board-400w.webp", wash: "sprayed" },
  /* Arthur, 12 Nov: "veneered wood (their choice)", the customer picks the
     wood; priced at his oak veneer figures until he says otherwise. */
  { name: "Veneered wood (your choice)", img: "/images/materials/veneered-board-400w.webp", wash: "" },
];

/* Arthur's upsell ladder, kept inside the 10 to 15%: from £15,000 what is on
   the house is enough for a whole unit, picked like any extra and valued at its
   normal starting price; another finish, or anything past the allowance, at
   normal prices. The library unit's price is a draft; the others are his
   published starting prices in melamine. */
const WHOLE = {
  library: { name: "Library unit, 2.4m high and 1.2m wide", price: 2000 },
  wardrobe2: { name: "2-door wardrobe, a rail and 2 shelves inside", price: 2300 },
  alcoves: { name: "A pair of alcove units", price: 3300 },
  tvunit: { name: "Built-in TV unit, up to " + draft("2.4m") + " wide", price: 3500 },
  wardrobe4: { name: "4-door wardrobe, 2 rails and 4 shelves inside", price: 4000 },
};

/* The wardrobe as an empty box (Arthur, 12 Nov): doors and carcass, Blum
   soft-close hinges, delivery and fitting; then the customer picks the inside
   part by part. His published prices include a basic inside, so the box is
   his price less that inside at the draft part prices (2 doors: a rail and 2
   shelves; 3 doors: 2 rails and 3 shelves; 4 doors: 2 rails and 4 shelves).
   Drafts until he gives box prices. Rows are finishes, columns door counts. */
/* 6 and 8 doors (Denis, 12 Nov): his four-door price times 1.5 and 2, rounded
   to £50. Drafts until he prices them. */
const PUBLISHED = [[2300, 3200, 4000], [2500, 3500, 4500], [3200, 4300, 5400], [3700, 5000, 6300]]
  .map((r) => [...r, Math.round((r[2] * 1.5) / 50) * 50, r[2] * 2]);
const STD_INSIDE = [{ rail: 1, shelf: 2 }, { rail: 2, shelf: 3 }, { rail: 2, shelf: 4 }, { rail: 3, shelf: 6 }, { rail: 4, shelf: 8 }];
/* The basic inside is taken off at the finish's own part prices, so the box
   plus that inside comes back to his published price in every finish. */
const partsValue = (o: Record<string, number>, f: number) =>
  Object.entries(o).reduce((s, [k, n]) => {
    const a = (ADDONS as Record<string, { price: number; byFinish?: number[] }>)[k];
    return s + (a.byFinish ? a.byFinish[f] : a.price) * n;
  }, 0);
const BOX = PUBLISHED.map((row, f) => row.map((v, i) => v - partsValue(STD_INSIDE[i], f)));
/* Kitchens use his four-door wardrobe's finish steps until he prices them. */
const FINISH_STEP = PUBLISHED.map((r) => r[2] / PUBLISHED[0][2]);
const WARDROBE_PARTS = ["rail", "shelf", "drawer", "led", "trouser", "shoe", "pulldown", "tray", "mirror"];

/* included: what each starting price already covers, from his published copy
   and Arthur's comments (Blum hinges from Kaspar's Q28; "Design included"). */
const BUNDLES = [
  {
    id: "wardrobe", label: "Fitted wardrobes", from: BOX[0][0], fromText: "box from " + draft(money(BOX[0][0])),
    sizeLabel: "Doors", sizes: ["2 doors", "3 doors", "4 doors", "6 doors", "8 doors"],
    finishes: FINISHES, prices: BOX, boxDraft: true, priceLabel: "the box",
    typical: [
      { parts: { rail: 1, shelf: 2, drawer: 2 }, text: "a rail, 2 shelves and 2 drawers" },
      { parts: { rail: 2, shelf: 3, drawer: 3 }, text: "2 rails, 3 shelves and 3 drawers" },
      { parts: { rail: 2, shelf: 4, drawer: 4 }, text: "2 rails, 4 shelves and 4 drawers" },
      { parts: { rail: 3, shelf: 6, drawer: 6 }, text: "3 rails, 6 shelves and 6 drawers" },
      { parts: { rail: 4, shelf: 8, drawer: 8 }, text: "4 rails, 8 shelves and 8 drawers" },
    ],
    partsLabel: "What goes inside", parts: WARDROBE_PARTS,
    includes: "The box is the doors and carcass. Then choose what goes inside.",
    included: ["Choose the doors and the finish", "Then build the inside, part by part"],
    addons: WARDROBE_PARTS,
  },
  {
    /* cardFloor: one alcove has no price yet and may sit below the first step,
       so the card promises only that, not the pair's step. */
    id: "alcove", label: "Alcove units and shelving", from: 3300, cardFloor: 2000, fromText: "from £3,300 a pair",
    sizeLabel: "Size", sizes: ["A pair of alcoves", "One alcove"],
    finishes: FINISHES, prices: [[3300, null], [3600, null], [4000, null], [6000, null]],
    partsLabel: "Paid extras, at normal prices", parts: ["shelf", "drawer", "led"],
    includes: "At this price: in each alcove, a base cupboard with two doors and three open shelves above, up to about 1m wide.",
    includesBySizeText: [
      "At this price: in each alcove, a base cupboard with two doors and three open shelves above, up to about 1m wide.",
      "For one alcove: a base cupboard with two doors and three open shelves above, up to about 1m wide.",
    ],
    included: ["A base cupboard and three open shelves, each side", "Up to about 1m wide per alcove"],
    includedBySize: [
      ["A base cupboard and three open shelves, each side", "Up to about 1m wide per alcove"],
      ["A base cupboard and three open shelves", "Up to about 1m wide"],
    ],
    addons: ["shelf", "drawer", "led"],
  },
  {
    id: "walkin", label: "Walk-in wardrobes", from: 5000, fromText: "from around £5,000",
    sizeLabel: "Layout", sizes: ["One wall", "Two walls, L-shaped", "Three walls, U-shaped"],
    finishes: null, prices: [[5000, 5000, 5000]], around: true,
    partsLabel: "Paid extras, at normal prices", parts: WARDROBE_PARTS,
    includes: "A walk-in wardrobe is priced per room, by what goes into it, and typically starts from around £5,000. Add any paid extras below.",
    included: ["Layout planned around what you store", "One, two or three walls"],
    addons: WARDROBE_PARTS,
  },
  {
    id: "tv", label: "Built-in TV units", from: 3500, fromText: "from £3,500",
    sizes: null, finishes: FINISHES, prices: null, perProject: true,
    partsLabel: "Paid extras, at normal prices", parts: ["led", "drawer", "shelf"],
    includes: "Built-in TV units are priced per project after one visit, from £3,500.",
    included: ["Layout set around your TV", "Closed cupboards and open sections"],
    addons: ["led", "drawer", "shelf"],
  },
  {
    /* Arthur, 12 Nov: pick how many units, then the finish; design and units
       included, appliances and worktops not. From £10,000 for up to [12]
       units in melamine; each unit beyond that a draft [£850]. */
    id: "kitchen", label: "Bespoke kitchens", from: 10000, fromText: "from £10,000",
    kind: "kitchen", unitsIncluded: 12, perUnit: 850,
    sizes: null, finishes: FINISHES, prices: null,
    partsLabel: "Paid extras, at normal prices", parts: ["led", "drawer"],
    includes: "",
    includesList: ["From £10,000 for up to " + draft("12") + " units in melamine board", "Each unit beyond that about " + draft("£850") + "; other finishes cost more", "Not included: appliances and worktops"],
    included: ["Up to " + draft("12") + " units in melamine board; other finishes cost more", "Appliances and worktops not included"],
    basketIncluded: [], notIncluded: "appliances and worktops",
    addons: ["led", "drawer"],
  },
];

const allowance = (p: number) => BANDS.reduce((a, [min, v]) => (p >= min ? v : a), 0);



const clientData = {
  draft: DRAFT,
  bands: BANDS,
  addons: ADDONS,
  whole: WHOLE,
  wholeFrom: WHOLE_FROM,
  finishStep: FINISH_STEP,
  bundles: BUNDLES.map((b) => ({ ...b })),
};
---

<Base
  title="The Christmas bundle"
  description="Wardrobes, walk-ins, alcove units, TV units and kitchens booked by 31 January 2027 come with extras on the house from a £2,500 basket. Prices unchanged."
  noindex={true}
>
  {/* LANDING PAGE, rev 4 (Arthur, 12 Nov: "make it a landing page, hero
      explains the offer then the options, Hormozi technique, Christmassy").
      Hormozi's value equation, kept inside protocol v1.4 and the pricing law:
      - a named bundle (The Christmas bundle) with the add-ons as named things;
      - dream outcome and time: plan it over Christmas, fitted in the new year;
      - low effort: three steps, one visit, a fixed itemised quotation;
      - likelihood: the live Google rating, two whole reviews, his real
        guarantee (Q35), nothing invented;
      - the value stack shown at normal prices from the cost guide, never a
        "you save" or a struck-out price;
      - urgency and scarcity only where true: the closing date, never
        extended, and a slot count only once Kaspar gives a real one.
      Christmas in the brand palette: the site's green, a berry ribbon in the
      brand's deep red, a drawn holly sprig. No snow, no countdown. */}
  <section class="xmas-hero">
    <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
      <div class="xmas-hero-grid">
        <div class="xmas-hero-copy">
          <p class="xmas-kicker">
            <svg class="holly" viewBox="0 0 40 24" aria-hidden="true"><path d="M20 12 C14 2 6 4 2 8 C7 9 6 14 10 15 C12 11 16 12 20 12 Z" /><path d="M20 12 C26 2 34 4 38 8 C33 9 34 14 30 15 C28 11 24 12 20 12 Z" /><circle cx="17" cy="15" r="3" /><circle cx="23" cy="15" r="3" /><circle cx="20" cy="19" r="3" /></svg>
            Christmas bundles, booking until 31 January 2027
          </p>
          <h1 class="xmas-h1">The Christmas bundle: extras worth up to [15%] of your job, on the house</h1>
          <p class="xmas-lede">
            Fitted wardrobes, walk-ins, alcove units, TV units and kitchens booked by Sunday 31 January 2027
            come with extras on the house that you pick. They start once your basket reaches £2,500. Plan it over Christmas, and it is fitted in the new year.
          </p>
          <p class="xmas-ctas">
            <a class="xmas-btn" href="#bundles">Build your bundle</a>
          </p>
          <p class="xmas-small">Booking closes on Sunday 31 January 2027, and the date will not move.</p>
        </div>
        {/* BALANCE (Arthur, 12 Nov: "the hero looks off, balance it"). With the
            photo gone the right half stood empty. It now holds the bundle at a
            glance, as a gift tag: what is always included, then the ladder of
            add-ons by quotation, ending with the library unit. Text, not a
            picture; brackets mark the drafts. */}
        <aside class="xmas-card" aria-label="What is in the Christmas bundle">
          {/* A red ribbon across the tag, crossing the one down its side, with a bow
              where they meet (Arthur, 12 Nov: "like a red ribbon, something festive"). */}
          <span class="xmas-lid" aria-hidden="true"></span>
          <svg class="xmas-bow" viewBox="0 0 80 56" aria-hidden="true"><path d="M37 31 L25 54 L31.5 51.5 L35 55 L40 32 Z" /><path d="M43 31 L55 54 L48.5 51.5 L45 55 L40 32 Z" /><path d="M40 28 C27 4 3 3 6 19 C9 33 28 33 40 28 Z" /><path d="M40 28 C53 4 77 3 74 19 C71 33 52 33 40 28 Z" /><path class="crease" d="M40 28 C31 16 18 12 13 18" /><path class="crease" d="M40 28 C49 16 62 12 67 18" /><rect x="33" y="21" width="14" height="14" rx="4" /></svg>
          <p class="xmas-card-title xmas-card-ribbon">In every bundle</p>
          <ul class="xmas-card-list">
            {/* Arthur, 12 Nov: the first line read as if every bundle got extras.
                It now says when they start. */}
            <li>From a £2,500 basket, extras on the house that you pick</li>
            <li>Prices unchanged</li>
            <li>A [15%] deposit covers your 2D drawings and elevations, and books your slot</li>
          </ul>
          {/* No prices first thing (Denis, 12 Nov): the ladder became what people pick. */}
          <p class="xmas-card-title">Pick your extras</p>
          <ul class="xmas-card-list">
            <li>Soft-close drawers and shelves</li>
            <li>LED lighting with door sensors</li>
            <li>Shoe racks, trouser rails and mirrors</li>
            <li>On bigger jobs, a whole unit, like a library unit</li>
          </ul>
        </aside>
      </div>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <div id="bundles"></div>
    <SectionHead level={4}>Christmas bundles</SectionHead>
    {/* Three short steps instead of a "How it works" section and a paragraph
        (Denis, 12 Nov). Step 3 in Arthur's words (12 Nov comment). */}
    <ol class="mini-steps">
      <li><span class="mini-n" aria-hidden="true">1</span><span><strong>Build your bundle.</strong> Pick a unit, then what goes inside.</span></li>
      <li><span class="mini-n" aria-hidden="true">2</span><span><strong>We see the space.</strong> A visit, or your photos and measurements, then your quotation.</span></li>
      <li><span class="mini-n" aria-hidden="true">3</span><span><strong>Book by 31 January.</strong> We collect a [15%] deposit for your 2D drawings and elevations, and book your fitting slot.</span></li>
    </ol>

    {/* What every unit shares, said once (Arthur, 12 Nov: "whatever is the same
        across all the products, put it somewhere standard for all of them"). */}
    <div class="std-strip">
      <p class="std-strip-title">Every unit comes with</p>
      <ul class="std-strip-list">
        <li>Design included</li>
        <li>Made to measure</li>
        <li>Delivered and fitted</li>
        <li>Blum soft-close hardware</li>
      </ul>
    </div>

    <div class="bundle-cards" role="list">
      {BUNDLES.map((b) => (
        <button type="button" class="bundle-card" data-bundle={b.id} aria-haspopup="dialog" role="listitem">
          {/* Larger and in colour (Arthur, 12 Nov): brand tokens only, oak and
              walnut timber, green paint, charcoal for the TV and hangers. Tight
              viewBoxes so each drawing fills its card. */}
          <span class="bundle-drawing" aria-hidden="true">
            {b.id === "wardrobe" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="10" y="6" width="140" height="132" /><rect class="f-oak2" x="14" y="16" width="42" height="118" /><rect class="f-oak2" x="59" y="16" width="42" height="118" /><rect class="f-oak2" x="104" y="16" width="42" height="118" /><line class="s-wal" x1="10" y1="12" x2="150" y2="12" /><line class="h" x1="50" y1="64" x2="50" y2="86" /><line class="h" x1="65" y1="64" x2="65" y2="86" /><line class="h" x1="110" y1="64" x2="110" y2="86" /><rect class="f-wal" x="6" y="138" width="148" height="8" /></svg>
            )}
            {b.id === "alcove" && (
              <svg viewBox="0 0 160 150"><rect class="f-greenwash" x="58" y="4" width="44" height="142" /><rect class="f-wal" x="50" y="70" width="60" height="7" /><rect class="f-oak2" x="6" y="98" width="50" height="48" /><line class="s-wal" x1="31" y1="98" x2="31" y2="146" /><rect class="f-oak2" x="104" y="98" width="50" height="48" /><line class="s-wal" x1="129" y1="98" x2="129" y2="146" /><line class="s-wal" x1="6" y1="40" x2="56" y2="40" /><line class="s-wal" x1="6" y1="66" x2="56" y2="66" /><line class="s-wal" x1="104" y1="40" x2="154" y2="40" /><line class="s-wal" x1="104" y1="66" x2="154" y2="66" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="18" y="29" width="6" height="11" /><rect class="f-oak" x="25" y="24" width="8" height="16" /><rect class="f-green" x="110" y="52" width="8" height="14" /><rect class="f-char" x="120" y="55" width="6" height="11" /><rect class="f-oak" x="134" y="28" width="12" height="12" /></svg>
            )}
            {b.id === "walkin" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="6" y="6" width="148" height="138" /><rect class="f-paper" x="12" y="22" width="80" height="116" /><line class="s-wal" x1="12" y1="32" x2="92" y2="32" /><path class="s-wal" d="M22 37 V31 a3 3 0 1 1 6 0" /><path class="f-green" d="M15 42 L19 37 H25 L29 42 V100 H15 Z" /><path class="s-wal" d="M40 37 V31 a3 3 0 1 1 6 0" /><path class="f-oak2" d="M33 42 L37 37 H43 L47 42 V70 H33 Z" /><path class="s-wal" d="M58 37 V31 a3 3 0 1 1 6 0" /><path class="f-wal" d="M51 42 L55 37 H61 L65 42 V92 H51 Z" /><path class="s-wal" d="M76 37 V31 a3 3 0 1 1 6 0" /><path class="f-greenwash" d="M69 42 L73 37 H79 L83 42 V72 H69 Z" /><line class="s-wal" x1="12" y1="118" x2="92" y2="118" /><rect class="f-char" x="18" y="111" width="12" height="7" rx="2" /><rect class="f-char" x="33" y="111" width="12" height="7" rx="2" /><rect class="f-wal" x="52" y="111" width="12" height="7" rx="2" /><rect class="f-wal" x="67" y="111" width="12" height="7" rx="2" /><rect class="f-oak2" x="98" y="22" width="50" height="116" /><line class="s-wal" x1="98" y1="66" x2="148" y2="66" /><line class="s-wal" x1="98" y1="84" x2="148" y2="84" /><line class="s-wal" x1="98" y1="102" x2="148" y2="102" /><line class="s-wal" x1="98" y1="120" x2="148" y2="120" /><line class="h" x1="116" y1="75" x2="130" y2="75" /><line class="h" x1="116" y1="93" x2="130" y2="93" /><line class="h" x1="116" y1="111" x2="130" y2="111" /><line class="h" x1="116" y1="129" x2="130" y2="129" /></svg>
            )}
            {b.id === "tv" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="4" y="6" width="152" height="138" /><rect class="f-char" x="42" y="30" width="76" height="46" /><rect class="f-oak2" x="4" y="100" width="152" height="44" /><line class="s-wal" x1="42" y1="100" x2="42" y2="144" /><line class="s-wal" x1="80" y1="100" x2="80" y2="144" /><line class="s-wal" x1="118" y1="100" x2="118" y2="144" /><line class="s-wal" x1="4" y1="40" x2="36" y2="40" /><line class="s-wal" x1="4" y1="70" x2="36" y2="70" /><line class="s-wal" x1="124" y1="40" x2="156" y2="40" /><line class="s-wal" x1="124" y1="70" x2="156" y2="70" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="19" y="30" width="6" height="10" /><rect class="f-green" x="132" y="58" width="12" height="12" /><line class="s-wal" x1="40" y1="100" x2="120" y2="100" /></svg>
            )}
            {b.id === "kitchen" && (
              <svg viewBox="0 0 160 150"><rect class="f-green" x="6" y="6" width="148" height="42" /><line class="s-paper" x1="43" y1="6" x2="43" y2="48" /><line class="s-paper" x1="80" y1="6" x2="80" y2="48" /><line class="s-paper" x1="117" y1="6" x2="117" y2="48" /><rect class="f-wal" x="2" y="84" width="156" height="9" /><rect class="f-green" x="6" y="93" width="148" height="51" /><line class="s-paper" x1="43" y1="93" x2="43" y2="144" /><line class="s-paper" x1="80" y1="93" x2="80" y2="144" /><line class="s-paper" x1="117" y1="93" x2="117" y2="144" /><line class="s-paper" x1="80" y1="110" x2="117" y2="110" /><line class="s-paper" x1="80" y1="127" x2="117" y2="127" /><line class="h-oak" x1="34" y1="104" x2="34" y2="120" /><line class="h-oak" x1="52" y1="104" x2="52" y2="120" /><line class="h-oak" x1="92" y1="102" x2="105" y2="102" /><line class="h-oak" x1="92" y1="119" x2="105" y2="119" /><line class="h-oak" x1="92" y1="136" x2="105" y2="136" /><rect class="f-oak" x="128" y="70" width="18" height="14" /></svg>
            )}
          </span>
          <span class="bundle-name">{b.label}</span>
          <span class="bundle-from">{b.fromText}</span>
          <ul class="bundle-incl">{b.included.map((i) => <li>{i}</li>)}</ul>
          <span class="bundle-allow">{(b as { around?: boolean }).around ? "Extras on the house, set by your quotation" : allowance((b as { cardFloor?: number }).cardFloor ?? b.from) ? "On the house: extras worth at least " + draft(money(allowance((b as { cardFloor?: number }).cardFloor ?? b.from))) : "Extras on the house from a £2,500 basket"}</span>
          <span class="bundle-cta">Build it <span aria-hidden="true">→</span></span>
        </button>
      ))}
    </div>

    {/* A pop-up window per unit (Arthur, 12 Nov: "when we press on one product it
        shouldn't scroll down, it should pop up a window to finish editing what you
        want inside, then it goes to the basket"). Native <dialog>: Escape, the
        close button or a tap outside closes it; the page stays where it was. */}
    <dialog class="bundle-dialog" data-bundle-dialog aria-labelledby="bundle-dialog-title">
      <div class="bundle-panel" data-bundle-panel>
        <div class="dialog-head">
          <p class="bundle-panel-title" id="bundle-dialog-title" data-panel-title></p>
          <button type="button" class="dialog-close" data-close aria-label="Close">×</button>
        </div>
        <div class="dialog-body" data-dialog-body>
          <div data-step-size class="bundle-step" hidden>
            <MonoLabel as="p"><span data-size-label>Size</span></MonoLabel>
            <div class="chips" data-chips-size></div>
          </div>
          <div data-step-units class="bundle-step" hidden>
            <MonoLabel as="p">How many units</MonoLabel>
            <div data-units-ctrl></div>
          </div>
          <div data-step-finish class="bundle-step" hidden>
            <MonoLabel as="p">Finish</MonoLabel>
            <div class="finish-tiles" data-chips-finish></div>
          </div>
          <p class="bundle-result" data-result></p>
          <p class="booking-note" data-includes></p>
          <ul class="bundle-incl panel-incl" data-includes-list hidden></ul>
          <div data-step-parts class="bundle-step" hidden>
            <MonoLabel as="p"><span data-parts-label>What goes inside</span></MonoLabel>
            <p class="booking-note parts-note">Added to your quotation at normal prices, and counted towards what comes on the house. Extras on the house are picked in your basket.</p>
            <p data-typical-wrap hidden><button type="button" class="chip" data-typical>Fill with a typical inside</button></p>
            <ul class="addon-list" data-parts></ul>
          </div>
        </div>
        <div class="dialog-foot">
          <p class="bundle-result" data-unit-total hidden></p>
          <p class="basket-nudge" data-panel-nudge hidden></p>
          <button type="button" class="bundle-add bundle-add-main" data-add disabled>Add to basket</button>
        </div>
      </div>
    </dialog>

    {/* The basket lives behind an icon that is always on screen (Denis, 12 Nov):
        right-hand side on desktop, top right under the header on phones. It opens
        a drawer with the units, what is on the house, and the send button. */}
    <button type="button" class="basket-fab" data-basket-open aria-label="Open your basket, 0 units">
      <svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10 L10 4 M17 10 L14 4" /><path d="M3 10 H21 L19 20 H5 Z" /><path d="M9 13 V17 M12 13 V17 M15 13 V17" /></svg><span class="basket-fab-count" data-basket-count>0</span>
    </button>
    <div class="basket-toast" data-toast role="status" hidden></div>

    <dialog class="basket-drawer" data-basket-drawer aria-labelledby="basket-title">
      <div class="drawer-panel">
        <div class="dialog-head">
          <p class="bundle-panel-title basket-title" id="basket-title"><svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10 L10 4 M17 10 L14 4" /><path d="M3 10 H21 L19 20 H5 Z" /><path d="M9 13 V17 M12 13 V17 M15 13 V17" /></svg>Your basket</p>
          <button type="button" class="dialog-close" data-basket-close aria-label="Close">×</button>
        </div>
        <div class="dialog-body drawer-body">
          <p class="booking-note" data-basket-empty>Your basket is empty. Pick a unit to start.</p>
          <div class="basket-inner" data-basket hidden>
            <ul class="basket-list" data-basket-list></ul>
            <div class="rcpt-totals" data-total></div>
            <p class="booking-note">Every unit: design included, made to measure, delivered and fitted, Blum soft-close hardware.</p>
            <p class="basket-nudge" data-nudge hidden></p>
            {/* On the house (Denis, 12 Nov): a big headline, a meter that stays in
                view while picking, and two groups that open on a tap. */}
            <section class="onhouse">
              <p class="onhouse-title">On the house</p>
              <p class="onhouse-sub">Each pick here is £0 and fills what is left. To add more at normal prices, add parts inside a unit.</p>
              <div class="onhouse-meter" data-meter></div>
              <details class="onhouse-group">
                <summary>Extras</summary>
                <ul class="addon-list" data-addons></ul>
                <p class="booking-note">Normal prices, as on our <Link href="/fitted-wardrobe-cost/" variant="inline">cost guide</Link>. Lighting needs a power supply that can reach the unit, which we check at the visit.</p>
              </details>
              <details class="onhouse-group">
                <summary>Whole units <span class="onhouse-lock" data-whole-lock></span></summary>
                <p class="booking-note" data-whole-note></p>
                <ul class="addon-list" data-addons-whole></ul>
              </details>
            </section>
            <p class="bundle-estimate" data-estimate></p>
          </div>
        </div>
        <div class="dialog-foot">
          <button type="button" class="bundle-send berry" data-send disabled>Send my basket with an enquiry</button>
          <p class="drawer-links"><button type="button" class="linklike" data-basket-close>Add another unit</button><a href="/book-early-2027/terms/">Booking terms</a></p>
        </div>
      </div>
    </dialog>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>What stands behind it</SectionHead>
    <div class="xmas-proof">
      <div>
        <FormProof quotes={["lorenzo", "ozge"]} keep={1} />
      </div>
      <ul class="xmas-guarantee">
        <li><strong>2 years</strong> on installation and workmanship.</li>
        <li><strong>10 years</strong> on the structure of the joinery.</li>
        <li><strong>Hardware</strong> under its maker's warranty.</li>
        <li><strong>Your cancellation rights</strong> are not affected.</li>
      </ul>
    </div>
  </Wrap>

  <section class="xmas-ribbon">
    <Wrap style="padding-top:var(--space-12);padding-bottom:var(--space-12)">
      <p class="xmas-ribbon-main">Booking closes on Sunday 31 January 2027.</p>
      <p class="xmas-ribbon-sub">[Number] fitting slots between February and April. The date will not be extended.</p>
      <p style="margin-top:var(--space-8)"><a class="xmas-btn xmas-btn-light" href="#bundles">Build your bundle</a></p>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    {/* A small form (Denis, 12 Nov): the basket arrives organised above it, so
        nobody chooses twice; people who skip the builder can still just ask. */}
    <div id="booking-form" class="booking-form">
      <p class="booking-form-title">Send your basket, or just ask</p>
      <div class="basket-summary" data-bundle-summary hidden></div>
      <EnquiryForm bonusPicker compact idPrefix="booking-" />
      <p class="booking-note">Read the <a href="/book-early-2027/terms/">booking terms</a>.</p>
    </div>
  </Wrap>

</Base>

<script is:inline define:vars={{ data: clientData }}>
  /* Bundle builder. A unit's size and finish give its starting price; the parts
     chosen inside it, at normal prices, give the unit total. Units add up in the
     basket; the basket total sets how much comes on the house, picked as items
     at £0. */
  (() => {
    const $ = (s, r = document) => r.querySelector(s);
    const money = (n) => "£" + n.toLocaleString("en-GB");
    const d = (s) => (data.draft ? "[" + s + "]" : s);
    const allowance = (p) => data.bands.reduce((a, [min, v]) => (p >= min ? v : a), 0);
    const nextBand = (p) => data.bands.find(([min]) => min > p) || null;
    const price = (v, dr) => (v === null ? d("price to come") : dr ? d(money(v)) : money(v));
    const line = (label, amount, cls) => {
      const r = document.createElement("div");
      r.className = "rcpt-line" + (cls ? " " + cls : "");
      const l = document.createElement("span"); l.className = "rcpt-label"; l.textContent = label;
      const v = document.createElement("span"); v.className = "rcpt-amt"; v.textContent = amount;
      r.append(l, v);
      return r;
    };
    const all = Object.assign({}, data.addons, data.whole);
    const addonOrder = Object.keys(data.addons);
    const wholeOrder = Object.keys(data.whole);
    const panel = $("[data-bundle-panel]");
    const dialog = $("[data-bundle-dialog]");
    const openDialog = () => {
      if (dialog.open) return;
      if (dialog.showModal) dialog.showModal(); else dialog.setAttribute("open", "");
      $("[data-dialog-body]").scrollTop = 0;
    };
    const closeDialog = () => { if (dialog.open) { if (dialog.close) dialog.close(); else dialog.removeAttribute("open"); } };
    const basket = $("[data-basket]");
    const state = { b: null, size: null, finish: null, units: 12, parts: {}, list: [], picks: {}, order: [], split: null, sent: false };
    const drawer = $("[data-basket-drawer]");
    const fab = $("[data-basket-open]");
    const toast = $("[data-toast]");
    const openDrawer = () => {
      closeDialog();
      toast.hidden = true;
      if (!drawer.open) { if (drawer.showModal) drawer.showModal(); else drawer.setAttribute("open", ""); }
    };
    const closeDrawer = () => { if (drawer.open) { if (drawer.close) drawer.close(); else drawer.removeAttribute("open"); } };
    /* On phones the icon sits top right, just under the sticky header. */
    const header = document.querySelector("header");
    const placeFab = () => {
      fab.style.top = matchMedia("(max-width: 600px)").matches
        ? Math.max(12, (header ? header.getBoundingClientRect().bottom : 0) + 8) + "px" : "";
    };
    addEventListener("scroll", placeFab, { passive: true });
    addEventListener("resize", placeFab);
    placeFab();
    let toastTimer = 0;
    const showToast = (text) => {
      toast.replaceChildren();
      const t = document.createElement("span"); t.textContent = text;
      const v = document.createElement("button"); v.type = "button"; v.textContent = "View basket";
      v.addEventListener("click", openDrawer);
      toast.append(t, v);
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.hidden = true; }, 4000);
    };

    const chip = (label, on, click, disabled) => {
      const el = document.createElement("button");
      el.type = "button";
      el.className = "chip";
      el.textContent = label;
      el.setAttribute("aria-pressed", on ? "true" : "false");
      if (disabled) el.disabled = true;
      el.addEventListener("click", click);
      return el;
    };
    const stepper = (n, set, label, min, max, noMore) => {
      const ctrl = document.createElement("span");
      ctrl.className = "addon-ctrl";
      const minus = chip("−", false, () => set(n - 1), n <= min);
      minus.setAttribute("aria-label", "One fewer: " + label);
      const count = document.createElement("span");
      count.className = "addon-count";
      count.textContent = String(n);
      const plus = chip("+", false, () => set(n + 1), n >= max || !!noMore);
      if (noMore && typeof noMore === "string") plus.title = noMore;
      plus.setAttribute("aria-label", "One more: " + label);
      ctrl.append(minus, count, plus);
      return ctrl;
    };
    const addonRow = (k, n, set, suffix, price, noMore) => {
      const a = all[k];
      const li = document.createElement("li");
      li.className = "addon";
      const name = document.createElement("span");
      name.className = "addon-name";
      name.textContent = a.name + ", " + suffix + d(money(price === undefined ? a.price : price));
      li.append(name, stepper(n, set, a.name, 0, 20, noMore));
      return li;
    };

    /* Drawers and shelves follow the finish, as on the cost guide. A unit with
       no finish choice uses the first column. */
    const priceOf = (k, f) => (all[k].byFinish ? all[k].byFinish[f || 0] : all[k].price);
    const partsValue = (parts, f) => Object.keys(parts).reduce((s, k) => s + priceOf(k, f) * (parts[k] || 0), 0);
    const partsText = (parts) => Object.keys(parts).filter((k) => parts[k] > 0).map((k) => parts[k] + " × " + all[k].name).join("; ");
    /* An extra on the house is valued at the lowest finish among the units it
       can go in, so "worth" never overstates it. */
    const pickPrice = (k, list) => {
      if (!all[k].byFinish) return all[k].price;
      const fs = list.filter((u) => u.addons.includes(k)).map((u) => u.finishIdx || 0);
      return priceOf(k, fs.length ? Math.min(...fs) : 0);
    };

    /* The starting price as configured, before parts and extras. */
    const basePrice = () => {
      const b = state.b;
      if (!b) return null;
      if (b.sizes && state.size === null) return null;
      if (b.finishes && state.finish === null) return null;
      if (b.kind === "kitchen") {
        const v = Math.round((data.finishStep[state.finish] * (b.from + Math.max(0, state.units - b.unitsIncluded) * b.perUnit)) / 50) * 50;
        const published = state.finish === 0 && state.units <= b.unitsIncluded;
        return { value: v, draft: !published, text: "indicative from " + (published ? money(v) : d(money(v))) };
      }
      if (b.perProject) return { value: b.from, draft: false, text: "indicative, priced per project " + b.fromText };
      const v = b.prices[b.finishes ? state.finish : 0][state.size];
      if (v === null) return { value: null, draft: true, text: d("price to come") };
      return {
        value: v, draft: !!b.boxDraft,
        text: (b.priceLabel ? b.priceLabel + ", " : "") + "indicative " + (b.around ? "from around " : "from ") + (b.boxDraft ? d(money(v)) : money(v)),
      };
    };
    const unitNow = () => {
      const p = basePrice();
      if (!p) return null;
      const extras = partsValue(state.parts, state.b.finishes ? state.finish : 0);
      return { p, extras, total: p.value === null ? null : p.value + extras, draft: p.draft || extras > 0 };
    };

    /* What comes on the house. The units and their parts set the step, and that
       is the whole quotation, because extras picked here are £0 lines. Picks are
       kept as single items in the order they were made; they can never go past
       the allowance, and a smaller basket drops the latest ones first. */
    const split = (list, order) => {
      const base = list.reduce((s, u) => s + (u.value || 0), 0);
      const keys = addonOrder.filter((k) => list.some((u) => u.addons.includes(k))).concat(base >= data.wholeFrom ? wholeOrder : []);
      const allow = allowance(base);
      const items = (order || []).filter((k) => keys.includes(k));
      let used = items.reduce((t, k) => t + pickPrice(k, list), 0);
      while (used > allow && items.length) used -= pickPrice(items.pop(), list);
      const lines = [];
      items.forEach((k) => {
        const l = lines.find((x) => x.k === k);
        if (l) l.n += 1; else lines.push({ k, p: pickPrice(k, list), n: 1 });
      });
      const room = allow - used;
      const cheapest = keys.length ? Math.min(...keys.filter((k) => !(wholeOrder.includes(k) && items.some((x) => wholeOrder.includes(x)))).map((k) => pickPrice(k, list))) : Infinity;
      return {
        base, keys, allow, room, lines, items, included: used, spendable: room >= cheapest,
        pending: list.some((u) => u.pending), around: list.some((u) => u.around), draft: list.some((u) => u.draft),
      };
    };
    const step = (n) => (n >= data.wholeFrom ? d(money(n)) : money(n));
    const about = (s) => (s.around ? "about " : "");
    const nextLine = (s) => {
      if (s.pending) return "A unit with its price to come is priced at the quotation, and counts towards what comes on the house.";
      const nb = nextBand(s.base);
      if (!nb) return "";
      return "At " + step(nb[0]) + ", extras worth " + d(money(nb[1])) + " come on the house" +
        (nb[0] === data.wholeFrom ? ", enough for a whole library unit" : "") + ". Your basket is " + money(nb[0] - s.base) + " away.";
    };
    const totalLabel = (s) => "Indicative total, from" + (s.around ? " around" : "");
    const totalAmount = (s) => (!s.base && s.pending ? d("price to come") : price(s.base, s.draft));

    const renderPanel = () => {
      const b = state.b;
      if (!b) return;
      $("[data-panel-title]").textContent = b.label;

      $("[data-step-size]").hidden = !b.sizes;
      $("[data-size-label]").textContent = b.sizeLabel || "Size";
      const siz = $("[data-chips-size]"); siz.replaceChildren();
      (b.sizes || []).forEach((s, i) => siz.append(chip(s, state.size === i, () => { state.size = i; renderPanel(); })));

      $("[data-step-units]").hidden = b.kind !== "kitchen";
      if (b.kind === "kitchen") $("[data-units-ctrl]").replaceChildren(stepper(state.units, (n) => { state.units = n; renderPanel(); }, "kitchen unit", 4, 40));

      $("[data-step-finish]").hidden = !b.finishes;
      const fin = $("[data-chips-finish]"); fin.replaceChildren();
      (b.finishes || []).forEach((f, i) => {
        const t = document.createElement("button");
        t.type = "button";
        t.className = "finish-tile";
        t.setAttribute("aria-pressed", state.finish === i ? "true" : "false");
        const pic = document.createElement("span");
        pic.className = "finish-pic" + (f.wash ? " " + f.wash : "");
        const img = document.createElement("img");
        img.src = f.img; img.alt = ""; img.loading = "lazy"; img.width = 400; img.height = 300;
        pic.append(img);
        const name = document.createElement("span");
        name.textContent = f.name;
        t.append(pic, name);
        t.addEventListener("click", () => { state.finish = i; renderPanel(); });
        fin.append(t);
      });

      const now = unitNow();
      const need = b.sizes && state.size === null
        ? (b.sizeLabel === "Doors" ? "how many doors" : "a " + (b.sizeLabel || "size").toLowerCase())
        : "a finish";
      $("[data-result]").textContent = now ? b.label + ": " + now.p.text + "." : "Choose " + need + " to see an indicative price.";
      $("[data-includes]").textContent = (b.includesBySizeText && state.size !== null ? b.includesBySizeText[state.size] : b.includes) || "";
      const il = $("[data-includes-list]"); il.replaceChildren();
      (b.includesList || []).forEach((t) => { const li = document.createElement("li"); li.textContent = t; il.append(li); });
      il.hidden = !b.includesList;

      const ps = $("[data-step-parts]");
      ps.hidden = !(now && b.parts);
      if (now && b.parts) {
        $("[data-parts-label]").textContent = b.partsLabel;
        const typ = b.typical && state.size !== null ? b.typical[state.size] : null;
        $("[data-typical-wrap]").hidden = !typ;
        if (typ) $("[data-typical]").textContent = "Fill with a typical inside: " + typ.text;
        const list = $("[data-parts]"); list.replaceChildren();
        const fi = b.finishes ? state.finish : 0;
        b.parts.forEach((k) => list.append(addonRow(k, state.parts[k] || 0, (m) => { state.parts[k] = Math.max(0, m); renderPanel(); }, "", priceOf(k, fi))));
      }

      const ut = $("[data-unit-total]");
      const pn = $("[data-panel-nudge]");
      ut.hidden = !(now && (now.total !== null || now.extras));
      pn.hidden = true;
      if (now && (now.total !== null || now.extras)) {
        ut.textContent = now.total === null
          ? "This unit: " + d("price to come") + ", with " + d(money(now.extras)) + " of parts and extras."
          : "This unit: indicative from " + (b.around ? "around " : "") + (now.draft ? d(money(now.total)) : money(now.total)) +
            (now.extras ? ", with " + d(money(now.extras)) + " of parts and extras" : "") + ".";
        const hypo = state.list.concat([{
          value: now.total === null ? now.extras : now.total, pending: now.total === null,
          addons: b.addons, draft: now.draft, finishIdx: b.finishes ? state.finish : 0, around: !!b.around,
        }]);
        const s = split(hypo, state.order);
        const kd = Math.floor(s.room / pickPrice("drawer", hypo));
        const kl = b.addons.includes("led") ? Math.floor(s.room / pickPrice("led", hypo)) : 0;
        const hasWhole = s.items.some((k) => wholeOrder.includes(k));
        const pl = (n, w) => n + " " + w + (n > 1 ? "s" : "");
        const t = (s.allow && !s.pending
          ? "With this unit your basket comes to " + (s.around ? "around " : "") + price(s.base, s.draft) +
            ", and extras worth " + about(s) + d(money(s.allow)) + " come on the house" + (s.around ? ", set by your quotation" : "") +
            (s.included ? ", " + d(money(s.included)) + " of it already picked" : "") +
            (!s.spendable ? ". " :
              s.base >= data.wholeFrom && !hasWhole && s.room >= pickPrice("library", hypo) ? ": room for a whole unit. "
              : kd >= 1 && kd <= 6 ? ": room for " + pl(kd, "more soft-close drawer") + " at £0" + (kl ? ", or lighting in " + pl(kl, "section") : "") + ". "
              : ": you pick them in your basket. ")
          : "") + nextLine(s);
        pn.textContent = t.trim();
        pn.hidden = !t.trim();
      }
      $("[data-add]").disabled = !now;
    };

    /* One entry per item, in the order picked; a minus takes off the latest of
       that extra. Whole units: one per basket. */
    const setPick = (k, m) => {
      const have = state.order.filter((x) => x === k).length;
      const want = Math.max(0, m);
      for (let i = have; i < want; i++) state.order.push(k);
      for (let i = want; i < have; i++) state.order.splice(state.order.lastIndexOf(k), 1);
      renderBasket();
    };

    const renderBasket = () => {
      const n = state.list.length;
      $("[data-basket-count]").textContent = String(n);
      fab.setAttribute("aria-label", "Open your basket, " + n + " unit" + (n === 1 ? "" : "s"));
      fab.classList.toggle("has-items", n > 0);
      $("[data-basket-empty]").hidden = n > 0;
      basket.hidden = !n;
      $("[data-send]").disabled = !n;
      if (!n) { state.split = null; state.picks = {}; state.order = []; fillForm(null); return; }

      /* The basket as a receipt: prices on the right, then what is on the house
         at £0 with its value, then the total. */
      const ul = $("[data-basket-list]"); ul.replaceChildren();
      state.list.forEach((u, i) => {
        const li = document.createElement("li");
        li.className = "rcpt-unit";
        const name = document.createElement("p");
        name.className = "rcpt-name";
        name.textContent = u.label + (u.detail ? ", " + u.detail : "");
        li.append(name, line(u.baseLabel, price(u.baseValue, u.baseDraft), "rcpt-part"));
        Object.keys(u.parts || {}).filter((k) => u.parts[k] > 0)
          .forEach((k) => li.append(line(u.parts[k] + " × " + all[k].name, d(money(priceOf(k, u.finishIdx) * u.parts[k])), "rcpt-part")));
        if (u.included && u.included.length) {
          const inc = document.createElement("small"); inc.className = "basket-incl";
          inc.textContent = "Includes: " + u.included.join("; ") + ".";
          li.append(inc);
        }
        if (u.notIncluded) {
          const ni = document.createElement("small"); ni.className = "basket-incl";
          ni.textContent = "Not included: " + u.notIncluded + ".";
          li.append(ni);
        }
        const rm = document.createElement("button");
        rm.type = "button"; rm.className = "basket-remove"; rm.textContent = "Remove";
        rm.setAttribute("aria-label", "Remove " + u.label);
        rm.addEventListener("click", () => { state.list.splice(i, 1); renderBasket(); });
        li.append(rm);
        ul.append(li);
      });

      /* Keep the picks to what fits; a smaller basket drops the latest first. */
      const s = split(state.list, state.order);
      const trimmed = s.items.length < state.order.length;
      state.order = s.items.slice();
      state.picks = {};
      s.items.forEach((k) => { state.picks[k] = (state.picks[k] || 0) + 1; });
      state.split = s;

      const tot = $("[data-total]"); tot.replaceChildren();
      if (s.lines.length) {
        tot.append(line("On the house", "", "rcpt-oh-head"));
        s.lines.forEach((l) => tot.append(line(l.n + " × " + all[l.k].name + ", worth " + d(money(l.p * l.n)), "£0", "rcpt-oh")));
      }
      if (trimmed) tot.append(line("Some extras on the house no longer fit your basket and came off.", "", "rcpt-left"));
      if (s.included) tot.append(line("Extras on the house, worth", d(money(s.included)), "rcpt-worth"));
      if (s.allow && s.room && s.spendable) tot.append(line("Still to choose, on the house", d(money(s.room)), "rcpt-left"));
      if (!s.allow && s.base && !s.pending) tot.append(line("Extras on the house from a " + money(data.bands[0][0]) + " basket", money(data.bands[0][0] - s.base) + " away", "rcpt-left"));
      tot.append(line(totalLabel(s), totalAmount(s), "rcpt-total"));
      if (s.pending && s.base) tot.append(line("Plus a unit with its price to come", "", "rcpt-left"));

      const nudge = $("[data-nudge]");
      const nl = s.allow || s.pending ? nextLine(s) : "";
      nudge.hidden = !nl;
      nudge.textContent = nl;

      const meter = $("[data-meter]"); meter.replaceChildren();
      const big = document.createElement("strong");
      const small = document.createElement("span");
      if (s.allow) {
        big.textContent = d(money(s.included)) + " of " + about(s) + d(money(s.allow)) + " chosen";
        small.textContent = (s.room && s.spendable ? d(money(s.room)) + " left to choose" : "All chosen") + (s.around ? "; the amount is set by your quotation" : "");
      } else {
        big.textContent = "From a " + money(data.bands[0][0]) + " basket";
        small.textContent = s.pending ? "Set once your quotation prices the unit."
          : "Your basket is " + money(data.bands[0][0] - s.base) + " away. Parts you add inside a unit count towards it.";
      }
      meter.append(big, small);

      const hasWhole = s.items.some((k) => wholeOrder.includes(k));
      const row = (k) => {
        const pp = pickPrice(k, state.list);
        const isWhole = wholeOrder.includes(k);
        const why = isWhole && hasWhole ? "One whole unit per basket" : pp > s.room ? "More than is left on the house" : "";
        const r = addonRow(k, state.picks[k] || 0, (m) => setPick(k, m), "", pp, why || false);
        return r;
      };
      const parts = $("[data-addons]"); parts.replaceChildren();
      s.keys.filter((k) => addonOrder.includes(k)).forEach((k) => parts.append(row(k)));
      const whole = $("[data-addons-whole]"); whole.replaceChildren();
      const canWhole = s.base >= data.wholeFrom;
      $("[data-whole-lock]").textContent = canWhole ? "" : "from " + d(money(data.wholeFrom));
      $("[data-whole-note]").textContent = canWhole
        ? "One whole unit per basket, at its normal starting price, and extras with whatever is left."
        : s.pending ? "Whole units come from " + d(money(data.wholeFrom)) + "."
        : "Your basket reaches whole units at " + d(money(data.wholeFrom)) + ": " + money(data.wholeFrom - s.base) + " away.";
      if (canWhole) wholeOrder.forEach((k) => whole.append(row(k)));
      $("[data-estimate]").textContent = "Indicative guide prices. The firm figure is the itemised quotation, after a measured survey or from your photos and measurements.";
      if (state.sent) fillForm(s);
    };

    document.querySelectorAll("[data-bundle]").forEach((card) => {
      card.addEventListener("click", () => {
        const b = data.bundles.find((x) => x.id === card.dataset.bundle);
        state.b = b; state.size = null; state.finish = null; state.units = b.unitsIncluded || 12; state.parts = {};
        renderPanel();
        openDialog();
      });
    });

    $("[data-close]").addEventListener("click", closeDialog);
    dialog.addEventListener("click", (e) => { if (e.target === dialog) closeDialog(); });
    dialog.addEventListener("close", () => { state.b = null; state.parts = {}; });

    $("[data-typical]").addEventListener("click", () => {
      const b = state.b;
      if (!b || !b.typical || state.size === null) return;
      state.parts = Object.assign({}, b.typical[state.size].parts);
      renderPanel();
    });

    $("[data-add]").addEventListener("click", () => {
      const b = state.b; const now = unitNow();
      if (!b || !now) return;
      const detail = [
        b.kind === "kitchen" ? state.units + " units" : "",
        b.sizes && state.size !== null ? b.sizes[state.size] : "",
        b.finishes && state.finish !== null ? b.finishes[state.finish].name : "",
      ].filter(Boolean).join(", ");
      state.list.push({
        id: b.id, label: b.label, detail, draft: now.draft,
        value: now.total === null ? now.extras : now.total, pending: now.total === null,
        finishIdx: b.finishes ? state.finish : 0,
        around: !!b.around,
        text: now.total === null ? now.p.text : "indicative from " + (b.around ? "around " : "") + (now.draft ? d(money(now.total)) : money(now.total)),
        partsText: partsText(state.parts), partsLabel: b.partsLabel, addons: b.addons,
        included: b.id === "wardrobe" ? [] : b.includedBySize ? b.includedBySize[state.size] : b.basketIncluded || b.included,
        notIncluded: b.notIncluded || "",
        parts: Object.assign({}, state.parts), baseValue: now.p.value, baseDraft: now.p.draft,
        baseLabel: b.priceLabel ? "The box" : b.perProject ? "Starting price, priced per project" : b.around ? "Starting price, around" : "Starting price",
      });
      state.b = null; state.parts = {};
      closeDialog();
      renderBasket();
      fab.classList.remove("bump"); void fab.offsetWidth; fab.classList.add("bump");
      showToast("Added to your basket: " + b.label + ".");
    });

    fab.addEventListener("click", openDrawer);
    document.querySelectorAll("[data-basket-close]").forEach((el) => el.addEventListener("click", closeDrawer));
    drawer.addEventListener("click", (e) => { if (e.target === drawer) closeDrawer(); });

    /* Puts the basket into the enquiry form: the hidden fields for the email,
       and a summary above the form of units, parts and what is on the house.
       Runs on Send and again after every change once sent; an empty basket
       clears it and brings the services question back. */
    const fillForm = (sp) => {
      const form = document.querySelector("#booking-form form");
      const summary = $("[data-bundle-summary]");
      const sf = form.querySelector("[data-services-field]");
      if (!sp || !state.list.length) {
        form.querySelector("[data-quick-price]").value = "";
        form.querySelector("[data-bonus-picks]").value = "";
        if (state.sent) form.querySelectorAll("input[name=service]").forEach((box) => { box.checked = false; });
        if (sf) sf.hidden = false;
        summary.replaceChildren();
        summary.hidden = true;
        state.sent = false;
        return;
      }
      const totalTxt = totalLabel(sp) + " " + totalAmount(sp) + (sp.pending && sp.base ? ", plus a unit with its price to come" : "");
      const unitsTxt = state.list.map((u) => u.label + (u.detail ? " (" + u.detail + ")" : "") + ": " + u.text).join("; ");
      const partsTxt = state.list.filter((u) => u.partsText).map((u) => u.label + ": " + u.partsText).join(" | ");
      form.querySelector("[data-quick-price]").value = "Units: " + unitsTxt + (partsTxt ? ". Parts: " + partsTxt : "") + ". " + totalTxt;
      const picks = sp.lines.map((l) => l.n + " x " + all[l.k].name).join("; ");
      form.querySelector("[data-bonus-picks]").value = picks ? picks + " (on the house, worth " + d(money(sp.included)) + ")" : "";
      form.querySelectorAll("input[name=service]").forEach((box) => { box.checked = state.list.some((u) => u.label === box.value); });
      if (sf) sf.hidden = true;

      summary.replaceChildren();
      const group = (title, items, cls) => {
        const g = document.createElement("div"); if (cls) g.className = cls;
        const h = document.createElement("p"); h.className = "summary-h"; h.textContent = title;
        const list = document.createElement("ul");
        items.forEach((x) => { const li = document.createElement("li"); li.textContent = x; list.append(li); });
        g.append(h, list); summary.append(g);
      };
      group("Units", state.list.map((u) => u.label + (u.detail ? ", " + u.detail : "") + ": " + u.text));
      const partLines = state.list.filter((u) => u.partsText).map((u) => u.label + ": " + u.partsText);
      if (partLines.length) group("Parts", partLines);
      if (sp.lines.length) group("On the house, worth " + d(money(sp.included)) + " at £0", sp.lines.map((l) => l.n + " × " + all[l.k].name + ", worth " + d(money(l.p * l.n))), "summary-bonus");
      const tot = document.createElement("p"); tot.className = "summary-total";
      tot.textContent = totalTxt + ".";
      summary.append(tot);
      summary.hidden = false;
    };

    $("[data-send]").addEventListener("click", () => {
      if (!state.list.length || !state.split) return;
      state.sent = true;
      fillForm(state.split);
      closeDrawer();
      document.getElementById("booking-form").scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>

