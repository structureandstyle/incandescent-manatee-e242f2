---
/**
 * PREVIEW ONLY, 12 Nov 2026 (branch flowtoform/booking-2027-preview): the
 * early-2027 booking page, where the Google post, the site band and the
 * quotations send people. Arthur's brief: one page for every service, the
 * visitor ticks what they want made and which add-ons they would choose, no
 * project value asked.
 *
 * Rev 2 (Arthur's preview comments, 12 Nov): every service he offers; a
 * catchier headline (three versions offered, the first here); "What is
 * included" becomes "Christmas bundles" with five service cards drawn in 2D.
 * Quick prices on three cards first (wardrobes, alcoves, walk-ins), as agreed;
 * TV units and kitchens show their published "from" figure and go straight
 * to the add-ons.
 *
 * THE QUICK PRICE IS ALWAYS A FLOOR. It is the guide starting price from the
 * cost guide, and the quotation can only be the same or higher, so "add-ons
 * worth at least £Y" never promises more than the band the quotation lands in.
 *
 * Every figure in [brackets] is a draft waiting on Kaspar: the band values and
 * add-on prices come from the cost guide preview (ss-cost-extras-preview) and
 * go live only once his real prices are live there first, so "normally £300"
 * has a real price behind it (CAP 3.7; DMCCA 2024 Sch 20 para 23). His own
 * published wardrobe, alcove pair, walk-in, TV unit and kitchen "from" figures
 * are shown as they are. Deposit: Arthur set a draft [15%] on 12 Nov, covering the 2D drawings and elevations (Kaspar confirms). Prices are marked indicative, and a quotation follows a measured survey or the customer's photos and measurements (Arthur, 12 Nov; Kaspar confirms the photo route).
 *
 * Copy to protocol v1.4: no "offer", "deal", "discount", "limited time" or
 * "free"; facts, not the promise formula; the closing date stated once and
 * never extended (Sch 20 para 7). noindex: a temporary page, removed on
 * 1 February 2027 with a redirect to /fitted-wardrobe-cost/.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import FormProof from "../components/FormProof.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";

/** Preview: wrap draft figures in brackets. False once Kaspar's prices are in. */
const DRAFT = true;
const draft = (s: string) => (DRAFT ? `[${s}]` : s);

const BANDS: [number, number][] = [[2000, 300], [3000, 450], [5000, 750], [8000, 1000]];

const ADDONS = {
  drawer: { name: "Soft-close drawer", price: 150 },
  led: { name: "LED lighting with a door sensor, per section", price: 150 },
  trouser: { name: "Pull-out trouser rail", price: 150 },
  shoe: { name: "Pull-out shoe rack", price: 180 },
  pulldown: { name: "Pull-down hanging rail", price: 180 },
  tray: { name: "Lined jewellery or accessory tray", price: 150 },
  mirror: { name: "Full-length mirror inside a door", price: 200 },
  shelf: { name: "Extra shelf", price: 50 },
};

/* Finish pictures from the materials page (public/images/materials/README.md):
   melamine is his own work, MDF and oak veneer are the supplier samples Denis
   kept on 2 Sep 2026. Hand-painted and sprayed are both MDF, so they share the
   MDF photograph under a colour wash that tells them apart. Decorative beside
   their labels, so alt="" (rule 7). Arthur, 12 Nov: the hero photo goes, the
   material pictures stay. */
const FINISHES = [
  { name: "Melamine board", img: "/images/materials/melamine-board-400w.webp", wash: "" },
  { name: "Hand-painted MDF", img: "/images/materials/mdf-board-400w.webp", wash: "painted" },
  { name: "Sprayed MDF", img: "/images/materials/mdf-board-400w.webp", wash: "sprayed" },
  { name: "Oak veneer", img: "/images/materials/veneered-board-400w.webp", wash: "" },
];
/* The upsell (Arthur, 12 Nov): bundles reaching the threshold also include a
   small library unit. Its normal price and the threshold are drafts for Kaspar. */
const LIBRARY = { threshold: 15000, name: "a library unit, 2.4m high and 1.2m wide" };
const WARDROBE_ADDONS = ["drawer", "led", "trouser", "shoe", "pulldown", "tray", "mirror", "shelf"];

/* Prices are Kaspar's published guide starting prices (cost guide tables);
   the per-layout walk-in and one-alcove figures do not exist yet.
   included: what each unit price already covers (Arthur, 12 Nov), taken only
   from his published copy: the cost guide starting specification and alcove
   note, the walk-in, TV unit and kitchen service pages, and the cost guide
   FAQ "no separate design fee". */
const BUNDLES = [
  {
    id: "wardrobe", label: "Fitted wardrobes", from: 2300, fromText: "from £2,300",
    finishes: FINISHES,
    sizes: ["2 doors", "3 doors", "4 doors"], /* widths removed (Arthur, 12 Nov) */
    prices: [[2300, 3200, 4000], [2500, 3500, 4500], [3200, 4300, 5400], [3700, 5000, 6300]],
    /* The inside in numbers (Arthur, 12 Nov): four doors is his spec, 2 rails,
       4 shelves and a set of 4 drawers; two and three doors scale it. All
       drafts for Kaspar. Rails and shelves are in his published price; the
       drawers are an add-on, so the Christmas bundle covers them, one per
       door, or lighting in the same number of sections instead. His published
       prices do not change, so nothing is discounted. */
    inside: [
      { text: "1 hanging rail and 2 shelves", n: 2 },
      { text: "2 hanging rails and 3 shelves", n: 3 },
      { text: "2 hanging rails and 4 shelves", n: 4 },
    ],
    includes: "At this price: a made-to-measure wardrobe, soft-close hinges, delivery and fitting. Choose a size to see what goes inside.",
    included: [draft("2 hanging rails and 4 shelves") + " in four doors", "Soft-close hinges", "Delivery and fitting", "Design, no separate fee"],
    xmas: "Christmas: a set of drawers, one per door, or lighting instead",
    addons: WARDROBE_ADDONS,
  },
  {
    /* cardFloor: one alcove has no price yet and may sit in the lowest band,
       so the card promises only that band, not the pair's. */
    id: "alcove", label: "Alcove units and shelving", from: 3300, cardFloor: 2000, fromText: "from £3,300 a pair",
    finishes: FINISHES,
    sizes: ["A pair of alcoves", "One alcove"],
    prices: [[3300, null], [3600, null], [4000, null], [6000, null]],
    includes: "At this price: in each alcove, a base cupboard with two doors and three open shelves above, up to about 1m wide, delivered and fitted. Lighting, drawers and extra shelves are add-ons, below.",
    included: ["Base cupboard, two doors, each side", "Three open shelves above", "Made to measure and fitted", "Design, no separate fee"],
    addons: ["led", "drawer", "shelf"],
  },
  {
    id: "walkin", label: "Walk-in wardrobes", from: 5000, fromText: "from around £5,000",
    finishes: null,
    sizes: ["One wall", "Two walls, L-shaped", "Three walls, U-shaped"],
    prices: [[5000, 5000, 5000]],
    includes: "A walk-in wardrobe is priced per room, by what goes into it, and typically starts from around £5,000. Add the drawers, lighting and fittings you would like below.",
    around: true,
    included: ["Layout planned around what you store", "Fitted, floors protected", "Design, no separate fee"],
    addons: WARDROBE_ADDONS,
  },
  {
    id: "tv", label: "Built-in TV units", from: 3500, fromText: "from £3,500",
    finishes: null, sizes: null, prices: null, perProject: true,
    includes: "Built-in TV units are priced per project after one visit, from £3,500.",
    included: ["Layout set around your TV", "Closed cupboards and open sections", "Design, no separate fee"],
    addons: ["led", "drawer", "shelf"],
  },
  {
    id: "kitchen", label: "Bespoke kitchens", from: 10000, fromText: "from £10,000",
    finishes: null, sizes: null, prices: null, perProject: true,
    includes: "Kitchens are priced per project after one visit, from £10,000. Worktops and appliances are itemised separately on the quotation.",
    included: ["Made-to-measure cabinetry, fitted", "Storage planned with the layout", "Design, no separate fee"],
    addons: ["led", "drawer"],
  },
];

const allowance = (p: number) => BANDS.reduce((a, [min, v]) => (p >= min ? v : a), 0);
const money = (n: number) => `£${n.toLocaleString("en-GB")}`;

const BAND_ROWS = [
  ["£2,000 to £2,999", "up to " + draft("£300")],
  ["£3,000 to £4,999", "up to " + draft("£450")],
  ["£5,000 to £7,999", "up to " + draft("£750")],
  ["£8,000 to £14,999", "up to " + draft("£1,000")],
  [draft("£15,000") + " and over", "up to " + draft("£1,000") + ", plus a library unit 2.4m high and 1.2m wide"],
];

const TERMS = [
  "Booked means the quotation accepted in writing and the [15%] deposit paid by 11.59pm on Sunday 31 January 2027.",
  "The deposit covers your 2D drawings and elevations, which start once it is paid, and books your fitting slot.",
  "Applies to fitted wardrobe, walk-in wardrobe, alcove unit, TV unit and kitchen jobs with a quotation of £2,000 or more. Several units in one quotation count together.",
  "A quotation of [£15,000] or more also includes a library unit, 2.4m high and 1.2m wide, in the same finish as the rest of the job.",
  "The quotation total before add-ons sets how much is included. Prices on this page are indicative guide prices. The firm figure is the itemised quotation, sent after a measured survey or from your photos and measurements, and it can only be the same as a guide starting price or higher.",
  "Each add-on appears on the quotation as its own line at £0. Its normal price is the price on our cost guide, and what we charge for it on any other job.",
  "In a fitted wardrobe, the add-ons start with a set of drawers, one per door, or lighting in the same number of sections instead. Other add-ons can be chosen to the same value.",
  "Prices are unchanged. The quotation is the normal itemised price for the job.",
  "Lighting needs a power supply that can reach the unit, which we check at the visit. Where it cannot, other add-ons of the same value are included.",
  "Add-ons cannot be exchanged for money, swapped for a lower price or moved to another job.",
  "The fitting date is agreed when the deposit is paid.",
  "Your cancellation rights are not affected.",
  "The closing date will not be extended.",
  "No VAT is added: we are not currently VAT registered.",
];

const clientData = {
  draft: DRAFT,
  bands: BANDS,
  addons: ADDONS,
  bundles: BUNDLES.map((b) => ({ ...b })),
  library: LIBRARY,
};
---

<Base
  title="The Christmas bundle"
  description="Wardrobes, walk-ins, alcove units, TV units and kitchens booked by 31 January 2027 come with add-ons you choose, at no cost. Prices unchanged, no VAT added."
  noindex={true}
>
  {/* LANDING PAGE, rev 4 (Arthur, 12 Nov: "make it a landing page, hero
      explains the offer then the options, Hormozi technique, Christmassy").
      Hormozi's value equation, kept inside protocol v1.4 and the pricing law:
      - a named bundle (The Christmas bundle) with the add-ons as named things;
      - dream outcome and time: plan it over Christmas, fitted in the new year;
      - low effort: three steps, one visit, a fixed itemised quotation;
      - likelihood: the live Google rating, two whole reviews, his real
        guarantee (Q35), nothing invented;
      - the value stack shown at normal prices from the cost guide, never a
        "you save" or a struck-out price;
      - urgency and scarcity only where true: the closing date, never
        extended, and a slot count only once Kaspar gives a real one.
      Christmas in the brand palette: the site's green, a berry ribbon in the
      brand's deep red, a drawn holly sprig. No snow, no countdown. */}
  <section class="xmas-hero">
    <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
      <div class="xmas-hero-grid">
        <div class="xmas-hero-copy">
          <p class="xmas-kicker">
            <svg class="holly" viewBox="0 0 40 24" aria-hidden="true"><path d="M20 12 C14 2 6 4 2 8 C7 9 6 14 10 15 C12 11 16 12 20 12 Z" /><path d="M20 12 C26 2 34 4 38 8 C33 9 34 14 30 15 C28 11 24 12 20 12 Z" /><circle cx="17" cy="15" r="3" /><circle cx="23" cy="15" r="3" /><circle cx="20" cy="19" r="3" /></svg>
            Christmas bundles, booking until 31 January 2027
          </p>
          <h1 class="xmas-h1">The Christmas bundle: add-ons worth from [£300], on the house</h1>
          <p class="xmas-lede">
            Fitted wardrobes, walk-ins, alcove units, TV units and kitchens booked by Sunday 31 January 2027
            come with add-ons you choose, at no cost. Plan it over Christmas, and it is fitted in the new year.
          </p>
          <p class="xmas-ctas">
            <a class="xmas-btn" href="#bundles">Build your bundle</a>
          </p>
          <p class="xmas-small">Booking closes on Sunday 31 January 2027, and the date will not move.</p>
        </div>
        {/* BALANCE (Arthur, 12 Nov: "the hero looks off, balance it"). With the
            photo gone the right half stood empty. It now holds the bundle at a
            glance, as a gift tag: what is always included, then the ladder of
            add-ons by quotation, ending with the library unit. Text, not a
            picture; brackets mark the drafts. */}
        <aside class="xmas-card" aria-label="What is in the Christmas bundle">
          {/* A red ribbon across the tag, crossing the one down its side, with a bow
              where they meet (Arthur, 12 Nov: "like a red ribbon, something festive"). */}
          <p class="xmas-card-title xmas-card-ribbon">In every bundle<svg class="xmas-bow" viewBox="0 0 48 34" aria-hidden="true"><path d="M22 18 L13 32 L18 30.5 L21 33 L24 19 Z" /><path d="M26 18 L35 32 L30 30.5 L27 33 L24 19 Z" /><path d="M24 16 C15 3 2 5 4 13 C6 21 16 20 24 16 Z" /><path d="M24 16 C33 3 46 5 44 13 C42 21 32 20 24 16 Z" /><rect x="20" y="12" width="8" height="8" rx="2.5" /></svg></p>
          <ul class="xmas-card-list">
            <li>Add-ons you choose: lighting, drawers, rails, racks</li>
            <li>Prices unchanged, no VAT added</li>
            <li>A [15%] deposit covers your 2D drawings and elevations, and books your slot</li>
          </ul>
          <p class="xmas-card-title">Add-ons included, by quotation</p>
          <dl class="xmas-ladder">
            <div><dt>£2,000</dt><dd>up to [£300]</dd></div>
            <div><dt>£3,000</dt><dd>up to [£450]</dd></div>
            <div><dt>£5,000</dt><dd>up to [£750]</dd></div>
            <div><dt>£8,000</dt><dd>up to [£1,000]</dd></div>
            <div class="xmas-ladder-top"><dt>[£15,000]</dt><dd>[£1,000], plus a library unit 2.4m by 1.2m</dd></div>
          </dl>
        </aside>
      </div>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <SectionHead level={4}>How it works</SectionHead>
    <ol class="xmas-steps">
      <li><strong>Build your bundle.</strong> Pick the furniture, the finish and your add-ons below.</li>
      <li><strong>We see the space.</strong> A measured survey at your home, or photos and measurements from you. Then we send an itemised quotation, with your add-ons on it at £0.</li>
      <li><strong>Book by 31 January.</strong> Accept the quotation and pay a [15%] deposit, which covers your 2D drawings and elevations and books your fitting slot. We agree the date then.</li>
    </ol>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <div id="bundles"></div>
    <SectionHead level={4}>Christmas bundles</SectionHead>
    <p class="booking-note">
      Add each unit you would like made: several units count together. Your bundle shows an indicative
      total and the add-ons that come with it, each shown on the quotation as its own line at £0.
    </p>

    <div class="bundle-cards" role="list">
      {BUNDLES.map((b) => (
        <button type="button" class="bundle-card" data-bundle={b.id} aria-pressed="false" role="listitem">
          {/* Larger and in colour (Arthur, 12 Nov): brand tokens only, oak and
              walnut timber, green paint, charcoal for the TV and hangers. Tight
              viewBoxes so each drawing fills its card. */}
          <span class="bundle-drawing" aria-hidden="true">
            {b.id === "wardrobe" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="10" y="6" width="140" height="132" /><rect class="f-oak2" x="14" y="16" width="42" height="118" /><rect class="f-oak2" x="59" y="16" width="42" height="118" /><rect class="f-oak2" x="104" y="16" width="42" height="118" /><line class="s-wal" x1="10" y1="12" x2="150" y2="12" /><line class="h" x1="50" y1="64" x2="50" y2="86" /><line class="h" x1="65" y1="64" x2="65" y2="86" /><line class="h" x1="110" y1="64" x2="110" y2="86" /><rect class="f-wal" x="6" y="138" width="148" height="8" /></svg>
            )}
            {b.id === "alcove" && (
              <svg viewBox="0 0 160 150"><rect class="f-greenwash" x="58" y="4" width="44" height="142" /><rect class="f-wal" x="50" y="70" width="60" height="7" /><rect class="f-oak2" x="6" y="98" width="50" height="48" /><line class="s-wal" x1="31" y1="98" x2="31" y2="146" /><rect class="f-oak2" x="104" y="98" width="50" height="48" /><line class="s-wal" x1="129" y1="98" x2="129" y2="146" /><line class="s-wal" x1="6" y1="40" x2="56" y2="40" /><line class="s-wal" x1="6" y1="66" x2="56" y2="66" /><line class="s-wal" x1="104" y1="40" x2="154" y2="40" /><line class="s-wal" x1="104" y1="66" x2="154" y2="66" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="18" y="29" width="6" height="11" /><rect class="f-oak" x="25" y="24" width="8" height="16" /><rect class="f-green" x="110" y="52" width="8" height="14" /><rect class="f-char" x="120" y="55" width="6" height="11" /><rect class="f-oak" x="134" y="28" width="12" height="12" /></svg>
            )}
            {b.id === "walkin" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="6" y="6" width="148" height="138" /><rect class="f-paper" x="12" y="22" width="80" height="116" /><line class="s-wal" x1="12" y1="32" x2="92" y2="32" /><path class="f-green" d="M24 34 l-9 30 h18 z" /><path class="f-wal" d="M44 34 l-9 36 h18 z" /><path class="f-char" d="M64 34 l-9 28 h18 z" /><path class="f-green" d="M82 34 l-8 34 h16 z" /><rect class="f-oak2" x="98" y="22" width="50" height="116" /><line class="s-wal" x1="98" y1="66" x2="148" y2="66" /><line class="s-wal" x1="98" y1="84" x2="148" y2="84" /><line class="s-wal" x1="98" y1="102" x2="148" y2="102" /><line class="s-wal" x1="98" y1="120" x2="148" y2="120" /><line class="h" x1="116" y1="75" x2="130" y2="75" /><line class="h" x1="116" y1="93" x2="130" y2="93" /><line class="h" x1="116" y1="111" x2="130" y2="111" /><line class="h" x1="116" y1="129" x2="130" y2="129" /></svg>
            )}
            {b.id === "tv" && (
              <svg viewBox="0 0 160 150"><rect class="f-oak" x="4" y="6" width="152" height="138" /><rect class="f-char" x="42" y="30" width="76" height="46" /><rect class="f-oak2" x="4" y="100" width="152" height="44" /><line class="s-wal" x1="42" y1="100" x2="42" y2="144" /><line class="s-wal" x1="80" y1="100" x2="80" y2="144" /><line class="s-wal" x1="118" y1="100" x2="118" y2="144" /><line class="s-wal" x1="4" y1="40" x2="36" y2="40" /><line class="s-wal" x1="4" y1="70" x2="36" y2="70" /><line class="s-wal" x1="124" y1="40" x2="156" y2="40" /><line class="s-wal" x1="124" y1="70" x2="156" y2="70" /><rect class="f-green" x="10" y="26" width="7" height="14" /><rect class="f-wal" x="19" y="30" width="6" height="10" /><rect class="f-green" x="132" y="58" width="12" height="12" /><line class="s-wal" x1="40" y1="100" x2="120" y2="100" /></svg>
            )}
            {b.id === "kitchen" && (
              <svg viewBox="0 0 160 150"><rect class="f-green" x="6" y="6" width="148" height="42" /><line class="s-paper" x1="43" y1="6" x2="43" y2="48" /><line class="s-paper" x1="80" y1="6" x2="80" y2="48" /><line class="s-paper" x1="117" y1="6" x2="117" y2="48" /><rect class="f-wal" x="2" y="84" width="156" height="9" /><rect class="f-green" x="6" y="93" width="148" height="51" /><line class="s-paper" x1="43" y1="93" x2="43" y2="144" /><line class="s-paper" x1="80" y1="93" x2="80" y2="144" /><line class="s-paper" x1="117" y1="93" x2="117" y2="144" /><line class="s-paper" x1="80" y1="110" x2="117" y2="110" /><line class="s-paper" x1="80" y1="127" x2="117" y2="127" /><line class="h-oak" x1="34" y1="104" x2="34" y2="120" /><line class="h-oak" x1="52" y1="104" x2="52" y2="120" /><line class="h-oak" x1="92" y1="102" x2="105" y2="102" /><line class="h-oak" x1="92" y1="119" x2="105" y2="119" /><line class="h-oak" x1="92" y1="136" x2="105" y2="136" /><rect class="f-oak" x="128" y="70" width="18" height="14" /></svg>
            )}
          </span>
          <span class="bundle-name">{b.label}</span>
          <span class="bundle-from">{b.fromText}</span>
          <span class="bundle-incl-title">Already included</span>
          <ul class="bundle-incl">{b.included.map((i) => <li>{i}</li>)}</ul>
          <span class="bundle-allow">{(b as { xmas?: string }).xmas && <span class="bundle-xmas">{(b as { xmas?: string }).xmas}</span>}Add-ons worth at least {draft(money(allowance((b as { cardFloor?: number }).cardFloor ?? b.from)))}</span>
        </button>
      ))}
    </div>

    <div class="bundle-panel" data-bundle-panel hidden aria-live="polite">
      <p class="bundle-panel-title" data-panel-title></p>
      <div data-step-finish class="bundle-step" hidden>
        <MonoLabel as="p">Finish</MonoLabel>
        <div class="finish-tiles" data-chips-finish></div>
      </div>
      <div data-step-size class="bundle-step" hidden>
        <MonoLabel as="p">Size</MonoLabel>
        <div class="chips" data-chips-size></div>
      </div>
      <p class="bundle-result" data-result></p>
      <p class="booking-note" data-includes></p>
      <div data-step-xmas class="bundle-step" hidden>
        <MonoLabel as="p">Your Christmas add-ons</MonoLabel>
        <div class="chips" data-chips-xmas></div>
        <p class="booking-note" data-xmas-note></p>
      </div>
      <p style="margin-top:var(--space-6)"><button type="button" class="bundle-add" data-add disabled>Add to my bundle</button></p>
    </div>

    <div class="basket" data-basket hidden aria-live="polite">
      <p class="bundle-panel-title">Your bundle</p>
      <ul class="basket-list" data-basket-list></ul>
      <p class="bundle-result" data-total></p>
      <p class="basket-library" data-library hidden></p>
      <p class="basket-nudge" data-nudge hidden></p>
      <div class="bundle-step">
        <MonoLabel as="p">Fill it with add-ons</MonoLabel>
        <p class="bundle-meter" data-meter></p>
        <ul class="addon-list" data-addons></ul>
        <p class="bundle-estimate" data-estimate></p>
        <p style="margin-top:var(--space-8)">
          <button type="button" class="bundle-send" data-send>Send this bundle with my enquiry</button>
        </p>
      </div>
    </div>

    <SectionHead level={5} style="margin-top:var(--space-14)">How much is included</SectionHead>
    <table class="booking-table">
      <thead><tr><th>Your quotation</th><th>Add-ons, at normal prices</th></tr></thead>
      <tbody>{BAND_ROWS.map(([a, b]) => <tr><td>{a}</td><td class="num">{b}</td></tr>)}</tbody>
    </table>
    <p class="booking-note">{draft("For example, a £2,500 wardrobe could include lighting in two sections, or two drawers.")}</p>
    <p class="booking-note">
      Normal prices are on our <Link href="/fitted-wardrobe-cost/" variant="inline">cost guide</Link>. Lighting
      needs a power supply that can reach the unit, which we check at the visit. Where it cannot, other add-ons
      of the same value are included.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>What stands behind it</SectionHead>
    <div class="xmas-proof">
      <div>
        <FormProof quotes={["lorenzo", "ozge"]} keep={1} />
      </div>
      <ul class="xmas-guarantee">
        <li><strong>2 years</strong> on installation and workmanship.</li>
        <li><strong>10 years</strong> on the structure of the joinery.</li>
        <li><strong>Hardware</strong> under its maker's warranty.</li>
        <li><strong>Your cancellation rights</strong> are not affected.</li>
      </ul>
    </div>
  </Wrap>

  <section class="xmas-ribbon">
    <Wrap style="padding-top:var(--space-12);padding-bottom:var(--space-12)">
      <p class="xmas-ribbon-main">Booking closes on Sunday 31 January 2027.</p>
      <p class="xmas-ribbon-sub">[Number] fitting slots between February and April. The date will not be extended.</p>
      <p style="margin-top:var(--space-8)"><a class="xmas-btn xmas-btn-light" href="#bundles">Build your bundle</a></p>
    </Wrap>
  </section>

  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <div id="booking-form" class="booking-form" style="border:var(--rule-structure);padding:clamp(20px,4vw,40px);background:var(--paper)">
      <MonoLabel as="p" style="margin-bottom:var(--space-10)">Send an enquiry</MonoLabel>
      <p class="booking-note" data-bundle-summary hidden></p>
      <EnquiryForm bonusPicker idPrefix="booking-" />
    </div>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={4}>Terms</SectionHead>
    <ul class="booking-terms">{TERMS.map((t) => <li>{t}</li>)}</ul>
  </Wrap>
</Base>

<script is:inline define:vars={{ data: clientData }}>
  /* The bundle builder, rev 6 (Arthur, 12 Nov): several units in one bundle.
     Configure a unit on its card, add it, repeat. The bundle total sets the
     add-on allowance (always a floor: each unit's guide starting price), the
     library unit at the threshold, and a nudge to the next milestone, stated
     as a fact ("At £X ... Your bundle is £Y away"), never "if you do X". */
  (() => {
    const $ = (s, r = document) => r.querySelector(s);
    const money = (n) => "£" + n.toLocaleString("en-GB");
    const d = (s) => (data.draft ? "[" + s + "]" : s);
    const allowance = (p) => data.bands.reduce((a, [min, v]) => (p >= min ? v : a), 0);
    const panel = $("[data-bundle-panel]");
    const basket = $("[data-basket]");
    const state = { b: null, finish: null, size: null, bonus: "drawer", units: [], picks: {}, split: null };
    const addonOrder = Object.keys(data.addons);

    const chip = (label, on, click, disabled) => {
      const el = document.createElement("button");
      el.type = "button";
      el.className = "chip";
      el.textContent = label;
      el.setAttribute("aria-pressed", on ? "true" : "false");
      if (disabled) el.disabled = true;
      el.addEventListener("click", click);
      return el;
    };

    const unitPrice = () => {
      const b = state.b;
      if (!b) return null;
      if (b.perProject) return { value: b.from, text: "indicative, priced per project " + b.fromText };
      const row = b.finishes ? state.finish : 0;
      if (row === null || state.size === null) return null;
      const v = b.prices[row][state.size];
      if (v === null) return { value: null, text: d("price to come") };
      return { value: v, text: "indicative " + (b.around ? "from around " : "from ") + money(v) };
    };

    /* How a set of units and add-on picks splits: the allowance follows the
       quotation (units plus any add-ons paid at normal prices). */
    const split = (units, picks) => {
      const base = units.reduce((s, u) => s + (u.value || 0), 0);
      const keys = addonOrder.filter((k) => units.some((u) => u.addons.includes(k)));
      const used = keys.reduce((s, k) => s + data.addons[k].price * (picks[k] || 0), 0);
      let allow = allowance(base || 2000);
      let extra = Math.max(0, used - allow);
      for (let i = 0; base && i < 4; i++) { allow = allowance(base + extra); extra = Math.max(0, used - allow); }
      const quote = base + extra;
      return { base, keys, allow, included: used - extra, extra, quote, library: base > 0 && quote >= data.library.threshold };
    };

    /* Wardrobes (Arthur, 12 Nov): the inside for the chosen size, and the
       Christmas add-ons it starts with, a drawer per door or lighting. */
    const insideOf = (b) => (b && b.inside && state.size !== null ? b.inside[state.size] : null);
    const bonusLabel = (key, n) => (key === "led" ? "lighting in " + n + " sections" : "a set of " + n + " drawers");

    const renderPanel = () => {
      const b = state.b;
      if (!b) { panel.hidden = true; return; }
      panel.hidden = false;
      $("[data-panel-title]").textContent = b.label;
      const fin = $("[data-chips-finish]"); fin.replaceChildren();
      const siz = $("[data-chips-size]"); siz.replaceChildren();
      $("[data-step-finish]").hidden = !b.finishes;
      $("[data-step-size]").hidden = !b.sizes;
      (b.finishes || []).forEach((f, i) => {
        const t = document.createElement("button");
        t.type = "button";
        t.className = "finish-tile";
        t.setAttribute("aria-pressed", state.finish === i ? "true" : "false");
        const pic = document.createElement("span");
        pic.className = "finish-pic" + (f.wash ? " " + f.wash : "");
        const img = document.createElement("img");
        img.src = f.img; img.alt = ""; img.loading = "lazy"; img.width = 400; img.height = 300;
        pic.append(img);
        const name = document.createElement("span");
        name.textContent = f.name;
        t.append(pic, name);
        t.addEventListener("click", () => { state.finish = i; renderPanel(); });
        fin.append(t);
      });
      (b.sizes || []).forEach((s, i) => siz.append(chip(s, state.size === i, () => { state.size = i; renderPanel(); })));
      const p = unitPrice();
      const res = $("[data-result]");
      res.textContent = p
        ? b.label + ": " + p.text + "."
        : "Choose " + (b.finishes && state.finish === null ? "a finish" : "a size") + " to see an indicative price.";
      const inside = insideOf(b);
      $("[data-includes]").textContent = inside
        ? "Inside, at this price: " + d(inside.text) + ". Also included: soft-close hinges, delivery and fitting, and the design, with no separate fee."
        : b.includes || "";
      const xs = $("[data-step-xmas]");
      xs.hidden = !(inside && p);
      if (inside && p) {
        const n = inside.n;
        const xc = $("[data-chips-xmas]"); xc.replaceChildren();
        xc.append(
          chip("A set of " + n + " drawers", state.bonus === "drawer", () => { state.bonus = "drawer"; renderPanel(); }),
          chip("Lighting in " + n + " sections", state.bonus === "led", () => { state.bonus = "led"; renderPanel(); }),
        );
        const cost = data.addons[state.bonus].price * n;
        const before = split(state.units, state.picks);
        const picks = { ...state.picks, [state.bonus]: (state.picks[state.bonus] || 0) + n };
        const after = split(state.units.concat([{ value: p.value, addons: b.addons }]), picks);
        const charged = Math.max(0, after.extra - (state.units.length ? before.extra : 0));
        const what = state.bonus === "led" ? "Lighting in " + n + " sections" : "A set of " + n + " soft-close drawers";
        $("[data-xmas-note]").textContent = what + ", normally " + d(money(cost)) + ". " +
          (charged >= cost
            ? "Your bundle's add-ons are already chosen, so it would be at the normal price."
            : charged
            ? "In your bundle, " + d(money(cost - charged)) + " of it comes at £0 and " + d(money(charged)) + " at the normal price."
            : "In your bundle it comes at £0, as its own line on the quotation.") +
          (state.bonus === "led" ? " Lighting needs a power supply that can reach the wardrobe, which we check at the visit." : "");
      }
      $("[data-add]").disabled = !p;
    };

    const renderBasket = () => {
      if (!state.units.length) { basket.hidden = true; return; }
      basket.hidden = false;
      const list = $("[data-basket-list]"); list.replaceChildren();
      state.units.forEach((u, i) => {
        const li = document.createElement("li");
        const t = document.createElement("span");
        t.textContent = u.label + (u.detail ? ", " + u.detail : "") + ": " + u.text;
        if (u.included && u.included.length) {
          const inc = document.createElement("small");
          inc.className = "basket-incl";
          inc.textContent = "Already included: " + u.included.join("; ") + ".";
          t.append(inc);
        }
        if (u.bonus) {
          const xm = document.createElement("small");
          xm.className = "basket-incl";
          xm.textContent = "Christmas add-ons: " + bonusLabel(u.bonus.key, u.bonus.n) + ", counted below.";
          t.append(xm);
        }
        const rm = document.createElement("button");
        rm.type = "button"; rm.className = "basket-remove"; rm.textContent = "Remove";
        rm.setAttribute("aria-label", "Remove " + u.label);
        rm.addEventListener("click", () => {
          if (u.bonus) state.picks[u.bonus.key] = Math.max(0, (state.picks[u.bonus.key] || 0) - u.bonus.n);
          state.units.splice(i, 1);
          renderBasket();
        });
        li.append(t, rm);
        list.append(li);
      });
      const keys = addonOrder.filter((k) => state.units.some((u) => u.addons.includes(k)));
      Object.keys(state.picks).forEach((k) => { if (!keys.includes(k)) delete state.picks[k]; });
      const { base, allow, included, extra, quote, library } = split(state.units, state.picks);
      state.split = { base, allow, included, extra, quote, library };
      const pending = state.units.some((u) => u.value === null);
      $("[data-total]").textContent = base
        ? "Indicative total: from " + money(base) + (pending ? ", plus a unit with its price to come" : "") +
          ". Your bundle includes add-ons worth at least " + d(money(allow)) + "."
        : "A quotation of £2,000 or more includes add-ons worth at least " + d(money(allow)) + ".";
      const libEl = $("[data-library]");
      libEl.hidden = !library;
      libEl.textContent = library ? "Included as well: " + data.library.name + ", in the same finish as the rest of the job." : "";
      const nudge = $("[data-nudge]");
      const milestones = data.bands.map(([min, v]) => ({ at: min, what: "add-ons grow to " + d(money(v)) }))
        .concat([{ at: data.library.threshold, what: data.library.name + " is included as well" }])
        .filter((m) => base && m.at > quote)
        .sort((a, b) => a.at - b.at);
      const next = milestones[0];
      nudge.hidden = !next;
      nudge.textContent = next ? "At " + d(money(next.at)) + ", " + next.what + ". Your bundle is " + money(next.at - quote) + " away." : "";
      $("[data-meter]").textContent = "Included at no cost: " + d(money(included)) + " of " + d(money(allow)) +
        (extra ? ". Beyond your bundle, at normal prices: " + d(money(extra)) + "." : ".");
      const addons = $("[data-addons]"); addons.replaceChildren();
      keys.forEach((k) => {
        const a = data.addons[k];
        const n = state.picks[k] || 0;
        const li = document.createElement("li");
        li.className = "addon";
        const name = document.createElement("span");
        name.className = "addon-name";
        name.textContent = a.name + ", normally " + d(money(a.price));
        const ctrl = document.createElement("span");
        ctrl.className = "addon-ctrl";
        const minus = chip("−", false, () => { state.picks[k] = Math.max(0, n - 1); renderBasket(); }, n === 0);
        minus.setAttribute("aria-label", "One fewer " + a.name);
        const count = document.createElement("span");
        count.className = "addon-count";
        count.textContent = String(n);
        const plus = chip("+", false, () => { state.picks[k] = n + 1; renderBasket(); }, n >= 20);
        plus.setAttribute("aria-label", "One more " + a.name);
        ctrl.append(minus, count, plus);
        li.append(name, ctrl);
        addons.append(li);
      });
      $("[data-estimate]").textContent = base
        ? "Indicative estimate with your add-ons: from " + d(money(quote)) + ". The firm figure is the itemised quotation, after a measured survey or from your photos and measurements."
        : "";
    };

    document.querySelectorAll("[data-bundle]").forEach((card) => {
      card.addEventListener("click", () => {
        const b = data.bundles.find((x) => x.id === card.dataset.bundle);
        document.querySelectorAll("[data-bundle]").forEach((c) => c.setAttribute("aria-pressed", c === card ? "true" : "false"));
        state.b = b; state.finish = null; state.size = null; state.bonus = "drawer";
        renderPanel();
        panel.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    $("[data-add]").addEventListener("click", () => {
      const b = state.b; const p = unitPrice();
      if (!b || !p) return;
      const detail = [b.finishes && state.finish !== null ? b.finishes[state.finish].name : "", b.sizes && state.size !== null ? b.sizes[state.size] : ""].filter(Boolean).join(", ");
      const inside = insideOf(b);
      const bonus = inside ? { key: state.bonus, n: inside.n } : null;
      const included = inside ? [d(inside.text), "Soft-close hinges", "Delivery and fitting", "Design, no separate fee"] : b.included;
      state.units.push({ id: b.id, label: b.label, detail, value: p.value, text: p.text, addons: b.addons, included, bonus });
      if (bonus) state.picks[bonus.key] = (state.picks[bonus.key] || 0) + bonus.n;
      state.b = null;
      document.querySelectorAll("[data-bundle]").forEach((c) => c.setAttribute("aria-pressed", "false"));
      renderPanel();
      renderBasket();
      basket.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    $("[data-send]").addEventListener("click", () => {
      const sp = state.split;
      if (!state.units.length || !sp) return;
      const units = state.units.map((u) => u.label + (u.detail ? " (" + u.detail + ")" : "") + ": " + u.text).join("; ");
      const quick = units + (sp.base ? ". Indicative total from " + money(sp.base) + (sp.extra ? ", with add-ons from " + money(sp.quote) : "") : "") +
        (sp.library ? ". Includes " + data.library.name : "");
      const picks = Object.entries(state.picks).filter(([, n]) => n > 0).map(([k, n]) => n + " x " + data.addons[k].name).join("; ");
      const form = document.querySelector("#booking-form form");
      form.querySelector("[data-quick-price]").value = quick;
      form.querySelector("[data-bonus-picks]").value = picks
        ? picks + " (" + money(sp.included) + " included at no cost" + (sp.extra ? ", " + money(sp.extra) + " beyond the bundle at normal prices" : "") + ")"
        : "";
      form.querySelectorAll("input[name=service]").forEach((box) => { if (state.units.some((u) => u.label === box.value)) box.checked = true; });
      const summary = $("[data-bundle-summary]");
      summary.textContent = "Your bundle: " + quick + "." + (picks ? " Add-ons: " + picks + "." : "");
      summary.hidden = false;
      document.getElementById("booking-form").scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>

<style is:global>

  /* CHRISTMAS, in the brand palette (rev 4). --berry is the brand deep red
     (the --error token value), used as ribbon only, never for text on paper. */
  .xmas-hero { --berry: #8A2E1F; background: var(--green); color: var(--paper); }
  .xmas-hero-grid { display: grid; gap: clamp(28px, 5vw, 72px); grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; }
  .xmas-h1 { font-family: var(--font-display); font-weight: var(--weight-regular, 400); font-size: var(--type-display-3); line-height: 1.06; letter-spacing: -0.01em; color: var(--paper); margin: var(--space-8) 0 var(--space-8); max-width: 15ch; }
  .xmas-card { background: var(--paper); color: var(--char); padding: clamp(20px, 3vw, 32px); border-top: 10px solid #8A2E1F; box-shadow: 0 18px 40px rgba(0,0,0,.18); position: relative; }
  .xmas-card::after { content: ""; position: absolute; top: -10px; bottom: 0; right: clamp(20px, 3vw, 32px); width: 10px; background: #8A2E1F; opacity: .9; }
  .xmas-card-title { margin: 0 0 var(--space-4); font-family: var(--font-mono); font-size: var(--type-mono); letter-spacing: var(--ls-mono-table); text-transform: uppercase; color: var(--ink-soft); padding-right: 28px; }
  .xmas-card-title + .xmas-ladder, .xmas-card-list + .xmas-card-title { margin-top: var(--space-8); }
  .xmas-card-list { list-style: none; padding: 0 28px 0 0; margin: 0; display: grid; gap: var(--space-3); font-size: var(--type-body-sm); }
  .xmas-card-list li { position: relative; padding-left: 1.6em; }
  .xmas-card-list li::before { content: ""; position: absolute; left: 0; top: 0.4em; width: 0.8em; height: 0.45em; border-left: 2px solid var(--green); border-bottom: 2px solid var(--green); transform: rotate(-45deg); }
  .xmas-ladder { margin: 0; padding-right: 28px; display: grid; }
  .xmas-ladder div { display: flex; justify-content: space-between; gap: var(--space-6); padding: var(--space-3) 0; border-bottom: var(--rule-hair); font-size: var(--type-body-sm); }
  .xmas-ladder dt { font-family: var(--font-mono); font-size: var(--type-mono); letter-spacing: var(--ls-mono-table); white-space: nowrap; }
  .xmas-ladder dd { margin: 0; text-align: right; white-space: nowrap; }
  .xmas-ladder-top dd { white-space: normal; }
  .xmas-card-ribbon {
    --pad: clamp(20px, 3vw, 32px);
    position: relative; z-index: 1;
    margin: 0 calc(-1 * var(--pad) - 12px) var(--space-6);
    padding: 12px calc(var(--pad) + 64px) 12px calc(var(--pad) + 12px);
    background: #8A2E1F; color: var(--paper);
    box-shadow: 0 3px 6px rgba(0,0,0,.18);
  }
  .xmas-card-ribbon::before, .xmas-card-ribbon::after { content: ""; position: absolute; bottom: -10px; width: 0; height: 0; border-top: 10px solid #551A11; }
  .xmas-card-ribbon::before { left: 0; border-left: 12px solid transparent; }
  .xmas-card-ribbon::after { right: 0; border-right: 12px solid transparent; }
  .xmas-bow { position: absolute; top: 50%; right: calc(var(--pad) - 11px); width: 56px; height: 40px; transform: translateY(-50%); overflow: visible; }
  .xmas-bow path, .xmas-bow rect { fill: #A8402C; stroke: #551A11; stroke-width: 1.5; stroke-linejoin: round; }
  .xmas-bow rect { fill: #8A2E1F; }
  .xmas-ladder-top { border-bottom: 0 !important; color: var(--green); font-weight: var(--weight-medium, 500); }
  @media (max-width: 820px) { .xmas-hero-grid { grid-template-columns: 1fr; } }
  .xmas-kicker { display: flex; align-items: center; gap: var(--space-4); margin: 0; font-family: var(--font-mono); font-size: var(--type-mono); letter-spacing: var(--ls-mono-table); text-transform: uppercase; color: var(--ink-rev-soft); }
  .holly { width: 40px; height: 24px; flex-shrink: 0; }
  .holly path { fill: color-mix(in srgb, var(--paper) 18%, var(--green)); stroke: var(--paper); stroke-width: 1.2; }
  .holly circle { fill: #8A2E1F; stroke: var(--paper); stroke-width: 1; }
  .xmas-lede { font-size: var(--type-lede); color: var(--ink-rev-soft); max-width: var(--measure); margin: 0; }
  .xmas-inclusions { list-style: none; padding: 0; margin: var(--space-9) 0 0; display: grid; gap: var(--space-4); max-width: var(--measure); }
  .xmas-inclusions li { position: relative; padding-left: 1.8em; color: var(--paper); }
  .xmas-inclusions li::before { content: ""; position: absolute; left: 0; top: 0.35em; width: 0.9em; height: 0.55em; border-left: 2px solid var(--oak); border-bottom: 2px solid var(--oak); transform: rotate(-45deg); }
  .xmas-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8); margin-top: var(--space-10); }
  .xmas-btn { display: inline-block; padding: 14px 22px; background: var(--paper); color: var(--char); text-decoration: none; font-weight: var(--weight-medium, 500); border-left: 6px solid #8A2E1F; }
  .xmas-btn-light { background: var(--paper); }
  .xmas-link { color: var(--paper); text-underline-offset: 4px; }
  @media (max-width: 600px) {
    .xmas-hero > * { padding-top: var(--space-12) !important; }
    .xmas-hero h1 { margin: var(--space-6) 0 var(--space-6) !important; }
    .xmas-inclusions { margin-top: var(--space-6); gap: var(--space-3); }
    .xmas-ctas { margin-top: var(--space-8); }
  }
  .xmas-small { margin-top: var(--space-8); font-size: var(--type-body-sm); color: var(--ink-rev-quiet); }
  .xmas-hero-photo { position: relative; }
  .xmas-tag { position: absolute; top: var(--space-6); left: calc(-1 * var(--space-4)); background: #8A2E1F; color: var(--paper); padding: 8px 14px; font-family: var(--font-mono); font-size: var(--type-mono); letter-spacing: var(--ls-mono-table); text-transform: uppercase; box-shadow: 0 2px 0 rgba(0,0,0,.15); }
  @media (max-width: 820px) { .xmas-tag { left: 0; } .xmas-hero-photo { max-width: 300px; } }
  .xmas-steps { list-style: none; counter-reset: step; padding: 0; margin: var(--space-9) 0 0; display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .xmas-steps li { counter-increment: step; position: relative; padding-top: var(--space-12); border-top: var(--rule-structure); }
  .xmas-steps li::before { content: counter(step); position: absolute; top: var(--space-4); left: 0; font-family: var(--font-mono); font-size: var(--type-mono); color: var(--green); }
  .xmas-stack { max-width: var(--measure); margin-top: var(--space-9); padding: clamp(16px, 4vw, 32px); border: var(--rule-structure); background: var(--paper); position: relative; border-top: 6px solid var(--green); }
  .xmas-stack-head { margin: 0; font-size: var(--type-lede); }
  .xmas-stack-list { list-style: none; padding: 0; margin: var(--space-8) 0 0; display: grid; }
  .xmas-stack-list li { display: flex; justify-content: space-between; gap: var(--space-6); padding: var(--space-5) 0; border-bottom: var(--rule-hair); }
  .xmas-stack-list li span:last-child { font-family: var(--font-mono); font-size: var(--type-mono); letter-spacing: var(--ls-mono-table); text-align: right; white-space: nowrap; }
