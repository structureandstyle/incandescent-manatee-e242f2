---
/**
 * The case-study index.
 *
 * Lists cleared entries, newest first. With none cleared it is noindexed and
 * out of the sitemap (page-gates.ts and astro.config.mjs read the same rule),
 * and it names no held entry: the live index never advertises a draft. Nothing
 * links here from the header or footer until an entry is cleared.
 */
import Base from "../../layouts/Base.astro";
import Wrap from "../../components/ds/Wrap.astro";
import Display from "../../components/ds/Display.astro";
import Kicker from "../../components/ds/Kicker.astro";
import Link from "../../components/ds/Link.astro";
import { ANSWERS } from "../../data/answers";
import { CASE_STUDIES, caseStudyPath } from "../../data/case-studies";
import { indexable, CASE_STUDY_INDEX } from "../../data/page-gates";

const cleared = CASE_STUDIES.filter((c) => indexable(caseStudyPath(c)))
  .sort((a, b) => (b.published ?? "").localeCompare(a.published ?? ""));
const title = (c: (typeof CASE_STUDIES)[number]) => {
  const v = ANSWERS[c.keys.title].value;
  return typeof v === "string" ? v : c.slug;
};
---

<Base
  title="Case studies"
  description="Finished Structure & Style jobs: the brief, what was fitted and how it was made."
  noindex={!indexable(CASE_STUDY_INDEX)}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Case studies</Kicker>
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      Finished jobs
    </Display>
    {cleared.length > 0 ? (
      <ul style="list-style:none;margin:0;padding:0;display:grid;gap:var(--space-9)">
        {cleared.map((c) => (
          <li><Link href={caseStudyPath(c)} variant="cta">{title(c)}</Link></li>
        ))}
      </ul>
    ) : (
      <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
        No case studies are published yet. In the meantime, the gallery shows our work.
        <Link href="/work/" variant="cta">See the gallery</Link>
      </p>
    )}
  </Wrap>
</Base>
