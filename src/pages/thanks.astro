---
/**
 * The landing after a form submission. Netlify redirects here only once it
 * has accepted the POST, which is why the form's GA4 event fires from this
 * page and not from the submit button. Noindexed and out of the sitemap: it
 * is not a destination, it is a receipt.
 *
 * Ported to the design system 2 Sep 2026.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import Link from "../components/ds/Link.astro";
import { BUSINESS } from "../data/site";
---

<Base
  title="Thank you"
  description="Your enquiry has been received."
  noindex
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Enquiries</Kicker>
    <Display level={2} as="h1" measure="var(--measure-display)" style="margin:var(--space-12) 0 var(--space-13)">
      Thank you, that has come through.
    </Display>
    <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
      We read every enquiry ourselves and come back to you with anything we need to know. If it
      is urgent, calling is quicker.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-12) var(--space-15);align-items:baseline;margin-top:var(--space-15)">
      <Link href={BUSINESS.phoneHref} variant="cta" chamfer>Call {BUSINESS.phoneDisplay}</Link>
      <Link href="/" variant="nav" chamfer>Back to the site</Link>
    </div>
  </Wrap>

  {/*
    The third enquiry channel. tel: and wa.me fire from Base.astro; the form
    fires here, because this page is only reached after Netlify accepts a POST.
    The flag is set in EnquiryForm.astro and cleared on read, so a refresh or a
    direct visit does not count a second enquiry.
  */}
  <script is:inline>
    (() => {
      let stamp = null;
      try {
        stamp = sessionStorage.getItem("ss_enquiry_submitted");
        sessionStorage.removeItem("ss_enquiry_submitted");
      } catch (err) {
        return;
      }
      if (!stamp) return;
      // Stale flag from an earlier session in the same tab.
      if (Date.now() - Number(stamp) > 10 * 60 * 1000) return;

      // Base.astro's gtag() is trapped inside the wrapper Astro generates for
      // define:vars, so window.gtag does not exist on any page of this site.
      // dataLayer is the shared global that gtag.js actually reads, so push to
      // it exactly the way gtag() does.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("event", "enquiry_form", { method: "form", link_url: "/thanks/" });
    })();
  </script>
</Base>
