---
/**
 * The landing after a form submission. Netlify redirects here only once it
 * has accepted the POST, which is why the form's GA4 event fires from this
 * page and not from the submit button. Noindexed and out of the sitemap: it
 * is not a destination, it is a receipt.
 *
 * Ported to the design system 2 Sep 2026.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import Link from "../components/ds/Link.astro";
import NextSteps from "../components/ds/NextSteps.astro";
import { BUSINESS } from "../data/site";

/* What happens next, 19 Oct 2026, replacing the paragraph that said it in
   prose. Steps 03 and 04 are PROCESS stages 01 and 02 by Kaspar's names
   (site-content.ts), shortened; nothing here that the stages do not say. No
   reply time is promised, on purpose: see EnquiryForm.astro. */
const STEPS = [
  {
    icon: "sheet",
    title: "Enquiry received",
    note: "Done",
    done: true,
    text: "Your details, and anything you attached, are with us now.",
  },
  {
    icon: "reply",
    title: "We come back to you",
    note: "Next",
    text: "We read every enquiry ourselves and get in touch with anything we need to know.",
  },
  {
    icon: "tape",
    title: "Survey & Planning",
    note: "In your home",
    text: "We visit to see the space, usually for 45 to 60 minutes, and measure it. You do not need every answer ready.",
  },
  {
    icon: "pencil",
    title: "Quotation & Design",
    note: "Fixed, itemised",
    text: "A fixed, itemised quotation follows the survey, with drawings where your project needs design work.",
  },
];
---

<Base
  title="Thank you"
  description="Your enquiry has been received. We reply with anything else we need, then arrange a survey before providing a detailed, itemised quotation for the work."
  noindex
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Enquiries</Kicker>
    <Display level={2} as="h1" measure="var(--measure-display)" style="margin:var(--space-12) 0 var(--space-13)">
      Thank you, that has come through.
    </Display>
    <section aria-labelledby="next-heading" style="margin-top:var(--space-16)">
      <Kicker id="next-heading">What happens next</Kicker>
      <div style="margin-top:var(--space-15)">
        <NextSteps steps={STEPS} />
      </div>
      <p style="margin-top:var(--space-15);padding-top:var(--space-12);border-top:var(--rule-hair);max-width:var(--measure);color:var(--text-quiet)">
        Preparation and fitting follow once you accept the quotation. <Link href="/process/">See the whole process</Link>.
        If it is urgent, calling is quicker.
      </p>
    </section>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-12) var(--space-15);align-items:baseline;margin-top:var(--space-12)">
      <Link href={BUSINESS.phoneHref} variant="cta" chamfer>Call {BUSINESS.phoneDisplay}</Link>
      <Link href="/" variant="nav" chamfer>Back to the site</Link>
    </div>
  </Wrap>

  {/*
    The third enquiry channel. tel: and wa.me fire from Base.astro; the form
    fires here, because this page is only reached after Netlify accepts a POST.
    The flag is set in EnquiryForm.astro and cleared on read, so a refresh or a
    direct visit does not count a second enquiry.
  */}
  <script is:inline>
    (() => {
      let stamp = null;
      try {
        stamp = sessionStorage.getItem("ss_enquiry_submitted");
        sessionStorage.removeItem("ss_enquiry_submitted");
      } catch (err) {
        return;
      }
      if (!stamp) return;
      // Stale flag from an earlier session in the same tab.
      if (Date.now() - Number(stamp) > 10 * 60 * 1000) return;

      // Base.astro's gtag() is trapped inside the wrapper Astro generates for
      // define:vars, so window.gtag does not exist on any page of this site.
      // dataLayer is the shared global that gtag.js actually reads, so push to
      // it exactly the way gtag() does.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("event", "enquiry_form", { method: "form", link_url: "/thanks/" });
    })();
  </script>
</Base>
