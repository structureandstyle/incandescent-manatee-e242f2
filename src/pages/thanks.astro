---
import Base from "../layouts/Base.astro";
import { BUSINESS } from "../data/site";
---

<Base
  title="Thank you"
  description="Your enquiry has been received."
>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-[length:var(--text-section)] font-semibold">Thank you, that has come through.</h1>
    <p class="mt-5 text-lg text-ink-soft">
      We read every enquiry ourselves and will come back to you shortly. If it is urgent, calling is
      quicker.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={BUSINESS.phoneHref} class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-bone hover:bg-timber-deep">
        Call {BUSINESS.phoneDisplay}
      </a>
      <a href="/" class="rounded-full border border-ink px-6 py-3 text-sm font-medium hover:border-timber hover:text-timber">
        Back to the site
      </a>
    </div>
  </section>

  {/*
    The third enquiry channel. tel: and wa.me fire from Base.astro; the form
    fires here, because this page is only reached after Netlify accepts a POST.
    The flag is set in EnquiryForm.astro and cleared on read, so a refresh or a
    direct visit does not count a second enquiry.
  */}
  <script is:inline>
    (() => {
      let stamp = null;
      try {
        stamp = sessionStorage.getItem("ss_enquiry_submitted");
        sessionStorage.removeItem("ss_enquiry_submitted");
      } catch (err) {
        return;
      }
      if (!stamp) return;
      // Stale flag from an earlier session in the same tab.
      if (Date.now() - Number(stamp) > 10 * 60 * 1000) return;

      // Base.astro's gtag() is trapped inside the wrapper Astro generates for
      // define:vars, so window.gtag does not exist on any page of this site.
      // dataLayer is the shared global that gtag.js actually reads, so push to
      // it exactly the way gtag() does.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("event", "enquiry_form", { method: "form", link_url: "/thanks/" });
    })();
  </script>
</Base>
