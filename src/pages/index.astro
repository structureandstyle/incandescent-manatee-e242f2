---
/**
 * The homepage, rebuilt on the design system.
 *
 * It kept the Astro scaffold's own layout until now, wearing the new palette,
 * which was the worst of both. This is the design system's structure: hero,
 * approach, work, materials, process with the drawing, the maker, reviews.
 *
 * THE COPY IS NOT THE DESIGN'S. Almost every sentence on the design's homepage
 * asserts something the questionnaire has since contradicted:
 *
 *   "the joinery workshop of Kaspar"            no workshop (Q3)
 *   "solid timber, honest joints"               MDF, veneered MDF, plywood (Q22)
 *   "carcasses that go in square"               unverified
 *   "cuts the joints, applies the finish"       materials are cut elsewhere (Q3)
 *   "Plate 05 · Kaspar at the bench"            no bench (Q3)
 *   "About the workshop"                        no workshop (Q3)
 *   "Six stages, one pair of hands"             there are four stages
 *
 * So the layout survives and the prose does not. What is asserted here is only
 * what is confirmed: the services, the areas served (which match the Business
 * Profile character for character, because citations are checked that way), and
 * the review aggregate. Everything else is a <Value> and completes itself when
 * the client answers.
 *
 * Even "one pair of hands" is held back. Q6 records that he works alone and
 * brings in a plumber, electrician and plasterer as a job needs them, and it is
 * the single most useful thing this page could say, but it is still marked
 * provisional rather than confirmed. It goes live the moment Q6 does.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Italic from "../components/ds/Italic.astro";
import Kicker from "../components/ds/Kicker.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import MaterialChip from "../components/ds/MaterialChip.astro";
import ProcessStep from "../components/ds/ProcessStep.astro";
import Reviews from "../components/ds/Reviews.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import Link from "../components/ds/Link.astro";
import Value from "../components/Value.astro";
import Ask from "../components/Ask.astro";

import { SERVICES, BUSINESS, servicePath, serviceLabel } from "../data/site";
import Faq from "../components/ds/Faq.astro";
import { HOMEPAGE_FAQS, MATERIALS, PROCESS, REVIEWS, BAND, CONTACT } from "../data/site-content";
import { WORK_GALLERY } from "../data/work-gallery";
import { indexable } from "../data/page-gates";
import { questionLabel } from "../data/answers";
import selection from "../../public/images/_selection.json";

const isIndexable = indexable("/");

const sel = selection as Record<string, { file: string; w: number; h: number }[]>;

/**
 * The showpiece: the green kitchen, supplied by Denis 31 Aug 2026, shown at
 * its own aspect ratio, uncropped, on his instruction.
 *
 * Provenance CONFIRMED the same day: Kaspar's photo drop (triaged into the
 * library, see the ops repo's docs/photo-library.md) contains another frame
 * of the same kitchen, and Denis confirmed the whole drop as his work.
 */
const hero = { file: "/images/bespoke-kitchens/green-kitchen.webp", w: 1636, h: 1091 };
/**
 * Selected work, POOLED, 6 September 2026. Kaspar, on the same message that
 * took the galleries off the service pages: "For the Selected Work section on
 * the homepage, I'd do the opposite. Put all the strongest completed work
 * together regardless of category, ideally one image per project rather than
 * several similar photos of the same thing."
 *
 * Until then this was four carousels, one per service, each cycling its own
 * selection. Now it is the first six frames of the curated work gallery,
 * which is already one image per project and already ordered so that no two
 * neighbours are the same type of work. Six, because the grid is three across
 * and two rows is a section rather than a page; the page is /work/.
 */
const sizeOf = new Map(
  Object.values(sel)
    .flat()
    .map((p) => [p.file, p])
);
const selected = WORK_GALLERY.filter((s) => sizeOf.has(s.file))
  .slice(0, 6)
  .map((s) => ({ ...s, ...(sizeOf.get(s.file) as { w: number; h: number }) }));

/* The plane joined stage 03 on 30 Aug 2026, once the stage-04 answer confirmed
   finishing work is real: machining, edging and finishing to the drawings, and
   pieces built up and finished in the room. See the note in ProcessStep.astro. */
const ICONS = ["tape", "pencil", "plane", "square"] as const;

/* The homepage questions, as data. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: HOMEPAGE_FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

{/* The description said "scribed to your walls and ceiling" until 2 Sep 2026.
    Section 7 allows the term once per page when it is defined in the same
    sentence, and a search snippet is read with no page around it, so the
    definition the Process section carries never reaches the person reading
    this. Plain words instead. */}
{/* THE TITLE LEADS WITH THE CATEGORY, NOT THE FLAGSHIP TERM, 5 Sep 2026.
    It read "Fitted wardrobes and joinery, London", opening on the same two
    words as /fitted-wardrobes/'s own title, "Fitted wardrobes London, made to
    measure". The target sheet gives "fitted wardrobes london" to that page
    alone and sets its month 3, 6 and 12 ranking floors on it, so the home page
    was competing for a term whose floors carry the engagement. The home page's
    job is the category and the company; the flagship phrase belongs to the
    flagship page. Every internal link labelled "Fitted wardrobes" already
    points there, and the description below still lists the services, so
    nothing else changes.

    "Bespoke" came out of the first version of this title, which measured 68
    characters once Base.astro appends the company name. 55 fits what a result
    page shows; the word is in the H1 kicker, the description and the footer
    strapline anyway. */}
<Base
  {/* "carpentry" returned to the title and description on 8 September 2026,
      launch day. Search Console's first twenty days showed every impression
      the domain had was a carpentry query (carpentry hampstead, carpenter
      chalk farm, bespoke carpentry), the Business Profile is named Bespoke
      Carpentry & Interiors and categorised Carpenter, and the rebuilt site
      had dropped the word entirely. The title stays off "fitted wardrobes"
      so it does not compete with /fitted-wardrobes/ (5 Sep). Ours, not his:
      his sentences on the page are untouched. */}
  title="Fitted furniture and carpentry, London"
  description="Bespoke carpentry and fitted furniture for London homes: fitted wardrobes, walk-in wardrobes and alcove units, measured on site and cut to your walls."
  schema={faqSchema}
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y)">
    {/* "Bespoke joinery · London" until 8 September 2026. A label of ours, not
        one of his sentences, and the only line above the fold that names the
        trade. Carpentry is what this market searches and what the Business
        Profile is named. */}
    <Kicker scribe>Bespoke carpentry and joinery · London</Kicker>

    {/* Kaspar's own headline and opening paragraph, 6 September 2026, in place
        of "made once, for one room". His is the plainer sentence and it is the
        one he wants read first.

        The italic falls on "your room", which is where his line turns: the
        emphasis is ours because he sent plain text, and it is the same
        treatment the old headline had on its last clause. */}
    <Display level={1} style="margin:var(--space-12) 0 var(--space-13)">
      Fitted furniture,<br />made to fit <Italic>your room.</Italic>
    </Display>

    <p style="max-width:var(--measure);font-size:var(--type-lede)">
      Bespoke fitted furniture for homes across London, including fitted wardrobes, walk-in
      wardrobes, alcove units and built-in TV units. Each piece is measured, designed and fitted
      around the space it belongs in.
    </p>

    {/* The services, by name. This was slice(0, 5), which silently picked up
        the cost guide when it was inserted fourth in SERVICES (Denis caught
        it on the homepage, 1 Sep 2026) and pushed out bespoke kitchens, whose
        carousel and hero photograph sit right below. The cost guide is a
        guide, not a service, so it is excluded by slug rather than by
        position. */}
    {/* Each name links to its page: this strip was plain text, so the
        homepage carried no link at all to the fitted wardrobes page, the
        flagship, since the four carousels below are the other services. */}
    <MonoLabel as="p" style="margin-top:var(--space-14)">
      {SERVICES.filter((s) => s.slug !== "fitted-wardrobe-cost").map((s, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={servicePath(s)} style="color:inherit">{serviceLabel(s)}</a>
        </>
      ))}
    </MonoLabel>

    {hero && (
      <div style="margin-top:var(--plate-y)">
        <Plate
          photo={hero.file}
          alt={`Bespoke kitchen, completed installation by ${BUSINESS.legalName}`}
          width={hero.w}
          height={hero.h}
          subject="Plate 01 · Bespoke kitchen"
          detail="Completed"
          ratio="1636 / 1091"
          eager
          plane="left"
        />
      </div>
    )}

    {/* This block sat ABOVE the plate until 2 Sep 2026, which put two blocks of
        claim in front of the first photograph on the page. Protocol section 11
        orders the proof: photography of finished work leads, before any claim.
        Below the plate it is also read after the thing it describes.

        The label is separate from his answer rather than inline, which is how
        it was: welded on it made one 26-word sentence, over the section 7
        ceiling of 25. A label is a label. */}
    <MonoLabel as="p" tone="soft" style="margin-top:var(--plate-y)">How the work is run</MonoLabel>
    <p style="max-width:var(--measure);margin-top:var(--space-5);color:var(--text-quiet)">
      <Value q="q06" />
    </p>
  </Wrap>

  <!-- Approach -->
  <Wrap style="padding-top:var(--section-y)">
    <Display level={3} as="h2" measure="var(--measure-display)">
      One commission, <Italic>start to finish.</Italic>
    </Display>
    <div style="max-width:var(--measure);margin-top:var(--space-13)">
      {/* Rewritten 3 Sep 2026, on Denis's note that a lead cannot follow it.
          It read: "The part nobody sees is the frame behind the doors. It goes
          in square against a wall that rarely is, and the difference is cut
          away rather than filled." Three trade ideas in two sentences, each
          assuming the reader already knows the trade: that square means true
          rather than merely four-sided, that walls are not, and that the other
          way of dealing with it is a filler strip. Section 7 asks that a bright
          14 year old follow every sentence on the first pass.

          The facts are unchanged and both are his. Q29 gives set out, levelled
          and plumb; Q31 gives walls, floors and ceilings rarely being straight.
          What has gone is the filler strip, because the hero paragraph on this
          same page already says the piece meets the floor and the ceiling
          without gaps or filler strips, and this section restating the page
          back to itself is the exact fault the 2 Sep About rewrite was for.

          The first attempt at this said "we build it level and straight" and
          the verify gate refused the build: "we build" is a Section 5
          provenance ban, because the client has no workshop and the site never
          claims the making. The frame goes in. That is the verb the site is
          entitled to.

          "Straight" rather than "level and straight" for two reasons: it is
          Q31's own word for what a wall is not, and Q29 runs three lines below
          this one with "set out, levelled, plumb" in his own wording, which
          this was echoing. */}
      {/* BOTH PARAGRAPHS ARE HIS, 6 September 2026 (10:43), typed under a
          screenshot of this section. The first replaces the frame-behind-the-
          doors paragraph above this note; the second replaces Q29, which it
          restates with a different middle clause, and it renders as his text
          rather than as the Value because his later sentence is the one he
          chose. Q29 is unchanged in answers.ts and still gates the page. */}
      <p>
        What you don't see matters just as much as what you do. Every installation starts with
        getting the structure level, plumb and properly set out, even when the room itself isn't.
        That's what allows the finished furniture to sit straight and the doors and details to line
        up as they should.
      </p>
      {/* "The standard it is held to" until 7 September 2026. His rename, and the
          About page's H1 since 6 September, so the two pages now agree. */}
      <MonoLabel as="p" tone="soft" style="margin-top:var(--space-12)">The standard we work to</MonoLabel>
      <p style="margin-top:var(--space-5)">
        Every piece carries our name. The same care goes into the details you see and the ones you
        don't, from the way materials meet to how doors close and drawers run. It should look right,
        feel right and be built to last.
      </p>
    </div>
  </Wrap>

  <!-- Work -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="Recent commissions" scribe>Selected work</SectionHead>
    {/* Three across, two rows, one frame shape. The six are all landscape and
        close to 4:3, so a fixed 4 / 3 frame crops nothing that matters and
        the rows sit level, which a row grid needs and a masonry does not.
        Every frame opens the lightbox, and with no carousel around them the
        lightbox set is all six. */}
    <div data-plate-set style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:var(--gap-md)">
      {selected.map((s, i) => (
        <Plate
          photo={s.file}
          alt={`${s.type}, completed installation by ${BUSINESS.legalName}`}
          width={s.w}
          height={s.h}
          ratio="4 / 3"
          sizes="(max-width: 660px) 92vw, (max-width: 1080px) 45vw, 320px"
          subject={s.type}
          plane={i === 0 ? "left" : false}
        />
      ))}
    </div>
    <p style="margin-top:var(--space-14)"><Link href="/work/" variant="nav" chamfer>All work</Link></p>
  </Wrap>

  <!-- Materials. Expandable since 1 Sep 2026: each card opens with where the
       material is used and what weighs for and against it, and hardware joined
       as the sixth card so the grid sits even. Copy rules in site-content.ts. -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="Boards, finishes and hardware" scribe>Materials</SectionHead>
    {/* THREE OVER TWO, 6 September 2026. Plywood came off the range on
        Kaspar's instruction, which left five cards in a three-column grid and
        the empty slot that hardware was added on 1 Sep to fill. Denis's call:
        stretch the last two across. They span the row and keep the height of
        the three above them by being wider rather than taller, so the section
        reads as one set. The rule is "the last two", not two named cards, so
        a sixth card puts the grid back to three and three on its own. */}
    <div class="mat-grid">
      {MATERIALS.map((m, i) => (
        <MaterialChip
          name={m.name}
          swatch={m.swatch}
          {/* The hardware swatch is a photograph of parts, not a finish, so it
              keeps no pure band above the wash. See MaterialChip. */}
          band={m.key !== "hardware"}
          description={m.description}
          uses={m.uses}
          pros={m.pros}
          cons={m.cons}
          class={i >= MATERIALS.length - 2 ? "wide" : undefined}
          sizes={i >= MATERIALS.length - 2 ? "(max-width: 700px) 92vw, (max-width: 1080px) 92vw, 480px" : undefined}
        />
      ))}
    </div>
    <p style="margin-top:var(--space-14)">
      <Link href="/materials/" variant="nav" chamfer>Materials, finishes and why not solid timber</Link>
    </p>
  </Wrap>

  <!-- Process -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="Four stages" scribe>Process</SectionHead>

    {/*
      THE WARDROBE ELEVATION CAME OFF ON 6 SEPTEMBER 2026, Kaspar's
      instruction: remove it here and on /process/, and replace it later with a
      genuine project drawing. It was a drawn generic wardrobe wall captioned
      "3400 × 2350 · 1:20", a specification for a job that does not exist, and
      he is right that a real drawing of a real project is worth more than an
      illustration of none.

      The component is not deleted, because the replacement is the same slot:
      src/components/ds/WardrobeDrawing.astro, mounted in a Plate with
      ratio="auto". Put a real drawing there when he sends one.
    */}

    {PROCESS.map((stage, i) => (
      <ProcessStep number={stage.number} icon={ICONS[i]} title={stage.title ?? "Stage still to be titled"}>
        {stage.confirmed ?? (
          <Ask q={questionLabel("stage04")}>
            What happens between the materials being cut and the piece reaching site
          </Ask>
        )}
      </ProcessStep>
    ))}

    <p style="margin-top:var(--space-14)">
      <Link href="/process/" variant="nav" chamfer>The full process, stage by stage</Link>
    </p>
  </Wrap>

  <!-- About. Was the maker section until the client's Part 6 direction
       change, 30 Aug 2026: company presentation, no personal name, no
       portrait. -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="The company" scribe>About Structure & Style</SectionHead>
    <div style="max-width:var(--measure)">
      {/* Rewritten 2 Sep 2026, on Denis reading this block and calling it
          repetitive and empty. He was right on both, and worse than he put it:
          every sentence in it was already said elsewhere on this same page.

          "The design is worked out in the room itself" restated the hero lede
          and the approach paragraph. "The first visit is to your home and
          takes 45 to 60 minutes" was process stage 01, three sections up, the
          same fact in the same words. Q35's guarantee was repeated almost
          verbatim in the FAQ four sections below. The heading said "About
          Structure & Style" and the link beneath it said "About Structure &
          Style" again. A section titled "The company" contained nothing about
          the company and nothing new, which is exactly why it read as empty.

          The first replacement was the section 11 conduct block, and Denis
          read that and said it was very specific: cutting locations, block
          hours and lift booking are what happens on site, not who we are. He
          asked for where we are based and how long we have been doing this.
          The conduct material went back to /about/, where it already sat in
          full, so nothing was lost.

          BASED IN CAMDEN TOWN is Denis's ruling of 2 Sep 2026, and it amends
          his own 30 Aug one. It was asked as a question rather than assumed,
          because the only address in the record is the registered office at
          71-75 Shelton Street, a Companies House service address in Covent
          Garden that the ops repo rules is never published. That address is
          in the borough of Camden, which would have made "based in Camden"
          technically true and materially false. He confirmed Camden Town is a
          real operating location. No street address appears here, so the
          service-area profile is untouched.

          HOW LONG WE HAVE BEEN DOING THIS is not here because no source for
          it exists. Q50 to Q53 were withdrawn on 30 Aug, his own live site
          claims nothing, and the only datable fact is the incorporation of
          31 Oct 2025, which is ten months and which the ops repo publishes to
          directories as "trading since October 2025". Anything else would be
          invented and checkable at Companies House in a minute. The standing
          ruling covers this: looking established is done with polish,
          process, guarantee, hardware brands and reviews.

          What carries the section instead is Q16, which is the closest thing
          in the whole questionnaire to a statement of character. The district
          list is six of the ten on /about/, because all ten in a
          bottom-of-page teaser reads as a list built for a search engine
          rather than a sentence.

          THREE ADDITIONS, Denis, 2 Sep 2026. Working across London is his own
          Q03 and his 30 Aug ruling, and the districts now sit under it as
          where most of the work is rather than as the limit of it. Cabinetry
          design is Q13 and Q20; the specifics here (internal layouts,
          materials, finishes, 3D visuals on more complex projects) are the
          half of Q20 the process section does not already carry, which says
          when design happens rather than what it covers.

          The third he asked for as "we are managing subcontractors", and it
          is written as the trades rather than as subcontracting, for two
          reasons. The FAQ on this same page says the person who measures your
          room is the person who draws it and fits it, and that nobody is sent
          in their place. "We manage subcontractors" next to that reads as the
          joinery being farmed out and contradicts it outright. And Q22 is an
          instruction not to explain the arrangement on the site. Naming
          plumbing, electrics and plastering says what he means, cannot be
          read as the joinery going elsewhere, and matches the evidence: a
          customer review on the profile reads "Uwe and Kas coordinated the
          team of plumber, electrician and plasterer".

          Note this claim is on the waiting-on-Kaspar list in
          `docs/engagement-status.md`, added 31 Aug, and it went in on Denis's
          instruction rather than on Kaspar's yes. Q38's records line came out
          to make room; /about/ carries it in full. */}
      {/* HIS PARAGRAPH, 6 September 2026 (11:12), under a screenshot of this
          section. The district list and the trades sentence above went with
          it: the districts are on the wardrobe page in his own words now, and
          the trades coordination is on the waiting-on-Kaspar list and he did
          not write it back in.

          THE BUDGET SENTENCE IS GONE ON HIS INSTRUCTION. Under this section he
          also wrote: "where the budget and brief don't meet... leave wording
          for the pricing/quotation section", quoting the sentence that used to
          end the paragraph below. Read as: that is a pricing conversation,
          not an About one. The cost sections on every service page already
          say what moves the price, so nothing is lost. */}
      <p>
        We are a joinery company based in Camden Town, working across London. We design, manage
        and install bespoke fitted furniture, from individual pieces to larger fitted interiors.
        Each project is developed around the room, the way it will be used and the finish the
        client wants to achieve.
      </p>
      <MonoLabel as="p" tone="soft" style="margin-top:var(--space-12)">Design</MonoLabel>
      <p style="margin-top:var(--space-5);color:var(--text-quiet)">
        Cabinetry design is part of the service: internal layouts, materials, finishes, and 3D
        visuals on more complex projects.
      </p>
      <p style="margin-top:var(--space-14)">
        <Link href="/about/" variant="nav" chamfer>More about how we work</Link>
      </p>
    </div>
  </Wrap>

  <!-- Reviews. Real quotes, verbatim from the profile, and the whole block
       links out to it: see REVIEWS in site-content.ts for the selection rule. -->
  <Wrap style="padding-top:var(--section-y)">
    <Reviews
      meta="Left by clients, unedited"
      average={REVIEWS.average}
      count={REVIEWS.count}
      source={REVIEWS.source}
      href={REVIEWS.profileUrl}
      quotes={REVIEWS.quotes}
    />
  </Wrap>

  <!-- Questions. The researched set: see HOMEPAGE_FAQS in site-content.ts. -->
  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
    <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
      {HOMEPAGE_FAQS.map((f) => <Faq q={f.q}>{f.a}</Faq>)}
    </div>
  </Wrap>

  <EnquireBand heading={BAND.heading} chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>

<style>
  /* The materials grid, three over two: see the note beside the markup. Six
     tracks so a card can take two thirds of a row without a fraction; an
     ordinary card takes two, a stretched one three. The stretched card's
     swatch goes to 9 / 4 so it keeps the height of a 3 / 2 swatch two thirds
     as wide, give or take the gap. */
  .mat-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap-md);
    align-items: start;
    /* A size container, so the frames below can take their height from the
       grid's own width in cqw. */
    container-type: inline-size;
  }
  .mat-grid > :global(*) {
    grid-column: span 2;
  }
  .mat-grid > :global(.wide) {
    grid-column: span 3;
    --mat-ratio: 9 / 4;
  }
  /* EVERY FRAME IS THE HEIGHT OF A NARROW CARD'S FRAME, by construction.
     The 9 / 4 ratio above was the first attempt and it is only a fallback
     now: the render measured the stretched tiles 8px taller than the row
     above on this page and 14px on /materials/, because a fixed ratio can
     be right for one gap width only and the two grids have different gaps.
     So the height is derived instead: a narrow card is two of six tracks and
     one gap, (100cqw - 5g) / 6 * 2 + g, which simplifies to (100cqw - 2g) / 3,
     and its 3 / 2 frame is that over 1.5. Set on all five frames, the wide
     ones come out wider and never taller, whatever the viewport. A browser
     without cqw ignores the height and keeps the ratio. */
  .mat-grid :global(.ss-mat-frame) {
    height: calc((100cqw - 2 * var(--gap-md)) / 4.5);
  }
  /* Two across on a tablet: the fourth card is an ordinary card again and
     the fifth has a row to itself, so it takes the row. A narrow card is now
     half the grid less half a gap. */
  @media (max-width: 1080px) {
    .mat-grid > :global(*),
    .mat-grid > :global(.wide) {
      grid-column: span 3;
      --mat-ratio: 3 / 2;
    }
    .mat-grid > :global(.wide):last-child {
      grid-column: span 6;
      --mat-ratio: 9 / 4;
    }
    .mat-grid :global(.ss-mat-frame) {
      height: calc((100cqw - var(--gap-md)) / 3);
    }
  }
  /* One column on a phone, every card the same shape. */
  @media (max-width: 660px) {
    .mat-grid > :global(*),
    .mat-grid > :global(.wide),
    .mat-grid > :global(.wide):last-child {
      grid-column: span 6;
      --mat-ratio: 3 / 2;
    }
    .mat-grid :global(.ss-mat-frame) {
      height: calc(100cqw / 1.5);
    }
  }
</style>
