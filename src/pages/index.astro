---
/**
 * The homepage, rebuilt on the design system.
 *
 * It kept the Astro scaffold's own layout until now, wearing the new palette,
 * which was the worst of both. This is the design system's structure: hero,
 * approach, work, materials, process with the drawing, the maker, reviews.
 *
 * THE COPY IS NOT THE DESIGN'S. Almost every sentence on the design's homepage
 * asserts something the questionnaire has since contradicted:
 *
 *   "the joinery workshop of Kaspar"            no workshop (Q3)
 *   "solid timber, honest joints"               MDF, veneered MDF, plywood (Q22)
 *   "carcasses that go in square"               unverified
 *   "cuts the joints, applies the finish"       materials are cut elsewhere (Q3)
 *   "Plate 05 · Kaspar at the bench"            no bench (Q3)
 *   "About the workshop"                        no workshop (Q3)
 *   "Six stages, one pair of hands"             there are four stages
 *
 * So the layout survives and the prose does not. What is asserted here is only
 * what is confirmed: the services, the areas served (which match the Business
 * Profile character for character, because citations are checked that way), and
 * the review aggregate. Everything else is a <Value> and completes itself when
 * the client answers.
 *
 * Even "one pair of hands" is held back. Q6 records that he works alone and
 * brings in a plumber, electrician and plasterer as a job needs them, and it is
 * the single most useful thing this page could say, but it is still marked
 * provisional rather than confirmed. It goes live the moment Q6 does.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Italic from "../components/ds/Italic.astro";
import Kicker from "../components/ds/Kicker.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import PlateCarousel from "../components/ds/PlateCarousel.astro";
import MaterialChip from "../components/ds/MaterialChip.astro";
import ProcessStep from "../components/ds/ProcessStep.astro";
import WardrobeDrawing from "../components/ds/WardrobeDrawing.astro";
import Reviews from "../components/ds/Reviews.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import Link from "../components/ds/Link.astro";
import Value from "../components/Value.astro";
import Ask from "../components/Ask.astro";

import { SERVICES, BUSINESS, servicePath, serviceLabel } from "../data/site";
import Faq from "../components/ds/Faq.astro";
import { HOMEPAGE_FAQS, MATERIALS, PROCESS, REVIEWS, BAND, CONTACT } from "../data/site-content";
import { indexable } from "../data/page-gates";
import { questionLabel } from "../data/answers";
import selection from "../../public/images/_selection.json";

const isIndexable = indexable("/");

const sel = selection as Record<string, { file: string; w: number; h: number }[]>;

/**
 * The showpiece: the green kitchen, supplied by Denis 31 Aug 2026, shown at
 * its own aspect ratio, uncropped, on his instruction.
 *
 * Provenance CONFIRMED the same day: Kaspar's photo drop (triaged into the
 * library, see the ops repo's docs/photo-library.md) contains another frame
 * of the same kitchen, and Denis confirmed the whole drop as his work.
 */
const hero = { file: "/images/bespoke-kitchens/green-kitchen.webp", w: 1636, h: 1091 };
/**
 * Selected work: four carousels, each cycling its service's own selection.
 * Bespoke kitchens joined 31 Aug 2026 on Denis's instruction. The images open
 * the lightbox; navigation to the service page moved to a named link under
 * each card, because a photograph that navigates when you expected it to
 * enlarge reads as a bug.
 */
const previews = SERVICES.map((s) => {
  const shots = sel[s.slug] ?? [];
  return shots.length ? { service: s, shots } : null;
})
  .filter(Boolean)
  .slice(1, 5) as { service: (typeof SERVICES)[number]; shots: { file: string; w: number; h: number }[] }[];

/* The plane joined stage 03 on 30 Aug 2026, once the stage-04 answer confirmed
   finishing work is real: machining, edging and finishing to the drawings, and
   pieces built up and finished in the room. See the note in ProcessStep.astro. */
const ICONS = ["tape", "pencil", "plane", "square"] as const;

/* The homepage questions, as data. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: HOMEPAGE_FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

{/* The description said "scribed to your walls and ceiling" until 2 Sep 2026.
    Section 7 allows the term once per page when it is defined in the same
    sentence, and a search snippet is read with no page around it, so the
    definition the Process section carries never reaches the person reading
    this. Plain words instead. */}
<Base
  title="Fitted wardrobes and joinery, London"
  description="Fitted wardrobes, walk-in wardrobes, alcove units and bespoke joinery for homes across London, measured on site and cut to follow your walls and ceiling."
  schema={faqSchema}
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y)">
    <Kicker scribe>Bespoke joinery · London</Kicker>

    <Display level={1} style="margin:var(--space-12) 0 var(--space-13)">
      Fitted furniture,<br />made once, <Italic>for one room.</Italic>
    </Display>

    <p style="max-width:var(--measure);font-size:var(--type-lede)">
      Alcove units, wardrobe walls, walk-in wardrobes and built-in TV units, for homes across
      London. Every piece is measured in your room and cut to follow the line of the wall. It
      meets the floor and the ceiling without gaps or filler strips.
    </p>

    {/* The services, by name. This was slice(0, 5), which silently picked up
        the cost guide when it was inserted fourth in SERVICES (Denis caught
        it on the homepage, 1 Sep 2026) and pushed out bespoke kitchens, whose
        carousel and hero photograph sit right below. The cost guide is a
        guide, not a service, so it is excluded by slug rather than by
        position. */}
    {/* Each name links to its page: this strip was plain text, so the
        homepage carried no link at all to the fitted wardrobes page, the
        flagship, since the four carousels below are the other services. */}
    <MonoLabel as="p" style="margin-top:var(--space-14)">
      {SERVICES.filter((s) => s.slug !== "fitted-wardrobe-cost").map((s, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={servicePath(s)} style="color:inherit">{serviceLabel(s)}</a>
        </>
      ))}
    </MonoLabel>

    {hero && (
      <div style="margin-top:var(--plate-y)">
        <Plate
          photo={hero.file}
          alt={`Bespoke kitchen, completed installation by ${BUSINESS.legalName}`}
          width={hero.w}
          height={hero.h}
          subject="Plate 01 · Bespoke kitchen"
          detail="Completed"
          ratio="1636 / 1091"
          eager
          plane="left"
        />
      </div>
    )}

    {/* This block sat ABOVE the plate until 2 Sep 2026, which put two blocks of
        claim in front of the first photograph on the page. Protocol section 11
        orders the proof: photography of finished work leads, before any claim.
        Below the plate it is also read after the thing it describes.

        The label is separate from his answer rather than inline, which is how
        it was: welded on it made one 26-word sentence, over the section 7
        ceiling of 25. A label is a label. */}
    <MonoLabel as="p" tone="soft" style="margin-top:var(--plate-y)">How the work is run</MonoLabel>
    <p style="max-width:var(--measure);margin-top:var(--space-5);color:var(--text-quiet)">
      <Value q="q06" />
    </p>
  </Wrap>

  <!-- Approach -->
  <Wrap style="padding-top:var(--section-y)">
    <Display level={3} as="h2" measure="var(--measure-display)">
      One commission, <Italic>start to finish.</Italic>
    </Display>
    <div style="max-width:var(--measure);margin-top:var(--space-13)">
      <p>
        The part nobody sees is the frame behind the doors. It goes in square against a wall that
        rarely is, and the difference is cut away rather than filled.
      </p>
      {/* Q29, his words. He refused any framing against other firms, so the
          paragraph states the standard rather than a comparison. The lead-in
          moved out of the sentence for the same reason as the one above. */}
      <MonoLabel as="p" tone="soft" style="margin-top:var(--space-12)">The standard it is held to</MonoLabel>
      <p style="margin-top:var(--space-5)">
        <Value q="q29" />
      </p>
    </div>
  </Wrap>

  <!-- Work -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="Recent commissions" scribe>Selected work</SectionHead>
    {/* Two by two, filling the width: the 420px floor means at most two
        columns inside the page measure, so four cards sit as two even rows
        instead of three plus an orphan. Collapses to one column on mobile. */}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:var(--gap-lg)">
      {previews.map(({ service, shots }) => (
        <div>
          <PlateCarousel
            shots={shots}
            altBase={`${serviceLabel(service)}, completed installation by ${BUSINESS.legalName}`}
            subject={serviceLabel(service)}
          />
          <p style="margin-top:var(--space-6)">
            <Link href={servicePath(service)} variant="nav">{serviceLabel(service)}</Link>
          </p>
        </div>
      ))}
    </div>
    <p style="margin-top:var(--space-14)"><Link href="/work/" variant="nav" chamfer>All work</Link></p>
  </Wrap>

  <!-- Materials. Expandable since 1 Sep 2026: each card opens with where the
       material is used and what weighs for and against it, and hardware joined
       as the sixth card so the grid sits even. Copy rules in site-content.ts. -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="Boards, finishes and hardware" scribe>Materials</SectionHead>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--gap-md);align-items:start">
      {MATERIALS.map((m) => (
        <MaterialChip
          name={m.name}
          swatch={m.swatch}
          {/* The hardware swatch is a photograph of parts, not a finish, so it
              keeps no pure band above the wash. See MaterialChip. */}
          band={m.key !== "hardware"}
          description={m.description}
          uses={m.uses}
          pros={m.pros}
          cons={m.cons}
        />
      ))}
    </div>
    <p style="margin-top:var(--space-14)">
      <Link href="/materials/" variant="nav" chamfer>Materials, finishes and why not solid timber</Link>
    </p>
  </Wrap>

  <!-- Process, with the drawing -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta={`${PROCESS.length} stages`} scribe>Process</SectionHead>

    {/*
      The drawing assembles in the order the work happens. Its eight stages map
      to the four steps below it. It sits here because this section has no
      photography of its own, which is exactly the case the design system built
      it for.
    */}
    <Plate
      as="div"
      subject="Fig. 01 · Wardrobe wall, elevation"
      detail="3400 × 2350 · 1:20"
      ratio="auto"
      style="margin-bottom:var(--gap-lg)"
    >
      <div style="padding:clamp(18px,3vw,44px) clamp(22px,4vw,64px);display:grid">
        <WardrobeDrawing />
      </div>
    </Plate>

    {PROCESS.map((stage, i) => (
      <ProcessStep number={stage.number} icon={ICONS[i]} title={stage.title ?? "Stage still to be titled"}>
        {stage.confirmed ?? (
          <Ask q={questionLabel("stage04")}>
            What happens between the materials being cut and the piece reaching site
          </Ask>
        )}
      </ProcessStep>
    ))}

    <p style="margin-top:var(--space-14)">
      <Link href="/process/" variant="nav" chamfer>The full process, stage by stage</Link>
    </p>
  </Wrap>

  <!-- About. Was the maker section until the client's Part 6 direction
       change, 30 Aug 2026: company presentation, no personal name, no
       portrait. -->
  <Wrap style="padding-top:var(--section-y)">
    <SectionHead meta="The company" scribe>About Structure & Style</SectionHead>
    <div style="max-width:var(--measure)">
      {/* Rewritten 2 Sep 2026, on Denis reading this block and calling it
          repetitive and empty. He was right on both, and worse than he put it:
          every sentence in it was already said elsewhere on this same page.

          "The design is worked out in the room itself" restated the hero lede
          and the approach paragraph. "The first visit is to your home and
          takes 45 to 60 minutes" was process stage 01, three sections up, the
          same fact in the same words. Q35's guarantee was repeated almost
          verbatim in the FAQ four sections below. The heading said "About
          Structure & Style" and the link beneath it said "About Structure &
          Style" again. A section titled "The company" contained nothing about
          the company and nothing new, which is exactly why it read as empty.

          The first replacement was the section 11 conduct block, and Denis
          read that and said it was very specific: cutting locations, block
          hours and lift booking are what happens on site, not who we are. He
          asked for where we are based and how long we have been doing this.
          The conduct material went back to /about/, where it already sat in
          full, so nothing was lost.

          BASED IN CAMDEN TOWN is Denis's ruling of 2 Sep 2026, and it amends
          his own 30 Aug one. It was asked as a question rather than assumed,
          because the only address in the record is the registered office at
          71-75 Shelton Street, a Companies House service address in Covent
          Garden that the ops repo rules is never published. That address is
          in the borough of Camden, which would have made "based in Camden"
          technically true and materially false. He confirmed Camden Town is a
          real operating location. No street address appears here, so the
          service-area profile is untouched.

          HOW LONG WE HAVE BEEN DOING THIS is not here because no source for
          it exists. Q50 to Q53 were withdrawn on 30 Aug, his own live site
          claims nothing, and the only datable fact is the incorporation of
          31 Oct 2025, which is ten months and which the ops repo publishes to
          directories as "trading since October 2025". Anything else would be
          invented and checkable at Companies House in a minute. The standing
          ruling covers this: looking established is done with polish,
          process, guarantee, hardware brands and reviews.

          What carries the section instead is Q16, which is the closest thing
          in the whole questionnaire to a statement of character. The district
          list is six of the ten on /about/, because all ten in a
          bottom-of-page teaser reads as a list built for a search engine
          rather than a sentence.

          THREE ADDITIONS, Denis, 2 Sep 2026. Working across London is his own
          Q03 and his 30 Aug ruling, and the districts now sit under it as
          where most of the work is rather than as the limit of it. Cabinetry
          design is Q13 and Q20; the specifics here (internal layouts,
          materials, finishes, 3D visuals on more complex projects) are the
          half of Q20 the process section does not already carry, which says
          when design happens rather than what it covers.

          The third he asked for as "we are managing subcontractors", and it
          is written as the trades rather than as subcontracting, for two
          reasons. The FAQ on this same page says the person who measures your
          room is the person who draws it and fits it, and that nobody is sent
          in their place. "We manage subcontractors" next to that reads as the
          joinery being farmed out and contradicts it outright. And Q22 is an
          instruction not to explain the arrangement on the site. Naming
          plumbing, electrics and plastering says what he means, cannot be
          read as the joinery going elsewhere, and matches the evidence: a
          customer review on the profile reads "Uwe and Kas coordinated the
          team of plumber, electrician and plasterer".

          Note this claim is on the waiting-on-Kaspar list in
          `docs/engagement-status.md`, added 31 Aug, and it went in on Denis's
          instruction rather than on Kaspar's yes. Q38's records line came out
          to make room; /about/ carries it in full. */}
      <p>
        We are a joinery company based in Camden Town, working across London. Most commissions
        are in the north: Hampstead, Belsize Park, Kentish Town, Highgate, Islington and Maida
        Vale. Where a job needs plumbing, electrics or plastering, we bring those trades in and
        coordinate them.
      </p>
      <MonoLabel as="p" tone="soft" style="margin-top:var(--space-12)">Design and budget</MonoLabel>
      <p style="margin-top:var(--space-5);color:var(--text-quiet)">
        Cabinetry design is part of the service: internal layouts, materials, finishes, and 3D
        visuals on more complex projects. Where the budget and the brief do not meet, we say what
        is driving the cost and adjust the design or the specification.
      </p>
      <p style="margin-top:var(--space-14)">
        <Link href="/about/" variant="nav" chamfer>More about how we work</Link>
      </p>
    </div>
  </Wrap>

  <!-- Reviews. Real quotes, verbatim from the profile, and the whole block
       links out to it: see REVIEWS in site-content.ts for the selection rule. -->
  <Wrap style="padding-top:var(--section-y)">
    <Reviews
      meta="Left by clients, unedited"
      average={REVIEWS.average}
      count={REVIEWS.count}
      source={REVIEWS.source}
      href={REVIEWS.profileUrl}
      quotes={REVIEWS.quotes}
    />
  </Wrap>

  <!-- Questions. The researched set: see HOMEPAGE_FAQS in site-content.ts. -->
  <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
    <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
    <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
      {HOMEPAGE_FAQS.map((f) => <Faq q={f.q}>{f.a}</Faq>)}
    </div>
  </Wrap>

  <EnquireBand heading={BAND.heading} chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>
