---
/**
 * The work page.
 *
 * The design shipped three case studies with full specification tables:
 * "Alcove library, Queen's Park" with 14 shelves on brass pins and a 3.4m span,
 * "Wardrobe wall, West Hampstead", "Window seat and shelving, Kensal Rise".
 * None of it was sourced. Q44 exists precisely because nobody knows which jobs
 * are real, so COMMISSIONS is empty and stays empty.
 *
 * SHAPE SETTLED AGAIN 6 September 2026, Kaspar's instruction after reviewing
 * the preview, and it reverses the 1 September shape rather than adjusting it.
 * That version was six collapsed categories, one carousel each, every
 * photograph reachable. His reading: there is not yet enough strong
 * photography in every category for categories to work, and six thin sets
 * advertise the thinness. So the grouping comes off, the strongest work goes
 * into one continuous gallery with the duplicates cut, and each frame carries
 * a plain description of the type of work. Filtering can return when the
 * library supports it.
 *
 * WHICH PHOTOGRAPHS, AND WHY THOSE, is src/data/work-gallery.ts. It is an
 * editorial list and it is meant to be edited by hand: this file only lays out
 * what that one names.
 *
 * The service pages lost their own galleries on the same instruction, so this
 * is now the only place the work is shown. The links below the gallery are
 * what carries a reader from a photograph to the page that explains it.
 *
 * The "jobs behind them" block (the Q44 to Q49 asks, rendered) came off on
 * 1 September on Denis's instruction. The questions are NOT answered and the
 * page's gate in page-gates.ts still holds it out of the index until they are;
 * only the on-page rendering of the wait went.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import Value from "../components/Value.astro";

import { BAND } from "../data/site-content";
import { BUSINESS, SERVICES, servicePath, serviceLabel } from "../data/site";
import { WORK_GALLERY } from "../data/work-gallery";
import { indexable } from "../data/page-gates";
import selection from "../../public/images/_selection.json";

const isIndexable = indexable("/work/");

/* Dimensions come from the selection rather than from the gallery list, so
   there is one place a photograph's real size is recorded. A file named in the
   gallery that is not in the selection fails the build here rather than
   shipping a frame with no width and height, which is a layout shift on the
   page whose whole content is photographs. */
const sel = selection as Record<string, { file: string; w: number; h: number }[]>;
const sizeOf = new Map(
  Object.values(sel)
    .flat()
    .map((p) => [p.file, p])
);

const shots = WORK_GALLERY.map((s) => {
  const found = sizeOf.get(s.file);
  if (!found) {
    throw new Error(
      `work-gallery.ts names ${s.file}, which is not in public/images/_selection.json. ` +
        "Add it to the selection, or correct the path."
    );
  }
  return { ...s, w: found.w, h: found.h };
});

/**
 * The frame follows its photograph, within a band, exactly as the service
 * galleries did until today. The band is the point: the two portrait kitchen
 * frames are 1126 x 2000 and unclamped they render three and a half times
 * taller than the landscape ones beside them, which no column layout can
 * balance around. Held between 3 / 4 and 3 / 2 the tallest is twice the
 * shortest and the columns fill evenly.
 */
const RATIO_MIN = 3 / 4;
const RATIO_MAX = 3 / 2;
const frameRatio = (p: { w: number; h: number }) =>
  String(Math.round(Math.min(RATIO_MAX, Math.max(RATIO_MIN, p.w / p.h)) * 1000) / 1000);

/**
 * Alt text: the type of work, that it is finished, and whose it is. All three
 * come from the triage. It does not describe the room, the materials or the
 * address, because nobody has written a per-image description and inventing
 * one is the failure the journal draft was blocked on. Q44 to Q49 are what
 * make real captions possible.
 */
const altFor = (type: string, n: number) =>
  `${type}, completed installation by ${BUSINESS.legalName}, photograph ${n}`;

/* The services with a page of their own, for the row under the gallery. The
   cost guide is excluded by its flag: it is a guide, not something a visitor
   looking at photographs has just seen one of. */
const services = SERVICES.filter((s) => !s.guide);
---

<Base
  title="Recent work"
  description="Photographs of completed installations across London: fitted wardrobes, walk-in wardrobes, alcove units, built-in TV units and bespoke kitchens."
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Work</Kicker>
    {/* His heading and paragraph, 6 September 2026, in place of "Rooms that
        were not square" and the line about walls that had never met a
        straight line. "Media units", not "media walls", is his own word
        choice here and it keeps protocol section 5. */}
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      Made for the space.
    </Display>
    <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
      A selection of fitted furniture and interior joinery completed across London. From fitted and
      walk-in wardrobes to alcove units, media units and other bespoke pieces, each project is
      designed around the space, how it will be used and the finish the client wants to achieve.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead meta={`${shots.length} photographs`} scribe>Finished work</SectionHead>

    {/* Columns rather than rows. Plates of different heights cannot sit in a
        row grid: a portrait beside two landscapes leaves half a row of empty
        paper. Three columns, two on a tablet, one on a phone, where the
        question does not arise.

        Every frame is a plain Plate with no [data-carousel] around it, and
        that is what makes the gallery browsable: the lightbox in Base.astro
        builds its set from the nearest carousel, or, finding none, from every
        plate photograph on the page. So clicking any frame opens the whole
        gallery at that photograph and arrows through all of them. */}
    <div class="work-gallery">
      {shots.map((s, i) => (
        <Plate
          photo={s.file}
          alt={altFor(s.type, i + 1)}
          width={s.w}
          height={s.h}
          ratio={frameRatio(s)}
          sizes="(max-width: 660px) 92vw, (max-width: 1080px) 45vw, 320px"
          {/* The type, and nothing beside it. Every plate elsewhere on the
              site carries a second half to its caption; here that was
              "Completed" under all twenty-one frames, on a page headed
              Finished work. The fact survives in the alt text, where it is
              read once per image by the people who need it. */}
          subject={s.type}
          eager={i < 2}
          plane={i === 0 ? "left" : false}
        />
      ))}
    </div>
  </Wrap>

  {/* The way back from a photograph to the page that explains the work. It
      matters more than it did: these pages no longer carry photography of
      their own, so this row is the only route between the two halves. */}
  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead level={5}>What each of these is</SectionHead>
    <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--gap-md)">
      {services.map((s) => (
        <li style="border-top:var(--rule-structure);padding-top:var(--space-9)">
          <Link href={servicePath(s)} variant="nav" chamfer>{serviceLabel(s)}</Link>
          <p style="margin-top:var(--space-6);font-size:var(--type-body-sm);color:var(--text-quiet)">{s.summary}</p>
        </li>
      ))}
    </ul>
  </Wrap>

  <EnquireBand heading="If you have a room in mind, start here." chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>

<style>
  /* `break-inside: avoid` keeps a plate and its caption together, and the
     plate is a block in its own column so the frame's own aspect-ratio decides
     its height. */
  .work-gallery {
    columns: 3;
    column-gap: var(--gap-md);
  }
  .work-gallery > * {
    break-inside: avoid;
    margin-bottom: var(--gap-md);
  }
  @media (max-width: 1080px) {
    .work-gallery { columns: 2; }
  }
  @media (max-width: 660px) {
    .work-gallery { columns: 1; }
  }
</style>
