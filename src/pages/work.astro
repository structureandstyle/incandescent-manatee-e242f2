---
/**
 * The work page.
 *
 * The design shipped three case studies with full specification tables:
 * "Alcove library, Queen's Park" with 14 shelves on brass pins and a 3.4m span,
 * "Wardrobe wall, West Hampstead", "Window seat and shelving, Kensal Rise".
 * None of it was sourced. Q44 exists precisely because nobody knows which jobs
 * are real, so COMMISSIONS is empty and stays empty.
 *
 * SHAPE SETTLED 1 September 2026, Denis's direction, third iteration that day:
 * six collapsed categories, one carousel card each, the same pattern as the
 * homepage's Selected work. The full-gallery version (every photograph laid
 * out) ran to 29 plates and scrolled forever; the carousels keep every
 * photograph reachable, with the lightbox swiping through a category's own
 * set. Five categories are the services with photography; the sixth, doors
 * and panelling, is real reviewed work with no service page of its own.
 *
 * The "jobs behind them" block (the Q44 to Q49 asks, rendered) came off the
 * same day on Denis's instruction. The questions are NOT answered and the
 * page's gate in page-gates.ts still holds it out of the index until they
 * are; only the on-page rendering of the wait went.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import PlateCarousel from "../components/ds/PlateCarousel.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Link from "../components/ds/Link.astro";
import Value from "../components/Value.astro";

import { BAND } from "../data/site-content";
import { BUSINESS, SERVICES, servicePath, serviceLabel } from "../data/site";
import { indexable } from "../data/page-gates";
import selection from "../../public/images/_selection.json";

const isIndexable = indexable("/work/");

const sel = selection as Record<string, { file: string; w: number; h: number }[]>;

/* The six categories: every service with photography, in SERVICES order, then
   doors and panelling from the 31 Aug drop. Each carries its full selection;
   the card cycles it. */
const categories = (
  SERVICES.map((s) => {
    const shots = sel[s.slug] ?? [];
    return shots.length
      ? { title: serviceLabel(s), shots, href: servicePath(s), alt: `${serviceLabel(s)}, completed installation by ${BUSINESS.legalName}` }
      : null;
  }).filter(Boolean) as { title: string; shots: { file: string; w: number; h: number }[]; href?: string; alt: string }[]
).concat(
  (sel["doors-panelling"] ?? []).length
    ? [
        {
          title: "Doors and panelling",
          shots: sel["doors-panelling"],
          href: undefined,
          alt: `Doors and panelling, completed installation by ${BUSINESS.legalName}`,
        },
      ]
    : []
);
---

<Base
  title="Recent work"
  description="Photographs of completed installations across London: fitted wardrobes, walk-in wardrobes, alcove units, built-in TV units and bespoke kitchens."
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Work</Kicker>
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      Rooms that were not square
    </Display>
    <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
      Every one of these started as a wall that had never met a straight line. The interesting part
      of each job is what had to be given up, and what did not.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead meta={`${categories.length} categories`} scribe>Finished work</SectionHead>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:var(--gap-lg)">
      {categories.map((c, i) => (
        <div>
          <PlateCarousel shots={c.shots} altBase={c.alt} subject={c.title} eager={i === 0} />
          {c.href && (
            <p style="margin-top:var(--space-6)">
              <Link href={c.href} variant="nav">{c.title}</Link>
            </p>
          )}
        </div>
      ))}
    </div>
  </Wrap>

  <EnquireBand heading="If you have a room in mind, start here." chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>
