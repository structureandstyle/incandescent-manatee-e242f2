---
/**
 * The seven contracted service pages, all from this one template.
 *
 * Structure comes from the SEO runbook and the local playbook, not from taste:
 * a clear H1 carrying the primary keyword, question-shaped H2s, a concise
 * answer before the detail, real numbers, named area coverage, three or more
 * photographs of completed work, and one obvious enquiry action.
 *
 * Every number on the page is a <Value>. None of them is written here. When an
 * answer lands in src/data/answers.ts the sentence completes itself, and when
 * the last one this page needs lands, page-gates.ts lifts its noindex and the
 * page enters the sitemap. That is the whole "one edit and push" mechanism, and
 * it is why this file contains no prices, no lead times and no guarantee terms.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Value from "../components/Value.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import SpecTable from "../components/ds/SpecTable.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import Faq from "../components/ds/Faq.astro";
import Link from "../components/ds/Link.astro";

import { SERVICES, SITE_URL, BUSINESS, servicePath, serviceLabel, type Service } from "../data/site";
import { BAND, CONTACT } from "../data/site-content";
import { SERVICE_COPY } from "../data/service-copy";
import { gateFor, indexable } from "../data/page-gates";
import { unanswered } from "../data/answers";
import selection from "../../public/images/_selection.json";

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;

const path = servicePath(service);
const open = unanswered(gateFor(path));
/**
 * Two gates, both must pass. The answer gate is the questionnaire machinery.
 * The copy gate holds back any service page that has no entry in
 * SERVICE_COPY: without its own intro, sections and FAQs, a page is the
 * shared template with different photographs, and seven near-identical pages
 * going indexable together is doorway-page territory. Wave two (media walls,
 * kitchens, home office) stays noindexed until its copy is written, even
 * after Q10 lands.
 */
const isIndexable = indexable(path) && Boolean(SERVICE_COPY[service.slug]);
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);

/**
 * Wave-one body copy and FAQs, where written (src/data/service-copy.ts).
 * Wave-two pages have no entry yet and render nothing extra. The intro sits
 * after the photography, never before it: protocol section 11, photography
 * leads.
 */
const copy = SERVICE_COPY[service.slug];

/**
 * Photographs, selected from the client's own library: finished work only, at
 * quality 4 or 5, spread across different shoot dates so a page is not three
 * angles of one room. Any file whose name carries "(1)" is excluded as a matter
 * of rule rather than by list: those are AI-edited duplicates and carry Google's
 * AI-generated label in the frame. Twelve of them exist; the written denylist
 * named only five.
 *
 * home-office-understairs-storage has no entry, and that is accurate rather
 * than an oversight: the library holds nothing finished above quality 3 for
 * home office and nothing at all for under-stair storage. Plate renders an
 * honest empty frame instead.
 */
const sel = selection as Record<string, { file: string; w: number; h: number }[]>;
/* The cost guide is the wardrobe product priced, so it shows the wardrobe
   photography. Without this it rendered the empty-frame state ("none in the
   library, requested from the client") on an indexable page (2 Sep 2026). */
const photos: { file: string; w: number; h: number }[] =
  sel[service.slug] ?? (service.slug === "fitted-wardrobe-cost" ? sel["fitted-wardrobes"] ?? [] : []);

/**
 * Alt text. Deliberately minimal and provably true: the service, and that the
 * work is finished, both of which come from the triage. It does not describe
 * the room, the materials or the location, because nobody has yet written a
 * per-image description and inventing one is the failure the journal draft was
 * blocked on. Q44 to Q49 are what make real captions possible.
 */
const altFor = (n: number) =>
  `${service.title}, completed installation by ${BUSINESS.legalName}, photograph ${n}`;

/**
 * The shape of each plate's frame, 5 September 2026.
 *
 * Every frame in this gallery was a fixed 3 / 2 with object-fit:cover,
 * whatever shape the photograph was. Nine of the library's selections are
 * portrait and two of the kitchen shots are 1126 x 2000: a centre crop of
 * those to 3 / 2 kept the ceiling and the downlights and cut the kitchen out
 * of the frame. Four fitted-wardrobe portraits lost half their height the same
 * way, which is part of why that gallery read as a row of near-identical
 * cavities.
 *
 * So the frame follows the photograph, WITHIN A BAND. The band is the part
 * that matters: an unclamped 1126 x 2000 plate renders three and a half times
 * taller than the landscape ones beside it and no column layout can balance
 * around it. Held between 3 / 4 and 3 / 2, the tallest plate is twice the
 * shortest, the columns fill evenly, and the crop that remains on the two
 * extreme portraits takes a quarter of their height off a ceiling rather than
 * two thirds off a kitchen.
 */
const RATIO_MIN = 3 / 4;
const RATIO_MAX = 3 / 2;
const frameRatio = (p: { w: number; h: number }) =>
  String(Math.round(Math.min(RATIO_MAX, Math.max(RATIO_MIN, p.w / p.h)) * 1000) / 1000);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.primary,
  description: service.description,
  provider: { "@id": `${SITE_URL}/#business` },
  areaServed: BUSINESS.areaServed.map((a) => ({ "@type": "Place", name: a })),
  url: new URL(path, SITE_URL).href,
};

/* The breadcrumb the page already shows, as data. */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: service.title, item: new URL(path, SITE_URL).href },
  ],
};

/* The page's own questions, as data. Only where the copy carries them. */
const faqSchema =
  copy && copy.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: copy.faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

const schema = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

/* Question-shaped H2s, each with the questions that answer it. A row carries
   either a questionnaire key (q) or confirmed literal copy (text): the guide
   price became per-service literal copy when the pricing document arrived on
   31 Aug 2026, because one site-wide q10 value cannot price seven services. */
type Row = { label: string; q?: Parameters<typeof unanswered>[0][number]; text?: string };
const SECTIONS: { id: string; heading: string; lead: string; rows: Row[] }[] = [
  {
    id: "cost",
    /* The cost guide's own title is already the cost question, so interpolating
       it produced "What do what fitted wardrobes cost cost?". */
    heading:
      service.slug === "fitted-wardrobe-cost"
        ? "The guide prices, by size and finish"
        : `What do ${service.title.toLowerCase()} cost?`,
    lead: "The honest answer is a range, because the room decides it.",
    rows: [
      { label: "Guide price", text: service.price },
      { label: "What moves it", q: "q11" },
      { label: "Smallest job taken", q: "q12" },
    ],
  },
  {
    id: "how-long",
    heading: "How long does it take?",
    lead: "Two different clocks: how far ahead the work is booked, and how long the work itself runs.",
    rows: [
      { label: "Booked ahead", q: "q07" },
      /* Q18 rendered bare stated the design week as automatic, on all four
         service pages, in a stats row read as flat fact beside "Booked ahead"
         and "Days on site". Q13 says straightforward jobs go straight to
         quotation, so a design week is conditional and this was undertaking
         work we do not owe. The process page caught the same promise in its
         own prose on 2 Sep 2026 (site-content.ts stage 02) and the fix never
         reached this template. Q18's own week survives; what is added is the
         condition Q13 puts on it. Text rather than a Value for the same
         reason the Guide price row above is text: the fact is derived from
         two answers, not quoted from one. Q18 stays in the page gate. */
      {
        label: "Survey to drawings",
        text:
          "Where the project needs design work, one week is set aside for it, and drawings follow at the end of that week. Straightforward projects can go straight to quotation.",
      },
      /* Q30's figure is "a straightforward wardrobe wall", which is the right
         fact on a wardrobe page and the wrong product everywhere else: an
         alcove unit is not a wardrobe wall and a walk-in is a room. The prior
         audit flagged this for alcove units, media walls and kitchens; the
         4 Sep read found it on walk-in wardrobes too.

         The honest fix is not to generalise Q30, because widening "a
         straightforward wardrobe wall" into "any piece" invents a duration the
         client never gave, which is the same fault the process page was
         corrected for on 2 Sep. So the wardrobe pages keep Q30 and every other
         service falls back to Q32, which is sourced and true for all of them.

         WHAT THIS NEEDS: per-service durations from Kaspar. He has only ever
         been asked about a wardrobe wall. */
      service.slug === "fitted-wardrobes" || service.slug === "fitted-wardrobe-cost"
        ? { label: "Days on site", q: "q30" }
        : { label: "On site", q: "q32" },
    ],
  },
  {
    id: "made-from",
    heading: "What is it made from?",
    lead: "Engineered board rather than solid timber, and that is a decision rather than a compromise.",
    rows: [
      { label: "Materials", q: "q22" },
      { label: "Finishes", q: "q24" },
      { label: "Hardware", q: "q28" },
      { label: "Why not solid timber", q: "q43" },
    ],
  },
  {
    id: "fitting",
    heading: "How is it fitted?",
    lead: "London rooms are rarely square. What happens where the piece meets the wall is the whole job.",
    rows: [
      { label: "Scribing", q: "q31" },
      { label: "Clearing up", q: "q33" },
    ],
  },
  {
    id: "after",
    heading: "What happens afterwards?",
    lead: "Timber moves with the first heating season. What matters is who comes back.",
    rows: [
      { label: "Guarantee", q: "q35" },
      { label: "Adjustments", q: "q36" },
    ],
  },
];
---

<Base
  title={service.metaTitle ?? service.heading}
  description={service.description}
  schema={schema}
  noindex={!isIndexable}
>
  <article>
    <!-- Hero -->
    <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
      <nav aria-label="Breadcrumb" style="margin-bottom:var(--space-10)">
        <MonoLabel tone="soft">
          <Link href="/" variant="nav">Home</Link>
          <span aria-hidden="true" style="padding:0 var(--space-5)">/</span>
          {service.title}
        </MonoLabel>
      </nav>

      <Kicker scribe>{service.primary}</Kicker>

      <Display level={1} as="h1" measure="var(--measure-display)" style="margin:var(--space-12) 0 var(--space-13)">
        {service.heading}
      </Display>

      <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
        {service.summary}
      </p>

      <div style="display:flex;flex-wrap:wrap;gap:var(--space-12) var(--space-15);align-items:baseline;margin-top:var(--space-15)">
        <Link href="#enquire" variant="cta" chamfer>Get a price</Link>
        <Link href={CONTACT.phoneHref} variant="nav" chamfer style="padding:var(--space-6) 0">Call {CONTACT.phoneDisplay}</Link>
        <Link href={CONTACT.whatsapp} variant="nav" chamfer style="padding:var(--space-6) 0">WhatsApp</Link>
      </div>
    </Wrap>

    <!-- The work itself, before any of the words -->
    <Wrap style="padding-bottom:var(--section-y)">
      {/* "8 of this work" was not a phrase. It sat under the H1 beside the
          photographs, the first thing a visitor reads after the hero, on every
          service page, and read as a dropped word. Two independent readers in
          the 4 Sep review flagged it and every other count label on this site
          is a complete noun phrase: "4 stages", "7 categories", "12 published".
          This one was the only outlier. */}
      <SectionHead
        meta={photos.length ? `${photos.length} photograph${photos.length === 1 ? "" : "s"}` : undefined}
        scribe
      >
        The work
      </SectionHead>

      {/* Frames follow their photographs now, within a band: see frameRatio
          above. Plates of different heights cannot sit in a row grid, where a
          portrait beside two landscapes leaves half a row of empty paper, so
          the gallery is columns rather than rows. Three columns, two on a
          tablet, one on a phone, where the question never arises. */}
      <div class="work-gallery">
        {photos.length > 0
          ? photos.map((p, i) => (
              <Plate
                photo={p.file}
                alt={altFor(i + 1)}
                width={p.w}
                height={p.h}
                ratio={frameRatio(p)}
                subject={`Plate ${String(i + 1).padStart(2, "0")} · ${service.title}`}
                detail="Completed"
                eager={i === 0}
                plane={i === 0 ? "left" : false}
              />
            ))
          : (
            <>
              <Plate subject="Plate 01" detail="None in the library" awaiting="No finished photograph exists for this service yet" />
              <Plate subject="Plate 02" detail="None in the library" awaiting="Requested from the client" />
            </>
          )}
      </div>
    </Wrap>

    {copy && (
      <Wrap style="padding-bottom:var(--section-y)">
        <div style="max-width:var(--measure)">
          {copy.intro.map((p, i) => (
            <p style={i ? "margin-top:var(--space-10)" : undefined}>{p}</p>
          ))}
        </div>
      </Wrap>
    )}

    <!-- Question-shaped sections -->
    {SECTIONS.map((section) => (
      <>
        <Wrap style="padding-bottom:var(--section-y)">
          <SectionHead id={section.id} level={4}>{section.heading}</SectionHead>
          <div style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--gap-xl);align-items:start">
            <p style="max-width:var(--measure-short);color:var(--text-quiet)">{copy?.leads?.[section.id] ?? section.lead}</p>
            <SpecTable
              stamp
              rows={[]}
              labelWidth="34%"
            >
              {section.rows.map((row) => (
                <tr>
                  <td style="width:34%;padding:var(--space-4) 0;padding-right:var(--space-8);border-bottom:var(--rule-hair);vertical-align:top;text-transform:uppercase;letter-spacing:var(--ls-mono-table);font-size:var(--type-mono);color:var(--ink-soft)">
                    {row.label}
                  </td>
                  <td style="padding:var(--space-4) 0;border-bottom:var(--rule-hair);vertical-align:top">
                    {row.q ? <Value q={row.q} /> : row.text}
                  </td>
                </tr>
              ))}
            </SpecTable>
          </div>
        </Wrap>

        {section.id === "cost" && copy?.priceTables && (
          <Wrap style="padding-bottom:var(--section-y)">
            {copy.priceTables.map((t) => (
              <div style="margin-bottom:var(--space-15)">
                <SectionHead level={5}>{t.title}</SectionHead>
                <p style="max-width:var(--measure);margin-top:var(--space-5);font-size:var(--type-body-sm);color:var(--text-quiet)">
                  {t.note}
                </p>
                {/* THE PRICE TABLES ON A PHONE, 5 September 2026. The wrapper
                    scrolled and nothing said so. At 375 and at 443 the widest
                    two columns, which carry the highest prices, sat off the
                    right edge; headless Chrome draws a scrollbar and iOS
                    Safari does not, so the only clue was a column heading cut
                    off mid-word. This is the page that exists to answer what
                    the work costs.

                    Three changes, all inside the scroller. The finish column
                    sticks to the left edge so a price is never read without
                    knowing which finish it belongs to. A fade on the right
                    shows there is more, and clears when the table is scrolled
                    to its end. And a mono line under the table says so in
                    words, shown only when the table actually overflows. */}
                <div class="price-scroll" data-price-scroll style="margin-top:var(--space-9)">
                  <div class="price-scroll-viewport" data-price-viewport>
                    <table class="price-table">
                      <thead>
                        <tr>
                          {t.columns.map((c) => (
                            <th style="text-align:left;padding:var(--space-4) var(--space-8) var(--space-4) 0;border-bottom:var(--rule-structure);text-transform:uppercase;letter-spacing:var(--ls-mono-table);font-size:var(--type-mono);font-weight:var(--weight-regular);color:var(--ink-soft)">
                              {c}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {t.rows.map((r) => (
                          <tr>
                            {r.map((cell, i) => (
                              <td style={`padding:var(--space-5) var(--space-8) var(--space-5) 0;border-bottom:var(--rule-hair);vertical-align:top${i === 0 ? "" : ";font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono-table)"}`}>
                                {cell}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
                <p class="price-scroll-hint" data-price-hint hidden>
                  <MonoLabel as="span" tone="soft">Scroll the table for the wider sizes</MonoLabel>
                </p>
              </div>
            ))}
            {copy.priceNotes?.map((n) => (
              <p style="max-width:var(--measure);margin-top:var(--space-8);font-size:var(--type-body-sm);color:var(--text-quiet)">{n}</p>
            ))}
          </Wrap>
        )}
      </>
    ))}

    {copy && copy.sections.map((sec) => (
      <Wrap style="padding-bottom:var(--section-y)">
        <SectionHead meta={sec.meta} level={4}>{sec.heading}</SectionHead>
        <div style="max-width:var(--measure)">
          {sec.body.map((p, i) => (
            <p style={i ? "margin-top:var(--space-10)" : undefined}>{p}</p>
          ))}
        </div>
      </Wrap>
    ))}

    <!-- Where we work. Confirmed, so it carries no open question. -->
    <Wrap style="padding-bottom:var(--section-y)">
      <SectionHead meta="Service area" level={4}>Where we work</SectionHead>
      <p style="max-width:var(--measure)">
        Across London, including {BUSINESS.areaServed.slice(0, -1).join(", ")} and{" "}
        {BUSINESS.areaServed.slice(-1)}.
      </p>
    </Wrap>

    {copy && copy.faqs.length > 0 && (
      <Wrap style="padding-bottom:var(--section-y)">
        <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
        <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
          {copy.faqs.map((f) => <Faq q={f.q}>{f.a}</Faq>)}
        </div>
      </Wrap>
    )}

    <!-- Enquiry -->
    <section id="enquire">
      {/* cta suppressed: the form itself sits directly below this band. */}
      <EnquireBand heading="If you have a room in mind, start here." cta={null} chamfer>
        {BAND.body}
        <Fragment slot="facts">
          {/* This page's own price line, then the shared lead time and area. */}
          <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">{service.bandPrice}</MonoLabel>
          {BAND.facts.slice(1).map((q) => (
            <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
              <Value q={q} />
            </MonoLabel>
          ))}
        </Fragment>
      </EnquireBand>

      <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
        <div style="max-width:var(--measure-tight)">
          <EnquiryForm compact service={service.title} />
        </div>
      </Wrap>
    </section>

    <!-- Cross-links -->
    <Wrap style="padding-bottom:var(--section-y)">
      <SectionHead level={5}>Also worth a look</SectionHead>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--gap-md)">
        {others.map((s) => (
          <li style="border-top:var(--rule-structure);padding-top:var(--space-9)">
            <Link href={servicePath(s)} variant="nav" chamfer>{serviceLabel(s)}</Link>
            <p style="margin-top:var(--space-6);font-size:var(--type-body-sm);color:var(--text-quiet)">{s.summary}</p>
          </li>
        ))}
      </ul>
    </Wrap>
  </article>
</Base>

<style>
  /* The photography, laid out in columns rather than rows: see the note beside
     the markup. `break-inside: avoid` is what keeps a plate and its caption
     together, and the plate is a block in its own column so the frame's own
     aspect-ratio decides its height. */
  .work-gallery {
    columns: 3;
    column-gap: var(--gap-md);
  }
  .work-gallery > * {
    break-inside: avoid;
    margin-bottom: var(--gap-md);
  }
  @media (max-width: 1080px) {
    .work-gallery { columns: 2; }
  }
  @media (max-width: 660px) {
    .work-gallery { columns: 1; }
  }

  .price-scroll {
    position: relative;
  }
  .price-scroll-viewport {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .price-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }
  /* The finish column stays put, so a figure is never read without knowing
     which finish it prices. Paper behind it, or the scrolling columns show
     through. */
  .price-table th:first-child,
  .price-table td:first-child {
    position: sticky;
    left: 0;
    background: var(--paper);
  }
  /* The separating hairline arrives only once something has scrolled under
     the column, and it is a shadow rather than a border so it never moves the
     cell it sits on. */
  .price-scroll[data-scrolled] .price-table th:first-child,
  .price-scroll[data-scrolled] .price-table td:first-child {
    box-shadow: 1px 0 0 var(--hair);
  }
  .price-scroll::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 56px;
    pointer-events: none;
    background: linear-gradient(to right, rgba(242, 238, 227, 0), var(--paper));
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease-out);
  }
  .price-scroll[data-overflow]:not([data-end])::after {
    opacity: 1;
  }
  .price-scroll-hint {
    margin-top: var(--space-6);
  }
</style>

<script>
  // The scroll state each price table reports about itself: whether it
  // overflows at all, whether it is at its right-hand end, and whether
  // anything has scrolled under the sticky first column. The CSS above reads
  // all three. Without JavaScript the table still scrolls, the sticky column
  // still sticks, and only the fade and the written hint are missing.
  document.querySelectorAll<HTMLElement>("[data-price-scroll]").forEach((wrap) => {
    const vp = wrap.querySelector<HTMLElement>("[data-price-viewport]");
    if (!vp) return;
    const next = wrap.nextElementSibling;
    const hint = next instanceof HTMLElement && next.matches("[data-price-hint]") ? next : null;
    const update = () => {
      const overflows = vp.scrollWidth - vp.clientWidth > 4;
      wrap.toggleAttribute("data-overflow", overflows);
      wrap.toggleAttribute("data-end", overflows && vp.scrollLeft + vp.clientWidth >= vp.scrollWidth - 4);
      wrap.toggleAttribute("data-scrolled", vp.scrollLeft > 2);
      if (hint) hint.hidden = !overflows;
    };
    update();
    vp.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  });
</script>
