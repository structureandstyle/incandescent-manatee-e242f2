---
/**
 * The seven contracted service pages, all from this one template.
 *
 * Structure comes from the SEO runbook and the local playbook, not from taste:
 * a clear H1 carrying the primary keyword, question-shaped H2s, a concise
 * answer before the detail, real numbers, named area coverage, three or more
 * photographs of completed work, and one obvious enquiry action.
 *
 * Every number on the page is a <Value>. None of them is written here. When an
 * answer lands in src/data/answers.ts the sentence completes itself, and when
 * the last one this page needs lands, page-gates.ts lifts its noindex and the
 * page enters the sitemap. That is the whole "one edit and push" mechanism, and
 * it is why this file contains no prices, no lead times and no guarantee terms.
 */
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Value from "../components/Value.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import Plate from "../components/ds/Plate.astro";
import SpecTable from "../components/ds/SpecTable.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import Faq from "../components/ds/Faq.astro";
import Link from "../components/ds/Link.astro";

import { SERVICES, SITE_URL, BUSINESS, servicePath, type Service } from "../data/site";
import { BAND, CONTACT } from "../data/site-content";
import { SERVICE_COPY } from "../data/service-copy";
import { gateFor, indexable } from "../data/page-gates";
import { unanswered } from "../data/answers";
import selection from "../../public/images/_selection.json";

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;

const path = servicePath(service);
const open = unanswered(gateFor(path));
/**
 * Two gates, both must pass. The answer gate is the questionnaire machinery.
 * The copy gate holds back any service page that has no entry in
 * SERVICE_COPY: without its own intro, sections and FAQs, a page is the
 * shared template with different photographs, and seven near-identical pages
 * going indexable together is doorway-page territory. Wave two (media walls,
 * kitchens, home office) stays noindexed until its copy is written, even
 * after Q10 lands.
 */
const isIndexable = indexable(path) && Boolean(SERVICE_COPY[service.slug]);
const others = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);

/**
 * Wave-one body copy and FAQs, where written (src/data/service-copy.ts).
 * Wave-two pages have no entry yet and render nothing extra. The intro sits
 * after the photography, never before it: protocol section 11, photography
 * leads.
 */
const copy = SERVICE_COPY[service.slug];

/**
 * Photographs, selected from the client's own library: finished work only, at
 * quality 4 or 5, spread across different shoot dates so a page is not three
 * angles of one room. Any file whose name carries "(1)" is excluded as a matter
 * of rule rather than by list: those are AI-edited duplicates and carry Google's
 * AI-generated label in the frame. Twelve of them exist; the written denylist
 * named only five.
 *
 * home-office-understairs-storage has no entry, and that is accurate rather
 * than an oversight: the library holds nothing finished above quality 3 for
 * home office and nothing at all for under-stair storage. Plate renders an
 * honest empty frame instead.
 */
const photos: { file: string; w: number; h: number }[] =
  (selection as Record<string, { file: string; w: number; h: number }[]>)[service.slug] ?? [];

/**
 * Alt text. Deliberately minimal and provably true: the service, and that the
 * work is finished, both of which come from the triage. It does not describe
 * the room, the materials or the location, because nobody has yet written a
 * per-image description and inventing one is the failure the journal draft was
 * blocked on. Q44 to Q49 are what make real captions possible.
 */
const altFor = (n: number) =>
  `${service.title}, completed installation by ${BUSINESS.legalName}, photograph ${n}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.primary,
  description: service.description,
  provider: { "@id": `${SITE_URL}/#business` },
  areaServed: BUSINESS.areaServed.map((a) => ({ "@type": "Place", name: a })),
  url: new URL(path, SITE_URL).href,
};

/* Question-shaped H2s, each with the questions that answer it. A row carries
   either a questionnaire key (q) or confirmed literal copy (text): the guide
   price became per-service literal copy when the pricing document arrived on
   31 Aug 2026, because one site-wide q10 value cannot price seven services. */
type Row = { label: string; q?: Parameters<typeof unanswered>[0][number]; text?: string };
const SECTIONS: { id: string; heading: string; lead: string; rows: Row[] }[] = [
  {
    id: "cost",
    /* The cost guide's own title is already the cost question, so interpolating
       it produced "What do what fitted wardrobes cost cost?". */
    heading:
      service.slug === "fitted-wardrobe-cost"
        ? "The guide prices, by size and finish"
        : `What do ${service.title.toLowerCase()} cost?`,
    lead: "The honest answer is a range, because the room decides it.",
    rows: [
      { label: "Guide price", text: service.price },
      { label: "What moves it", q: "q11" },
      { label: "Smallest job taken", q: "q12" },
    ],
  },
  {
    id: "how-long",
    heading: "How long does it take?",
    lead: "Two different clocks: how far ahead the work is booked, and how long the work itself runs.",
    rows: [
      { label: "Booked ahead", q: "q07" },
      { label: "Survey to drawings", q: "q18" },
      { label: "Days on site", q: "q30" },
    ],
  },
  {
    id: "made-from",
    heading: "What is it made from?",
    lead: "Engineered board rather than solid timber, and that is a decision rather than a compromise.",
    rows: [
      { label: "Materials", q: "q22" },
      { label: "Finishes", q: "q24" },
      { label: "Hardware", q: "q28" },
      { label: "Why not solid timber", q: "q43" },
    ],
  },
  {
    id: "fitting",
    heading: "How is it fitted?",
    lead: "London rooms are rarely square. What happens where the piece meets the wall is the whole job.",
    rows: [
      { label: "Scribing", q: "q31" },
      { label: "Clearing up", q: "q33" },
    ],
  },
  {
    id: "after",
    heading: "What happens afterwards?",
    lead: "Timber moves with the first heating season. What matters is who comes back.",
    rows: [
      { label: "Guarantee", q: "q35" },
      { label: "Adjustments", q: "q36" },
    ],
  },
];
---

<Base
  title={service.heading}
  description={service.description}
  schema={schema}
  noindex={!isIndexable}
>
  <article>
    <!-- Hero -->
    <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
      <nav aria-label="Breadcrumb" style="margin-bottom:var(--space-10)">
        <MonoLabel tone="soft">
          <Link href="/" variant="nav">Home</Link>
          <span aria-hidden="true" style="padding:0 var(--space-5)">/</span>
          {service.title}
        </MonoLabel>
      </nav>

      <Kicker scribe>{service.primary}</Kicker>

      <Display level={1} as="h1" measure="var(--measure-display)" style="margin:var(--space-12) 0 var(--space-13)">
        {service.heading}
      </Display>

      <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
        {service.summary}
      </p>

      <div style="display:flex;flex-wrap:wrap;gap:var(--space-12) var(--space-15);align-items:baseline;margin-top:var(--space-15)">
        <Link href="#enquire" variant="cta" chamfer>Get a price</Link>
        <Link href={CONTACT.phoneHref} variant="nav" chamfer>Call {CONTACT.phoneDisplay}</Link>
        <Link href={CONTACT.whatsapp} variant="nav" chamfer>WhatsApp</Link>
      </div>
    </Wrap>

    <!-- The work itself, before any of the words -->
    <Wrap style="padding-bottom:var(--section-y)">
      <SectionHead meta={photos.length ? `${photos.length} of this work` : undefined} scribe>
        The work
      </SectionHead>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:var(--gap-md)">
        {photos.length > 0
          ? photos.map((p, i) => (
              <Plate
                photo={p.file}
                alt={altFor(i + 1)}
                width={p.w}
                height={p.h}
                subject={`Plate ${String(i + 1).padStart(2, "0")} · ${service.title}`}
                detail="Completed"
                eager={i === 0}
                plane={i === 0 ? "left" : false}
              />
            ))
          : (
            <>
              <Plate subject="Plate 01" detail="None in the library" awaiting="No finished photograph exists for this service yet" />
              <Plate subject="Plate 02" detail="None in the library" awaiting="Requested from the client" />
            </>
          )}
      </div>
    </Wrap>

    {copy && (
      <Wrap style="padding-bottom:var(--section-y)">
        <div style="max-width:var(--measure)">
          {copy.intro.map((p, i) => (
            <p style={i ? "margin-top:var(--space-10)" : undefined}>{p}</p>
          ))}
        </div>
      </Wrap>
    )}

    <!-- Question-shaped sections -->
    {SECTIONS.map((section) => (
      <>
        <Wrap style="padding-bottom:var(--section-y)">
          <SectionHead id={section.id} level={4}>{section.heading}</SectionHead>
          <div style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--gap-xl);align-items:start">
            <p style="max-width:var(--measure-short);color:var(--text-quiet)">{copy?.leads?.[section.id] ?? section.lead}</p>
            <SpecTable
              stamp
              rows={[]}
              labelWidth="34%"
            >
              {section.rows.map((row) => (
                <tr>
                  <td style="width:34%;padding:var(--space-4) 0;padding-right:var(--space-8);border-bottom:var(--rule-hair);vertical-align:top;text-transform:uppercase;letter-spacing:var(--ls-mono-table);font-size:var(--type-mono);color:var(--ink-soft)">
                    {row.label}
                  </td>
                  <td style="padding:var(--space-4) 0;border-bottom:var(--rule-hair);vertical-align:top">
                    {row.q ? <Value q={row.q} /> : row.text}
                  </td>
                </tr>
              ))}
            </SpecTable>
          </div>
        </Wrap>

        {section.id === "cost" && copy?.priceTables && (
          <Wrap style="padding-bottom:var(--section-y)">
            {copy.priceTables.map((t) => (
              <div style="margin-bottom:var(--space-15)">
                <SectionHead level={5}>{t.title}</SectionHead>
                <p style="max-width:var(--measure);margin-top:var(--space-5);font-size:var(--type-body-sm);color:var(--text-quiet)">
                  {t.note}
                </p>
                <div style="overflow-x:auto;margin-top:var(--space-9)">
                  <table style="width:100%;border-collapse:collapse;min-width:520px">
                    <thead>
                      <tr>
                        {t.columns.map((c) => (
                          <th style="text-align:left;padding:var(--space-4) var(--space-8) var(--space-4) 0;border-bottom:var(--rule-structure);text-transform:uppercase;letter-spacing:var(--ls-mono-table);font-size:var(--type-mono);font-weight:var(--weight-regular);color:var(--ink-soft)">
                            {c}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {t.rows.map((r) => (
                        <tr>
                          {r.map((cell, i) => (
                            <td style={`padding:var(--space-5) var(--space-8) var(--space-5) 0;border-bottom:var(--rule-hair);vertical-align:top${i === 0 ? "" : ";font-family:var(--font-mono);font-size:var(--type-mono);letter-spacing:var(--ls-mono-table)"}`}>
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
            {copy.priceNotes?.map((n) => (
              <p style="max-width:var(--measure);margin-top:var(--space-8);font-size:var(--type-body-sm);color:var(--text-quiet)">{n}</p>
            ))}
          </Wrap>
        )}
      </>
    ))}

    {copy && copy.sections.map((sec) => (
      <Wrap style="padding-bottom:var(--section-y)">
        <SectionHead meta={sec.meta} level={4}>{sec.heading}</SectionHead>
        <div style="max-width:var(--measure)">
          {sec.body.map((p, i) => (
            <p style={i ? "margin-top:var(--space-10)" : undefined}>{p}</p>
          ))}
        </div>
      </Wrap>
    ))}

    <!-- Where we work. Confirmed, so it carries no open question. -->
    <Wrap style="padding-bottom:var(--section-y)">
      <SectionHead meta="Service area" level={4}>Where we work</SectionHead>
      <p style="max-width:var(--measure)">
        {BUSINESS.areaServed.slice(0, -1).join(", ")} and {BUSINESS.areaServed.slice(-1)}.
      </p>
    </Wrap>

    {copy && copy.faqs.length > 0 && (
      <Wrap style="padding-bottom:var(--section-y)">
        <SectionHead meta="Questions" scribe>Asked before enquiring</SectionHead>
        <div style="margin-top:var(--space-12);max-width:var(--measure);border-bottom:var(--rule-hair)">
          {copy.faqs.map((f) => <Faq q={f.q}>{f.a}</Faq>)}
        </div>
      </Wrap>
    )}

    <!-- Enquiry -->
    <section id="enquire">
      {/* cta suppressed: the form itself sits directly below this band. */}
      <EnquireBand heading="If you have a room in mind, start here." cta={null} chamfer>
        {BAND.body}
        <Fragment slot="facts">
          {BAND.facts.map((q) => (
            <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
              <Value q={q} />
            </MonoLabel>
          ))}
        </Fragment>
      </EnquireBand>

      <Wrap style="padding-top:var(--section-y);padding-bottom:var(--section-y)">
        <div style="max-width:var(--measure-tight)">
          <EnquiryForm compact />
        </div>
      </Wrap>
    </section>

    <!-- Cross-links -->
    <Wrap style="padding-bottom:var(--section-y)">
      <SectionHead level={5}>Also worth a look</SectionHead>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--gap-md)">
        {others.map((s) => (
          <li style="border-top:var(--rule-structure);padding-top:var(--space-9)">
            <Link href={servicePath(s)} variant="nav" chamfer>{s.title}</Link>
            <p style="margin-top:var(--space-6);font-size:var(--type-body-sm);color:var(--text-quiet)">{s.summary}</p>
          </li>
        ))}
      </ul>
    </Wrap>
  </article>
</Base>
