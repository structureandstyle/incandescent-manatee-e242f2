---
/**
 * Not found.
 *
 * The rebuild replaced a single-URL React app with real routes, so every deep
 * link anyone ever saved from the old site now lands somewhere that does not
 * exist. This page exists so that lands on a way back into the funnel rather
 * than on Netlify's default.
 *
 * No question gate: it states no fact that the content questionnaire owns, so
 * it is publishable the day it is written. Netlify serves it on a 404 status,
 * which is what keeps it out of the index without a robots tag.
 *
 * Ported to the design system 2 Sep 2026.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import Link from "../components/ds/Link.astro";
import { BUSINESS } from "../data/site";
---

<Base
  title="Page not found"
  description="That page is not here. Find your way back to Structure & Style, or get in touch about your project."
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>404</Kicker>
    <Display level={2} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      Page not found
    </Display>
    <div style="max-width:var(--measure);color:var(--text-quiet)">
      <p>
        There is nothing at this address. The site was rebuilt recently, so a page you saved
        earlier may have moved, or the link may simply have a typo in it.
      </p>
      <p style="margin-top:var(--space-8)">
        Nothing is lost. Start again from the <Link href="/">home page</Link>, or tell us about
        your project and we will come back to you.
      </p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-10) var(--space-14);align-items:baseline;margin-top:var(--space-15)">
      <Link href="/contact/" variant="cta" chamfer>Send an enquiry</Link>
      <Link href={BUSINESS.phoneHref} variant="nav" chamfer>Call {BUSINESS.phoneDisplay}</Link>
      <Link href={BUSINESS.whatsapp} variant="nav" chamfer rel="noopener">WhatsApp</Link>
      <Link href={`mailto:${BUSINESS.email}`} variant="nav" chamfer>Email</Link>
    </div>
  </Wrap>
</Base>
