---
/**
 * The materials page.
 *
 * The design system's version listed European oak, American black walnut and
 * painted tulipwood, with quarter-sawn grain references and a swatch each. The
 * confirmed range (Q22, 30 Aug 2026) is engineered board throughout: five
 * families, each carrying its Q39 description from `site-content.ts`. Q22's
 * ruling also stands: who cuts the material, and the arrangement behind it,
 * stays off the site.
 *
 * No swatches yet. The design mapped its chips onto --oak, --walnut and
 * --green, and reusing those to stand for materials that are not those timbers
 * would put the removed claim back through the side door: a chip filled with
 * oak brown and captioned MDF still says oak. Q24 is now answered, so choosing
 * real swatches is unblocked, but it is a design decision not yet made.
 *
 * Q43 is the argument this page has to win, and it is his: engineered board
 * over solid timber as a considered choice, in his reasoning rather than ours.
 */
import Base from "../layouts/Base.astro";
import Wrap from "../components/ds/Wrap.astro";
import Display from "../components/ds/Display.astro";
import Kicker from "../components/ds/Kicker.astro";
import SectionHead from "../components/ds/SectionHead.astro";
import MaterialChip from "../components/ds/MaterialChip.astro";
import EnquireBand from "../components/ds/EnquireBand.astro";
import MonoLabel from "../components/ds/MonoLabel.astro";
import Value from "../components/Value.astro";

import { MATERIALS, BAND, CONTACT } from "../data/site-content";
import { indexable } from "../data/page-gates";

const isIndexable = indexable("/materials/");
---

<Base
  title="Materials and finishes"
  description="What bespoke fitted furniture is made from, what each material is like to work with, and why engineered board is the right choice for fitted work."
  noindex={!isIndexable}
>
  <Wrap style="padding-top:var(--hero-y);padding-bottom:var(--section-y)">
    <Kicker scribe>Materials</Kicker>
    <Display level={1} as="h1" style="margin:var(--space-12) 0 var(--space-13)">
      What it is made from
    </Display>
    <p style="max-width:var(--measure);font-size:var(--type-lede);color:var(--text-quiet)">
      Fitted furniture asks something different of a material than a freestanding piece does. It has
      to hold a line against a wall that moves, and hold a finish for years.
    </p>
  </Wrap>

  {/* The board families only: hardware has its own card on the homepage grid
      but its own whole section further down this page, so it stays off this
      grid rather than appearing twice. Each card opens with where the material
      is used and what weighs for and against it (added 1 Sep 2026). */}
  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead
      meta={`${MATERIALS.filter((m) => m.key !== "hardware").length} in the standard range`}
      scribe
    >
      The range
    </SectionHead>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:var(--gap-lg);align-items:start">
      {MATERIALS.filter((m) => m.key !== "hardware").map((m) => (
        <MaterialChip
          name={m.name}
          swatch={m.swatch}
          description={m.description}
          uses={m.uses}
          pros={m.pros}
          cons={m.cons}
        />
      ))}
    </div>

    <p style="max-width:var(--measure);margin-top:var(--space-15);color:var(--text-quiet)">
      The full range: <Value q="q22" join=", " suffix="." /> Each is chosen for the design, the
      use, the finish and the budget of the project.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead meta="Finishes" level={4}>How it is finished</SectionHead>
    <p style="max-width:var(--measure)"><Value q="q24" /></p>
  </Wrap>

  {/* Named brands allowed here by Denis's ruling, 30 Aug 2026: Blum and Hafele
      are what he actually specifies (Q28), and buyers recognise them. The
      protocol's supplier ban now reads as amended for hardware; the cutting
      arrangement stays unnamed, which is the client's own Q22 ruling. */}
  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead meta="Hardware" level={4}>What the moving parts are</SectionHead>
    <p style="max-width:var(--measure)"><Value q="q28" /></p>
    <p style="max-width:var(--measure);margin-top:var(--space-10);color:var(--text-quiet)">
      Hinges, drawer runners and other moving hardware also carry their manufacturer's warranty,
      on top of our own guarantee.
    </p>
  </Wrap>

  <Wrap style="padding-bottom:var(--section-y)">
    <SectionHead meta="The one worth asking about" level={4}>Why not solid timber</SectionHead>
    <p style="max-width:var(--measure)"><Value q="q43" /></p>
    <p style="max-width:var(--measure);margin-top:var(--space-10);color:var(--text-quiet)">
      The one we reach for first: <Value q="q40" />
    </p>
  </Wrap>

  <EnquireBand heading="If you have a room in mind, start here." chamfer>
    {BAND.body}
    <Fragment slot="facts">
      {BAND.facts.map((q) => (
        <MonoLabel size="md" tone="paper-soft" style="letter-spacing:.1em">
          <Value q={q} />
        </MonoLabel>
      ))}
    </Fragment>
  </EnquireBand>
</Base>
